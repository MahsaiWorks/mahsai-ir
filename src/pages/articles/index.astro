---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<BaseLayout
  title={`مقالات آموزشی املاک | ${siteConfig.brandName}`}
  description="راهنماهای کاربردی MAHSAI برای مدیریت فایل ملکی، متقاضیان و فعالیت‌های روزانه مشاوران املاک."
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">دانش کاربردی</p>
      <h1>مقالات آموزشی املاک</h1>
      <p class="page-lead">
        راهنماهای کوتاه و کاربردی برای ثبت بهتر اطلاعات، پیگیری منظم و استفاده
        دقیق‌تر از ابزارهای متراژ.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell articles-grid">
      {
        articles.map((article) => (
          <article class="article-card">
            <div class="article-meta">
              <span>{article.data.category}</span>
              <span>{article.data.readingTime}</span>
            </div>
            <div>
              <h2>
                <a href={`/articles/${article.id}/`}>{article.data.title}</a>
              </h2>
              <p>{article.data.description}</p>
            </div>
            <div class="article-footer">
              <time datetime={article.data.publishedAt.toISOString()}>
                {formatDate(article.data.publishedAt)}
              </time>
              <a class="text-link" href={`/articles/${article.id}/`}>
                مطالعه مقاله <span aria-hidden="true">←</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
