---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import { siteConfig } from '../../config/site';
import { articleClusters } from '../../data/articleClusters';
import { guideTopics } from '../../data/guideTopics';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featured =
  articles.find((article) => article.id === 'score-property-files') ??
  articles.find((article) => article.data.featured) ??
  articles[0];

const clusterArticles = (cluster: (typeof articleClusters)[number]['id']) =>
  articles
    .filter((article) => article.data.cluster === cluster)
    .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
---

<BaseLayout
  title={`مجلهٔ مشاور املاک؛ فایل، مشتری و آگهی | ${siteConfig.brandName}`}
  description="مقاله‌های ساده، تصویری و کاربردی برای مشاوران املاک ایران؛ از فایل‌گیری و نیازسنجی مشتری تا بازدید، پیگیری، آگهی و امنیت اطلاعات."
>
  {
    featured && (
      <header class="journal-hero">
        <div class="shell journal-hero-grid">
          <div>
            <p class="kicker">مجلهٔ کاربردی متراژ</p>
            <h1>راهنمایی که فردا در دفتر به کارتان می‌آید.</h1>
            <p class="lead">
              مقاله‌ها روان، تصویری و قابل اجرا نوشته شده‌اند؛ هر مطلب یک مسئلهٔ
              واقعی را باز می‌کند و با یک قدم مشخص تمام می‌شود.
            </p>
            <div class="hero-actions">
              <a class="button" href={`/articles/${featured.id}/`}>
                پیشنهاد برای شروع
              </a>
              <a class="text-link" href="/academy/">
                مسیرهای آموزشی ←
              </a>
            </div>
          </div>
          <article class="journal-feature-card">
            <a href={`/articles/${featured.id}/`}>
              <img
                src={featured.data.cover}
                alt={featured.data.coverAlt}
                width={featured.data.coverWidth}
                height={featured.data.coverHeight}
              />
              <div>
                <span>{featured.data.category}</span>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
              </div>
            </a>
          </article>
        </div>
      </header>
    )
  }

  <nav class="cluster-nav" aria-label="موضوع‌های مجلهٔ املاک">
    <div class="shell cluster-nav-grid">
      {
        articleClusters.map((cluster) => (
          <a href={`#cluster-${cluster.id}`}>
            <strong>{cluster.title}</strong>
            <span>{clusterArticles(cluster.id).length} مطلب</span>
          </a>
        ))
      }
    </div>
  </nav>

  <section
    class="section journal-guides"
    aria-labelledby="journal-guides-title"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">قبل از انتخاب مقاله</p>
          <h2 id="journal-guides-title">
            یک موضوع را از ابتدا تا انتها جمع‌بندی کنید.
          </h2>
        </div>
        <a class="text-link" href="/guides/">همهٔ راهنماهای جامع ←</a>
      </header>
      <div class="guide-card-grid">
        {guideTopics.map((guide) => <GuideCard guide={guide} compact />)}
      </div>
    </div>
  </section>

  <div class="article-clusters">
    {
      articleClusters.map((cluster, index) => {
        const entries = clusterArticles(cluster.id);
        if (entries.length === 0) return null;

        return (
          <section
            class:list={[
              'section article-cluster',
              { 'article-cluster-alt': index % 2 === 1 },
            ]}
            id={`cluster-${cluster.id}`}
            aria-labelledby={`cluster-title-${cluster.id}`}
          >
            <div class="shell article-cluster-layout">
              <header class="cluster-section-head">
                <div>
                  <p class="kicker">موضوع</p>
                  <h2 id={`cluster-title-${cluster.id}`}>{cluster.title}</h2>
                </div>
                <p>{cluster.description}</p>
              </header>
              <div
                class:list={[
                  'editorial-grid',
                  'article-cluster-grid',
                  { 'editorial-grid-single': entries.length === 1 },
                ]}
              >
                {entries.map((article, articleIndex) => (
                  <ArticleCard
                    article={article}
                    featured={articleIndex === 0}
                  />
                ))}
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="journal-cta">
    <div class="shell journal-cta-inner">
      <div>
        <p class="kicker kicker-light">دانش وقتی ارزش دارد که اجرا شود</p>
        <h2>راهنما را بخوانید؛ ادامهٔ کار را در متراژ مرتب کنید.</h2>
      </div>
      <p>
        فایل‌ها، نیاز مشتری، بازدیدها و پیگیری‌های روزانه را یک‌جا نگه دارید تا
        چیزی وسط شلوغی دفتر جا نماند.
      </p>
      <a class="button button-light" href="/apps/metrazh/">آشنایی با متراژ</a>
    </div>
  </section>
</BaseLayout>
