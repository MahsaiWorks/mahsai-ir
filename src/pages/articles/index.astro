---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { articleClusters } from '../../data/articleClusters';
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const featured =
  articles.find((article) => article.data.featured) ?? articles[0];
const latest = articles
  .filter((article) => article.id !== featured?.id)
  .slice(0, 6);
const numbers = new Intl.NumberFormat('fa-IR');
---

<BaseLayout
  title="مجلهٔ مهسای | راهکارهای کاربردی برای کار روزانه"
  description="مقاله‌ها و راهنماهای مهسای برای مشاوران املاک؛ از ثبت فایل و شناخت مشتری تا پیگیری، بازدید و امنیت اطلاعات."
>
  <header class="brand-journal-header shell">
    <p class="kicker">خواندنی‌های کاربردی</p><h1>مجلهٔ مهسای</h1><p>
      پاسخ روشن به پرسش‌های کار روزانه
    </p>
  </header>
  {
    featured && (
      <section class="shell brand-journal-feature" aria-label="مقالهٔ منتخب">
        <>
          <a
            class="brand-journal-cover"
            href={`/articles/${featured.id}/`}
            aria-hidden="true"
            tabindex="-1"
          >
            <ResponsiveImage
              src={featured.data.cover}
              width={featured.data.coverWidth}
              height={featured.data.coverHeight}
              alt=""
              aria-hidden="true"
              fetchpriority="high"
            />
          </a>
          <div>
            <>
              <p class="kicker">انتخاب برای خواندن</p>
              <h2>
                <a href={`/articles/${featured.id}/`}>{featured.data.title}</a>
              </h2>
              <p>{featured.data.description}</p>
              <span class="brand-reading-meta">
                {featured.data.category} — {featured.data.readingTime}
              </span>
              <a class="text-link" href={`/articles/${featured.id}/`}>
                خواندن مقاله ←
              </a>
            </>
          </div>
        </>
      </section>
    )
  }
  <nav class="shell brand-topic-nav" aria-label="موضوع‌های مجله">
    {
      articleClusters.map((cluster) => (
        <a href={`/articles/topics/${cluster.id}/`}>
          <>
            <strong>{cluster.title}</strong>
            <span>
              {numbers.format(
                articles.filter(
                  (article) => article.data.cluster === cluster.id,
                ).length,
              )}{' '}
              مقاله
            </span>
          </>
        </a>
      ))
    }
  </nav>
  <section class="section" aria-labelledby="latest-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">تازه‌های مجله</p><h2 id="latest-title">
            پیشنهاد ما برای خواندن
          </h2>
        </div><a class="text-link" href="/guides/">راهنماهای جامع ←</a>
      </header><div class="article-grid brand-reading-grid">
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
  <section
    class="section brand-next-steps"
    aria-labelledby="reading-paths-title"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">مطالعهٔ موضوعی</p><h2 id="reading-paths-title">
            از موضوع مورد نیازتان شروع کنید
          </h2>
        </div><p>مقاله‌های هر موضوع در یک مسیر مشخص کنار هم قرار گرفته‌اند.</p>
      </header><div class="brand-topic-directory">
        {
          articleClusters.map((cluster) => (
            <div>
              <>
                <h3>
                  <a href={`/articles/topics/${cluster.id}/`}>
                    {cluster.title}
                  </a>
                </h3>
                <ul>
                  {articles
                    .filter((article) => article.data.cluster === cluster.id)
                    .slice(0, 3)
                    .map((article) => (
                      <li>
                        <a href={`/articles/${article.id}/`}>
                          {article.data.title}
                        </a>
                      </li>
                    ))}
                </ul>
                <a class="text-link" href={`/articles/topics/${cluster.id}/`}>
                  همهٔ مقاله‌های این موضوع ←
                </a>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell brand-contact-row">
      <div>
        <p class="kicker">از خواندن تا انجام دادن</p><h2>
          همراه با تمرین یاد بگیرید
        </h2><p>در آموزش‌های مهسای، مثال‌ها را قدم‌به‌قدم اجرا می‌کنید.</p>
      </div><a class="button" href="/academy/">آموزش‌های رایگان</a>
    </div>
  </section>
</BaseLayout>
