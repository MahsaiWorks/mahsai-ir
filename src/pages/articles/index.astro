---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import PageStage from '../../components/PageStage.astro';
import { siteConfig } from '../../config/site';
import { articleClusters } from '../../data/articleClusters';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featured =
  articles.find((article) => article.id === 'score-property-files') ??
  articles.find((article) => article.data.featured) ??
  articles[0];

const clusterArticles = (cluster: (typeof articleClusters)[number]['id']) =>
  articles
    .filter((article) => article.data.cluster === cluster)
    .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
---

<BaseLayout
  title={`آموزش مشاور املاک؛ فایل، مشتری و آگهی | ${siteConfig.brandName}`}
  description="راهنماهای کاربردی و به‌هم‌پیوسته برای مشاوران املاک؛ از فایل‌گیری و نیازسنجی مشتری تا بازدید، پیگیری، آگهی‌نویسی و امنیت اطلاعات."
>
  <PageStage
    eyebrow="مجلهٔ کاربردی متراژ"
    title="راهنماهایی که فردا در دفتر"
    highlight="به کارتان می‌آیند."
    lead="هر مقاله یک مسئلهٔ واقعی دفتر املاک را با زبان ساده باز می‌کند، نمونه و تصویر دارد و با یک قدم قابل اجرا تمام می‌شود؛ از ثبت فایل تا پیگیری مشتری و نوشتن آگهی."
    note="این مطالب کنار اپلیکیشن متراژ ساخته شده‌اند: راهنما کمک می‌کند روش درست را بفهمید و متراژ کمک می‌کند همان روش را در کار روزانه منظم نگه دارید."
    signals={[
      'فایل و داده',
      'مشتری و بازدید',
      'آگهی و بازاریابی',
      'دانش حقوقی عمومی',
    ]}
    tone="mint"
  />

  <nav class="cluster-nav" aria-label="مسیرهای مطالعه مقالات">
    <div class="shell cluster-nav-grid">
      {
        articleClusters.map((cluster) => (
          <a href={`#cluster-${cluster.id}`}>
            <strong>{cluster.title}</strong>
            <p>{cluster.description}</p>
          </a>
        ))
      }
    </div>
  </nav>

  {
    featured && (
      <section
        class="page-section featured-reading"
        aria-labelledby="featured-reading-title"
      >
        <div class="shell featured-reading-grid">
          <a class="featured-reading-media" href={`/articles/${featured.id}/`}>
            <img src={featured.data.cover} alt={featured.data.coverAlt} />
          </a>
          <div class="featured-reading-copy">
            <p class="eyebrow">برای شروع از اینجا بخوانید</p>
            <span>
              {featured.data.category} · {featured.data.readingTime}
            </span>
            <h2 id="featured-reading-title">
              <a href={`/articles/${featured.id}/`}>{featured.data.title}</a>
            </h2>
            <p>{featured.data.description}</p>
            <ul>
              {featured.data.takeaways.map((takeaway) => (
                <li>{takeaway}</li>
              ))}
            </ul>
            <a class="button" href={`/articles/${featured.id}/`}>
              شروع مطالعه
            </a>
          </div>
        </div>
      </section>
    )
  }

  <div class="article-clusters">
    {
      articleClusters.map((cluster) => {
        const entries = clusterArticles(cluster.id);
        if (entries.length === 0) return null;

        return (
          <section
            class="page-section article-cluster"
            id={`cluster-${cluster.id}`}
            aria-labelledby={`cluster-title-${cluster.id}`}
          >
            <div class="shell">
              <header class="cluster-heading">
                <div>
                  <p class="eyebrow">مسیر مطالعه</p>
                  <h2 id={`cluster-title-${cluster.id}`}>{cluster.title}</h2>
                  <p>{cluster.description}</p>
                </div>
              </header>
              <div class="editorial-grid">
                {entries.map((article, index) => (
                  <ArticleCard article={article} featured={index === 0} />
                ))}
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="journal-cta">
    <div class="shell journal-cta-inner">
      <div>
        <p class="eyebrow">دانش وقتی به درد می‌خورد که اجرا شود</p>
        <h2>راهنما را بخوانید؛ ادامه کار را در متراژ مرتب کنید.</h2>
      </div>
      <p>
        فایل‌ها، نیاز مشتری، بازدیدها و پیگیری‌های روزانه را یک‌جا نگه دارید تا
        چیزی وسط شلوغی دفتر جا نماند.
      </p>
      <a class="button" href="/apps/metrazh/">آشنایی با متراژ</a>
    </div>
  </section>
</BaseLayout>
