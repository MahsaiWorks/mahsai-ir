---
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config/site';
import { articleClusters } from '../../data/articleClusters';
import AnswerFirst from '../../components/AnswerFirst.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter(
    (article) => !article.data.draft,
  );

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const { Content, headings } = await render(article);
const canonical = new URL(Astro.url.pathname, Astro.site);
const cluster = articleClusters.find(
  (entry) => entry.id === article.data.cluster,
);
const sameCluster = allArticles
  .filter(
    (entry) =>
      entry.id !== article.id && entry.data.cluster === article.data.cluster,
  )
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
const nextInSeries =
  sameCluster.find(
    (entry) => entry.data.seriesOrder > article.data.seriesOrder,
  ) ?? sameCluster[0];

const explicitRelated = article.data.related
  .map((id) => allArticles.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);
const relatedArticles = [...explicitRelated, ...sameCluster]
  .filter(
    (entry, index, entries) =>
      entries.findIndex((candidate) => candidate.id === entry.id) === index,
  )
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  image: new URL(article.data.cover, Astro.site).toString(),
  keywords: article.data.keywords.join(', '),
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (
    article.data.updatedAt ?? article.data.publishedAt
  ).toISOString(),
  mainEntityOfPage: canonical.toString(),
  author: {
    '@type': 'Organization',
    name: siteConfig.brandName,
    url: new URL('/about/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.brandName,
  },
  inLanguage: 'fa-IR',
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'خانه',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'مجلهٔ املاک',
      item: new URL('/articles/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: canonical.toString(),
    },
  ],
};
---

<BaseLayout
  title={`${article.data.title} | ${siteConfig.brandName}`}
  description={article.data.description}
  image={article.data.cover}
  imageAlt={article.data.coverAlt}
  imageWidth={article.data.coverWidth}
  imageHeight={article.data.coverHeight}
  type="article"
  keywords={article.data.keywords}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleStructuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbStructuredData)}
  />

  <article class="article-page" data-accent={article.data.accent}>
    <header class="article-stage">
      <div class="shell">
        <nav class="breadcrumbs" aria-label="مسیر صفحه">
          <a href="/">خانه</a><span aria-hidden="true">/</span>
          <a href="/articles/">مجلهٔ املاک</a><span aria-hidden="true">/</span>
          <span>{cluster?.title ?? article.data.category}</span>
        </nav>

        <div class="article-stage-grid">
          <div class="article-stage-copy">
            <p class="article-stage-label">
              <span>{article.data.category}</span>
              <i aria-hidden="true"></i>
              {cluster?.title}
            </p>
            <h1>{article.data.title}</h1>
            <p class="article-deck">{article.data.description}</p>
            <div class="article-byline">
              <span>نویسنده: تحریریهٔ {siteConfig.brandName}</span>
              <time datetime={article.data.publishedAt.toISOString()}>
                انتشار: {formatDate(article.data.publishedAt)}
              </time>
              {
                article.data.updatedAt && (
                  <time datetime={article.data.updatedAt.toISOString()}>
                    به‌روزرسانی: {formatDate(article.data.updatedAt)}
                  </time>
                )
              }
              <span>{article.data.readingTime} مطالعه</span>
            </div>

            <div class="article-takeaways">
              <p>در این راهنما چه چیزی یاد می‌گیرید؟</p>
              <ul>
                {article.data.takeaways.map((takeaway) => <li>{takeaway}</li>)}
              </ul>
            </div>
          </div>

          <figure class="article-stage-cover">
            <img
              src={article.data.cover}
              alt={article.data.coverAlt}
              width={article.data.coverWidth}
              height={article.data.coverHeight}
              style={`object-position: ${article.data.coverPosition} center`}
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </header>

    <div
      class="shell article-reading-layout"
      data-view-event="article_reading_started"
    >
      <aside class="article-toc" aria-label="فهرست مقاله">
        <p>سریع بروید سراغ بخش موردنظرتان</p>
        <ol>
          {
            headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))
          }
        </ol>
        <a
          class="toc-product-link"
          href="/apps/metrazh/"
          data-event="article_to_metrazh"
          data-event-location="article_toc"
        >
          ببینید متراژ چه کمکی می‌کند <span aria-hidden="true">←</span>
        </a>
        <a class="toc-academy-link" href="/academy/">
          مسیرهای آموزشی املاک <span aria-hidden="true">←</span>
        </a>
      </aside>

      <div class="article-body prose">
        <AnswerFirst answer={article.data.description} />
        <Content />
        <section class="editorial-note" aria-labelledby="editorial-note-title">
          <p class="eyebrow">شفافیت تحریریه</p>
          <h2 id="editorial-note-title">این مطلب چطور تهیه و به‌روز می‌شود؟</h2>
          <dl>
            <div>
              <dt>مسئول محتوا</dt>
              <dd>تحریریهٔ {siteConfig.brandName}</dd>
            </div>
            <div>
              <dt>روش تهیه</dt>
              <dd>
                {
                  article.data.cluster === 'legal'
                    ? 'مرور منابع و درگاه‌های رسمی پیوندشده در متن، همراه با هشدار مراجعه به فرد دارای صلاحیت برای هر پرونده.'
                    : 'آموزش مرحله‌ای و قابل اجرا، با تطبیق ادعاهای محصول با قابلیت‌های مستند نسخهٔ عمومی متراژ.'
                }
              </dd>
            </div>
            <div>
              <dt>آخرین بررسی</dt>
              <dd>
                {formatDate(article.data.updatedAt ?? article.data.publishedAt)}
              </dd>
            </div>
          </dl>
          {
            article.data.cluster === 'legal' && (
              <p class="editorial-warning">
                این نوشته تا تاریخ بالا تأییدیهٔ وکیل یا کارشناس حقوقی بیرونی
                ندارد و جای مشاورهٔ تخصصی برای پروندهٔ واقعی را نمی‌گیرد.
              </p>
            )
          }
          <p>
            خطا یا اطلاعات قدیمی دیدید؟ مسیر اصلاح و شیوهٔ پاسخ‌گویی در
            <a href="/editorial-policy/"> سیاست تحریریه و اصلاحات</a> آمده است.
          </p>
        </section>
        <aside class="article-inline-cta">
          <span>متراژ، محصول مهسای</span>
          <h2>اگر این روش به کارتان می‌آید، داخل متراژ مرتب نگهش دارید.</h2>
          <p>
            فایل، متقاضی، بازدید و پیگیری را یک‌جا ثبت کنید تا دفعه بعد از صفر
            شروع نکنید و وسط شلوغی دفتر چیزی جا نماند.
          </p>
          <a
            class="button"
            href="/apps/metrazh/"
            data-event="article_to_metrazh"
            data-event-location="article_inline_cta">متراژ را ببینید</a
          >
        </aside>
      </div>
    </div>
  </article>

  {
    nextInSeries && (
      <section class="series-next" aria-labelledby="series-next-title">
        <div class="shell series-next-inner">
          <div>
            <p class="eyebrow">قدم بعدی این مسیر</p>
            <h2 id="series-next-title">
              <a href={`/articles/${nextInSeries.id}/`}>
                {nextInSeries.data.title}
              </a>
            </h2>
            <p>{nextInSeries.data.description}</p>
          </div>
          <a class="button" href={`/articles/${nextInSeries.id}/`}>
            ادامه مطالعه
          </a>
        </div>
      </section>
    )
  }

  {
    relatedArticles.length > 0 && (
      <section class="related-stories" aria-labelledby="related-title">
        <div class="shell">
          <div class="journal-section-head">
            <div>
              <p class="eyebrow">اگر این موضوع برایتان مهم بود</p>
              <h2 id="related-title">این راهنماها را هم از دست ندهید.</h2>
            </div>
            <a class="story-link" href="/articles/">
              همهٔ مقاله‌ها
            </a>
          </div>
          <div class="related-grid">
            {relatedArticles.map((related) => (
              <article class="related-card">
                <a href={`/articles/${related.id}/`}>
                  <img
                    src={related.data.cover}
                    alt={related.data.coverAlt}
                    width={related.data.coverWidth}
                    height={related.data.coverHeight}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <p>{related.data.category}</p>
                <h3>
                  <a href={`/articles/${related.id}/`}>{related.data.title}</a>
                </h3>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
