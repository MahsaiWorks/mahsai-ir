---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandCompanion from '../components/BrandCompanion.astro';
---

<BaseLayout
  title="دربارهٔ مهسای | فناوری برای زندگی و کار"
  description="مهسای، خانهٔ ابزارهای فارسی، آموزش‌های کاربردی و راهنمای استفاده؛ با اپلیکیشن متراژ و مسیرهای رسمی ارتباط و پشتیبانی آشنا شوید."
>
  <header class="inner-hero about-hero">
    <div class="shell inner-hero-grid">
      <div>
        <p class="kicker">دربارهٔ مهسای</p><h1>
          فناوری باید کار را آسان‌تر کند
        </h1><p class="lead">
          مهسای از نیازهای روزمره شروع می‌کند؛ ابزارهای فارسی می‌سازیم و آموزش و
          راهنما را کنار آن‌ها قرار می‌دهیم تا استفاده از فناوری ساده‌تر شود.
        </p><div class="hero-actions">
          <a class="button" href="/apps/">مشاهدهٔ اپلیکیشن‌ها</a><a
            class="text-link"
            href="/academy/">آموزش‌های مهسای ←</a
          >
        </div>
      </div>
      <BrandCompanion eager />
    </div>
  </header>
  <section class="section" aria-labelledby="our-approach-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">نگاه ما</p><h2 id="our-approach-title">
            کار با مهسای باید آسان باشد
          </h2>
        </div><p>طراحی ساده، متن خوانا و راهنمایی در زمان نیاز.</p>
      </header>
      <div class="brand-feature-strip">
        <article>
          <h3>زبان آشنا</h3><p>
            فارسی روان، چیدمان راست‌به‌چپ و مثال‌هایی نزدیک به زندگی و کار شما.
          </p>
        </article><article>
          <h3>ابزارهای کاربردی</h3><p>
            روی کارهایی تمرکز می‌کنیم که هر روز به آن‌ها نیاز دارید.
          </p>
        </article><article>
          <h3>آموزش و پشتیبانی</h3><p>
            آموزش، راهنمای نسخه‌ها و پشتیبانی در کنار محصول در دسترس‌اند.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section
    class="section brand-next-steps"
    aria-labelledby="mahsai-world-title"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">دنیای مهسای</p><h2 id="mahsai-world-title">
            مهسای را بیشتر بشناسید
          </h2>
        </div>
      </header>
      <div class="brand-link-grid">
        <a href="/apps/"
          ><span>اپلیکیشن</span><h3>ابزارهای مهسای</h3><p>
            متراژ را بشناسید و محیط واقعی آن را ببینید
          </p><b aria-hidden="true">←</b></a
        ><a href="/academy/"
          ><span>یادگیری</span><h3>آموزش‌های کاربردی</h3><p>
            قدم‌به‌قدم همراه مثال و تمرین پیش بروید
          </p><b aria-hidden="true">←</b></a
        ><a href="/articles/"
          ><span>خواندنی</span><h3>مجلهٔ مهسای</h3><p>
            برای پرسش‌های کاری خود پاسخ پیدا کنید
          </p><b aria-hidden="true">←</b></a
        >
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell brand-contact-row">
      <div>
        <p class="kicker">در ارتباط باشیم</p><h2>
          تجربهٔ شما به بهتر شدن مهسای کمک می‌کند
        </h2><p>
          پرسش، پیشنهاد یا مشکلی در استفاده دارید؟ از راه‌های رسمی پشتیبانی با
          ما در میان بگذارید.
        </p>
      </div><a class="button" href="/support/">ارتباط با پشتیبانی</a>
    </div>
  </section>
</BaseLayout>
