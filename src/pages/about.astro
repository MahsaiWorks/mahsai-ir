---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);
if (!app) throw new Error('Published Metrazh content entry is missing.');
const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const instagramLink = siteConfig.socialLinks.find((link) =>
  link.url.includes('instagram.com/mahsaiapp'),
);
---

<BaseLayout
  title={`دربارهٔ ${siteConfig.brandName} | خانهٔ محصولات فارسی کاربردی`}
  description="MAHSAI خانهٔ اپلیکیشن‌های فارسی برای کار واقعی است؛ محصول فقط پس از انتشار رسمی معرفی می‌شود و آموزش و پشتیبانی مرتبط را کنار خود دارد."
>
  <header class="inner-hero about-hero">
    <div class="shell inner-hero-grid">
      <div>
        <p class="kicker">دربارهٔ MAHSAI</p>
        <h1>ما ابزارهای فارسی می‌سازیم تا کارهای روزمره ساده‌تر شوند</h1>
        <p class="lead">
          قبل از نصب می‌توانید محیط واقعی هر محصول را ببینید، روش استفاده‌اش را
          یاد بگیرید و اگر سؤال داشتید، مستقیم از ما بپرسید.
        </p>
        <div class="hero-actions">
          <a class="button" href="/apps/">محصولات منتشرشده</a>
          <a class="text-link" href="/support/">راه‌های پشتیبانی ←</a>
        </div>
      </div>
      <figure>
        <ResponsiveImage
          src="/images/editorial/property-workflow.webp"
          alt="میز کار منظم با پرونده‌های املاک و ماکت ساختمان"
          width="1536"
          height="1024"
        />
      </figure>
    </div>
  </header>

  <section class="section values-section" aria-labelledby="values-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">چطور محصول می‌سازیم؟</p>
          <h2 id="values-title">هر قابلیت باید یک کار واقعی را ساده‌تر کند</h2>
        </div>
        <p>
          کاربر باید سریع بفهمد محصول چه کاری انجام می‌دهد و آیا به درد کارش
          می‌خورد یا نه.
        </p>
      </header>
      <div class="value-grid">
        <article>
          <h3>اول نیاز کاربر، بعد امکانات</h3>
          <p>
            فهرست بلند امکانات کافی نیست. محصول باید یک کار واقعی را سریع‌تر یا
            ساده‌تر کند.
          </p>
        </article>
        <article>
          <h3>تصویر واقعی، نه وعده</h3>
          <p>
            کاربر باید محیط و قابلیت فعلی را ببیند؛ نه ماکتی که با نسخهٔ واقعی
            ارتباطی ندارد.
          </p>
        </article>
        <article>
          <h3>فارسی روان از روز اول</h3>
          <p>
            متن روان، چیدمان راست‌به‌چپ و مثال‌های آشنا از همان اول وارد طراحی
            می‌شوند، نه در آخر کار.
          </p>
        </article>
        <article>
          <h3>پشتیبانی بعد از انتشار</h3>
          <p>
            راه نصب، حریم خصوصی، نسخهٔ فعلی و راه تماس با پشتیبانی باید همیشه
            راحت پیدا شوند.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="release-policy" aria-labelledby="release-policy-title">
    <div class="shell release-policy-grid">
      <div>
        <p class="kicker kicker-light">سیاست معرفی محصول</p>
        <h2 id="release-policy-title">
          محصولی که هنوز آماده نیست، در سایت معرفی نمی‌کنیم
        </h2>
      </div>
      <p>
        نام، دسته‌بندی، تصویر یا وعدهٔ محصول درحال‌ساخت عمومی نخواهد شد. صفحهٔ
        محصول زمانی ساخته می‌شود که نسخهٔ رسمی قابل دریافت و مسیر پشتیبانی آماده
        باشد.
      </p>
    </div>
  </section>

  {
    instagramLink && (
      <section
        class="section official-channel-section"
        aria-labelledby="official-channel-title"
      >
        <div class="shell official-channel-card">
          <div>
            <p class="kicker">صفحهٔ رسمی اپلیکیشن‌ها</p>
            <h2 id="official-channel-title">
              MAHSAI را در اینستاگرام دنبال کنید.
            </h2>
            <p>
              در <bdi dir="ltr">@mahsaiapp</bdi> اپلیکیشن‌های منتشرشده،
              قابلیت‌های قابل استفاده و آموزش‌های کوتاه معرفی می‌شوند. محصولی که
              هنوز آماده و منتشر نشده باشد در این صفحه وعده داده نمی‌شود.
            </p>
          </div>
          <a
            class="button"
            href={instagramLink.url}
            target="_blank"
            rel="me noopener"
            data-event="official_instagram_open"
            data-event-location="about_page"
          >
            دیدن صفحهٔ @mahsaiapp
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    )
  }

  <section class="section about-product" aria-labelledby="about-product-title">
    <div class="shell about-product-grid">
      <div class="about-product-visual">
        <ResponsiveImage
          class="about-product-character"
          src="/images/home/metrazh-hero-character.webp"
          alt="مشاور املاک در حال استفاده از تلفن همراه"
          width="1717"
          height="916"
          loading="lazy"
          decoding="async"
        />
        <ResponsiveImage
          class="about-product-screen"
          src="/images/apps/metrazh/bazaar/customer-follow-up.webp"
          alt="تصویر رسمی متراژ در کافه‌بازار"
          width="1080"
          height="1920"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <p class="kicker">محصول منتشرشده</p>
        <ResponsiveImage
          class="metrazh-wordmark metrazh-wordmark-dark"
          src={app.data.wordmark}
          alt="متراژ"
          width="702"
          height="425"
        />
        <h2 id="about-product-title">متراژ برای مدیریت فایل و مشتری املاک</h2>
        <p>{app.data.shortDescription}</p>
        <div class="hero-actions">
          <a class="button" href="/apps/metrazh/">معرفی کامل متراژ</a>
          {
            bazaarLink && (
              <a
                class="text-link"
                href={getTrackedCafeBazaarUrl(bazaarLink.url, 'about_product')}
                target="_blank"
                rel="noopener"
              >
                نصب از کافه‌بازار ↗
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
