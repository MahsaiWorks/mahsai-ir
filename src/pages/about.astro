---
import { getCollection } from 'astro:content';
import PageStage from '../components/PageStage.astro';
import { siteConfig } from '../config/site';
import { getCafeBazaarLink } from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const metrazhApp = (await getCollection('apps')).find(
  (app) => app.id === 'metrazh',
);
if (!metrazhApp) throw new Error('Metrazh content entry is missing.');
const bazaarLink = getCafeBazaarLink(metrazhApp.data.storeLinks);
---

<BaseLayout
  title={`درباره ${siteConfig.brandName} | هوش مصنوعی و محصولات فارسی`}
  description="MAHSAI یک مرجع عملی هوش مصنوعی برای فارسی‌زبانان و سازندهٔ متراژ است؛ با تمرکز بر اطلاعات قابل بررسی و محصولی که از مسئلهٔ واقعی شروع می‌شود."
>
  <PageStage
    eyebrow="درباره MAHSAI"
    title="اطلاعات قابل بررسی؛"
    highlight="محصول قابل استفاده."
    lead="MAHSAI دو مسیر روشن دارد: تبدیل تغییرات سریع هوش مصنوعی به راهنمای فارسی قابل اجرا، و ساخت محصولاتی که از یک مسئلهٔ واقعی شروع می‌شوند."
    index="دو مسیر · یک استاندارد"
    note="مرکز AI و اپلیکیشن متراژ هویت و مسیر محتوایی مستقل دارند، اما هر دو باید دقیق، روشن و پاسخ‌گو باشند."
    signals={[
      'منبع و تاریخ بررسی',
      'فارسی و راست‌به‌چپ',
      'پشتیبانی رسمی',
      'اصلاح شفاف',
    ]}
    tone="mint"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href="/ai/">مرکز هوش مصنوعی</a>
      <a class="page-stage-link" href="/apps/metrazh/">معرفی متراژ</a>
    </div>
  </PageStage>

  <section class="page-section" aria-labelledby="about-paths-title">
    <div class="shell split-intro">
      <div class="split-intro-heading">
        <p class="eyebrow">MAHSAI چه می‌سازد؟</p>
        <h2 id="about-paths-title">دو نوع ارزش برای دو نیاز متفاوت.</h2>
      </div>
      <p>
        مرکز هوش مصنوعی برای تصمیم و یادگیری روزانه ساخته می‌شود. متراژ یک محصول
        مستقل برای نظم‌دادن به جریان کار مشاوران املاک است. هیچ‌کدام قرار نیست
        جای دیگری را بگیرد.
      </p>
    </div>
    <div class="shell about-ai-paths">
      <article>
        <span>01</span><p class="eyebrow">MAHSAI AI</p><h3>
          از تغییر سریع، اطلاعات قابل استفاده.
        </h3><p>
          رادار خبر، راهنمای ابزار، آموزش رایگان، آزمایش فارسی و هوش مصنوعی
          آفلاین؛ با لینک منبع و زمان آخرین بررسی.
        </p><a class="story-link" href="/ai/"
          >ورود به مرکز AI <span aria-hidden="true">←</span></a
        >
      </article>
      <article>
        <span>02</span><p class="eyebrow">محصول مستقل</p><img
          src={metrazhApp.data.logo.dark}
          alt="متراژ"
          width="170"
          height="103"
        /><h3>از تجربهٔ پراکنده، جریان کاری منظم.</h3><p>
          {metrazhApp.data.shortDescription}
        </p><a class="story-link" href="/apps/metrazh/"
          >معرفی کامل متراژ <span aria-hidden="true">←</span></a
        >
      </article>
    </div>
  </section>

  <section
    class="page-section page-section-ink"
    aria-labelledby="about-standard-title"
  >
    <div class="shell focus-ledger">
      <header>
        <p class="eyebrow">استاندارد مشترک</p><h2 id="about-standard-title">
          وضوح قبل از حجم.
        </h2>
      </header>
      <div>
        <article>
          <span>01</span><div>
            <h3>مسئله قبل از قابلیت</h3><p>
              محتوا و محصول باید یک نیاز مشخص را کوتاه‌تر، روشن‌تر یا کم‌خطاتر
              کنند.
            </p>
          </div>
        </article>
        <article>
          <span>02</span><div>
            <h3>شاهد قبل از ادعا</h3><p>
              خبر به منبع اصلی و نتیجهٔ آزمایش به روش قابل تکرار نیاز دارد.
            </p>
          </div>
        </article>
        <article>
          <span>03</span><div>
            <h3>فارسی از ابتدا</h3><p>
              زبان، راست‌به‌چپ و مثال‌های قابل لمس بخشی از طراحی‌اند، نه ترجمهٔ
              آخر کار.
            </p>
          </div>
        </article>
        <article>
          <span>04</span><div>
            <h3>مسئولیت بعد از انتشار</h3><p>
              تاریخ بررسی، مسیر پشتیبانی و سیاست اصلاح باید همیشه قابل مشاهده
              باشند.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell product-callout">
      <div class="product-callout-art">
        <img
          src="/images/editorial/female-consultant-matching.webp"
          alt="تصویر سه‌بعدی مشاور املاک در حال بررسی نیاز مشتری"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">محصول منتشرشده</p><img
          class="product-callout-logo"
          src="/images/apps/metrazh/wordmark-dark.png"
          alt="متراژ"
          width="170"
          height="103"
        /><h2>دستیار فارسی جریان کار املاک.</h2><p>
          متراژ برای ثبت فایل، مدیریت متقاضی، برنامه‌ریزی بازدید، پیگیری و
          آماده‌سازی خروجی‌های کاری طراحی شده است. نسخهٔ عمومی {
            metrazhApp.data.version
          } از مسیر رسمی کافه‌بازار در دسترس است.
        </p><div class="catalog-app-actions">
          {
            bazaarLink && (
              <a
                class="button"
                href={bazaarLink.url}
                target="_blank"
                rel="noopener"
              >
                دانلود از کافه‌بازار
              </a>
            )
          }<a class="text-link" href="/apps/metrazh/">معرفی کامل محصول ←</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
