---
import PageStage from '../components/PageStage.astro';
import { siteConfig } from '../config/site';
import { metrazhStory } from '../data/metrazhStory';
import { specialties } from '../data/specialties';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`درباره ${siteConfig.brandName} | توسعه اپلیکیشن فارسی`}
  description="داستان شکل‌گیری مهسای و متراژ؛ محصولی که از تجربه واقعی کار در املاک و مسئله پراکندگی اطلاعات ساخته شد."
>
  <PageStage
    eyebrow="درباره برند"
    title="متراژ از دل یک تجربه واقعی"
    highlight="ساخته شد."
    lead={metrazhStory.summary}
    index="صفحه ۰۱"
    note="مهسای محل معرفی محصولات، مستندات رسمی و محتوای آموزشی مرتبط با آن‌هاست."
    signals={['توسعه اپلیکیشن', 'تجربه فارسی و RTL', 'پشتیبانی رسمی محصول']}
    tone="mint"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href="/apps/metrazh/#origin-story"
        >خواندن داستان متراژ</a
      >
      <a class="page-stage-link" href="/support/">ارتباط با پشتیبانی</a>
    </div>
  </PageStage>

  <section class="page-section" aria-labelledby="approach-title">
    <div class="shell split-intro">
      <div class="split-intro-heading">
        <p class="eyebrow">روش ساخت</p>
        <h2 id="approach-title">کمتر حواس‌پرتی؛ بیشتر وضوح در کار روزانه.</h2>
      </div>
      <p>
        نقطه شروع متراژ فهرستی از قابلیت‌ها نبود؛ تجربه‌ای بود که در آن اطلاعات
        ارزشمند میان پنج دفتر، برگه‌های پراکنده و حافظه تقسیم شده بودند. طراحی
        محصول از همان جریان واقعی شروع شد: ثبت فایل و متقاضی، بازدید، پیگیری،
        معامله و حفظ اختیار اطلاعات.
      </p>
    </div>

    <div class="shell principle-grid">
      <article>
        <span>01</span>
        <h3>مسئله قبل از قابلیت</h3>
        <p>هر ابزار باید یک کار مشخص را کوتاه‌تر، منظم‌تر یا کم‌خطاتر کند.</p>
      </article>
      <article>
        <span>02</span>
        <h3>فارسی از ابتدا</h3>
        <p>راست‌به‌چپ، واژه‌ها و ترتیب اطلاعات بخشی از طراحی محصول‌اند.</p>
      </article>
      <article>
        <span>03</span>
        <h3>اطلاعات قابل کنترل</h3>
        <p>
          کاربر باید بداند داده‌هایش کجا هستند و چگونه از آن‌ها پشتیبان می‌گیرد.
        </p>
      </article>
    </div>
  </section>

  <section class="page-section page-section-ink" aria-labelledby="focus-title">
    <div class="shell focus-ledger">
      <header>
        <p class="eyebrow">حوزه‌های تمرکز</p>
        <h2 id="focus-title">سه لایه از یک تجربه محصول.</h2>
      </header>
      <div>
        {
          specialties.map((specialty) => (
            <article>
              <span>{specialty.number}</span>
              <div>
                <h3>{specialty.title}</h3>
                <p>{specialty.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell product-callout">
      <div class="product-callout-art">
        <img
          src="/images/editorial/female-consultant-matching.webp"
          alt="تصویر سه‌بعدی مشاور خانم در حال بررسی نیاز مشتری و فایل‌های ملک"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">محصول فعلی</p>
        <img
          class="product-callout-logo"
          src="/images/apps/metrazh/wordmark-dark.png"
          alt="متراژ"
          width="170"
          height="103"
        />
        <h2>دستیار فارسی برای نظم دادن به جریان کار املاک.</h2>
        <p>
          متراژ برای ثبت فایل‌های ملکی، مدیریت متقاضی، برنامه‌ریزی بازدید،
          یادآوری پیگیری و آماده‌سازی خروجی‌های کاری طراحی شده و در مرحله توسعه
          و پیش‌انتشار قرار دارد.
        </p>
        <a class="text-link" href="/apps/metrazh/">معرفی کامل محصول ←</a>
      </div>
    </div>
  </section>
</BaseLayout>
