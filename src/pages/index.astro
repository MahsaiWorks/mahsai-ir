---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../config/site';
import { getCafeBazaarLink } from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

const learningPaths = [
  {
    title: 'فایل‌گیری منظم',
    description:
      'فایل کامل ثبت کنید، کیفیت آن را بسنجید و اطلاعات قدیمی را زود تشخیص دهید.',
    image: '/images/editorial/property-workflow.webp',
    alt: 'میز کار مشاور املاک با پرونده‌ها و ماکت یک ساختمان',
    href: '/academy/#files',
  },
  {
    title: 'شناخت مشتری و بازدید',
    description:
      'نیاز مشتری را دقیق‌تر بفهمید و بازدیدها را با هدف و مسیر روشن جلو ببرید.',
    image: '/images/editorial/client-matching.webp',
    alt: 'چیدمان تصویری برای تطبیق نیاز مشتری با فایل مناسب',
    href: '/academy/#clients',
  },
  {
    title: 'آگهی مؤثر ملک',
    description: 'با عکس بهتر و متن روشن‌تر، متقاضی مرتبط‌تری به آگهی برسانید.',
    image: '/images/editorial/property-photography.webp',
    alt: 'آماده‌سازی حرفه‌ای عکس یک ملک برای آگهی',
    href: '/academy/#marketing',
  },
] as const;

const softwareStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.data.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: app.data.minOs,
  softwareVersion: app.data.version,
  description: app.data.shortDescription,
  url: new URL('/apps/metrazh/', Astro.site).toString(),
  image: new URL(app.data.icon, Astro.site).toString(),
  downloadUrl: bazaarLink?.url,
  inLanguage: 'fa-IR',
  author: { '@type': 'Organization', name: siteConfig.brandName },
};
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(softwareStructuredData)}
  />

  <section class="home-hero" aria-labelledby="home-title">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="kicker">ساخته‌شده برای کار واقعی در ایران</p>
        <h1 id="home-title">
          هر ابزار باید یک کار واقعی را <span>ساده‌تر کند.</span>
        </h1>
        <p class="lead">
          MAHSAI خانهٔ اپلیکیشن‌های فارسیِ کاربردی است؛ محصول را روشن معرفی
          می‌کنیم، راه استفاده را ساده آموزش می‌دهیم و مسیر پشتیبانی را همیشه در
          دسترس می‌گذاریم.
        </p>
        <div class="hero-actions">
          <a class="button" href="/apps/metrazh/">آشنایی با متراژ</a>
          <a class="text-link" href="/academy/">آموزش رایگان املاک ←</a>
        </div>
        <ul class="trust-list" aria-label="تعهدهای MAHSAI">
          <li>فقط محصول منتشرشده</li>
          <li>تصویر و اطلاعات واقعی</li>
          <li>پشتیبانی رسمی</li>
        </ul>
      </div>

      <figure class="home-hero-visual">
        <img
          class="home-hero-character"
          src="/images/home/metrazh-hero-character.webp"
          alt="مشاور املاک در حال استفاده از تلفن همراه کنار ماکت ساختمان"
          width="1717"
          height="916"
          fetchpriority="high"
        />
        <div class="hero-phone-card" aria-label="تصویر رسمی اپلیکیشن متراژ">
          <img
            src="/images/apps/metrazh/bazaar/customer-follow-up.webp"
            alt="معرفی رسمی پیگیری نیاز مشتری در متراژ"
            width="1080"
            height="1920"
          />
        </div>
        <figcaption>
          <img
            class="metrazh-wordmark-surface"
            src="/images/apps/metrazh/wordmark-dark.png"
            alt="متراژ"
            width="702"
            height="425"
          />
          <span>دستیار فارسی مشاور املاک</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="product-spotlight" aria-labelledby="spotlight-title">
    <div class="shell product-spotlight-grid">
      <div class="product-spotlight-copy">
        <p class="kicker kicker-light">محصول منتشرشدهٔ MAHSAI</p>
        <img
          class="metrazh-wordmark metrazh-wordmark-surface"
          src="/images/apps/metrazh/wordmark-dark.png"
          alt="متراژ"
          width="702"
          height="425"
        />
        <h2 id="spotlight-title">
          فایل، مشتری، بازدید و پیگیری؛ یک‌جا و قابل پیدا کردن.
        </h2>
        <p>
          برای مشاور املاکی که نمی‌خواهد اطلاعات روزانه میان دفتر، گالری، کاغذ و
          پیام‌ها گم شود.
        </p>
        <ul class="feature-checks">
          <li>ثبت و جست‌وجوی فایل‌های ملکی</li>
          <li>مدیریت نیاز مشتری و تطبیق با فایل</li>
          <li>یادآوری بازدید و پیگیری اقدام بعدی</li>
        </ul>
        <div class="hero-actions">
          {
            bazaarLink && (
              <a
                class="button button-light"
                href={bazaarLink.url}
                target="_blank"
                rel="noopener"
              >
                نصب از کافه‌بازار
              </a>
            )
          }
          <a class="text-link text-link-light" href="/apps/metrazh/">
            تصاویر و قابلیت‌ها ←
          </a>
        </div>
      </div>

      <div class="product-screen-pair" aria-label="تصاویر رسمی متراژ">
        <figure>
          <img
            src="/images/apps/metrazh/bazaar/smart-matching.webp"
            alt="معرفی رسمی تطبیق هوشمند فایل و مشتری در متراژ"
            width="1080"
            height="1920"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure>
          <img
            src="/images/apps/metrazh/bazaar/smart-listing.webp"
            alt="معرفی رسمی ساخت متن آگهی از اطلاعات فایل در متراژ"
            width="1080"
            height="1920"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section learning-preview" aria-labelledby="learning-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">آموزش کنار ابزار</p>
          <h2 id="learning-title">از مسئلهٔ امروزتان شروع کنید.</h2>
        </div>
        <p>
          هر مسیر کوتاه و قابل اجراست؛ اول روش را یاد می‌گیرید و بعد می‌توانید
          همان روش را در متراژ منظم نگه دارید.
        </p>
      </header>

      <div class="visual-path-grid">
        {
          learningPaths.map((path) => (
            <article class="visual-path-card">
              <a href={path.href}>
                <img
                  src={path.image}
                  alt={path.alt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <h3>{path.title}</h3>
                  <p>{path.description}</p>
                  <span>شروع این مسیر ←</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section academy-banner" aria-labelledby="academy-title">
    <div class="shell academy-banner-frame">
      <figure>
        <img
          src="/images/stock/real-estate-consultation.jpg"
          alt="گفت‌وگوی مشاور املاک با مراجعه‌کننده هنگام بازدید ملک"
          width="1800"
          height="1200"
          loading="lazy"
          decoding="async"
        />
        <figcaption>عکس: RDNE از Pexels</figcaption>
      </figure>
      <div>
        <p class="kicker">مسیرهای رایگان و مرحله‌به‌مرحله</p>
        <h2 id="academy-title">کمتر بخوانید؛ دقیق‌تر اجرا کنید.</h2>
        <p>
          آموزش‌ها برای نمایش اصطلاحات پیچیده نیستند. هر درس با یک مسئلهٔ واقعی
          شروع می‌شود، با نمونه جلو می‌رود و با یک اقدام روشن تمام می‌شود.
        </p>
        <a class="button" href="/academy/">دیدن همهٔ مسیرهای آموزشی</a>
      </div>
    </div>
  </section>

  <section class="section latest-reading" aria-labelledby="latest-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">مجلهٔ کاربردی املاک</p>
          <h2 id="latest-title">راهنماهایی برای همان روز کاری.</h2>
        </div>
        <a class="text-link" href="/articles/">همهٔ مقاله‌ها ←</a>
      </header>
      <div class="editorial-grid">
        {
          articles
            .slice(0, 3)
            .map((article, index) => (
              <ArticleCard article={article} featured={index === 0} />
            ))
        }
      </div>
    </div>
  </section>

  <section class="launch-rule" aria-labelledby="launch-rule-title">
    <div class="shell launch-rule-inner">
      <div>
        <p class="kicker">قاعدهٔ انتشار MAHSAI</p>
        <h2 id="launch-rule-title">
          محصول وقتی روی سایت می‌آید که واقعاً منتشر شده باشد.
        </h2>
      </div>
      <p>
        نام، تصویر یا جزئیات محصول درحال‌ساخت عمومی نمی‌شود. هر صفحهٔ محصول باید
        نسخهٔ قابل دریافت، اطلاعات واقعی و مسیر پشتیبانی مشخص داشته باشد.
      </p>
      <a class="button button-secondary" href="/apps/">محصولات منتشرشده</a>
    </div>
  </section>
</BaseLayout>
