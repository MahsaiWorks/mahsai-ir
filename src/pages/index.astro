---
import { getCollection } from 'astro:content';
import AIGuideCard from '../components/AIGuideCard.astro';
import { siteConfig } from '../config/site';
import { aiNavigation } from '../data/aiNavigation';
import BaseLayout from '../layouts/BaseLayout.astro';

const updates = (await getCollection('aiUpdates'))
  .filter((update) => !update.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const guides = (await getCollection('aiGuides'))
  .filter((guide) => !guide.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );
const tools = (await getCollection('aiTools')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredApp = (await getCollection('apps'))
  .filter((app) => app.data.featured)
  .sort((a, b) => a.data.order - b.data.order)[0];
const bazaarLink = featuredApp?.data.storeLinks.find((link) =>
  link.url.includes('cafebazaar.ir'),
);
const latestUpdate = updates[0];
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
>
  <section class="ai-hero home-ai-hero" aria-labelledby="home-title">
    <div class="shell ai-hero-grid spatial-hero">
      <div class="ai-hero-copy">
        <p class="ai-kicker">
          <span>MAHSAI</span> · هوش مصنوعی برای فارسی‌زبانان
        </p>
        <h1 id="home-title">هر روز بدانید <span>در AI چه مهم است.</span></h1>
        <p>
          خبر تأییدشده، ابزار بررسی‌شده و راهنمایی که همان روز بتوانید در کار
          واقعی استفاده کنید؛ بدون شایعه، فهرست‌های بی‌پایان و ادعای بی‌منبع.
        </p>
        <div class="ai-hero-actions">
          <a class="button" href="/ai/today/"
            >رادار امروز <span aria-hidden="true">←</span></a
          ><a class="button button-secondary" href="/ai/learn/"
            >از کجا شروع کنم؟</a
          >
        </div>
        <ul class="ai-trust-line" aria-label="تعهدهای محتوایی">
          <li><span aria-hidden="true">✓</span> منبع رسمی</li><li>
            <span aria-hidden="true">✓</span> تاریخ آخرین بررسی
          </li><li><span aria-hidden="true">✓</span> آموزش رایگان و عملی</li>
        </ul>
      </div>
      <aside
        class="home-intel-board spatial-console"
        aria-label="داشبورد محتوای هوش مصنوعی MAHSAI"
      >
        <header>
          <p><span aria-hidden="true"></span> INTELLIGENCE DESK</p><strong
            >به‌روز در ۲۲ مرداد ۱۴۰۵</strong
          >
        </header>
        <div class="home-intel-score">
          <span>امروز</span><b>{String(updates.length).padStart(2, '0')}</b><p>
            گزارش دارای منبع
          </p>
        </div>
        <dl>
          <div><dt>راهنما</dt><dd>{guides.length}</dd></div><div>
            <dt>ابزار</dt><dd>{tools.length}</dd>
          </div><div><dt>جاوااسکریپت صفحه</dt><dd>صفر</dd></div>
        </dl>
        <footer><span aria-hidden="true">●</span> در حال توسعهٔ روزانه</footer>
      </aside>
    </div>
  </section>

  {
    latestUpdate && (
      <section class="home-radar-strip" aria-labelledby="home-radar-title">
        <div class="shell home-radar-grid">
          <div>
            <>
              <p class="eyebrow">رادار امروز</p>
              <h2 id="home-radar-title">{latestUpdate.data.title}</h2>
              <p>{latestUpdate.data.description}</p>
              <a class="story-link" href={`/ai/today/${latestUpdate.id}/`}>
                گزارش کامل و منابع <span aria-hidden="true">←</span>
              </a>
            </>
          </div>
          <div class="home-radar-proof">
            <>
              <span>آخرین راستی‌آزمایی</span>
              <strong>{formatDate(latestUpdate.data.verifiedAt)}</strong>
              <p>{latestUpdate.data.sources.length} منبع رسمی در خود گزارش</p>
              <a href="/ai/sources/">سیاست منابع و اصلاحات</a>
            </>
          </div>
        </div>
      </section>
    )
  }

  <section class="home-ai-map section" aria-labelledby="home-map-title">
    <div class="shell">
      <div class="ai-section-head">
        <div>
          <p class="eyebrow">مرکز هوش مصنوعی</p><h2 id="home-map-title">
            یک سؤال دارید؛ یک مسیر روشن بگیرید.
          </h2>
        </div><p>به‌جای گشتن میان صدها لینک، از نوع نیازتان شروع کنید.</p>
      </div>
      <div class="home-ai-map-grid">
        {
          aiNavigation.slice(0, 6).map((item, index) => (
            <a href={item.href}>
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <>
                    <strong>{item.label}</strong>
                    <p>{item.description}</p>
                  </>
                </div>
                <i aria-hidden="true">←</i>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-learning section" aria-labelledby="home-learning-title">
    <div class="shell">
      <div class="ai-section-head">
        <div>
          <p class="eyebrow">آموزش رایگان</p><h2 id="home-learning-title">
            سه راهنما برای شروع درست.
          </h2>
        </div><a class="story-link" href="/ai/learn/">همه آموزش‌ها</a>
      </div>
      <div class="ai-guide-grid">
        {
          guides
            .slice(0, 3)
            .map((guide, index) => (
              <AIGuideCard guide={guide} featured={index === 0} />
            ))
        }
      </div>
    </div>
  </section>

  <section class="home-standard section" aria-labelledby="home-standard-title">
    <div class="shell home-standard-grid">
      <div>
        <p class="eyebrow">استاندارد MAHSAI</p><h2 id="home-standard-title">
          اطلاعاتی که بتوانید دوباره بررسی کنید.
        </h2><p>
          ما خبر را از نظر جدا می‌کنیم، قابلیت اعلام‌شده را به‌جای نتیجهٔ تست جا
          نمی‌زنیم و تاریخ تازه‌بودن محتوا را پنهان نمی‌کنیم.
        </p><a class="button button-secondary" href="/ai/sources/"
          >روش کار تحریریه</a
        >
      </div>
      <ol>
        <li><span>منبع</span><strong>لینک مستقیم به مرجع اصلی</strong></li><li>
          <span>زمان</span><strong>انتشار، بررسی و به‌روزرسانی جدا</strong>
        </li><li>
          <span>تجربه</span><strong>آزمون فقط با روش قابل تکرار</strong>
        </li><li>
          <span>اصلاح</span><strong>تغییر مهم، روشن و قابل پیگیری</strong>
        </li>
      </ol>
    </div>
  </section>

  {
    featuredApp && (
      <section class="home-metrazh" aria-labelledby="home-metrazh-title">
        <div class="shell home-metrazh-grid">
          <div class="home-metrazh-copy">
            <>
              <p class="eyebrow">محصول مستقل MAHSAI</p>
              <img
                src={featuredApp.data.logo.light}
                alt="متراژ"
                width="170"
                height="103"
              />
              <h2 id="home-metrazh-title">
                دستیار فارسی کار روزانهٔ مشاوران املاک.
              </h2>
              <p>{featuredApp.data.shortDescription}</p>
              <ul>
                {featuredApp.data.features.slice(0, 3).map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <div>
                <a class="button" href="/apps/metrazh/">
                  معرفی کامل متراژ
                </a>
                {bazaarLink && (
                  <a
                    class="home-metrazh-download"
                    href={bazaarLink.url}
                    target="_blank"
                    rel="noopener"
                  >
                    دانلود از کافه‌بازار <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </>
          </div>
          <figure>
            <>
              <img
                src="/images/apps/metrazh/bazaar/slide-04.jpg"
                alt="تطبیق هوشمند فایل و مشتری در اپلیکیشن متراژ"
                width="1080"
                height="1920"
                loading="lazy"
              />
              <figcaption>
                متراژ مسیر محصول و پشتیبانی مستقل خود را حفظ می‌کند.
              </figcaption>
            </>
          </figure>
        </div>
      </section>
    )
  }

  <section class="home-close-ai" aria-labelledby="home-close-title">
    <div class="shell">
      <p class="ai-kicker">MAHSAI</p><h2 id="home-close-title">
        هر روز یک تصمیم بهتر با اطلاعات کمتر، اما معتبرتر.
      </h2><div>
        <a class="button" href="/ai/">ورود به مرکز هوش مصنوعی</a><a
          href="/ai/rss.xml">دنبال‌کردن RSS</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
