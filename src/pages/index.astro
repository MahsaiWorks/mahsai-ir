---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { specialties } from '../data/specialties';
import BaseLayout from '../layouts/BaseLayout.astro';

const apps = (await getCollection('apps'))
  .filter((app) => app.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const featuredApp = apps[0];
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
const featuredProjects = projects.filter((project) => project.featured);
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
>
  <section class="home-stage" aria-labelledby="home-title">
    <div class="shell">
      <div class="home-stage-frame">
        <div class="home-stage-copy">
          <p class="home-brand-line">
            <span lang="en" dir="ltr">MAHSAI</span>
            <i aria-hidden="true"></i>
            توسعه اپلیکیشن فارسی
          </p>
          <h1 id="home-title">
            هر فایل، هر مشتری،
            <span>هر پیگیری؛ یک‌جا.</span>
          </h1>
          <p class="home-stage-lead">
            متراژ، دستیار فارسی مشاوران املاک برای مدیریت منظم فایل‌ها،
            متقاضیان، بازدیدها و کارهای روزانه است.
          </p>
          <div class="home-stage-actions">
            <a class="button home-primary-action" href="/apps/metrazh/">
              آشنایی با متراژ <span aria-hidden="true">←</span>
            </a>
            <a class="home-quiet-link" href="/articles/">
              راهنماهای کاربردی املاک
            </a>
          </div>
          {
            featuredApp && (
              <div class="home-product-signature">
                <img
                  src={featuredApp.data.logo.dark}
                  alt="لوگوی متراژ"
                  width="170"
                  height="103"
                />
                <p>
                  <strong>{featuredApp.data.tagline}</strong>
                  <span>نسخه {featuredApp.data.version} · اندروید</span>
                </p>
              </div>
            )
          }
        </div>

        <div class="home-stage-art">
          <img
            src="/images/home/metrazh-hero-character.webp"
            alt="تصویر سه‌بعدی یک مشاور املاک در حال استفاده از تلفن همراه"
            width="1536"
            height="1024"
            fetchpriority="high"
          />
          <p class="home-art-note">
            <span aria-hidden="true">✓</span>
            طراحی‌شده برای جریان واقعی کار املاک
          </p>
        </div>

        <ul class="home-stage-facts" aria-label="ویژگی‌های کلیدی متراژ">
          <li>
            <span>پلتفرم</span><strong lang="en" dir="ltr">Android</strong>
          </li>
          <li><span>تجربه کاربری</span><strong>فارسی و راست‌به‌چپ</strong></li>
          <li>
            <span>مدیریت داده</span><strong>ذخیره اصلی روی دستگاه</strong>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {
    featuredApp && (
      <section class="home-product-section" aria-labelledby="product-title">
        <div class="shell home-product-grid">
          <div class="home-product-visual">
            <span class="home-visual-label">نمای واقعی اپلیکیشن</span>
            <div class="home-device" aria-hidden="true">
              <img src="/images/apps/metrazh/files.png" alt="" loading="lazy" />
            </div>
            <p class="home-visual-callout">
              <span aria-hidden="true">⌕</span>
              جست‌وجو، فیلتر و دسترسی سریع
            </p>
          </div>

          <div class="home-product-copy">
            <p class="eyebrow">محصول منتخب MAHSAI</p>
            <img
              class="home-product-logo"
              src={featuredApp.data.logo.dark}
              alt="متراژ"
              width="170"
              height="103"
            />
            <h2 id="product-title">کار روزانه املاک، در یک جریان روشن.</h2>
            <p class="home-product-description">
              {featuredApp.data.shortDescription}
            </p>
            <ol class="home-feature-list">
              {featuredApp.data.features.slice(0, 3).map((feature, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{feature}</p>
                </li>
              ))}
            </ol>
            <a class="text-link" href="/apps/metrazh/">
              مشاهده معرفی کامل و تصاویر محصول
              <span aria-hidden="true">←</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="home-focus-section" aria-labelledby="focus-title">
    <div class="shell home-focus-panel">
      <div>
        <p class="eyebrow">حوزه تمرکز</p>
        <h2 id="focus-title">
          توسعه محصول فارسی، از مسئله واقعی تا تجربه دقیق.
        </h2>
      </div>
      {
        specialties.map((specialty) => (
          <article class="home-focus-item">
            <span>{specialty.number}</span>
            <div>
              <h3>{specialty.title}</h3>
              <p>{specialty.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="home-projects-section" aria-labelledby="projects-title">
        <div class="shell">
          <header class="home-section-header">
            <div>
              <p class="eyebrow">پروژه‌های منتخب</p>
              <h2 id="projects-title">محصولاتی برای استفاده واقعی.</h2>
            </div>
          </header>
          <div class="home-projects-grid">
            {featuredProjects.map((project) => (
              <article>
                <span>{project.type}</span>
                <h3>{project.name}</h3>
                <p>{project.summary}</p>
                <a class="text-link" href={project.url}>
                  مشاهده پروژه
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="home-journal" aria-labelledby="articles-title">
    <div class="shell">
      <header class="home-section-header">
        <div>
          <p class="eyebrow">مجله کاربردی املاک</p>
          <h2 id="articles-title">راهنماهایی که مستقیم به کار می‌آیند.</h2>
        </div>
        <a class="home-quiet-link" href="/articles/">مشاهده همه مقالات</a>
      </header>

      <div class="home-journal-grid">
        {
          articles.map((article) => (
            <article class="home-journal-card">
              <a
                class="home-journal-image"
                href={`/articles/${article.id}/`}
                aria-label={`مطالعه ${article.data.title}`}
              >
                <img
                  src={article.data.cover}
                  alt={article.data.coverAlt}
                  loading="lazy"
                />
              </a>
              <div class="home-journal-meta">
                <span>{article.data.category}</span>
                <span>{article.data.readingTime}</span>
              </div>
              <h3>
                <a href={`/articles/${article.id}/`}>{article.data.title}</a>
              </h3>
              <p>{article.data.description}</p>
              <a class="text-link" href={`/articles/${article.id}/`}>
                مطالعه مقاله <span aria-hidden="true">←</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-closing" aria-label="درباره و پشتیبانی">
    <div class="shell home-closing-grid">
      <article class="home-about-card">
        <p class="eyebrow">درباره MAHSAI</p>
        <h2>توسعه اپلیکیشن با تمرکز بر مسئله‌های روزمره.</h2>
        <p>{siteConfig.biography}</p>
        <a class="text-link" href="/about/">
          بیشتر درباره MAHSAI <span aria-hidden="true">←</span>
        </a>
      </article>

      <article class="home-support-card">
        <p class="eyebrow">پشتیبانی رسمی</p>
        <h2>برای پرسش‌های مربوط به متراژ، پاسخ روشن بگیرید.</h2>
        <p>گزارش مشکل، پیشنهاد و پرسش‌های محصول را از مسیر رسمی پیگیری کنید.</p>
        <div class="home-support-actions">
          <a class="button" href="/support/">رفتن به پشتیبانی</a>
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr">
            {siteConfig.supportEmail}
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
