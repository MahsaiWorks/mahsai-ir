---
import { getCollection } from 'astro:content';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

const featuredArticle = articles[0];
const readingList = articles.slice(1, 4);

const workRoutes = [
  {
    problem: 'فایل تازه می‌رسد',
    outcome: 'اطلاعات ملک همان لحظه در یک پروندهٔ قابل جست‌وجو ثبت می‌شود.',
    href: '/guides/property-files/',
    action: 'روش نظم‌دادن به فایل‌ها',
  },
  {
    problem: 'مشتری نیازش را توضیح می‌دهد',
    outcome:
      'بودجه، محدوده و اولویت‌ها می‌مانند تا گفت‌وگوی بعدی از صفر شروع نشود.',
    href: '/guides/real-estate-clients/',
    action: 'راهنمای شناخت و پیگیری مشتری',
  },
  {
    problem: 'زمان بازدید و پیگیری نزدیک است',
    outcome:
      'کار بعدی کنار همان فایل و مشتری روشن می‌ماند؛ نه گوشهٔ دفتر و پیام‌رسان.',
    href: '/academy/',
    action: 'آموزش‌های کوتاه و اجرایی',
  },
] as const;
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
  preloadImage="/images/apps/metrazh/ui/customers.webp"
  preloadImageWidth={720}
  preloadImageSizes="(max-width: 43.75rem) 44vw, (max-width: 56.25rem) 46vw, 18rem"
>
  <section class="mahsai-hero" aria-labelledby="home-title">
    <div class="shell mahsai-hero-grid">
      <div class="mahsai-hero-copy">
        <p class="brand-intro">MAHSAI / ابزارهای فارسی برای کار روزانه</p>
        <h1 id="home-title">
          کمتر دنبال اطلاعات بگردید؛ <span>بیشتر کارتان را جلو ببرید.</span>
        </h1>
        <p class="lead">
          MAHSAI برای بخش‌های شلوغ کار روزانه، ابزارهای فارسیِ ساده می‌سازد.
          متراژ، اولین محصول ما، فایل‌های ملک، مشتری‌ها و پیگیری‌ها را یک‌جا نگه
          می‌دارد تا چیزی گم نشود و کار بعدی معلوم باشد.
        </p>
        <div class="hero-actions">
          {
            bazaarLink && (
              <a
                class="button"
                href={getTrackedCafeBazaarUrl(bazaarLink.url, 'home_hero')}
                target="_blank"
                rel="noopener"
                data-event="metrazh_bazaar_click"
                data-event-location="home_hero"
              >
                نصب رایگان متراژ
              </a>
            )
          }
          <a class="arrow-link" href="/apps/metrazh/">
            قبل از نصب، محیط برنامه را ببینید <span aria-hidden="true">←</span>
          </a>
        </div>
        <dl class="hero-proof-list" aria-label="مشخصات محصول منتشرشده">
          <div><dt>اکنون در دسترس</dt><dd>متراژ</dd></div>
          <div><dt>ساخته‌شده برای</dt><dd>مشاور و دفتر املاک</dd></div>
          <div><dt>اگر کمک خواستید</dt><dd>پشتیبانی مستقیم فارسی</dd></div>
        </dl>
      </div>

      <div class="screen-ledger" aria-label="نمای واقعی محیط متراژ">
        <figure class="screen-ledger-main">
          <ResponsiveImage
            src="/images/apps/metrazh/ui/customers.webp"
            alt="صفحهٔ مشتری‌ها در اپلیکیشن متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 43.75rem) 44vw, (max-width: 56.25rem) 48vw, 18rem"
            fetchpriority="high"
          />
        </figure>
        <figure class="screen-ledger-side screen-ledger-side-top">
          <ResponsiveImage
            src="/images/apps/metrazh/ui/properties.webp"
            alt="صفحهٔ فایل‌های ملکی در اپلیکیشن متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 56.25rem) 38vw, 12rem"
          />
        </figure>
        <figure class="screen-ledger-side screen-ledger-side-bottom">
          <ResponsiveImage
            src="/images/apps/metrazh/ui/matching.webp"
            alt="صفحهٔ پیشنهاد فایل متناسب با نیاز مشتری در متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 56.25rem) 38vw, 12rem"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="work-index" aria-labelledby="work-index-title">
    <div class="shell work-index-layout">
      <header class="work-index-head">
        <p class="section-sign">روش MAHSAI</p>
        <h2 id="work-index-title">
          از همان جایی شروع می‌کنیم که کار گره می‌خورد.
        </h2>
        <p>
          فایل تازه، تماس مشتری یا پیگیری نزدیک؛ هر ابزار و راهنمای MAHSAI باید
          یکی از این لحظه‌های واقعی را ساده‌تر کند و قدم بعدی را نشان دهد.
        </p>
      </header>
      <div class="work-route-list">
        {
          workRoutes.map((route) => (
            <article class="work-route">
              <span class="work-node" aria-hidden="true" />
              <div>
                <p>{route.problem}</p>
                <h3>{route.outcome}</h3>
              </div>
              <a href={route.href}>
                {route.action} <span aria-hidden="true">←</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="metrazh-evidence" aria-labelledby="metrazh-evidence-title">
    <div class="shell metrazh-evidence-grid">
      <div class="metrazh-evidence-copy">
        <p class="section-sign section-sign-light">متراژ؛ آمادهٔ نصب</p>
        <ResponsiveImage
          class="metrazh-wordmark metrazh-wordmark-surface"
          src="/images/apps/metrazh/wordmark-dark.png"
          alt="متراژ"
          width="702"
          height="425"
          sizes="10rem"
        />
        <h2 id="metrazh-evidence-title">
          فایل، مشتری و پیگیری؛ کنار هم و پیدا شدنی.
        </h2>
        <p>
          متراژ برای مشاوری ساخته شده که نمی‌خواهد اطلاعات میان دفترچه، گالری و
          پیام‌رسان گم شود. نیاز مشتری، مشخصات ملک و کار بعدی در یک میزکار قابل
          جست‌وجو می‌مانند.
        </p>
        <ul class="evidence-list">
          <li>ثبت و جست‌وجوی فایل‌های فروش، رهن و اجاره</li>
          <li>پروندهٔ مشتری، اولویت‌ها و اقدام بعدی</li>
          <li>پیشنهاد فایل متناسب با معیارهای ثبت‌شده</li>
        </ul>
        <div class="hero-actions">
          <a class="button button-light" href="/apps/metrazh/">
            متراژ را کامل ببینید
          </a>
          <a class="arrow-link arrow-link-light" href="/support/">
            سؤال دارید؟ مستقیم بپرسید <span aria-hidden="true">←</span>
          </a>
        </div>
      </div>

      <div class="evidence-visual">
        <figure>
          <ResponsiveImage
            src="/images/apps/metrazh/ui/matching.webp"
            alt="نتیجهٔ تطبیق نیاز مشتری با فایل‌های متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 56.25rem) 64vw, 23rem"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  {
    featuredArticle && (
      <section class="mahsai-journal" aria-labelledby="journal-title">
        <div class="shell">
          <header class="journal-intro">
            <div>
              <p class="section-sign">مجلهٔ کار املاک</p>
              <h2 id="journal-title">
                چیزی بخوانید که همین امروز به کارتان بیاید.
              </h2>
            </div>
            <a class="arrow-link" href="/articles/">
              دیدن همهٔ مقاله‌ها <span aria-hidden="true">←</span>
            </a>
          </header>

          <div class="journal-spread">
            <article class="journal-feature">
              <a
                href={`/articles/${featuredArticle.id}/`}
                style={`--journal-cover-ratio: ${featuredArticle.data.coverWidth} / ${featuredArticle.data.coverHeight};`}
              >
                <ResponsiveImage
                  src={featuredArticle.data.cover}
                  alt={featuredArticle.data.coverAlt}
                  width={featuredArticle.data.coverWidth}
                  height={featuredArticle.data.coverHeight}
                  sizes="(max-width: 56.25rem) 100vw, 60vw"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div>
                <p>
                  {featuredArticle.data.category} ·{' '}
                  {featuredArticle.data.readingTime}
                </p>
                <h3>
                  <a href={`/articles/${featuredArticle.id}/`}>
                    {featuredArticle.data.title}
                  </a>
                </h3>
                <span>{featuredArticle.data.description}</span>
              </div>
            </article>

            <div class="journal-list">
              {readingList.map((article) => (
                <article>
                  <p>
                    {article.data.category} · {article.data.readingTime}
                  </p>
                  <a
                    class="journal-entry-link"
                    href={`/articles/${article.id}/`}
                  >
                    <h3>{article.data.title}</h3>
                    <span class="journal-entry-cta">
                      خواندن مقاله <span aria-hidden="true">←</span>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
