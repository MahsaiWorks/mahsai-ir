---
import { getCollection } from 'astro:content';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import WorkdayNavigator from '../components/WorkdayNavigator.astro';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/real-estate-tools.css';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

const featuredArticle = articles[0];
const readingList = articles.slice(1, 4);

const workRoutes = [
  {
    id: 'new-file',
    label: 'فایل تازه رسیده',
    eyebrow: 'مالک منتظر جواب است',
    title: 'جزئیات را قبل از گم‌شدن، به یک پروندهٔ قابل پیدا کردن تبدیل کنید.',
    description:
      'از همان تماس اول معلوم کنید چه چیزی قطعی است، چه چیزی باید کامل شود و دفعهٔ بعد برای چه موضوعی با مالک تماس می‌گیرید.',
    steps: [
      'هویت فایل و نوع معامله را روشن کنید.',
      'قیمت و امکان بازدید را با تاریخ تأیید بنویسید.',
      'اقدام بعدی برای تماس با مالک بگذارید.',
    ],
    href: '/guides/property-files/',
    action: 'مسیر فایل‌گیری را باز کنید',
    secondaryHref: '/tools/',
    secondaryAction: 'عنوان فایل بسازید',
  },
  {
    id: 'client-call',
    label: 'مشتری پشت خط است',
    eyebrow: 'گفت‌وگو نباید از صفر شروع شود',
    title: 'خواستهٔ واقعی مشتری را از علاقه‌های لحظه‌ای جدا کنید.',
    description:
      'بودجه، محله و تعداد اتاق کافی نیست. شرط قطعی، زمان تصمیم و دلیل رد یا پسند فایل قبلی مسیر معرفی بعدی را دقیق می‌کند.',
    steps: [
      'شرط قطعی را از ترجیح جدا کنید.',
      'چند فایل نزدیک را با دلیل انتخاب کنید.',
      'زمان و موضوع پیگیری بعدی را مشخص کنید.',
    ],
    href: '/guides/real-estate-clients/',
    action: 'راهنمای شناخت مشتری',
    secondaryHref: '/articles/match-property-to-client/',
    secondaryAction: 'تطبیق فایل و مشتری',
  },
  {
    id: 'visit-time',
    label: 'قرار بازدید نزدیک است',
    eyebrow: 'قبل از حرکت، همه‌چیز را یک‌بار ببینید',
    title: 'بازدید را از یک قرار پراکنده به مسیری روشن تبدیل کنید.',
    description:
      'فعال بودن فایل، حضور مالک، ترتیب مسیر و انتظار مشتری را هماهنگ کنید؛ بعد از بازدید هم نتیجه را بدون اقدام بعدی رها نکنید.',
    steps: [
      'فایل، مالک و ساعت قرار را دوباره تأیید کنید.',
      'بین مسیرها زمان واقعی بگذارید.',
      'بازخورد را به یک اقدام مشخص تبدیل کنید.',
    ],
    href: '/guides/property-visits/',
    action: 'برنامهٔ بازدید را بچینید',
    secondaryHref: '/resources/real-estate-checklists/#property-visits',
    secondaryAction: 'چک‌لیست چاپی',
  },
  {
    id: 'choose-tool',
    label: 'دنبال ابزار مناسبم',
    eyebrow: 'اول مسئله، بعد نرم‌افزار',
    title: 'ابزاری را انتخاب کنید که در سه لحظهٔ واقعی روزتان جواب بدهد.',
    description:
      'نام قابلیت‌ها کافی نیست. ثبت فایل تازه، پاسخ به مشتری قدیمی و پیگیری بازدید را با اطلاعات واقعی خودتان امتحان کنید.',
    steps: [
      'سه مسئلهٔ پرتکرار دفتر را بنویسید.',
      'سرعت پیدا کردن اطلاعات را آزمایش کنید.',
      'پشتیبانی، خروجی و امنیت داده را بسنجید.',
    ],
    href: '/real-estate-software/',
    action: 'راهنمای انتخاب نرم‌افزار',
    secondaryHref: '/apps/metrazh/',
    secondaryAction: 'دیدن متراژ',
  },
] as const;
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
  preloadImage="/images/apps/metrazh/ui/customers.webp"
  preloadImageWidth={720}
  preloadImageSizes="(max-width: 43.75rem) 44vw, (max-width: 56.25rem) 46vw, 18rem"
>
  <section class="mahsai-hero" aria-labelledby="home-title">
    <div class="shell mahsai-hero-grid">
      <div class="mahsai-hero-copy">
        <p class="brand-intro">برای روزهایی که چند فایل و تماس با هم می‌رسند</p>
        <h1 id="home-title">
          کار املاک شلوغ است؛ <span>لازم نیست بی‌نظم هم باشد.</span>
        </h1>
        <p class="lead">
          از تماس مالک تا پیگیری مشتری، اطلاعات بین دفترچه، واتساپ و گالری پخش
          می‌شود. متراژ همه را روی گوشی شما کنار هم نگه می‌دارد؛ ساده، فارسی و
          آماده برای روزهای پرکار.
        </p>
        <div class="hero-actions">
          {
            bazaarLink && (
              <a
                class="button"
                href={getTrackedCafeBazaarUrl(bazaarLink.url, 'home_hero')}
                target="_blank"
                rel="noopener"
                data-event="metrazh_bazaar_click"
                data-event-location="home_hero"
              >
                نصب رایگان متراژ
              </a>
            )
          }
          <a class="arrow-link" href="/apps/metrazh/">
            داخل متراژ را ببینید <span aria-hidden="true">←</span>
          </a>
        </div>
        <dl class="hero-proof-list" aria-label="مشخصات محصول منتشرشده">
          <div><dt>برای چه کسی؟</dt><dd>مشاور و دفتر املاک</dd></div>
          <div><dt>شروع کار</dt><dd>نصب رایگان از بازار</dd></div>
          <div>
            <dt>اگر جایی گیر کردید</dt><dd>پشتیبانی فارسی کنار شماست</dd>
          </div>
        </dl>
      </div>

      <div class="screen-ledger" aria-label="نمای واقعی محیط متراژ">
        <figure class="screen-ledger-main">
          <ResponsiveImage
            src="/images/apps/metrazh/ui/customers.webp"
            alt="صفحهٔ مشتری‌ها در اپلیکیشن متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 43.75rem) 44vw, (max-width: 56.25rem) 48vw, 18rem"
            fetchpriority="high"
          />
        </figure>
        <figure class="screen-ledger-side screen-ledger-side-top">
          <ResponsiveImage
            src="/images/apps/metrazh/ui/properties.webp"
            alt="صفحهٔ فایل‌های ملکی در اپلیکیشن متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 56.25rem) 38vw, 12rem"
          />
        </figure>
        <figure class="screen-ledger-side screen-ledger-side-bottom">
          <ResponsiveImage
            src="/images/apps/metrazh/ui/matching.webp"
            alt="صفحهٔ پیشنهاد فایل متناسب با نیاز مشتری در متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 56.25rem) 38vw, 12rem"
          />
        </figure>
        <p class="screen-ledger-note">
          <span>وقتی تلفن زنگ می‌خورد</span>
          <strong>اطلاعات همان‌جا روبه‌روی شماست.</strong>
        </p>
      </div>
    </div>
  </section>

  <WorkdayNavigator routes={workRoutes} />

  <section class="home-toolkit" aria-labelledby="home-toolkit-title">
    <div class="shell">
      <header class="home-toolkit-head">
        <div>
          <p class="section-sign">میز ابزار رایگان MAHSAI</p>
          <h2 id="home-toolkit-title">
            لازم نیست برای هر جواب ساده، فرم پر کنید یا شماره بدهید.
          </h2>
        </div>
        <p>
          ابزارها و برگه‌های آماده مستقیم در مرورگر باز می‌شوند؛ برای استفادهٔ
          روزمرهٔ دفتر، نه جمع‌کردن اطلاعات شما.
        </p>
      </header>

      <div class="home-toolkit-grid">
        <article class="tool-preview tool-preview-name">
          <div class="tool-preview-copy">
            <span>ابزار تعاملی</span>
            <h3>عنوان یکدست برای فایل بسازید.</h3>
            <p>
              نوع معامله، محله، نوع ملک و نشانهٔ تشخیصی را بدهید؛ یک عنوان کوتاه
              و پیدا‌کردنی تحویل بگیرید.
            </p>
            <a class="button" href="/tools/">ساختن عنوان فایل</a>
          </div>
          <div class="file-title-demo" aria-hidden="true">
            <span>فروش</span><span>جنت‌آباد جنوبی</span><span>آپارتمان</span>
            <strong>۲خواب، طبقهٔ ۳</strong>
          </div>
        </article>

        <article class="tool-preview tool-preview-paper">
          <div class="checklist-paper" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <div>
            <span>نسخهٔ چاپی</span>
            <h3>چهار چک‌لیست کنار میز کار.</h3>
            <p>
              فایل‌گیری، نیاز مشتری، بازدید و آگهی؛ آمادهٔ چاپ یا ذخیرهٔ PDF.
            </p>
            <a class="arrow-link" href="/resources/real-estate-checklists/">
              گرفتن چک‌لیست‌ها <span aria-hidden="true">←</span>
            </a>
          </div>
        </article>

        <article class="tool-preview tool-preview-decision">
          <div class="decision-mark" aria-hidden="true">
            <span>مسئله</span><i></i><span>آزمون</span><i></i><strong
              >انتخاب</strong
            >
          </div>
          <div>
            <span>راهنمای تصمیم</span>
            <h3>نرم‌افزار را با کار واقعی بسنجید.</h3>
            <p>
              یک راهنمای بی‌طرف برای اینکه قبل از انتخاب، سؤال‌های درست را
              بپرسید.
            </p>
            <a class="arrow-link" href="/real-estate-software/">
              دیدن معیارهای انتخاب <span aria-hidden="true">←</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="metrazh-evidence" aria-labelledby="metrazh-evidence-title">
    <div class="shell metrazh-evidence-grid">
      <div class="metrazh-evidence-copy">
        <p class="section-sign section-sign-light">
          متراژ همین حالا قابل نصب است
        </p>
        <ResponsiveImage
          class="metrazh-wordmark metrazh-wordmark-surface"
          src="/images/apps/metrazh/wordmark-dark.png"
          alt="متراژ"
          width="702"
          height="425"
          sizes="10rem"
        />
        <h2 id="metrazh-evidence-title">هر فایل و مشتری، یک جای مشخص دارد.</h2>
        <p>
          اسم مشتری را بزنید و خواسته‌ها، یادداشت آخر و قدم بعدی را ببینید. کد
          فایل را جست‌وجو کنید و بدون ورق‌زدن دفتر یا بالا و پایین‌کردن پیام‌ها،
          به همان ملکی برسید که دنبالش هستید.
        </p>
        <ul class="evidence-list">
          <li>فایل‌های فروش، رهن و اجاره سریع‌تر پیدا می‌شوند</li>
          <li>خواسته و پیگیری بعدی مشتری جلوی چشم می‌ماند</li>
          <li>گزینه‌های نزدیک‌تر به نیاز مشتری برای بررسی جلو می‌آیند</li>
        </ul>
        <div class="hero-actions">
          <a class="button button-light" href="/apps/metrazh/">
            ببینید متراژ چطور کار می‌کند
          </a>
          <a class="arrow-link arrow-link-light" href="/support/">
            سؤال دارید؟ مستقیم بپرسید <span aria-hidden="true">←</span>
          </a>
        </div>
      </div>

      <div class="evidence-visual">
        <figure>
          <ResponsiveImage
            src="/images/apps/metrazh/ui/matching.webp"
            alt="نتیجهٔ تطبیق نیاز مشتری با فایل‌های متراژ"
            width="720"
            height="1600"
            sizes="(max-width: 56.25rem) 64vw, 23rem"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  {
    featuredArticle && (
      <section class="mahsai-journal" aria-labelledby="journal-title">
        <div class="shell">
          <header class="journal-intro">
            <div>
              <p class="section-sign">مجلهٔ کار املاک</p>
              <h2 id="journal-title">
                جواب یک سؤال واقعی را در چند دقیقه پیدا کنید.
              </h2>
            </div>
            <a class="arrow-link" href="/articles/">
              دیدن همهٔ مقاله‌ها <span aria-hidden="true">←</span>
            </a>
          </header>

          <div class="journal-spread">
            <article class="journal-feature">
              <a
                href={`/articles/${featuredArticle.id}/`}
                style={`--journal-cover-ratio: ${featuredArticle.data.coverWidth} / ${featuredArticle.data.coverHeight};`}
              >
                <ResponsiveImage
                  src={featuredArticle.data.cover}
                  alt={featuredArticle.data.coverAlt}
                  width={featuredArticle.data.coverWidth}
                  height={featuredArticle.data.coverHeight}
                  sizes="(max-width: 56.25rem) 100vw, 60vw"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div>
                <p>
                  {featuredArticle.data.category} ·{' '}
                  {featuredArticle.data.readingTime}
                </p>
                <h3>
                  <a href={`/articles/${featuredArticle.id}/`}>
                    {featuredArticle.data.title}
                  </a>
                </h3>
                <span>{featuredArticle.data.description}</span>
              </div>
            </article>

            <div class="journal-list">
              {readingList.map((article) => (
                <article>
                  <p>
                    {article.data.category} · {article.data.readingTime}
                  </p>
                  <a
                    class="journal-entry-link"
                    href={`/articles/${article.id}/`}
                  >
                    <h3>{article.data.title}</h3>
                    <span class="journal-entry-cta">
                      خواندن مقاله <span aria-hidden="true">←</span>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
