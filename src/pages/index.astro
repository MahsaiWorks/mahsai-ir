---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import academyHero from '../assets/academy/hero-scene.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/brand-home.css';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { metrazhDirectRelease } from '../data/metrazhDirectRelease';
const apps = (await getCollection('apps'))
  .filter((app) => app.id === 'metrazh' && app.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order);
const articles = await getCollection('articles');
const readingIds = [
  'complete-property-file',
  'real-estate-client-follow-up',
  'secure-real-estate-data',
];
const reading = readingIds
  .map((id) =>
    articles.find((article) => article.id === id && !article.data.draft),
  )
  .filter((article): article is NonNullable<typeof article> =>
    Boolean(article),
  );
const lessons = [
  'یک فایل نمونه بسازید',
  'اطلاعات را مرتب وارد کنید',
  'زمان پیگیری را مشخص کنید',
  'فایل را برای پشتیبان‌گیری آماده کنید',
];
---

<BaseLayout
  title="مهسای | آموزش هوش مصنوعی و دوره‌های تولید محتوا"
  description="آکادمی مهسای و دورهٔ ابر مشاور برای یادگیری ساخت عکس، ویدیو و استوری با هوش مصنوعی؛ در کنار آموزش‌های رایگان، ابزارهای فارسی و اپلیکیشن متراژ."
  image="/assets/academy/abr-moshaver/hero-scene.webp"
  imageAlt="آکادمی مهسای؛ نمونه‌های دورهٔ ابر مشاور برای ساخت محتوا با هوش مصنوعی"
  imageWidth={1280}
  imageHeight={550}
>
  <div class="brand-home">
    <section class="brand-hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">آکادمی مهسای</p>
        <h1 id="hero-title">
          هوش مصنوعی را یاد بگیر<br /><span>محتوای خودت را بساز</span>
        </h1>
        <p class="hero-description">
          از عکس و ویدیو تا استوری و سریال؛ با آموزش‌های عملی، ایده‌هایت را برای
          پیج و کار خودت به محتوا تبدیل کن.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="/academy/"
            >مشاهدهٔ دوره‌ها <span aria-hidden="true">←</span></a
          ><a class="text-link" href="/apps/"
            >اپلیکیشن‌های مهسای <span aria-hidden="true">↙</span></a
          >
        </div>
      </div>
      <figure class="hero-visual">
        <Image
          src={academyHero}
          width={1280}
          height={550}
          widths={[320, 480, 640, 768, 960, 1280]}
          sizes="(max-width: 480px) calc(100vw - 36px), (max-width: 800px) calc(100vw - 44px), (max-width: 1100px) calc((100vw - 88px) * 0.51), 610px"
          format="webp"
          quality={85}
          loading="eager"
          alt="دورهٔ ابر مشاور؛ چند نمونه از ساخت سریال، رشته‌استوری، انیمیشن و قبل‌وبعد"
          fetchpriority="high"
        />
      </figure>
    </section>

    <nav class="discovery wrap" aria-label="مسیرهای مهسای">
      <a href="#apps"
        ><span class="path-icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><rect x="6" y="2" width="12" height="20" rx="3"></rect><path
              d="M10 18h4"></path></svg
          ></span
        ><span
          ><strong>برنامهٔ مناسب را پیدا کنید</strong><small
            >اپلیکیشن‌های مهسای</small
          ></span
        ><span class="path-arrow" aria-hidden="true">↙</span></a
      >
      <a href="#academy"
        ><span class="path-icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><path
              d="M12 5C8 2 5 3 2 4v15c3-1 6-2 10 1 4-3 7-2 10-1V4c-3-1-6-2-10 1Zm0 0v15"
            ></path></svg
          ></span
        ><span
          ><strong>دورهٔ مناسب را پیدا کنید</strong><small
            >آکادمی مهسای و آموزش‌های عملی</small
          ></span
        ><span class="path-arrow" aria-hidden="true">↙</span></a
      >
      <a href="#journal"
        ><span class="path-icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            ><rect x="3" y="3" width="18" height="18" rx="2"></rect><path
              d="M7 8h10M7 12h10M7 16h6"></path></svg
          ></span
        ><span
          ><strong>مقاله‌های کاربردی بخوانید</strong><small
            >خواندنی‌های مجلهٔ مهسای</small
          ></span
        ><span class="path-arrow" aria-hidden="true">↙</span></a
      >
    </nav>

    <section
      class="section-space wrap apps-section"
      id="apps"
      aria-labelledby="apps-title"
    >
      <header class="section-header">
        <div>
          <p class="eyebrow">اپلیکیشن‌های مهسای</p><h2 id="apps-title">
            ابزار مناسب کارتان را پیدا کنید
          </h2>
        </div><a class="section-link" href="/apps/"
          >مشاهدهٔ اپلیکیشن‌ها <span aria-hidden="true">←</span></a
        >
      </header>
      <div class:list={['apps-list', { 'single-app': apps.length === 1 }]}>
        {
          apps.map((app) => (
            <article class="app-feature">
              <div class="app-feature-copy">
                <div class="app-identity">
                  <>
                    <ResponsiveImage
                      src={app.data.icon}
                      width="76"
                      height="76"
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                    />
                    <div>
                      <>
                        <span class="app-category">دستیار مشاوران املاک</span>
                        <h3>{app.data.name}</h3>
                      </>
                    </div>
                    <span class="platform">اندروید</span>
                  </>
                </div>
                <h4>
                  فایل، مشتری و پیگیری
                  <br />
                  در یک برنامه
                </h4>
                <p>
                  {app.data.shortDescription} اطلاعات روی گوشی شما می‌ماند و
                  یادآوری‌ها کمک می‌کنند کاری از قلم نیفتد.
                </p>
                <ul class="app-features">
                  <>
                    <li>ثبت و جست‌وجوی فایل</li>
                    <li>تطبیق فایل و مشتری</li>
                    <li>یادآوری و پیگیری</li>
                  </>
                </ul>
                <div class="app-actions">
                  <>
                    <a
                      class="button-primary"
                      href={`/apps/${app.id}/download/`}
                    >
                      دریافت {app.data.name} <span aria-hidden="true">↓</span>
                    </a>
                    <a class="text-link" href={`/apps/${app.id}/`}>
                      امکانات و جزئیات ←
                    </a>
                  </>
                </div>
                <p class="app-version">
                  نصب رایگان؛ امکانات حرفه‌ای با اشتراک{' '}
                  <span>نسخهٔ مستقیم {metrazhDirectRelease.versionFa}</span>
                </p>
              </div>
              <div
                class="app-screens"
                aria-label="صفحه‌های واقعی اپلیکیشن متراژ"
              >
                <div class="screen-window screen-one">
                  <ResponsiveImage
                    src="/images/apps/metrazh/current/property-details.webp"
                    width="1080"
                    height="2460"
                    alt="پروندهٔ یک ملک نمونه در متراژ"
                    sizes="(max-width: 620px) calc(44vw - 40px), (max-width: 900px) 172px, 198px"
                    loading="lazy"
                  />
                </div>
                <div class="screen-window screen-two">
                  <ResponsiveImage
                    src="/images/apps/metrazh/current/workspace.webp"
                    width="1080"
                    height="2460"
                    alt="میزکار متراژ با برنامه‌ها و پیگیری‌های نمونه"
                    sizes="(max-width: 620px) calc(44vw - 40px), (max-width: 900px) 172px, 198px"
                    loading="lazy"
                  />
                </div>
                <span class="screens-caption">از محیط واقعی متراژ</span>
              </div>
            </article>
          ))
        }
      </div>
      <div class="web-tools">
        <div>
          <span class="tools-label">بدون نصب، در مرورگر</span><h3>
            برای کارهای کوچکِ روزانه
          </h3>
        </div><a href="/tools/follow-up-message/"
          ><span>متن پیگیری مشتری</span><span aria-hidden="true">↖</span></a
        ><a href="/tools/visit-planner/"
          ><span>برنامه‌ریزی بازدید</span><span aria-hidden="true">↖</span></a
        ><a class="all-tools" href="/tools/">همهٔ ابزارها ←</a>
      </div>
    </section>

    <section
      class="academy-section"
      id="academy"
      aria-labelledby="academy-title"
    >
      <div class="wrap">
        <header class="section-header">
          <div>
            <p class="eyebrow">دوره‌ها و آموزش‌ها</p><h2 id="academy-title">
              مسیر یادگیری خودت را انتخاب کن
            </h2>
          </div><a class="section-link" href="/academy/"
            >دیدن آکادمی <span aria-hidden="true">←</span></a
          >
        </header>
        <article class="course-feature ai-course-feature">
          <div class="course-cover">
            <ResponsiveImage
              src="/assets/academy/abr-moshaver/hero-scene.webp"
              width="1280"
              height="550"
              alt="چند نمونه از آموزش‌های دورهٔ ابر مشاور"
              loading="lazy"
            />
          </div>
          <div class="course-copy">
            <div class="course-meta">
              <span>آموزش هوش مصنوعی</span><span
                >۱۵ درس · ۱ ساعت و ۴۰ دقیقه</span
              >
            </div>
            <h3>ابر مشاور</h3>
            <p>
              ساخت عکس، ویدیو، رشته‌استوری، شخصیت مجازی و محتوای سریالی برای پیج
              و کار خودت.
            </p>
            <a
              class="button-mint"
              href="/academy/courses/ai-content-real-estate/"
            >
              آشنایی با دوره <span aria-hidden="true">←</span>
            </a>
            <small class="course-access"
              >این‌ها فقط چند نمونه از آموزش‌های دوره‌اند.</small
            >
          </div>
        </article>
        <div class="course-feature">
          <div class="course-cover">
            <ResponsiveImage
              src="/images/brand/editorial/digital-workspace-metrazh-v4.webp"
              width="1536"
              height="1024"
              alt="مشاور املاک در حال مدیریت اطلاعات با گوشی و لپ‌تاپ، از نمای بالا"
              loading="lazy"
            /><span class="course-badge">آموزش رایگان</span>
          </div>
          <div class="course-copy">
            <div class="course-meta">
              <span>مسیر شروع کار</span><span>۴ درس کوتاه؛ ۳۰ دقیقه</span>
            </div><h3>اولین فایل ملکی مرتب<br />در ۳۰ دقیقه</h3><p>
              با یک مثال تمرینی جلو بروید؛ در پایان، یک فایل کامل و زمان مشخص
              برای پیگیری بعدی دارید.
            </p><ol class="lesson-list">
              {
                lessons.map((lesson, index) => (
                  <li>
                    <span>
                      {new Intl.NumberFormat('fa-IR').format(index + 1)}
                    </span>
                    {lesson}
                  </li>
                ))
              }
            </ol><a
              class="button-mint"
              href="/academy/first-organized-property-file/"
              >شروع آموزش <span aria-hidden="true">←</span></a
            ><small class="course-access">بدون ثبت‌نام؛ همراه با تمرین</small>
          </div>
        </div>
      </div>
    </section>

    <section
      class="section-space wrap journal-section"
      id="journal"
      aria-labelledby="journal-title"
    >
      <header class="section-header">
        <div>
          <p class="eyebrow">مجلهٔ مهسای</p><h2 id="journal-title">
            پیشنهاد ما برای خواندن
          </h2>
        </div><a class="section-link" href="/articles/"
          >همهٔ مقاله‌ها <span aria-hidden="true">←</span></a
        >
      </header>
      <div class="journal-grid">
        {
          reading.map((article) => (
            <article class="journal-card">
              <>
                <a
                  class="article-cover"
                  href={`/articles/${article.id}/`}
                  tabindex="-1"
                  aria-label={`خواندن مقالهٔ ${article.data.title}`}
                >
                  <ResponsiveImage
                    src={article.data.cover}
                    width={article.data.coverWidth}
                    height={article.data.coverHeight}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                  />
                </a>
                <div class="article-meta">
                  <>
                    <span>{article.data.category}</span>
                    <span>{article.data.readingTime}</span>
                  </>
                </div>
                <h3>
                  <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                </h3>
                <p>{article.data.description}</p>
                <a
                  class="article-link"
                  href={`/articles/${article.id}/`}
                  aria-label={`خواندن مقالهٔ ${article.data.title}`}
                >
                  خواندن مقاله <span aria-hidden="true">←</span>
                </a>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section class="support-band wrap" aria-labelledby="support-title">
      <div class="support-symbol" aria-hidden="true">؟</div><div>
        <p class="eyebrow">اگر جایی به راهنما نیاز داشتید</p><h2
          id="support-title"
        >
          چطور می‌توانیم کمک کنیم؟
        </h2><p>
          راهنمای استفاده، پاسخ پرسش‌ها و راه ارتباط با پشتیبانی را اینجا پیدا
          کنید.
        </p>
      </div><a class="button-outline" href="/support/"
        >راهنما و پشتیبانی <span aria-hidden="true">↖</span></a
      >
    </section>
  </div>
</BaseLayout>
