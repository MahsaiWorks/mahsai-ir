---
import { getCollection } from 'astro:content';
import AppCard from '../components/AppCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../config/site';
import { specialties } from '../data/specialties';
import BaseLayout from '../layouts/BaseLayout.astro';

const apps = (await getCollection('apps'))
  .filter((app) => app.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">MAHSAI · توسعه اپلیکیشن</p>
        <h1>ابزارهایی برای <span>کارهای واقعی</span>.</h1>
        <p class="hero-copy">
          MAHSAI توسعه‌دهنده متراژ است؛ اپلیکیشن اندروید برای مدیریت فایل‌های
          ملکی، متقاضیان و پیگیری‌های روزانه مشاوران املاک.
        </p>
        <div class="hero-actions">
          <a class="button" href="/apps/metrazh/">
            معرفی متراژ <span aria-hidden="true">←</span>
          </a>
          <a class="button button-secondary" href="/articles/">مقالات آموزشی</a>
        </div>
      </div>
      <p class="hero-note">
        <strong>متراژ ۱.۰.۳</strong>
        <span>نسخه اندروید در حال توسعه و پیش‌انتشار است.</span>
      </p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="focus-title">
    <div class="shell">
      <SectionHeading
        eyebrow="حوزه تمرکز"
        title="توسعه اپلیکیشن فارسی برای اندروید"
        description="تمرکز فعلی MAHSAI توسعه متراژ و ساخت ابزارهای راست‌به‌چپ برای جریان واقعی کار مشاوران املاک است."
      />
      <div class="specialties-grid">
        {
          specialties.map((specialty) => (
            <article class="specialty-card">
              <span class="specialty-number">{specialty.number}</span>
              <h3>{specialty.title}</h3>
              <p>{specialty.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="apps-title">
    <div class="shell">
      <SectionHeading
        eyebrow="اپلیکیشن MAHSAI"
        title="متراژ؛ دستیار مشاوران املاک"
        description="مدیریت هوشمند فایل‌ها — آفلاین و امن. داده‌های اصلی روی دستگاه نگهداری می‌شوند و برخی قابلیت‌ها برای کارکرد به اینترنت نیاز دارند."
      />
      <div class="apps-grid">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="articles-title">
    <div class="shell">
      <SectionHeading
        eyebrow="مقالات آموزشی"
        title="راهنماهایی برای کار دقیق‌تر در املاک"
        description="مطالب کاربردی درباره ثبت فایل، مدیریت متقاضی، پیگیری مشتری و ابزارهای متراژ."
      />
      <div class="articles-grid">
        {
          articles.map((article) => (
            <article class="article-card">
              <div class="article-meta">
                <span>{article.data.category}</span>
                <span>{article.data.readingTime}</span>
              </div>
              <div>
                <h2>
                  <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                </h2>
                <p>{article.data.description}</p>
              </div>
              <a class="text-link" href={`/articles/${article.id}/`}>
                مطالعه مقاله <span aria-hidden="true">←</span>
              </a>
            </article>
          ))
        }
      </div>
      <div class="hero-actions">
        <a class="button button-secondary" href="/articles/">همه مقالات</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell about-preview">
      <div class="about-visual" aria-hidden="true">
        <span>ساخت برای استفاده واقعی.</span>
      </div>
      <div class="about-copy">
        <p class="eyebrow">درباره MAHSAI</p>
        <h2>توسعه اپلیکیشن با تمرکز بر مسئله‌های روزمره.</h2>
        <p>{siteConfig.biography}</p>
        <a class="text-link" href="/about/">
          درباره MAHSAI <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell cta-panel">
      <p class="eyebrow">پشتیبانی رسمی</p>
      <h2>برای پرسش‌های مربوط به متراژ همراه شما هستیم.</h2>
      <p>
        برای گزارش مشکل، پیشنهاد یا پرسش درباره نسخه پیش‌انتشار از ایمیل و
        کانال‌های رسمی پشتیبانی استفاده کنید.
      </p>
      <div class="cta-actions">
        <a class="button" href="/support/">رفتن به پشتیبانی</a>
        <a
          class="button button-secondary"
          href={`mailto:${siteConfig.supportEmail}`}
          dir="ltr"
        >
          {siteConfig.supportEmail}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
