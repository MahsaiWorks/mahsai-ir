---
import { getCollection } from 'astro:content';
import AIGuideCard from '../components/AIGuideCard.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const updates = (await getCollection('aiUpdates'))
  .filter((update) => !update.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const guides = (await getCollection('aiGuides'))
  .filter((guide) => !guide.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );
const propertyGuides = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder)
  .slice(0, 3);
const featuredApp = (await getCollection('apps'))
  .filter((app) => app.data.featured)
  .sort((a, b) => a.data.order - b.data.order)[0];
const bazaarLink = featuredApp?.data.storeLinks.find((link) =>
  link.url.includes('cafebazaar.ir'),
);
const latestUpdate = updates[0];
const entryPaths = [
  {
    label: 'تازه چه شده؟',
    description:
      'تغییرهای مهم را کوتاه، روشن و همراه با کاری که باید انجام دهید بخوانید.',
    href: '/ai/today/',
    tone: 'coral',
  },
  {
    label: 'از کجا شروع کنم؟',
    description:
      'با راهنماهای رایگان و قدم‌به‌قدم، اولین نتیجهٔ قابل استفاده را بگیرید.',
    href: '/ai/learn/',
    tone: 'mint',
  },
  {
    label: 'کدام ابزار مناسب من است؟',
    description:
      'کاربرد، محدودیت و شرایط استفاده از ابزارها را پیش از انتخاب ببینید.',
    href: '/ai/tools/',
    tone: 'navy',
  },
  {
    label: 'بدون اینترنت هم می‌شود؟',
    description:
      'راه‌های اجرای هوش مصنوعی روی رایانهٔ شخصی را ساده و امن یاد بگیرید.',
    href: '/ai/offline/',
    tone: 'sand',
  },
] as const;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
>
  <section class="mahsa-home-hero" aria-labelledby="home-title">
    <div class="shell mahsa-home-hero-grid">
      <div class="mahsa-home-copy">
        <p class="mahsa-home-kicker">برای کاربران فارسی‌زبان</p>
        <h1 id="home-title">
          هوش مصنوعی را بفهمید؛ <span>به کار بگیرید.</span>
        </h1>
        <p>
          راهنماهای ساده و تصویری، مقایسه‌های صادقانه و تازه‌هایی که واقعاً روی
          انتخاب یا کار شما اثر می‌گذارند؛ با درنظرگرفتن نیاز و شرایط کاربر
          ایرانی.
        </p>
        <div class="mahsa-home-actions">
          <a class="button" href="/ai/learn/">از یک راهنمای ساده شروع کنید</a>
          <a class="mahsa-text-link" href="/ai/today/">تازه‌های مهم را ببینید</a
          >
        </div>
        <ul class="mahsa-home-promises" aria-label="ویژگی‌های مطالب مهسای">
          <li>فارسی و روان</li>
          <li>منبع و تاریخ بررسی</li>
          <li>بدون ثبت‌نام اجباری</li>
        </ul>
      </div>
      <figure class="mahsa-home-visual">
        <img
          src="/ai/gemini-notebook-editorial-cover-v1.png"
          alt="مجموعه‌ای از برگه‌ها و منابع که به یک راهنمای منظم تبدیل شده‌اند"
          width="1664"
          height="945"
        />
        <figcaption>
          <span>مسئلهٔ واقعی</span>
          <span>توضیح ساده</span>
          <span>قدم بعدی روشن</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {
    latestUpdate && (
      <section class="mahsa-latest" aria-labelledby="home-latest-title">
        <div class="shell mahsa-latest-card">
          <div class="mahsa-latest-copy">
            <p class="eyebrow">تازه و کاربردی</p>
            <h2 id="home-latest-title">{latestUpdate.data.title}</h2>
            <p>{latestUpdate.data.description}</p>
            <div class="mahsa-latest-action">
              <span>کاری که بهتر است انجام دهید</span>
              <p>{latestUpdate.data.action}</p>
            </div>
            <a class="button" href={`/ai/today/${latestUpdate.id}/`}>
              توضیح کامل و منبع
            </a>
          </div>
          <aside class="mahsa-latest-note">
            <span>بررسی‌شده در</span>
            <strong>{formatDate(latestUpdate.data.verifiedAt)}</strong>
            <p>
              این مطلب بر پایهٔ {latestUpdate.data.sources.length} منبع اصلی
              نوشته شده و اگر اطلاعاتش تغییر کند، دوباره بررسی می‌شود.
            </p>
          </aside>
        </div>
      </section>
    )
  }

  <section class="mahsa-entry section" aria-labelledby="home-map-title">
    <div class="shell">
      <div class="mahsa-section-heading">
        <div>
          <p class="eyebrow">از نیاز خودتان شروع کنید</p>
          <h2 id="home-map-title">دنبال چه جوابی هستید؟</h2>
        </div>
        <p>
          لازم نیست ساختار سایت را بلد باشید؛ نزدیک‌ترین سؤال به نیازتان را
          انتخاب کنید.
        </p>
      </div>
      <div class="mahsa-entry-grid">
        {
          entryPaths.map((item) => (
            <a href={item.href} data-tone={item.tone}>
              <span aria-hidden="true">
                <>
                  <i />
                  <b />
                </>
              </span>
              <strong>{item.label}</strong>
              <p>{item.description}</p>
              <em>رفتن به این بخش ←</em>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mahsa-learning section" aria-labelledby="home-learning-title">
    <div class="shell">
      <div class="mahsa-section-heading">
        <div>
          <p class="eyebrow">راهنماهای رایگان</p>
          <h2 id="home-learning-title">بخوانید و همان روز امتحان کنید.</h2>
        </div>
        <a class="story-link" href="/ai/learn/">همهٔ راهنماها</a>
      </div>
      <div class="ai-guide-grid">
        {
          guides
            .slice(0, 3)
            .map((guide, index) => (
              <AIGuideCard guide={guide} featured={index === 0} />
            ))
        }
      </div>
    </div>
  </section>

  {
    featuredApp && (
      <section class="mahsa-product" aria-labelledby="home-metrazh-title">
        <div class="shell mahsa-product-grid">
          <div class="home-metrazh-copy">
            <>
              <p class="eyebrow">ساخته‌شده برای بازار املاک ایران</p>
              <img
                src={featuredApp.data.logo.light}
                alt="متراژ"
                width="170"
                height="103"
              />
              <h2 id="home-metrazh-title">
                فایل، مشتری و پیگیری را از پراکندگی نجات دهید.
              </h2>
              <p>
                متراژ یک اپلیکیشن فارسی برای مشاوران املاک است؛ جایی برای
                نگهداری فایل‌ها، نیاز مشتری، بازدیدها و اقدام بعدی، بدون وابستگی
                به چند دفتر و یادداشت پراکنده.
              </p>
              <ul>
                {featuredApp.data.features.slice(0, 3).map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <div>
                <a class="button" href="/apps/metrazh/">
                  متراژ چطور کمک می‌کند؟
                </a>
                {bazaarLink && (
                  <a
                    class="home-metrazh-download"
                    href={bazaarLink.url}
                    target="_blank"
                    rel="noopener"
                  >
                    نصب از کافه‌بازار <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </>
          </div>
          <figure class="mahsa-product-visual">
            <>
              <img
                src="/images/apps/metrazh/bazaar/slide-04.jpg"
                alt="تطبیق هوشمند فایل و مشتری در اپلیکیشن متراژ"
                width="1080"
                height="1920"
                loading="lazy"
              />
              <figcaption>
                نمای واقعی بخش تطبیق فایل و نیاز مشتری در متراژ
              </figcaption>
            </>
          </figure>
        </div>
      </section>
    )
  }

  {
    propertyGuides.length > 0 && (
      <section
        class="mahsa-property-reads section"
        aria-labelledby="home-property-title"
      >
        <div class="shell">
          <div class="mahsa-section-heading">
            <div>
              <p class="eyebrow">کنار اپلیکیشن متراژ</p>
              <h2 id="home-property-title">
                راهنماهایی برای کار بهتر در املاک.
              </h2>
            </div>
            <a class="story-link" href="/articles/">
              همهٔ مقاله‌های املاک
            </a>
          </div>
          <div class="mahsa-property-grid">
            {propertyGuides.map((article) => (
              <article>
                <a href={`/articles/${article.id}/`}>
                  <img
                    src={article.data.cover}
                    alt={article.data.coverAlt}
                    loading="lazy"
                  />
                </a>
                <p>{article.data.category}</p>
                <h3>
                  <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                </h3>
                <a class="story-link" href={`/articles/${article.id}/`}>
                  مطالعهٔ راهنما
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
