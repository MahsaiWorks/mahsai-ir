---
import { getCollection } from 'astro:content';
import AppCard from '../components/AppCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../config/site';
import { specialties } from '../data/specialties';
import BaseLayout from '../layouts/BaseLayout.astro';

const apps = (await getCollection('apps'))
  .filter((app) => app.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={siteConfig.seoDefaults.title}
  description={siteConfig.seoDefaults.description}
>
  <section class="hero hero-home">
    <div class="shell hero-grid">
      <div class="hero-content">
        <p class="hero-badge">
          <span aria-hidden="true"></span> محصولی از MAHSAI
        </p>
        <h1>ابزار حرفه‌ای برای <span>کارهای واقعی.</span></h1>
        <p class="hero-copy">
          متراژ، دستیار فارسی مشاوران املاک برای مدیریت فایل‌ها، متقاضیان،
          بازدیدها و پیگیری‌های روزانه؛ طراحی‌شده برای یک جریان کاری منظم‌تر.
        </p>
        <div class="hero-actions">
          <a class="button" href="/apps/metrazh/">
            آشنایی با متراژ <span aria-hidden="true">←</span>
          </a>
          <a class="button button-secondary" href="/articles/">مقالات آموزشی</a>
        </div>
        <ul class="hero-signals" aria-label="ویژگی‌های اصلی">
          <li><span aria-hidden="true">✓</span> ویژه اندروید</li>
          <li><span aria-hidden="true">✓</span> فارسی و راست‌به‌چپ</li>
          <li><span aria-hidden="true">✓</span> پشتیبانی رسمی</li>
        </ul>
      </div>
      <div class="hero-product-visual" aria-label="پیش‌نمایش اپلیکیشن متراژ">
        <div class="hero-visual-copy">
          <img
            src="/images/apps/metrazh/icon.png"
            alt=""
            width="56"
            height="56"
          />
          <div><strong>متراژ</strong><span>دستیار مشاوران املاک</span></div>
        </div>
        <div class="hero-phone hero-phone-secondary" aria-hidden="true">
          <img src="/images/apps/metrazh/files.png" alt="" />
        </div>
        <div class="hero-phone hero-phone-primary">
          <img
            src="/images/apps/metrazh/dashboard.png"
            alt="نمای میز کار اپلیکیشن متراژ"
          />
        </div>
        <span class="hero-version">نسخه ۱.۰.۳ · پیش‌انتشار</span>
      </div>
    </div>
  </section>

  <section class="home-facts" aria-label="مشخصات متراژ">
    <div class="shell home-facts-grid">
      <p><span>محصول</span><strong>متراژ</strong></p>
      <p><span>پلتفرم</span><strong lang="en" dir="ltr">Android</strong></p>
      <p>
        <span>حداقل نسخه</span><strong lang="en" dir="ltr">Android 7.0</strong>
      </p>
      <p><span>وضعیت</span><strong>در حال توسعه</strong></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="focus-title">
    <div class="shell">
      <SectionHeading
        eyebrow="حوزه تمرکز"
        title="توسعه اپلیکیشن فارسی برای اندروید"
        description="تمرکز فعلی MAHSAI توسعه متراژ و ساخت ابزارهای راست‌به‌چپ برای جریان واقعی کار مشاوران املاک است."
      />
      <div class="specialties-grid">
        {
          specialties.map((specialty) => (
            <article class="specialty-card">
              <span class="specialty-number">{specialty.number}</span>
              <h3>{specialty.title}</h3>
              <p>{specialty.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="apps-title">
    <div class="shell">
      <SectionHeading
        eyebrow="اپلیکیشن MAHSAI"
        title="متراژ؛ دستیار مشاوران املاک"
        description="مدیریت هوشمند فایل‌ها — آفلاین و امن. داده‌های اصلی روی دستگاه نگهداری می‌شوند و برخی قابلیت‌ها برای کارکرد به اینترنت نیاز دارند."
      />
      <div class="apps-grid apps-grid-featured">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="articles-title">
    <div class="shell">
      <SectionHeading
        eyebrow="مقالات آموزشی"
        title="راهنماهایی برای کار دقیق‌تر در املاک"
        description="مطالب کاربردی درباره ثبت فایل، مدیریت متقاضی، پیگیری مشتری و ابزارهای متراژ."
      />
      <div class="articles-grid">
        {
          articles.map((article) => (
            <article class="article-card">
              <div class="article-meta">
                <span>{article.data.category}</span>
                <span>{article.data.readingTime}</span>
              </div>
              <div>
                <h2>
                  <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                </h2>
                <p>{article.data.description}</p>
              </div>
              <a class="text-link" href={`/articles/${article.id}/`}>
                مطالعه مقاله <span aria-hidden="true">←</span>
              </a>
            </article>
          ))
        }
      </div>
      <div class="hero-actions">
        <a class="button button-secondary" href="/articles/">همه مقالات</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell about-preview">
      <div class="about-visual" aria-hidden="true">
        <small>MAHSAI / PRODUCT DEVELOPMENT</small>
        <span>ساختن، برای استفاده واقعی.</span>
        <i></i>
      </div>
      <div class="about-copy">
        <p class="eyebrow">درباره MAHSAI</p>
        <h2>توسعه اپلیکیشن با تمرکز بر مسئله‌های روزمره.</h2>
        <p>{siteConfig.biography}</p>
        <a class="text-link" href="/about/">
          درباره MAHSAI <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell cta-panel">
      <p class="eyebrow">پشتیبانی رسمی</p>
      <h2>برای پرسش‌های مربوط به متراژ همراه شما هستیم.</h2>
      <p>
        برای گزارش مشکل، پیشنهاد یا پرسش درباره نسخه پیش‌انتشار از ایمیل و
        کانال‌های رسمی پشتیبانی استفاده کنید.
      </p>
      <div class="cta-actions">
        <a class="button" href="/support/">رفتن به پشتیبانی</a>
        <a
          class="button button-secondary"
          href={`mailto:${siteConfig.supportEmail}`}
          dir="ltr"
        >
          {siteConfig.supportEmail}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
