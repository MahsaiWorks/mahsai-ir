---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import { siteConfig } from '../../config/site';
import { articleClusters } from '../../data/articleClusters';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);

const trackImages = {
  files: {
    src: '/images/editorial/property-workflow.webp',
    alt: 'میز کار منظم مشاور املاک با پرونده‌ها و ماکت ساختمان',
  },
  clients: {
    src: '/images/editorial/visit-route-planning.webp',
    alt: 'برنامه‌ریزی مسیر بازدید چند ملک',
  },
  marketing: {
    src: '/images/editorial/smart-property-ad.webp',
    alt: 'آماده‌سازی متن و تصویر برای آگهی یک ملک',
  },
  legal: {
    src: '/images/editorial/secure-real-estate-data.webp',
    alt: 'حفاظت از اسناد و اطلاعات کاری املاک',
  },
} as const;

const collectionStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'آموزش رایگان مشاور املاک',
  description:
    'مسیرهای یادگیری مرحله‌به‌مرحله برای فایل‌گیری، شناخت مشتری، بازدید، پیگیری، آگهی و امنیت اطلاعات در کار املاک.',
  url: new URL('/academy/', Astro.site).toString(),
  inLanguage: 'fa-IR',
  hasPart: articles.map((article) => ({
    '@type': 'Article',
    name: article.data.title,
    url: new URL(`/articles/${article.id}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title={`آموزش رایگان مشاور املاک؛ از فایل تا پیگیری | ${siteConfig.brandName}`}
  description="آموزش ساده، تصویری و مرحله‌به‌مرحله برای مشاوران املاک ایران؛ فایل‌گیری، نیازسنجی مشتری، بازدید، پیگیری، آگهی‌نویسی و امنیت اطلاعات."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(collectionStructuredData)}
  />

  <header class="academy-hero">
    <div class="shell academy-hero-grid">
      <div>
        <p class="kicker">آموزش رایگان برای دفتر املاک</p>
        <h1>یاد بگیرید، همان روز <span>در کارتان اجرا کنید.</span></h1>
        <p class="lead">
          به‌جای درس‌های طولانی و اصطلاحات سنگین، از مسئله‌ای شروع کنید که امروز
          در دفتر دارید. هر مسیر کوتاه، پیوسته و قابل اجراست.
        </p>
        <div class="hero-actions">
          <a class="button" href="#learning-paths">انتخاب مسیر یادگیری</a>
          <a class="text-link" href="/apps/metrazh/">آشنایی با متراژ ←</a>
        </div>
        <ul class="trust-list">
          <li>بدون ثبت‌نام</li>
          <li>رایگان</li>
          <li>مناسب بازار ایران</li>
        </ul>
      </div>
      <figure>
        <img
          src="/images/stock/real-estate-consultation.jpg"
          alt="گفت‌وگوی مشاور املاک با مراجعه‌کننده در زمان بازدید"
          width="1800"
          height="1200"
          fetchpriority="high"
        />
        <figcaption>عکس: RDNE از Pexels</figcaption>
      </figure>
    </div>
  </header>

  <nav class="academy-map" aria-label="مسیرهای آموزش املاک">
    <div class="shell academy-map-grid">
      {
        articleClusters.map((cluster) => (
          <a href={`#${cluster.id}`}>
            <strong>{cluster.title}</strong>
            <span>
              {
                articles.filter(
                  (article) => article.data.cluster === cluster.id,
                ).length
              }{' '}
              راهنمای کاربردی
            </span>
          </a>
        ))
      }
    </div>
  </nav>

  <div id="learning-paths" class="academy-tracks">
    {
      articleClusters.map((cluster, index) => {
        const entries = articles.filter(
          (article) => article.data.cluster === cluster.id,
        );
        const image = trackImages[cluster.id];

        return (
          <section
            class:list={[
              'academy-track',
              { 'academy-track-alt': index % 2 === 1 },
            ]}
            id={cluster.id}
            aria-labelledby={`track-${cluster.id}`}
          >
            <div class="shell academy-track-head">
              <div>
                <p class="kicker">مسیر یادگیری</p>
                <h2 id={`track-${cluster.id}`}>{cluster.title}</h2>
                <p>{cluster.description}</p>
              </div>
              <figure>
                <img
                  src={image.src}
                  alt={image.alt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                />
              </figure>
            </div>
            <div class="shell editorial-grid">
              {entries.map((article, articleIndex) => (
                <ArticleCard article={article} featured={articleIndex === 0} />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="academy-finish">
    <div class="shell academy-finish-grid">
      <div>
        <p class="kicker kicker-light">بعد از یادگیری</p>
        <h2>روش درست وقتی ماندگار می‌شود که در جریان کار جا بگیرد.</h2>
        <p>
          متراژ کمک می‌کند فایل، نیاز مشتری، بازدید و پیگیری‌هایی را که در این
          مسیرها یاد گرفته‌اید، یک‌جا نگه دارید.
        </p>
        <a class="button button-light" href="/apps/metrazh/">
          دیدن متراژ در عمل
        </a>
      </div>
      <div class="academy-phone-row" aria-label="تصاویر واقعی متراژ">
        <img
          src="/images/apps/metrazh/property.png"
          alt="جزئیات فایل ملک در متراژ"
          width="1080"
          height="2400"
          loading="lazy"
        />
        <img
          src="/images/apps/metrazh/report.png"
          alt="گزارش کار در اپلیکیشن متراژ"
          width="1080"
          height="2400"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
