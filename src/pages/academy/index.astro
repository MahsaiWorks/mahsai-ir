---
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import { articleClusters } from '../../data/articleClusters';
import { guideTopics } from '../../data/guideTopics';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);

const trackImages = {
  files: {
    src: '/images/brand/editorial/between-visits-metrazh-v4.webp',
    alt: 'میز کار منظم مشاور املاک با پرونده‌ها و ماکت ساختمان',
  },
  clients: {
    src: '/images/brand/editorial/article-visits-v5.webp',
    alt: 'برنامه‌ریزی مسیر بازدید چند ملک',
  },
  marketing: {
    src: '/images/brand/editorial/article-photography-v5.webp',
    alt: 'آماده‌سازی متن و تصویر برای آگهی یک ملک',
  },
  legal: {
    src: '/images/brand/editorial/article-security-v5.webp',
    alt: 'حفاظت از اسناد و اطلاعات کاری املاک',
  },
} as const;

const voteTopics = [
  { id: 'stale_files', label: 'مرتب‌کردن فایل‌های قدیمی' },
  { id: 'client_followup', label: 'پیگیری مشتری مردد' },
  { id: 'property_ads', label: 'نوشتن آگهی بهتر' },
  { id: 'visit_planning', label: 'برنامه‌ریزی بازدیدها' },
] as const;

const collectionStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'آکادمی مهسای؛ دوره‌ها و آموزش‌های کاربردی',
  description:
    'دورهٔ ابر مشاور برای ساخت محتوا با هوش مصنوعی، در کنار آموزش‌های رایگان و مرحله‌به‌مرحله برای کار با متراژ و مدیریت اطلاعات املاک.',
  url: new URL('/academy/', Astro.site).toString(),
  inLanguage: 'fa-IR',
  hasPart: [
    {
      '@type': 'Course',
      name: 'دوره آموزشی ساخت ویدیو و استوری با هوش مصنوعی (ابر مشاور)',
      url: new URL(
        '/academy/courses/ai-content-real-estate/',
        Astro.site,
      ).toString(),
      isAccessibleForFree: false,
    },
    {
      '@type': 'Course',
      name: 'اولین فایل ملکی مرتب در ۳۰ دقیقه',
      url: new URL(
        '/academy/first-organized-property-file/',
        Astro.site,
      ).toString(),
      isAccessibleForFree: true,
    },
    ...articles.map((article) => ({
      '@type': 'Article',
      name: article.data.title,
      url: new URL(`/articles/${article.id}/`, Astro.site).toString(),
    })),
  ],
};
---

<BaseLayout
  title={`آکادمی مهسای | دورهٔ هوش مصنوعی و آموزش‌های کاربردی`}
  description="دورهٔ ابر مشاور برای ساخت عکس، ویدیو و استوری با هوش مصنوعی؛ سرفصل‌ها و نمونه‌های دوره را ببینید و آموزش‌های رایگان متراژ را قدم‌به‌قدم دنبال کنید."
  image="/assets/academy/abr-moshaver/hero-scene.webp"
  imageAlt="آکادمی مهسای؛ دورهٔ ابر مشاور و نمونه‌های ساخت محتوا با هوش مصنوعی"
  imageWidth={1280}
  imageHeight={550}
  preloadImage="/assets/academy/abr-moshaver/hero-scene.webp"
  preloadImageWidth={1280}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(collectionStructuredData)}
  />

  <header class="academy-hero">
    <div class="shell academy-hero-grid">
      <div>
        <p class="kicker">آکادمی مهسای</p>
        <h1>دوره‌ها و آموزش‌های کاربردی</h1>
        <p class="lead">
          ساخت محتوا با هوش مصنوعی را یاد بگیر یا با آموزش‌های رایگان، کار با
          متراژ را شروع کن. مسیر مناسب خودت را انتخاب کن.
        </p>
        <div class="hero-actions">
          <a class="button" href="/academy/courses/ai-content-real-estate/"
            >دیدن دورهٔ ابر مشاور</a
          >
          <a class="text-link" href="#free-training">آموزش‌های رایگان متراژ ←</a
          >
        </div>
        <ul class="trust-list">
          <li>آموزش عملی</li>
          <li>همراه مثال</li>
          <li>متن و آموزش فارسی</li>
        </ul>
      </div>
      <figure class="academy-course-visual">
        <ResponsiveImage
          src="/assets/academy/abr-moshaver/hero-scene.webp"
          width="1280"
          height="550"
          alt="دورهٔ ابر مشاور؛ چند نمونه از ساخت سریال، رشته‌استوری، انیمیشن و قبل‌وبعد"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  <section
    class="section academy-course-introduction"
    aria-labelledby="abr-moshaver-title"
  >
    <div class="shell">
      <p class="kicker">دورهٔ آنلاین ابر مشاور</p>
      <h2 id="abr-moshaver-title">ساخت ویدیو و استوری با هوش مصنوعی</h2>
      <p>
        با یک گوشی ساده، برای پیج، شغل و برند شخصی خودت محتوا بساز. ۱۵ درس عملی
        با مجموع ۱ ساعت و ۴۰ دقیقه و ۲۴ ثانیه آموزش.
      </p>
      <a class="button" href="/academy/courses/ai-content-real-estate/"
        >سرفصل‌ها و نمونه‌های دوره</a
      >
    </div>
  </section>

  <section
    class="academy-featured-course"
    id="free-training"
    aria-labelledby="featured-course-title"
  >
    <div class="shell academy-featured-course-grid">
      <figure>
        <ResponsiveImage
          src="/images/brand/editorial/digital-workspace-metrazh-v4.webp"
          alt="مشاور املاک در حال مدیریت اطلاعات با گوشی و لپ‌تاپ، از نمای بالا"
          width="1536"
          height="1024"
        />
      </figure>
      <div>
        <p class="kicker">آموزش رایگان · بدون ثبت‌نام</p>
        <h2 id="featured-course-title">در ۳۰ دقیقه، یک فایل مرتب بسازید</h2>
        <p>
          چهار درس کوتاه را انجام می‌دهید و یک فایل تمرینی می‌سازید که راحت پیدا
          می‌شود و زمان پیگیری بعدی آن مشخص است.
        </p>
        <ul>
          <li>تمرین با اطلاعات ساختگی</li>
          <li>برگهٔ آمادهٔ چاپ</li>
          <li>کنترل کامل بودن فایل در پایان</li>
        </ul>
        <a class="button" href="/academy/first-organized-property-file/"
          >شروع رایگان دوره</a
        >
      </div>
    </div>
  </section>

  <nav class="academy-map" aria-label="مسیرهای آموزش املاک">
    <div class="shell academy-map-grid">
      {
        articleClusters.map((cluster) => (
          <a href={`#${cluster.id}`}>
            <strong>{cluster.title}</strong>
            <span>
              {
                articles.filter(
                  (article) => article.data.cluster === cluster.id,
                ).length
              }{' '}
              راهنمای کاربردی
            </span>
          </a>
        ))
      }
    </div>
  </nav>

  <section class="section guide-preview" aria-labelledby="academy-guides-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">نمی‌دانید از کجا شروع کنید؟</p>
          <h2 id="academy-guides-title">
            راهنمای نزدیک به کار امروزتان را انتخاب کنید
          </h2>
        </div>
        <p>
          هر راهنما موضوع را از اول توضیح می‌دهد و بعد شما را به آموزش‌های
          جزئی‌تر می‌رساند.
        </p>
      </header>
      <div class="guide-card-grid">
        {guideTopics.map((guide) => <GuideCard guide={guide} compact />)}
      </div>
    </div>
  </section>

  <div id="learning-paths" class="academy-tracks">
    {
      articleClusters.map((cluster, index) => {
        const entries = articles.filter(
          (article) => article.data.cluster === cluster.id,
        );
        const image = trackImages[cluster.id];

        return (
          <section
            class:list={[
              'academy-track',
              { 'academy-track-alt': index % 2 === 1 },
            ]}
            id={cluster.id}
            aria-labelledby={`track-${cluster.id}`}
          >
            <div class="shell academy-track-layout">
              <header class="academy-track-head">
                <div>
                  <p class="kicker">آموزش‌های این موضوع</p>
                  <h2 id={`track-${cluster.id}`}>{cluster.title}</h2>
                  <p>{cluster.description}</p>
                </div>
                <figure>
                  <ResponsiveImage
                    src={image.src}
                    alt={image.alt}
                    width="1536"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              </header>
              <div
                class:list={[
                  'editorial-grid',
                  'academy-track-articles',
                  { 'editorial-grid-single': entries.length === 1 },
                ]}
              >
                {entries.map((article, articleIndex) => (
                  <ArticleCard
                    article={article}
                    featured={articleIndex === 0}
                  />
                ))}
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="section academy-vote" aria-labelledby="academy-vote-title">
    <div class="shell academy-vote-card">
      <div>
        <p class="kicker">نظر شما برای آموزش بعدی</p>
        <h2 id="academy-vote-title">
          دوست دارید آموزش بعدی دربارهٔ چه چیزی باشد؟
        </h2>
        <p>
          فقط یک گزینه را بزنید. نیازی به ورود، ایمیل یا نوشتن توضیح نیست و متن
          انتخاب شما در سایت نمایش داده نمی‌شود.
        </p>
      </div>
      <ul>
        {
          voteTopics.map((topic) => (
            <li>
              <button
                type="button"
                data-topic-vote={topic.id}
                aria-pressed="false"
                data-event="content_vote_email"
                data-event-location={`academy_vote_${topic.id}`}
              >
                {topic.label}
              </button>
            </li>
          ))
        }
      </ul>
      <p class="academy-vote-status" data-vote-status aria-live="polite"></p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-topic-vote]')];
      const status = document.querySelector('[data-vote-status]');
      if (!buttons.length || !status) return;

      const markVote = (selected) => {
        for (const button of buttons) {
          const isSelected = button === selected;
          button.toggleAttribute('data-selected', isSelected);
          button.setAttribute('aria-pressed', String(isSelected));
          button.disabled = true;
        }
        status.textContent = 'ممنون؛ انتخابت ثبت شد.';
      };

      let savedVote = '';
      try {
        savedVote = sessionStorage.getItem('mahsai_academy_vote') || '';
      } catch {}
      const savedButton = buttons.find(
        (button) => button.dataset.topicVote === savedVote,
      );
      if (savedButton) markVote(savedButton);

      for (const button of buttons) {
        button.addEventListener('click', () => {
          if (button.disabled || button.hasAttribute('data-selected')) return;
          try {
            sessionStorage.setItem(
              'mahsai_academy_vote',
              button.dataset.topicVote || '',
            );
          } catch {}
          markVote(button);
        });
      }
    })();
  </script>

  <section class="academy-finish">
    <div class="shell academy-finish-grid">
      <div>
        <p class="kicker kicker-light">بعد از یادگیری</p>
        <h2>چیزی را که یاد گرفته‌اید، در کار روزانه تکرار کنید</h2>
        <p>
          متراژ کمک می‌کند فایل، نیاز مشتری، بازدید و پیگیری‌هایی را که در این
          آموزش‌ها یاد گرفته‌اید، یک‌جا نگه دارید.
        </p>
        <a class="button button-light" href="/apps/metrazh/">
          دیدن متراژ در عمل
        </a>
      </div>
      <div class="academy-phone-row" aria-label="تصاویر رسمی متراژ">
        <ResponsiveImage
          src="/images/apps/metrazh/current/ad-assistant.webp"
          alt="معرفی رسمی ساخت آگهی از اطلاعات فایل در متراژ"
          width="1080"
          height="2460"
          loading="lazy"
          decoding="async"
        />
        <ResponsiveImage
          src="/images/apps/metrazh/current/visits.webp"
          alt="معرفی رسمی برنامه‌ریزی بازدیدها در متراژ"
          width="1080"
          height="2460"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .academy-hero .academy-course-visual {
    min-height: 0;
  }

  .academy-hero .academy-course-visual :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 550;
    object-fit: contain;
  }
</style>
