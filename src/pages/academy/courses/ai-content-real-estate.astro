---
import { siteConfig } from '../../../config/site';
import { aiFilmCourse } from '../../../data/aiFilmCourse';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const salesEnabled = import.meta.env.PUBLIC_ACADEMY_SALES_ENABLED === 'true';
const funnelEnabled =
  salesEnabled && import.meta.env.PUBLIC_ACADEMY_FUNNEL_ENABLED === 'true';
const courseTitle = aiFilmCourse.title;
// This existing server entry preserves signed referral/funnel attribution and redirects to checkout.
const checkoutUrl = 'https://android-pay.mahsai.ir/academy/buy';
const purchaseLabel = 'ثبت‌نام دوره';
const faNumber = new Intl.NumberFormat('fa-IR');
const lessonTime = (seconds: number) =>
  `${faNumber.format(Math.floor(seconds / 60))}:${String(seconds % 60)
    .padStart(2, '0')
    .replace(/\d/g, (digit) => '۰۱۲۳۴۵۶۷۸۹'.charAt(Number(digit)))}`;
const academyLoginUrl = 'https://android-pay.mahsai.ir/account/academy';
const supportUrl = 'https://t.me/Mahsaisupport';
const internationalEnabled =
  salesEnabled && import.meta.env.PUBLIC_ACADEMY_PAYPAL_ENABLED === 'true';
const internationalUrl =
  'https://android-pay.mahsai.ir/academy/buy-international';

const results = [
  {
    number: '۰۱',
    title: 'ساخت عکس و ویدیو با هوش مصنوعی',
    text: 'ایده‌ات را به تصویر و ویدیوی قابل استفاده تبدیل کنی.',
  },
  {
    number: '۰۲',
    title: 'شخصیت مجازی خودت را بساز',
    text: 'شخصیتی طراحی کنی که چهره‌اش در عکس‌ها و ویدیوهای مختلف ثابت‌تر بماند.',
  },
  {
    number: '۰۳',
    title: 'قبل‌وبعد و فرمت‌های محتوا',
    text: 'فرمت قبل‌وبعد و چند قالب کاربردی محتوا را از صفر بسازی.',
  },
  {
    number: '۰۴',
    title: 'رشته‌استوری پیجت را بساز',
    text: 'استوری‌های مرتبط طراحی کنی که یک داستان را قدم‌به‌قدم جلو ببرند.',
  },
  {
    number: '۰۵',
    title: 'داستانت را به یک سریال تبدیل کن',
    text: 'یک ایده را به روایت چندقسمتی تبدیل کنی؛ مثل نمونهٔ «خانهٔ پدری».',
  },
  {
    number: '۰۶',
    title: 'خروجی طبیعی‌تر و خطاهای رایج',
    text: 'خروجی را دقیق‌تر بررسی کنی و خطاهای رایج را زودتر تشخیص بدهی.',
  },
  {
    number: '۰۷',
    title: 'موزیک باکلام و بی‌کلام',
    text: 'برای محتوایت موسیقی باکلام یا بی‌کلام مناسب بسازی.',
  },
  {
    number: '۰۸',
    title: 'دستیار شخصی برای ایده‌پردازی و تولید محتوا',
    text: 'برای ایده‌پردازی و برنامه‌ریزی کار خودت، یک دستیار شخصی تنظیم کنی.',
  },
  {
    number: '۰۹',
    title: 'انتخاب ابزار و حل مشکلات رایج',
    text: 'ابزار مناسب هر کار را انتخاب کنی و از خطاهای معمول عبور کنی.',
  },
] as const;

const featuredResults = [results[1], results[4], results[3]];
const additionalResults = results.filter(
  (_, index) => ![1, 4, 3].includes(index),
);

const faqs = [
  {
    question: 'برای ویدئوهای سیدنس آمده‌ام؛ این دوره چه چیزی آموزش می‌دهد؟',
    answer: aiFilmCourse.scope,
  },
  {
    question: 'با گوشی هم می‌تونم شروع کنم؟',
    answer:
      'در چند درس نمونهٔ کار روی صفحهٔ گوشی را می‌بینی. پیش از ثبت‌نام، دسترسی ابزارهای مدنظرت را روی گوشی و حساب خودت بررسی کن.',
  },
  {
    question: 'چطور دوره و فایل‌ها رو دریافت می‌کنم؟',
    answer:
      'پس از تأیید پرداخت، با همان شمارهٔ خرید وارد دوره‌های من شو. درخواست عضویت در کانال‌های تلگرام از حساب خریدار قابل پیگیری است و تماشای سایت به تأیید عضویت تلگرام وابسته نیست.',
  },
  {
    question: 'پشتیبانی دوره دقیقاً برای چیه؟',
    answer:
      'اگر در هر بخش از دوره سؤال داشتی یا جایی برایت روشن نبود، پشتیبان کنار توست تا شفاف‌سازی و راهنمایی‌ات کند؛ برای پرداخت، ورود و دسترسی هم کمک می‌گیری.',
  },
  {
    question: 'هزینهٔ ابزارهای هوش مصنوعی داخل مبلغ دوره است؟',
    answer:
      'هزینهٔ اشتراک یا اعتبار ابزارها جداست و با ابزار، پلن و زمان تغییر می‌کند. برای بعضی ابزارها ممکن است گزینهٔ رایگان در دسترس باشد. پیش از شروع، شرایط همان ابزار را در حساب خودت بررسی کن.',
  },
] as const;

const courseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: courseTitle,
  description:
    'آموزش عملی ساخت عکس، ویدیو، استوری و محتوای سریالی با هوش مصنوعی برای مشاغل و برندهای شخصی.',
  url: new URL(
    '/academy/courses/ai-content-real-estate/',
    Astro.site,
  ).toString(),
  provider: {
    '@type': 'Organization',
    name: siteConfig.brandName,
    url: Astro.site?.toString(),
  },
  inLanguage: 'fa-IR',
  isAccessibleForFree: false,
  timeRequired: 'PT1H40M24S',
};
---

<BaseLayout
  title={courseTitle + ' | ' + siteConfig.brandName}
  description="۱۵ درس عملی برای کارگردانی و فیلمسازی با هوش مصنوعی؛ از ساخت عکس و ویدیو تا استوری و محتوای سریالی برای پیج، کسب‌وکار و برند شخصی."
  image="/assets/academy/abr-moshaver/course-hero-banner-20261031.webp"
  imageAlt="دورهٔ آموزشی کارگردانی و فیلمسازی با هوش مصنوعی"
  imageWidth={1912}
  imageHeight={823}
  preloadImage="/assets/academy/abr-moshaver/course-hero-banner-20261031.webp"
  preloadImageWidth={1912}
  preloadImageSizes="100vw"
  keywords={[
    'دوره هوش مصنوعی',
    'کارگردانی با هوش مصنوعی',
    'فیلمسازی با هوش مصنوعی',
    'آموزش تولید محتوا',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(courseStructuredData)}
  />
  <article
    class="course-page"
    data-academy-funnel={funnelEnabled ? 'true' : 'false'}
  >
    <header class="course-hero shell">
      <img
        class="course-hero-image"
        src="/assets/academy/abr-moshaver/course-hero-banner-20261031.webp"
        alt="دورهٔ آموزشی کارگردانی و فیلمسازی با هوش مصنوعی"
        width="1912"
        height="823"
        fetchpriority="high"
        decoding="async"
      />
      <p class="course-existing-login">
        قبلاً دوره را خریده‌ای؟
        <a href={academyLoginUrl}>قبلاً خریده‌ام؛ ورود به دوره</a>
      </p>
      <h1>{courseTitle}</h1>
      <p class="course-upgrade-intro">
        از ایده تا ویدئو پیش برو. با مثال‌های عملی، داستان و شخصیت طراحی کن،
        سکانس‌ها را بساز و خروجی را بازبینی و تدوین کن. نمونه‌های اصلی دوره
        ملکی‌اند؛ همین مراحل را برای پیج، محصول یا خدمات خودت تمرین کن.
      </p>
      <p class="course-upgrade-scope">{aiFilmCourse.scope}</p>
      <div class="course-purchase-strip" id="course-purchase">
        <div class="course-strip-offer">
          <span class="course-strip-offer-label">ثبت‌نام در دورهٔ آموزشی</span>
          <div class="course-offer-price">
            <strong
              >{faNumber.format(aiFilmCourse.currentPriceToman)}
              <small>تومان</small></strong
            >
          </div>
          <a class="course-button" href={checkoutUrl}>{purchaseLabel}</a>
          <p class="course-price-note">
            مبلغ نهایی و شرایط همان سفارش پیش از پرداخت در صفحهٔ ثبت‌نام نمایش
            داده می‌شوند.
          </p>
          <p class="course-support-cta">
            پاسخ‌گویی پشتیبانی: زیر ۲۴ ساعت ·{' '}
            <a href={supportUrl} target="_blank" rel="noopener noreferrer">
              تلگرام <bdi dir="ltr">@Mahsaisupport</bdi>
            </a>
          </p>
        </div>
        <dl class="course-metrics">
          <div>
            <dt>{faNumber.format(aiFilmCourse.lessons.length)} درس</dt><dd>
              ۱۵ ویدیوی آموزشی
            </dd>
          </div>
          <div>
            <dt><bdi dir="ltr">{aiFilmCourse.durationClock}</bdi></dt><dd>
              زمان آموزش
            </dd>
          </div>
          <div><dt>دسترسی دائمی</dt><dd>به دوره و آپدیت‌های آینده</dd></div>
        </dl>
        {
          internationalEnabled && (
            <p class="course-international-option">
              خارج از ایران هستی؟{' '}
              <a href={internationalUrl} data-academy-international>
                پرداخت با PayPal · <bdi dir="ltr">40 USD</bdi>
              </a>
            </p>
          )
        }
      </div>
    </header>

    <section
      class="course-section shell course-introduction"
      aria-labelledby="course-introduction-title"
    >
      <figure class="course-preview">
        <figcaption data-course-reveal>
          <h2 id="course-introduction-title">مقدمهٔ مدرس</h2>
        </figcaption>
        <div class="course-preview-player">
          <video
            id="course-preview"
            controls
            tabindex="0"
            playsinline
            preload="none"
            poster="/assets/academy/abr-moshaver/course-introduction-poster-v2.webp"
            aria-label="ویدیوی مقدمهٔ دورهٔ آموزشی کارگردانی و فیلمسازی با هوش مصنوعی"
          >
            <source
              src="/assets/academy/abr-moshaver/course-introduction-v1.mp4"
              type="video/mp4"
            />
            <track
              kind="captions"
              src="/assets/academy/abr-moshaver/course-introduction-v1.fa.vtt"
              srclang="fa"
              label="فارسی"
            />
            برای دیدن نمونه، از مرورگری استفاده کن که پخش ویدیو را پشتیبانی می‌کند.
          </video>
          <button
            class="course-preview-play"
            id="course-preview-play"
            type="button"
            hidden
          >
            <span aria-hidden="true">▶</span> پخش مقدمهٔ دوره
          </button>
        </div>
      </figure>
    </section>

    <section
      class="course-section shell course-outcomes"
      aria-labelledby="course-outcomes-title"
    >
      <details>
        <summary
          ><h2 id="course-outcomes-title">
            بعد از خرید چه آموزش‌هایی در انتظارته؟
          </h2></summary
        >
        <p class="course-outcomes-intro">
          عکس و ویدیو، شخصیت مجازی، سریال، انیمیشن و موزیک؛ چند نمونه از
          مهارت‌هایی که در ۱۵ درس عملی تمرین می‌کنی.
        </p>
        <div class="course-result-grid">
          {
            [...featuredResults, ...additionalResults].map((result) => (
              <article>
                <h3>{result.title}</h3>
                <p>{result.text}</p>
              </article>
            ))
          }
        </div>
      </details>
    </section>

    <section
      class="course-section course-examples shell"
      aria-labelledby="course-examples-title"
    >
      <header class="course-section-head" data-course-reveal>
        <h2 id="course-examples-title">تصویر نمونه‌ها و ارتباطشان با درس‌ها</h2>
      </header>
      <p>
        این رسانه‌ها عکس‌اند. هر نمونه با درس مرتبط یا به‌عنوان الهام معرفی شده
        است؛ نمونه‌های عملی ساخت ویدئو در درس‌های فعلی با Flow هستند.
      </p>
      <div class="course-example-grid course-square-example-grid">
        {
          aiFilmCourse.examples.slice(0, 3).map((item) => (
            <figure data-course-reveal>
              <>
                <h3 class="course-example-title">{item.title}</h3>
                <img
                  src={item.src}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  alt={item.title + '؛ تصویر نمونه'}
                />
                <figcaption>
                  <>
                    <p>{item.relationship}</p>
                    <a href={'#course-lesson-' + item.lessonNumber}>
                      دیدن درس مرتبط در فهرست
                    </a>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
      <div class="course-vertical-example-grid">
        {
          aiFilmCourse.examples.slice(3).map((item) => (
            <figure data-course-reveal>
              <>
                <h3 class="course-example-title">{item.title}</h3>
                <img
                  src={item.src}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  alt={item.title + '؛ تصویر نمونه'}
                />
                <figcaption>
                  <>
                    <p>{item.relationship}</p>
                    <a href={'#course-lesson-' + item.lessonNumber}>
                      دیدن درس مرتبط در فهرست
                    </a>
                  </>
                </figcaption>
              </>
            </figure>
          ))
        }
      </div>
    </section>

    <section
      class="course-section shell"
      aria-labelledby="course-syllabus-title"
    >
      <h2 id="course-syllabus-title">فهرست درس‌های فعلی دوره</h2>
      <p>
        درس ۷ بانک ۳۰ فرمت و ایده است. نوع آموزش هر درس را کنار عنوان می‌بینی؛
        این فهرست شامل آموزش آیندهٔ سیدنس نیست.
      </p>
      <ol class="course-syllabus-list">
        {
          aiFilmCourse.lessons.map((lesson) => (
            <li id={'course-lesson-' + lesson.number}>
              <>
                <span aria-hidden="true">{faNumber.format(lesson.number)}</span>
                <div>
                  <>
                    <strong>{lesson.title}</strong>
                    <small>{lesson.format}</small>
                  </>
                </div>
                <time dir="ltr">{lessonTime(lesson.durationSeconds)}</time>
              </>
            </li>
          ))
        }
      </ol>
    </section>
    <section
      class="course-section shell"
      aria-labelledby="course-resources-title"
    >
      <h2 id="course-resources-title">فایل‌های همراه درس‌ها</h2>
      <p>
        فایل دستیار محتوا، راهنمای ۳۰ فرمت و راهنمای رشته‌استوری در منابع همراه
        دوره قرار دارند. پس از ورود، فایل‌های مرتبط را کنار درس مربوط یا از
        کانال «فایل + پرامپت» دوره پیگیری کن.
      </p>
      <ul>
        {
          aiFilmCourse.companionFiles.map((file) => (
            <li>
              <>
                <a href={'#course-lesson-' + file.lessonNumber}>
                  درس {faNumber.format(file.lessonNumber)} · {file.title}
                </a>
                <p>{file.use}</p>
              </>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="course-section shell" aria-labelledby="course-faq-title">
      <header class="course-section-head">
        <h2 id="course-faq-title">قبل از خرید</h2>
      </header>
      <div class="course-faq-list">
        {
          faqs.map((faq) => (
            <details>
              <>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </>
            </details>
          ))
        }
      </div>
    </section>

    <section
      id="purchase-terms"
      class="course-section shell course-terms"
      aria-labelledby="purchase-terms-title"
    >
      <details>
        <summary id="purchase-terms-title">شرایط بازگشت وجه</summary>
        <p>
          در صورت پرداخت تکراری یا عدم امکان ارائه دسترسی به دوره، مبلغ مربوط
          بازگردانده می‌شود. درخواست‌های انصراف و بازپرداخت از طریق پشتیبانی و
          مطابق مقررات قابل‌اعمال بررسی می‌شوند.
        </p>
      </details>
    </section>

    {
      salesEnabled && (
        <div class="course-mobile-dock">
          <>
            <div class="course-dock-price">
              <span>قیمت دوره</span>
              <strong>
                {faNumber.format(aiFilmCourse.currentPriceToman)} تومان
              </strong>
            </div>
            <a class="course-button" href={checkoutUrl}>
              ثبت‌نام دوره
            </a>
          </>
        </div>
      )
    }
  </article>
  <footer slot="footer" class="course-site-footer">
    <div class="shell">
      <a href={supportUrl} target="_blank" rel="noopener noreferrer"
        >پشتیبانی دوره</a
      >
    </div>
  </footer>
  <script>
    import '../../../scripts/academy-funnel';
    import '../../../scripts/academy-motion';
    const sample = document.querySelector<HTMLVideoElement>('#course-preview');
    const play = document.querySelector<HTMLButtonElement>(
      '#course-preview-play',
    );
    if (sample && play) {
      play.hidden = false;
      play.addEventListener('click', () => {
        void sample.play().catch(() => {
          play.hidden = false;
        });
      });
      sample.addEventListener('playing', () => {
        if (document.activeElement === play) sample.focus();
        play.hidden = true;
      });
      sample.addEventListener('pause', () => {
        play.hidden = false;
      });
      sample.addEventListener('ended', () => {
        play.hidden = false;
      });
    }
  </script>
</BaseLayout>

<style>
  .course-upgrade-intro,
  .course-upgrade-scope {
    max-width: 72ch;
    margin-inline: auto;
    line-height: 1.95;
  }
  .course-upgrade-scope {
    padding: 1rem;
    border: 1px solid #dce5f5;
    border-radius: 1rem;
    background: #f5f8ff;
  }
  .course-price-note {
    font-size: 0.8rem;
    color: var(--course-muted);
    line-height: 1.8;
  }
  .course-examples figcaption {
    padding: 1rem;
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .course-syllabus-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .course-syllabus-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: start;
    padding: 1rem;
    border: 1px solid #dce5f5;
    border-radius: 1rem;
    scroll-margin-top: 6rem;
    line-height: 1.9;
  }
  .course-syllabus-list small {
    display: block;
    color: var(--course-muted);
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }
  @media (max-width: 600px) {
    .course-examples .course-square-example-grid,
    .course-examples .course-vertical-example-grid {
      grid-template-columns: 1fr;
    }
    .course-examples .course-example-title {
      font-size: 1rem;
      padding: 0.7rem;
    }
    .course-examples figure img {
      max-height: 24rem;
      object-fit: contain;
    }
  }

  @font-face {
    font-family: 'Vazirmatn Variable';
    font-style: normal;
    font-display: optional;
    font-weight: 100 900;
    src: url('/fonts/vazirmatn-arabic-wght-normal.woff2') format('woff2');
    unicode-range:
      U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1,
      U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF,
      U+FE70-FE74, U+FE76-FEFC;
  }
  @font-face {
    font-family: 'Vazirmatn Variable';
    font-style: normal;
    font-display: optional;
    font-weight: 100 900;
    src: url('/fonts/vazirmatn-latin-wght-normal.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF,
      U+FFFD;
  }
