---
import { siteConfig } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const salesEnabled = import.meta.env.PUBLIC_ACADEMY_SALES_ENABLED === 'true';
const checkoutUrl = salesEnabled
  ? 'https://android-pay.mahsai.ir/account/academy#buy-ai-content-real-estate'
  : '#course-purchase';
const purchaseLabel = salesEnabled ? 'خرید دوره' : 'اطلاعات ثبت‌نام';
const supportUrl = 'https://t.me/Mahsaisupport';

const results = [
  {
    number: '۰۱',
    title: 'ساخت عکس و ویدیو با هوش مصنوعی',
    text: 'ایده‌ات را به تصویر و ویدیوی قابل استفاده تبدیل کنی.',
  },
  {
    number: '۰۲',
    title: 'شخصیت مجازی خودت را بساز',
    text: 'شخصیتی طراحی کنی که چهره‌اش در عکس‌ها و ویدیوهای مختلف ثابت‌تر بماند.',
  },
  {
    number: '۰۳',
    title: 'قبل‌وبعد و فرمت‌های محتوا',
    text: 'فرمت قبل‌وبعد و چند قالب کاربردی محتوا را از صفر بسازی.',
  },
  {
    number: '۰۴',
    title: 'رشته‌استوری پیجت را بساز',
    text: 'استوری‌های مرتبط طراحی کنی که یک داستان را قدم‌به‌قدم جلو ببرند.',
  },
  {
    number: '۰۵',
    title: 'داستانت را به یک سریال تبدیل کن',
    text: 'یک ایده را به روایت چندقسمتی تبدیل کنی؛ مثل نمونهٔ «خانهٔ پدری».',
  },
  {
    number: '۰۶',
    title: 'خروجی طبیعی‌تر و خطاهای رایج',
    text: 'خروجی را دقیق‌تر بررسی کنی و خطاهای رایج را زودتر تشخیص بدهی.',
  },
  {
    number: '۰۷',
    title: 'موزیک باکلام و بی‌کلام',
    text: 'برای محتوایت موسیقی باکلام یا بی‌کلام مناسب بسازی.',
  },
  {
    number: '۰۸',
    title: 'دستیار شخصی برای ایده‌پردازی و تولید محتوا',
    text: 'برای ایده‌پردازی و برنامه‌ریزی کار خودت، یک دستیار شخصی تنظیم کنی.',
  },
  {
    number: '۰۹',
    title: 'انتخاب ابزار و حل مشکلات رایج',
    text: 'ابزار مناسب هر کار را انتخاب کنی و از خطاهای معمول عبور کنی.',
  },
] as const;

const featuredResults = [results[1], results[4], results[3]];
const additionalResults = results.filter(
  (_, index) => ![1, 4, 3].includes(index),
);

const faqs = [
  {
    question: 'با گوشی هم می‌تونم شروع کنم؟',
    answer:
      'بله، ویدیوها رو با همین گوشی می‌تونی ببینی و آموزش‌ها رو اجرا کنی.',
  },
  {
    question: 'چطور دوره و فایل‌ها رو دریافت می‌کنم؟',
    answer:
      'بعد از پرداخت موفق، ویدیوها داخل پنل حسابت آنلاین پخش می‌شن و فایل‌های همراه مجاز رو از همون پنل دریافت می‌کنی. ویدیوها لینک دانلود عمومی ندارن.',
  },
  {
    question: 'پشتیبانی دوره دقیقاً برای چیه؟',
    answer:
      'پشتیبانی برای مشکل پرداخت، ورود و دسترسیه و پاسخ‌گویی حداکثر تا ۲ روز کاری انجام می‌شه. این پشتیبانی مشاورهٔ نامحدود تولید محتوا یا اجرای پروژه نیست.',
  },
  {
    question: 'هزینهٔ ابزارهای هوش مصنوعی داخل مبلغ دوره است؟',
    answer:
      'نه؛ مبلغ دوره برای آموزش و دسترسی به محتواست. بعضی ابزارهای بیرونی پلن یا اعتبار جدا دارن و قیمتشون ممکنه تغییر کنه.',
  },
] as const;

const courseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'دوره آموزشی ساخت ویدیو و استوری با هوش مصنوعی (ابر مشاور)',
  description:
    'آموزش عملی ساخت عکس، ویدیو، استوری و محتوای سریالی با هوش مصنوعی برای مشاغل و برندهای شخصی.',
  url: new URL(
    '/academy/courses/ai-content-real-estate/',
    Astro.site,
  ).toString(),
  provider: {
    '@type': 'Organization',
    name: siteConfig.brandName,
    url: Astro.site?.toString(),
  },
  inLanguage: 'fa-IR',
  isAccessibleForFree: false,
  timeRequired: 'PT1H40M24S',
};
---

<BaseLayout
  title={'دوره آموزشی ساخت ویدیو و استوری با هوش مصنوعی (ابر مشاور) | ' +
    siteConfig.brandName}
  description="دورهٔ ضبط‌شدهٔ ابر مشاور؛ ۱۵ درس عملی برای ساخت عکس، ویدیو و استوری با هوش مصنوعی برای پیج، کسب‌وکار و برند شخصی."
  image="/assets/academy/abr-moshaver/hero-scene.webp"
  imageAlt="دورهٔ ابر مشاور؛ نمونه‌های ساخت سریال، رشته‌استوری، انیمیشن و قبل‌وبعد"
  imageWidth={1280}
  imageHeight={550}
  keywords={[
    'دوره هوش مصنوعی',
    'آموزش تولید محتوا',
    'محتوای سریالی',
    'ابر مشاور',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(courseStructuredData)}
  />
  <article class="course-page">
    <header class="course-hero shell">
      <h1>ابر مشاور<span>ساخت ویدیو و استوری با هوش مصنوعی</span></h1>
      <p class="course-lead">
        ۱۵ درس ضبط‌شده و عملی برای ساخت محتوای پیج یا کسب‌وکار خودت.
      </p>
      <img
        class="course-hero-image"
        src="/assets/academy/abr-moshaver/hero-scene.webp"
        width="1280"
        height="550"
        alt="شخصیت مجازی دوره با گوشی، در کنار نمونه‌های تصویر و ویدیوی هوش مصنوعی"
        loading="eager"
        fetchpriority="high"
      />
      <div class="course-purchase-strip" id="course-purchase">
        <div class="course-strip-offer">
          <div class="course-offer-price">
            <del aria-label="قیمت اصلی: ۹ میلیون و ۹۸۰ هزار تومان">
              <span>۹٬۹۸۰٬۰۰۰</span>
              <small>تومان</small>
            </del>
            <span class="course-discount">۵۰٪ تخفیف</span>
            <strong>۴٬۹۸۰٬۰۰۰ <small>تومان</small></strong>
          </div>
          <a class="course-button" href={checkoutUrl}>{purchaseLabel}</a>
        </div>
        <dl class="course-metrics">
          <div><dt>۱۵ درس</dt><dd>ضبط‌شده</dd></div>
          <div><dt><bdi dir="ltr">۱:۴۰:۲۴</bdi></dt><dd>زمان آموزش</dd></div>
          <div><dt>دسترسی دائمی</dt><dd>به دوره و آپدیت‌های آینده</dd></div>
        </dl>
      </div>
      {
        !salesEnabled && (
          <p class="course-sale-notice" role="status">
            ثبت‌نام پس از تکمیل اتصال پرداخت و پخش خصوصی باز می‌شود. برای سؤال
            دربارهٔ دوره،{' '}
            <a href={supportUrl} target="_blank" rel="noopener noreferrer">
              به پشتیبانی پیام بده
            </a>
            .
          </p>
        )
      }
    </header>

    <section
      class="course-section shell course-outcomes"
      aria-labelledby="course-outcomes-title"
    >
      <details>
        <summary
          ><h2 id="course-outcomes-title">
            بعد از خرید چه آموزش‌هایی در انتظارته؟
          </h2></summary
        >
        <p class="course-outcomes-intro">
          عکس و ویدیو، شخصیت مجازی، سریال، انیمیشن و موزیک؛ چند نمونه از
          مهارت‌هایی که در ۱۵ درس عملی تمرین می‌کنی.
        </p>
        <div class="course-result-grid">
          {
            [...featuredResults, ...additionalResults].map((result) => (
              <article>
                <h3>{result.title}</h3>
                <p>{result.text}</p>
              </article>
            ))
          }
        </div>
      </details>
    </section>

    <section
      class="course-section course-examples shell"
      aria-labelledby="course-examples-title"
    >
      <header class="course-section-head">
        <h2 id="course-examples-title">
          نمونه‌هایی از چیزی که در دوره می‌بینی
        </h2><p>از روایت یک داستان تا ساخت شخصیت، انیمیشن و ویدیوی قبل‌وبعد.</p>
      </header>
      <div class="course-example-grid">
        <figure>
          <h3 class="course-example-title">آموزش ساخت سریال</h3>
          <img
            src="/assets/academy/abr-moshaver/example-fathers-house.webp"
            width="720"
            height="1280"
            loading="lazy"
            alt="نمونهٔ داستان خانهٔ پدری در دوره"
          /><figcaption>خانهٔ پدری؛ روایت چندقسمتی</figcaption>
        </figure>
        <figure>
          <h3 class="course-example-title">رشته استوری</h3>
          <img
            src="/assets/academy/abr-moshaver/example-character.webp"
            width="768"
            height="1376"
            loading="lazy"
            alt="آیدا در کافه؛ نمونهٔ رشته استوری دوره"
          /><figcaption>آیدا در کافه؛ نمونهٔ رشته استوری</figcaption>
        </figure>
        <figure>
          <h3 class="course-example-title">انیمیشن</h3>
          <img
            src="/assets/academy/abr-moshaver/example-animation.webp"
            width="941"
            height="1672"
            loading="lazy"
            alt="نمونهٔ انیمیشن ساخته‌شده با هوش مصنوعی"
          /><figcaption>ساخت انیمیشن با هوش مصنوعی</figcaption>
        </figure>
      </div>
      <div class="course-before-after">
        <figure>
          <img
            src="/assets/academy/abr-moshaver/balcony-before.webp"
            width="941"
            height="1672"
            loading="lazy"
            alt="بالکن پیش از تغییر در نمونهٔ آموزشی قبل‌وبعد"
          /><figcaption>قبل</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/academy/abr-moshaver/balcony-after.webp"
            width="941"
            height="1672"
            loading="lazy"
            alt="بالکن پس از تغییر در نمونهٔ آموزشی قبل‌وبعد"
          /><figcaption>بعد</figcaption>
        </figure>
      </div>
    </section>

    <section
      class="course-section shell course-fit"
      aria-labelledby="course-fit-title"
    >
      <h2 id="course-fit-title">این دوره برای تو مناسبه؟</h2>
      <p>
        برای ساخت محتوای پیج، محصول، خدمات یا برند شخصی خودت با مثال‌های عملی.
      </p>
      <p>
        برای نتیجه‌گرفتن باید تمرین کنی؛ آموزش، جای اجرای پروژه یا مشاورهٔ
        نامحدود نیست.
      </p>
      <p class="course-buying-flow">
        ورود با شمارهٔ موبایل ← پرداخت ← دسترسی آنلاین در همان حساب
      </p>
    </section>

    <section class="course-section shell" aria-labelledby="course-faq-title">
      <header class="course-section-head">
        <h2 id="course-faq-title">قبل از خرید</h2>
      </header>
      <div class="course-faq-list">
        {
          faqs.map((faq) => (
            <details>
              <>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </>
            </details>
          ))
        }
        <details>
          <summary>شرایط بازگشت وجه چطور است؟</summary><p>
            در صورت پرداخت تکراری یا عدم امکان ارائه دسترسی به دوره، مبلغ مربوط
            بازگردانده می‌شود. درخواست‌های انصراف و بازپرداخت از طریق پشتیبانی و
            مطابق مقررات قابل‌اعمال بررسی می‌شوند.
          </p>
        </details>
      </div>
    </section>

    <section
      id="purchase-terms"
      class="course-section shell course-terms"
      aria-labelledby="purchase-terms-title"
    >
      <details>
        <summary id="purchase-terms-title">شرایط کامل خرید و بازگشت وجه</summary
        >
        <ul>
          <li>
            نسخهٔ فعلی شامل ۱۵ درس با مجموع ۱ ساعت و ۴۰ دقیقه و ۲۴ ثانیه آموزش
            است.
          </li>
          <li>
            قیمت اصلی ۹٬۹۸۰٬۰۰۰ تومان و قیمت ویژهٔ فعلی ۴٬۹۸۰٬۰۰۰ تومان است.
            تخفیف به‌صورت خودکار اعمال می‌شود. مبلغ نهایی پیش از پرداخت در پنل
            نمایش داده می‌شود.
          </li>
          <li>
            دسترسی به دوره و آپدیت‌های آیندهٔ آن دائمی و از حساب شخصی خودت است؛
            ویدیوها آنلاین پخش می‌شوند و فایل‌های همراه مجاز از همان پنل دریافت
            می‌شوند.
          </li>
          <li>هزینه یا اعتبار ابزارهای بیرونی جداست.</li>
          <li>
            پشتیبانی برای پرداخت، ورود و دسترسی از تلگرام انجام می‌شود؛ زمان
            پاسخ‌گویی حداکثر ۲ روز کاری است.
          </li>
          <li>
            در صورت پرداخت تکراری یا عدم امکان ارائه دسترسی به دوره، مبلغ مربوط
            بازگردانده می‌شود. درخواست‌های انصراف و بازپرداخت از طریق پشتیبانی و
            مطابق مقررات قابل‌اعمال بررسی می‌شوند.
          </li>
          <li>
            مبلغ نهایی و نسخهٔ دقیق شرایط پیش از پرداخت نمایش داده می‌شود. شرایط
            پذیرفته‌شده هنگام خرید برای همان سفارش حفظ می‌شود؛ تغییرات بعدی،
            شرایط سفارش قبلی را جایگزین نمی‌کند.
          </li>
        </ul>
      </details>
    </section>

    <footer class="course-final shell">
      <h2>برای پیج و کارت محتوا بساز</h2>
      <p class="course-final-note">
        در صورت پرداخت تکراری یا عدم امکان ارائهٔ دسترسی، مبلغ مربوط بازگردانده
        می‌شود؛ انصراف طبق{' '}
        <a href="#purchase-terms">شرایط خرید و بازگشت وجه</a> بررسی می‌شود.
      </p>
      <a class="course-button" href={checkoutUrl}>{purchaseLabel}</a>
      <div class="course-final-links">
        <a href="#purchase-terms">شرایط خرید</a><a
          href={supportUrl}
          target="_blank"
          rel="noopener noreferrer">پشتیبانی تلگرام</a
        >
      </div>
    </footer>
    {
      salesEnabled && (
        <div class="course-mobile-dock">
          <>
            <div class="course-dock-price">
              <span>قیمت دوره با تخفیف</span>
              <strong>۴٬۹۸۰٬۰۰۰ تومان</strong>
            </div>
            <a class="course-button" href={checkoutUrl}>
              خرید دوره
            </a>
          </>
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .course-page {
    --course-ink: #101642;
    --course-blue: #064dff;
    --course-muted: #59668f;
    --course-pale: #f1f6ff;
    color: var(--course-ink);
    background: #fff;
    padding-bottom: 4rem;
  }
  .shell {
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
  }
  .course-hero {
    text-align: center;
    padding-top: 2rem;
  }
  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }
  .course-hero h1 {
    font-weight: 850;
    font-size: clamp(1.65rem, 3.15vw, 2.6rem);
    line-height: 1.6;
    margin: 0 auto 0.7rem;
    max-width: 56rem;
  }
  .course-hero h1 > span {
    display: block;
    color: var(--course-blue);
    font-size: clamp(1.1rem, 2.2vw, 1.7rem);
    line-height: 1.8;
    margin-top: 0.35rem;
  }
  .course-lead {
    font-size: clamp(1rem, 1.65vw, 1.25rem);
    font-weight: 600;
    color: var(--course-muted);
    line-height: 1.9;
    margin-bottom: 1.2rem;
  }
  .course-hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1280/550;
    object-fit: cover;
    border-radius: 1rem;
    background: var(--course-pale);
  }
  .course-purchase-strip {
    display: grid;
    grid-template-columns: minmax(18rem, 1fr) 2fr;
    gap: 1.6rem;
    padding: 1.6rem 1.8rem;
    margin-top: 1rem;
    background: var(--course-pale);
    border-radius: 1rem;
    align-items: center;
    scroll-margin-top: 7rem;
  }
  .course-strip-offer {
    display: grid;
    gap: 0.65rem;
  }
  .course-offer-price {
    display: grid;
    grid-template-columns: max-content max-content;
    justify-content: center;
    justify-items: center;
    align-items: center;
    gap: 0.3rem 0.7rem;
  }
  .course-offer-price del {
    color: var(--course-muted);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.7;
    text-decoration: none;
    white-space: nowrap;
  }
  .course-offer-price del > span {
    position: relative;
    display: inline-block;
  }
  .course-offer-price del > span::after {
    content: '';
    position: absolute;
    inset-inline: -0.15rem;
    top: 51%;
    height: 1.5px;
    background: #d32632;
    transform: rotate(-4deg);
    pointer-events: none;
  }
  .course-offer-price del small {
    font-size: 0.75rem;
    font-weight: 650;
  }
  .course-discount {
    padding: 0.2rem 0.6rem;
    border-radius: 0.5rem;
    background: #dce7ff;
    color: #003cc8;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.7;
  }
  .course-strip-offer strong {
    grid-column: 1 / -1;
    font-size: 1.85rem;
  }
  .course-strip-offer strong small {
    font-size: 0.95rem;
  }
  .course-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.6rem 1.6rem;
    border-radius: 0.7rem;
    background: var(--course-blue);
    color: white;
    font-weight: 750;
    text-decoration: none;
    line-height: 1.6;
    transition: background 0.15s;
  }
  .course-button:hover {
    background: #003cd0;
  }
  .course-button:focus-visible,
  summary:focus-visible {
    outline: 3px solid #94b7ff;
    outline-offset: 4px;
  }
  .course-metrics {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .course-metrics > div {
    padding: 0.8rem;
    border-inline-start: 1px solid #d8e3f7;
  }
  .course-metrics dt {
    font-size: 1.2rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .course-metrics dd {
    font-size: 0.8rem;
    color: var(--course-muted);
    margin: 0.4rem 0 0;
    line-height: 1.8;
  }
  .course-start-note {
