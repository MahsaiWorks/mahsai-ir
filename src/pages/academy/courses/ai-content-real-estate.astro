---
import { siteConfig } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const salesEnabled = import.meta.env.PUBLIC_ACADEMY_SALES_ENABLED === 'true';
const checkoutUrl = salesEnabled
  ? 'https://android-pay.mahsai.ir/account/academy#buy-ai-content-real-estate'
  : '#course-purchase';
const purchaseLabel = salesEnabled ? 'شروع یادگیری' : 'اطلاعات ثبت‌نام';
const supportUrl = 'https://t.me/Mahsaisupport';

const results = [
  {
    number: '۰۱',
    title: 'ساخت عکس و ویدیو با هوش مصنوعی',
    text: 'ایده‌ات را به تصویر و ویدیوی قابل استفاده تبدیل کنی.',
  },
  {
    number: '۰۲',
    title: 'شخصیت مجازی با چهرهٔ ثابت',
    text: 'شخصیتی بسازی که چهره‌اش در خروجی‌های مختلف ثابت‌تر بماند.',
  },
  {
    number: '۰۳',
    title: 'قبل‌وبعد و فرمت‌های محتوا',
    text: 'فرمت قبل‌وبعد و چند قالب کاربردی محتوا را از صفر بسازی.',
  },
  {
    number: '۰۴',
    title: 'استوری و رشته‌استوری',
    text: 'برای استوری‌ها یک مسیر پیوسته و قابل دنبال‌کردن طراحی کنی.',
  },
  {
    number: '۰۵',
    title: 'محتوای سریالی',
    text: 'یک ایده را به قسمت‌های مرتبط و قابل ادامه تبدیل کنی.',
  },
  {
    number: '۰۶',
    title: 'خروجی طبیعی‌تر و خطاهای رایج',
    text: 'خروجی را دقیق‌تر بررسی کنی و خطاهای رایج را زودتر تشخیص بدهی.',
  },
  {
    number: '۰۷',
    title: 'موزیک باکلام و بی‌کلام',
    text: 'برای محتوایت موسیقی باکلام یا بی‌کلام مناسب بسازی.',
  },
  {
    number: '۰۸',
    title: 'دستیار شخصی برای ایده‌پردازی و تولید محتوا',
    text: 'برای ایده‌پردازی و برنامه‌ریزی کار خودت، یک دستیار شخصی تنظیم کنی.',
  },
  {
    number: '۰۹',
    title: 'انتخاب ابزار و حل مشکلات رایج',
    text: 'ابزار مناسب هر کار را انتخاب کنی و از خطاهای معمول عبور کنی.',
  },
] as const;

const coursePath = [
  {
    step: 'شروع هوشمند',
    title: 'اول مسیر کارت رو روشن می‌کنی',
    text: 'با ابزارها آشنا می‌شی و می‌بینی چطور می‌تونی هوش مصنوعی رو از یه گفت‌وگوی معمولی به دستیار کارت نزدیک کنی.',
  },
  {
    step: 'ساختن',
    title: 'ایده‌ات رو به تصویر و ویدیو می‌رسونی',
    text: 'با نمونه‌های عملی جلو می‌ری تا فاصلهٔ بین «یه ایده دارم» و «یه خروجی قابل‌انتشار دارم» کمتر بشه.',
  },
  {
    step: 'ثبات',
    title: 'به محتوات هویت می‌دی',
    text: 'روی یکدست‌بودن چهره، فضا و حس خروجی کار می‌کنی تا قسمت‌های مختلف کنار هم هماهنگ‌تر دیده بشن.',
  },
  {
    step: 'تداوم',
    title: 'محتوای سریالی می‌چینی',
    text: 'الگوی یک فرمت موفق رو بررسی می‌کنی و می‌بینی چطور می‌شه از یک موضوع، مسیر چندقسمتی ساخت.',
  },
  {
    step: 'انتشار',
    title: 'خروجی رو برای پیجت جمع می‌کنی',
    text: 'سراغ فرمت‌های مختلف، روایت استوری، صدا و خطاهای رایج می‌ری تا تمرینت به محتوای آمادهٔ انتشار نزدیک‌تر بشه.',
  },
] as const;

const goodFit = [
  'برای کارت محتوا می‌سازی، ولی روند ثابتی نداری.',
  'می‌خوای برای شغل، محصول، خدمات یا برند شخصی خودت محتوا بسازی.',
  'می‌خوای عکس، ویدیو، استوری و محتوای سریالی را عملی یاد بگیری.',
  'دوست داری نتیجه رو با مثال عملی ببینی، نه اینکه فقط تعریف ابزارها رو بشنوی.',
] as const;

const notFit = [
  'دنبال یک دکمه‌ای هستی که بدون تمرین، همه‌چیز رو خودکار و بی‌نقص بسازه.',
  'فقط یه فهرست بلند از ابزارها می‌خوای و قصد نداری چیزی تولید کنی.',
  'انتظار داری محتوا به‌جای تو اجرا بشه یا مشاورهٔ نامحدود بگیری.',
] as const;

const buyingSteps = [
  {
    number: '۱',
    title: 'وارد پنل می‌شی',
    text: 'با شمارهٔ موبایل، حساب دوره‌ات رو می‌سازی یا وارد همون حساب قبلی می‌شی.',
  },
  {
    number: '۲',
    title: 'قیمت رو می‌بینی',
    text: 'تخفیف همین حالا اعمال شده؛ مبلغ نهایی رو می‌بینی و مستقیم به پرداخت می‌ری.',
  },
  {
    number: '۳',
    title: 'دوره داخل حسابت می‌آید',
    text: 'بعد از پرداخت موفق، محتوایی که خریدی داخل همون حساب برات فعال می‌شه و آنلاین می‌بینیش.',
  },
] as const;

const faqs = [
  {
    question: 'با گوشی هم می‌تونم شروع کنم؟',
    answer:
      'بله؛ با گوشی می‌تونی ویدیوهای دوره رو ببینی و تمرین‌های ساخت محتوا رو شروع کنی.',
  },
  {
    question: 'این دوره برای چه کسانی ساخته شده؟',
    answer:
      'برای هر کسی که می‌خواد با هوش مصنوعی برای شغل، خدمات، محصول، آموزش یا برند شخصی خودش عکس، ویدیو و استوری بسازه.',
  },
  {
    question: 'دقیقاً چند ویدیو و چقدر آموزش داخل دوره است؟',
    answer:
      'نسخهٔ فعلی ۱۵ ویدیو داره و زمان کلش ۱ ساعت و ۴۰ دقیقه و ۲۴ ثانیه است. آموزش‌ها فشرده‌ان و با توضیح‌های کش‌دار وقتت رو نمی‌گیرن.',
  },
  {
    question: 'بعد از خرید تا چه مدت دسترسی دارم؟',
    answer:
      'به دوره و آپدیت‌های آیندهٔ آن دسترسی دائمی داری و از داخل حساب خودت می‌بینیش.',
  },
  {
    question: 'ویدیوها رو می‌تونم دانلود کنم؟',
    answer:
      'نه؛ ویدیوها داخل پنل حسابت به‌صورت آنلاین دیده می‌شن و لینک دانلود عمومی ندارن.',
  },
  {
    question: 'پشتیبانی دوره دقیقاً برای چیه؟',
    answer:
      'پشتیبانی برای مشکل پرداخت، ورود و دسترسیه و پاسخ‌گویی حداکثر تا ۲ روز کاری انجام می‌شه. این پشتیبانی مشاورهٔ نامحدود تولید محتوا یا اجرای پروژه نیست.',
  },
  {
    question: 'برای قیمت ویژه به کد تخفیف نیاز دارم؟',
    answer:
      'نه؛ تخفیف به‌صورت خودکار اعمال می‌شود. مبلغ پرداخت این پیشنهاد ۴٬۹۸۰٬۰۰۰ تومان است و پیش از ورود به درگاه آن را می‌بینی.',
  },
  {
    question: 'هزینهٔ ابزارهای هوش مصنوعی داخل مبلغ دوره است؟',
    answer:
      'نه. مبلغ دوره برای خود آموزش و دسترسی به محتواییه که خریدی. بعضی ابزارهای بیرونی پلن یا اعتبار جدا دارن و قیمتشون هم ممکنه عوض بشه. داخل دوره دربارهٔ مسیر انتخاب و خرید ابزارها هم صحبت می‌کنیم، ولی هزینهٔ خود سرویس‌ها جداست.',
  },
] as const;

const courseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'دوره آموزشی ساخت ویدیو و استوری با هوش مصنوعی (ابر مشاور)',
  description:
    'آموزش عملی ساخت عکس، ویدیو، استوری و محتوای سریالی با هوش مصنوعی برای مشاغل و برندهای شخصی.',
  url: new URL(
    '/academy/courses/ai-content-real-estate/',
    Astro.site,
  ).toString(),
  provider: {
    '@type': 'Organization',
    name: siteConfig.brandName,
    url: Astro.site?.toString(),
  },
  inLanguage: 'fa-IR',
  isAccessibleForFree: false,
  timeRequired: 'PT1H40M24S',
};
---

<BaseLayout
  title={'دوره آموزشی ساخت ویدیو و استوری با هوش مصنوعی (ابر مشاور) | ' +
    siteConfig.brandName}
  description="با یک گوشی ساده، ساخت عکس، ویدیو، استوری و محتوای سریالی با هوش مصنوعی را برای شغل و برند شخصی خودت یاد بگیر."
  image="/assets/academy/abr-moshaver/hero-scene.webp"
  imageAlt="دورهٔ ابر مشاور؛ نمونه‌های ساخت سریال، رشته‌استوری، انیمیشن و قبل‌وبعد"
  imageWidth={1280}
  imageHeight={550}
  keywords={[
    'دوره هوش مصنوعی',
    'آموزش تولید محتوا',
    'محتوای سریالی',
    'ابر مشاور',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(courseStructuredData)}
  />
  <article class="course-page">
    <header class="course-hero shell">
      <h1>
        دوره آموزشی ساخت ویدیو و استوری<br class="desktop-break" /> با هوش مصنوعی
        (ابر مشاور)
      </h1>
      <p class="course-lead">
        با یه گوشی ساده، برای پیج و کار خودت محتوا بساز و ازش درآمدزایی کن.
      </p>
      <img
        class="course-hero-image"
        src="/assets/academy/abr-moshaver/hero-scene.webp"
        width="1280"
        height="550"
        alt="شخصیت مجازی دوره با گوشی، در کنار نمونه‌های تصویر و ویدیوی هوش مصنوعی"
        loading="eager"
        fetchpriority="high"
      />
      <div class="course-purchase-strip" id="course-purchase">
        <div class="course-strip-offer">
          <div class="course-offer-price">
            <del aria-label="قیمت اصلی: ۹ میلیون و ۹۸۰ هزار تومان">
              <span>۹٬۹۸۰٬۰۰۰</span>
              <small>تومان</small>
            </del>
            <span class="course-discount">۵۰٪ تخفیف</span>
            <strong>فقط ۴٬۹۸۰٬۰۰۰ <small>تومان</small></strong>
          </div>
          <a class="course-button" href={checkoutUrl}>{purchaseLabel}</a>
          <span>فقط به مدت محدود؛ تخفیف خودکار و بدون نیاز به کد.</span>
        </div>
        <dl class="course-metrics">
          <div><dt>۱۵ درس</dt><dd>ویدیوی آموزشی</dd></div>
          <div><dt>۱:۴۰:۲۴</dt><dd>زمان کل آموزش</dd></div>
          <div><dt>دسترسی دائمی</dt><dd>به دوره و آپدیت‌های آینده</dd></div>
        </dl>
      </div>
      {
        !salesEnabled && (
          <p class="course-sale-notice" role="status">
            ثبت‌نام پس از تکمیل اتصال پرداخت و پخش خصوصی باز می‌شود. برای سؤال
            دربارهٔ دوره،{' '}
            <a href={supportUrl} target="_blank" rel="noopener noreferrer">
              به پشتیبانی پیام بده
            </a>
            .
          </p>
        )
      }
      <p class="course-start-note">همین حالا شروع کن</p>
    </header>

    <section
      class="course-section shell"
      aria-labelledby="course-outcomes-title"
    >
      <header class="course-section-head">
        <h2 id="course-outcomes-title">چی یاد می‌گیری؟</h2><p>
          ساخت محتوا برای شغل، خدمات، محصول یا برند شخصی خودت؛ با مثال‌های عملی.
        </p>
      </header>
      <div class="course-result-grid">
        {
          results.map((result) => (
            <article>
              <>
                <h3>{result.title}</h3>
                <p>{result.text}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="course-section course-examples shell"
      aria-labelledby="course-examples-title"
    >
      <header class="course-section-head">
        <h2 id="course-examples-title">
          نمونه‌هایی از چیزی که در دوره می‌بینی
        </h2><p>از روایت یک داستان تا ساخت شخصیت، انیمیشن و ویدیوی قبل‌وبعد.</p>
      </header>
      <div class="course-example-grid">
        <figure>
          <h3 class="course-example-title">آموزش ساخت سریال</h3>
          <img
            src="/assets/academy/abr-moshaver/example-fathers-house.webp"
            width="720"
            height="1280"
            loading="lazy"
            alt="نمونهٔ داستان خانهٔ پدری در دوره"
          /><figcaption>خانهٔ پدری؛ روایت چندقسمتی</figcaption>
        </figure>
        <figure>
          <h3 class="course-example-title">رشته استوری</h3>
          <img
            src="/assets/academy/abr-moshaver/example-character.webp"
            width="768"
            height="1376"
            loading="lazy"
            alt="آیدا در کافه؛ نمونهٔ رشته استوری دوره"
          /><figcaption>آیدا در کافه؛ نمونهٔ رشته استوری</figcaption>
        </figure>
        <figure>
          <h3 class="course-example-title">انیمیشن</h3>
          <img
            src="/assets/academy/abr-moshaver/example-animation.webp"
            width="941"
            height="1672"
            loading="lazy"
            alt="نمونهٔ انیمیشن ساخته‌شده با هوش مصنوعی"
          /><figcaption>ساخت انیمیشن با هوش مصنوعی</figcaption>
        </figure>
      </div>
      <div class="course-before-after">
        <figure>
          <img
            src="/assets/academy/abr-moshaver/balcony-before.webp"
            width="941"
            height="1672"
            loading="lazy"
            alt="بالکن پیش از تغییر در نمونهٔ آموزشی قبل‌وبعد"
          /><figcaption>قبل</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/academy/abr-moshaver/balcony-after.webp"
            width="941"
            height="1672"
            loading="lazy"
            alt="بالکن پس از تغییر در نمونهٔ آموزشی قبل‌وبعد"
          /><figcaption>بعد</figcaption>
        </figure>
      </div>
    </section>

    <section
      id="course-path"
      class="course-section course-path"
      aria-labelledby="course-path-title"
    >
      <div class="shell">
        <header class="course-section-head">
          <h2 id="course-path-title">مسیر آموزش، از ایده تا محتوا</h2><p>
            این پنج مرحله، خلاصهٔ مسیر ۱۵ درس دوره است.
          </p>
        </header>
        <ol class="course-path-list">
          {
            coursePath.map((item, index) => (
              <li>
                <>
                  <span class="course-path-number">
                    {(index + 1).toLocaleString('fa-IR')}
                  </span>
                  <div>
                    <>
                      <p>{item.step}</p>
                      <h3>{item.title}</h3>
                      <span>{item.text}</span>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="course-section shell" aria-labelledby="course-fit-title">
      <header class="course-section-head">
        <h2 id="course-fit-title">این دوره برای تو مناسبه؟</h2>
      </header>
      <div class="course-fit-grid">
        <article>
          <h3>به دردت می‌خورد اگر…</h3><ul>
            {goodFit.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h3>به دردت نمی‌خوره اگه…</h3><ul>
            {notFit.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <section class="course-section shell" aria-labelledby="course-buying-title">
      <header class="course-section-head">
        <h2 id="course-buying-title">خرید و دسترسی به دوره</h2><p>
          حسابی که با آن خرید می‌کنی، محل دیدن درس‌ها و دریافت فایل‌های همراه
          است.
        </p>
      </header>
      <ol class="course-buying-steps">
        {
          buyingSteps.map((step) => (
            <li>
              <>
                <span>{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="course-section shell" aria-labelledby="course-faq-title">
      <header class="course-section-head">
        <h2 id="course-faq-title">قبل از خرید</h2>
      </header>
      <div class="course-faq-list">
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </>
            </details>
          ))
        }
        <details>
          <summary>شرایط بازگشت وجه چطور است؟</summary><p>
            در صورت پرداخت تکراری یا عدم امکان ارائه دسترسی به دوره، مبلغ مربوط
            بازگردانده می‌شود. درخواست‌های انصراف و بازپرداخت از طریق پشتیبانی و
            مطابق مقررات قابل‌اعمال بررسی می‌شوند.
          </p>
        </details>
      </div>
    </section>

    <section
      id="purchase-terms"
      class="course-section shell course-terms"
      aria-labelledby="purchase-terms-title"
    >
      <header class="course-section-head">
        <h2 id="purchase-terms-title">شرایط خرید این دوره</h2>
      </header>
      <ul>
        <li>
          نسخهٔ فعلی شامل ۱۵ درس با مجموع ۱ ساعت و ۴۰ دقیقه و ۲۴ ثانیه آموزش
          است.
        </li>
        <li>
          قیمت اصلی ۹٬۹۸۰٬۰۰۰ تومان و قیمت ویژهٔ فعلی ۴٬۹۸۰٬۰۰۰ تومان است. تخفیف
          به‌صورت خودکار اعمال می‌شود. مبلغ نهایی پیش از پرداخت در پنل نمایش
          داده می‌شود.
        </li>
        <li>
          دسترسی به دوره و آپدیت‌های آیندهٔ آن دائمی و از حساب شخصی خودت است؛
          ویدیوها آنلاین پخش می‌شوند و فایل‌های همراه مجاز از همان پنل دریافت
          می‌شوند.
        </li>
        <li>هزینه یا اعتبار ابزارهای بیرونی جداست.</li>
        <li>
          پشتیبانی برای پرداخت، ورود و دسترسی از تلگرام انجام می‌شود؛ زمان
          پاسخ‌گویی حداکثر ۲ روز کاری است.
        </li>
        <li>
          در صورت پرداخت تکراری یا عدم امکان ارائه دسترسی به دوره، مبلغ مربوط
          بازگردانده می‌شود. درخواست‌های انصراف و بازپرداخت از طریق پشتیبانی و
          مطابق مقررات قابل‌اعمال بررسی می‌شوند.
        </li>
        <li>
          مبلغ نهایی و نسخهٔ دقیق شرایط پیش از پرداخت نمایش داده می‌شود. شرایط
          پذیرفته‌شده هنگام خرید برای همان سفارش حفظ می‌شود؛ تغییرات بعدی، شرایط
          سفارش قبلی را جایگزین نمی‌کند.
        </li>
      </ul>
    </section>

    <footer class="course-final shell">
      <h2>روی آیندهٔ شغلیت سرمایه‌گذاری کن</h2>
      <p>از یادگرفتن تا ساختن محتوای خودت؛ با ۱۵ درس عملی و دسترسی دائمی.</p>
      <a class="course-button" href={checkoutUrl}>{purchaseLabel}</a>
      <div class="course-final-links">
        <a href="#purchase-terms">شرایط خرید</a><a
          href={supportUrl}
          target="_blank"
          rel="noopener noreferrer">پشتیبانی تلگرام</a
        >
      </div>
    </footer>
    {
      salesEnabled && (
        <div class="course-mobile-dock">
          <>
            <div class="course-dock-price">
              <span>قیمت ویژه، فقط به مدت محدود</span>
              <strong>۴٬۹۸۰٬۰۰۰ تومان</strong>
            </div>
            <a class="course-button" href={checkoutUrl}>
              شروع یادگیری
            </a>
          </>
        </div>
      )
    }
  </article>
</BaseLayout>

