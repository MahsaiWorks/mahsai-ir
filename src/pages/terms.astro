---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';
const metrazhApp = (await getCollection('apps')).find(
  (app) => app.id === 'metrazh',
);
if (!metrazhApp) throw new Error('Published Metrazh content is missing.');
const bazaarLink = getCafeBazaarLink(metrazhApp.data.storeLinks);
const highlights = [
  { label: 'مبلغ روشن', text: 'قیمت و مدت، پیش از پرداخت' },
  { label: 'فعال‌سازی اشتراک', text: 'پس از تأیید پرداخت' },
  { label: 'بازیابی خرید', text: 'با همان شمارهٔ همراه' },
];
---

<BaseLayout
  title="شرایط خرید و استفاده از متراژ | MAHSAI"
  description="شرایط خرید مستقیم اشتراک متراژ؛ پرداخت، فعال‌سازی، بازیابی، بازپرداخت و راه ارتباط با پشتیبانی."
>
  <header slot="header" class="terms-header">
    <div class="terms-header-inner">
      <a href="/apps/metrazh/" class="terms-brand" aria-label="صفحهٔ متراژ"
        ><img
          src="/images/apps/metrazh/icon-app-official.webp"
          width="44"
          height="44"
          alt="نشان متراژ"
        /><span><strong>متراژ</strong><small>دستیار مشاوران املاک</small></span
        ></a
      >
      <a class="terms-help" href="/support/"
        >پشتیبانی خرید <span aria-hidden="true">↗</span></a
      >
    </div>
  </header>
  <div class="terms-page">
    <div class="terms-shell">
      <section
        id="direct-purchase"
        class="terms-intro"
        aria-labelledby="terms-title"
      >
        <div class="terms-eyebrow">
          <span aria-hidden="true"></span>پیش از پرداخت
        </div>
        <h1 id="terms-title">شرایط خرید اشتراک</h1>
        <p>آنچه دربارهٔ پرداخت، فعال‌سازی و پشتیبانی خرید باید بدانید.</p>
        <div class="terms-date">
          آخرین به‌روزرسانی <time datetime="2026-09-09">۱۸ شهریور ۱۴۰۵</time>
        </div>
      </section>
      <div class="terms-layout">
        <aside class="terms-overview" aria-label="خلاصهٔ مسیر خرید">
          <div class="terms-summary-card">
            <div class="terms-card-heading">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
                ><path
                  d="M12 3 4.5 6v5c0 4.6 3.3 8 7.5 10 4.2-2 7.5-5.4 7.5-10V6L12 3Z"
                ></path><path d="m8.5 12 2.3 2.3 4.7-5"></path></svg
              ><h2>خرید اشتراک، در یک نگاه</h2>
            </div>
            <ul class="terms-highlights">
              {
                highlights.map((item, index) => (
                  <li>
                    <>
                      <span class="terms-step" aria-hidden="true">
                        {['۱', '۲', '۳'][index]}
                      </span>
                      <span>
                        <>
                          <strong>{item.label}</strong>
                          <small>{item.text}</small>
                        </>
                      </span>
                    </>
                  </li>
                ))
              }
            </ul>
            <a class="terms-primary" href="metrazh://payment-return"
              >بازگشت به برنامه <span aria-hidden="true">←</span></a
            >
            <p class="terms-return-note">
              انتخاب پلن و پرداخت را در برنامه ادامه دهید.
            </p>
          </div>
          <div class="terms-contact-card">
            <span class="terms-contact-icon" aria-hidden="true"
              ><svg
                viewBox="0 0 24 24"
                width="21"
                height="21"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                ><path
                  d="M5 13v-2a7 7 0 0 1 14 0v2M5 12H3v6h4v-6H5Zm14 0h2v6h-4v-6h2Zm0 6c0 3-3 3-6 3"
                ></path></svg
              ></span
            >
            <h2>برای پیگیری خرید کنارتان هستیم</h2><p>
              اگر دربارهٔ پرداخت یا اشتراک سؤالی دارید، از پشتیبانی راهنمایی
              بگیرید.
            </p><a href="/support/"
              >ارتباط با پشتیبانی <span aria-hidden="true">↗</span></a
            >
          </div>
        </aside>
        <section
          class="terms-sections"
          aria-label="متن کامل شرایط خرید و استفاده"
        >
          <p class="terms-reading-note">
            برای خواندن جزئیات، هر بخش را باز کنید.
          </p>
          <details class="terms-section" open>
            <summary
              ><span class="terms-section-number" aria-hidden="true">۰۱</span
              ><span
                ><strong>مبلغ و نحوهٔ پرداخت</strong><small
                  >قیمت پلن و درگاه بانکی</small
                ></span
              ><span class="terms-chevron" aria-hidden="true"></span></summary
            >
            <div class="terms-detail">
              <p>
                قیمت و مدت هر پلن پیش از پرداخت نمایش داده می‌شود. مبالغ برنامه
                تومان است؛ مبلغ درگاه بانکی ممکن است به ریال نمایش داده شود و هر
                تومان برابر ۱۰ ریال است. خرید مستقیم از طریق زیبال انجام می‌شود
                و تمدید خودکار ندارد.
              </p>
            </div>
          </details>
          <details class="terms-section">
            <summary
              ><span class="terms-section-number" aria-hidden="true">۰۲</span
              ><span
                ><strong>فعال‌سازی و بازیابی</strong><small
                  >تمدید، ارتقا و استفاده در گوشی دیگر</small
                ></span
              ><span class="terms-chevron" aria-hidden="true"></span></summary
            >
            <div class="terms-detail">
              <p>
                اشتراک با تأیید پرداخت توسط سرور و با درخواست شما فعال می‌شود.
                خرید مستقیم به حساب تأییدشده با شمارهٔ همراه متصل است و با همان
                حساب روی گوشی اندرویدی دیگر قابل بازیابی است. بازیابی اشتراک،
                فایل‌های ملکی و اطلاعات مشتریان را از گوشی قبلی منتقل نمی‌کند؛
                انتقال آن‌ها از مسیر پشتیبان‌گیری و بازیابی داخل برنامه انجام
                می‌شود. روزهای باقی‌ماندهٔ اشتراک مستقیم در تمدید یا ارتقای آن
                حفظ می‌شود. خریدهای قبلی بازار از مسیر بازیابی و مدیریت همان
                فروشگاه پیگیری می‌شوند.
              </p>
            </div>
          </details>
          <details class="terms-section">
            <summary
              ><span class="terms-section-number" aria-hidden="true">۰۳</span
              ><span
                ><strong>پرداخت ناموفق یا تکراری</strong><small
                  >پیگیری و بازگرداندن وجه</small
                ></span
              ><span class="terms-chevron" aria-hidden="true"></span></summary
            >
            <div class="terms-detail">
              <p>
                اگر مبلغ کسر شده اما نتیجه مشخص نیست، دوباره خرید نکنید؛ ابتدا
                نتیجهٔ همان پرداخت را در برنامه پیگیری کنید. برای پرداخت تکراری
                یا پرداخت تأییدشده بدون ارائهٔ اشتراک، شناسهٔ تراکنش را به
                پشتیبانی بفرستید. پس از بررسی، وجه اضافی بازگردانده می‌شود؛ اگر
                ارائهٔ اشتراک خریداری‌شده ممکن نباشد، وجه همان خرید مسترد خواهد
                شد.
              </p>
            </div>
          </details>
          <details class="terms-section">
            <summary
              ><span class="terms-section-number" aria-hidden="true">۰۴</span
              ><span
                ><strong>انصراف و شروع فوری</strong><small
                  >حقوق خریدار و درخواست شروع خدمت</small
                ></span
              ><span class="terms-chevron" aria-hidden="true"></span></summary
            >
            <div class="terms-detail">
              <p>
                حق انصراف قانونی در موارد مشمول برقرار است. برای خدماتی که هنوز
                ارائه نشده، مهلت قانونی حداقل هفت روز کاری با رعایت شرایط آغاز
                مهلت است. اگر با درخواست و توافق شما ارائهٔ خدمت پیش از پایان
                این مهلت آغاز شود، موضوع تابع استثنای خدمات در آیین‌نامهٔ مواد
                ۳۸ و ۴۲ قانون تجارت الکترونیکی است. این بند حق پیگیری عدم ارائهٔ
                خدمت یا دریافت وجه اضافی را حذف نمی‌کند. ضمانت بازپرداخت
                بی‌قیدوشرط صرفاً به علت تغییر نظر پس از استفاده، به‌صورت تعهد
                اضافی ارائه نمی‌شود.
              </p>
              <p>
                پیش از پرداخت، لینک شرایط و این توضیح کنار دکمه نمایش داده
                می‌شود: «با پرداخت، شرایط خرید و شروع فوری را می‌پذیرم.» با زدن
                دکمهٔ پرداخت، این پذیرش و نسخهٔ شرایط همراه سفارش ثبت می‌شود؛
                اشتراک پس از تأیید پرداخت فعال خواهد شد.
              </p>
            </div>
          </details>
          <details class="terms-section">
            <summary
              ><span class="terms-section-number" aria-hidden="true">۰۵</span
              ><span
                ><strong>حساب و حریم خصوصی</strong><small
                  >اطلاعات موردنیاز برای پیگیری خرید</small
                ></span
              ><span class="terms-chevron" aria-hidden="true"></span></summary
            >
            <div class="terms-detail">
              <p>
                حداقل اطلاعات حساب و رسید، مانند شناسهٔ سفارش، مبلغ، زمان، وضعیت
                و شناسهٔ تراکنش، برای پیگیری، بازیابی و تکالیف قانونی نگهداری
                می‌شود. مدت نگهداری تابع همین نیازها و تکالیف است. اطلاعات کارت
                بانکی در متراژ ذخیره نمی‌شود.
                <a href="/privacy/#direct-account"
                  >جزئیات حریم خصوصی حساب و خرید</a
                >
                را نیز بخوانید.
              </p>
              <p>
                شناسهٔ این شرایط: <span dir="ltr"
                  >metrazh-android-sale-2026-09-08-v1</span
                >
              </p>
            </div>
          </details>
          <details class="terms-section">
            <summary
              ><span class="terms-section-number" aria-hidden="true">۰۶</span
              ><span
                ><strong>شرایط استفاده از متراژ</strong><small
                  >داده‌ها، خروجی‌ها و نسخه‌های رسمی</small
                ></span
              ><span class="terms-chevron" aria-hidden="true"></span></summary
            >
            <div class="terms-detail">
              <h3>استفاده مسئولانه</h3>
              <p>
                کاربر مسئول صحت اطلاعاتی است که در برنامه ثبت، ویرایش یا
                اشتراک‌گذاری می‌کند. پیش از ثبت یا انتشار اطلاعات مالک، مشتری،
                تصویر، مدرک یا نشانی، باید مجوزهای لازم دریافت شود.
              </p>

              <h3>محاسبات، قراردادها و خروجی‌ها</h3>
              <p>
                محاسبات مالی، کمیسیون، رهن و اجاره، قراردادها، گزارش‌ها و
                فایل‌های PDF ابزار کمکی هستند و تضمین حقوقی، مالی یا کارشناسی
                محسوب نمی‌شوند. پیش از تصمیم‌گیری یا امضای سند، نتیجه باید توسط
                فرد واجد صلاحیت بررسی شود.
              </p>

              <h3>نگهداری اطلاعات</h3>
              <p>
                داده‌های اصلی متراژ روی دستگاه کاربر نگهداری می‌شوند. حفاظت از
                دستگاه، انتخاب رمز امن، تهیه پشتیبان رمزگذاری‌شده و نگهداری
                جداگانه رمز و فایل پشتیبان بر عهده کاربر است.
              </p>

              <h3>سرویس‌های شخص ثالث</h3>
              <p>
                نقشه، پرداخت، موقعیت، تشخیص گفتار، اشتراک‌گذاری و مسیریابی ممکن
                است از سرویس‌ها یا برنامه‌های شخص ثالث استفاده کنند. ادامه
                استفاده از آن سرویس‌ها تابع شرایط و سیاست‌های همان ارائه‌دهنده
                است.
              </p>

              <h3>مالکیت محتوا</h3>
              <p>
                نام مهسای (MAHSAI)، نام و نشان متراژ، طراحی‌ها و محتوای اختصاصی
                این وب‌سایت متعلق به مالک مربوط هستند. استفاده مجدد تجاری یا
                انتساب نادرست آن‌ها بدون اجازه مجاز نیست.
              </p>

              <h3>تماس</h3>
              <p>
                برای پرسش درباره این شرایط با
                <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
                  >{siteConfig.supportEmail}</a
                >
                تماس بگیرید.
              </p>

              <h3>وضعیت محصول</h3>
              <p>
                نسخهٔ عمومی متراژ از مسیرهای رسمی زیر در دسترس است. قابلیت‌ها،
                ظاهر برنامه، شیوهٔ ارائه و شرایط اشتراک ممکن است در
                به‌روزرسانی‌های بعدی تغییر کنند.
              </p>
              <ul>
                <li>
                  <a href="/apps/metrazh/download/"
                    >دانلود مستقیم متراژ از سایت رسمی</a
                  >
                </li>
                {
                  bazaarLink && (
                    <li>
                      <a
                        href={getTrackedCafeBazaarUrl(
                          bazaarLink.url,
                          'terms_store',
                        )}
                        target="_blank"
                        rel="noopener"
                      >
                        صفحهٔ متراژ در کافه‌بازار
                      </a>
                    </li>
                  )
                }
              </ul>
            </div>
          </details><div class="terms-endnote">
            <span aria-hidden="true">✓</span><p>
              پذیرش شرایط در صفحهٔ خرید برنامه انجام می‌شود. مطالعهٔ این صفحه،
              به‌تنهایی خریدی ثبت نمی‌کند.
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>
  <footer slot="footer" class="terms-footer">
    <div>
      <p>متراژ، محصول <a href="/">مهسای</a></p><a
        href={`mailto:${siteConfig.supportEmail}`}
        dir="ltr">{siteConfig.supportEmail}</a
      >
    </div>
  </footer>
</BaseLayout>

<style>
  @font-face {
    font-family: 'Metrazh Terms';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/vazirmatn-arabic-wght-normal.woff2') format('woff2');
  }
  .terms-header,
  .terms-page,
  .terms-footer {
    font-family: 'Metrazh Terms', 'Vazirmatn Variable', Tahoma, sans-serif;
    color: #14263e;
    font-weight: 400;
    letter-spacing: 0;
  }
  .terms-header {
    background: #fff;
    border-bottom: 1px solid #e5eaf1;
  }
  .terms-header-inner {
    max-width: 1080px;
    margin: auto;
    padding: 16px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .terms-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #12263f;
  }
  .terms-brand img {
    border-radius: 12px;
    width: 44px;
    height: 44px;
  }
  .terms-brand strong,
  .terms-brand small {
    display: block;
  }
  .terms-brand strong {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.5;
  }
  .terms-brand small {
    font-size: 11px;
    color: #526271;
    line-height: 1.8;
  }
  .terms-help {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #536379;
    font-size: 12px;
    text-decoration: none;
    padding: 9px 12px;
    border: 1px solid #e3e9f0;
    border-radius: 12px;
    min-height: 42px;
  }
  .terms-help:hover {
    background: #f3f6fa;
    color: #14263e;
  }
  .terms-page {
    background: #f5f7fb;
    padding: 36px 0 52px;
    min-height: 80vh;
  }
  .terms-shell {
    max-width: 1080px;
    margin: auto;
    padding: 0 28px;
  }
  .terms-intro {
    margin-bottom: 28px;
    scroll-margin-top: 24px;
  }
  .terms-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
    color: #0f766e;
  }
  .terms-eyebrow > span {
    width: 6px;
    height: 6px;
    background: #0f766e;
    border-radius: 50%;
  }
  .terms-intro h1 {
    font-family: inherit;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    line-height: 1.6;
    letter-spacing: 0;
    margin: 8px 0;
    color: #112641;
  }
  .terms-intro > p {
    font-size: 14px;
    line-height: 1.9;
    color: #586a80;
    margin: 0;
  }
  .terms-date {
    margin-top: 16px;
    display: flex;
    gap: 8px;
    font-size: 11px;
    color: #6b788a;
  }
  .terms-date time {
    font-weight: 600;
  }
  .terms-layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .terms-overview {
    display: grid;
    gap: 16px;
  }
  .terms-summary-card {
    background: #fff;
    border: 1px solid #e1e7ef;
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 4px 18px #12263f04;
  }
  .terms-card-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #0f766e;
  }
  .terms-card-heading h2 {
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.8;
    margin: 0;
    letter-spacing: 0;
    color: #172c46;
  }
  .terms-highlights {
    list-style: none;
    padding: 0;
    margin: 18px 0 22px;
  }
  .terms-highlights li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 0;
  }
  .terms-highlights li + li {
    border-top: 1px solid #edf0f5;
  }
  .terms-step {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border: 1px solid #dfebe9;
    color: #0f766e;
    background: #f0f8f6;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
  }
  .terms-highlights strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.7;
  }
  .terms-highlights small {
    display: block;
    font-size: 11px;
    color: #617187;
    line-height: 1.8;
  }
  .terms-primary {
    min-height: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    border-radius: 16px;
    padding: 10px 16px;
    color: #fff;
    background: #112641;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .terms-primary:hover {
    background: #1b3959;
  }
  .terms-return-note {
    color: #69788a;
    text-align: center;
    font-size: 10px;
