---
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`شرایط استفاده | ${siteConfig.brandName}`}
  description="شرایط استفاده از وب‌سایت MAHSAI و نسخه پیش‌انتشار اپلیکیشن متراژ."
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">شرایط استفاده</p>
      <h1>استفاده از MAHSAI و متراژ</h1>
      <p class="page-lead">
        با استفاده از این وب‌سایت یا اپلیکیشن متراژ، مسئولیت استفاده آگاهانه از
        اطلاعات، ابزارها و خروجی‌های برنامه را می‌پذیرید.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell content-layout">
      <article class="prose">
        <h2>وضعیت محصول</h2>
        <p>
          متراژ در حال توسعه و پیش‌انتشار است. قابلیت‌ها، ظاهر برنامه، شیوه
          ارائه و شرایط اشتراک ممکن است پیش از انتشار عمومی تغییر کنند. در حال
          حاضر هیچ لینک عمومی تأییدشده‌ای برای دانلود اعلام نشده است.
        </p>

        <h2>استفاده مسئولانه</h2>
        <p>
          کاربر مسئول صحت اطلاعاتی است که در برنامه ثبت، ویرایش یا اشتراک‌گذاری
          می‌کند. پیش از ثبت یا انتشار اطلاعات مالک، مشتری، تصویر، مدرک یا
          نشانی، باید مجوزهای لازم دریافت شود.
        </p>

        <h2>محاسبات، قراردادها و خروجی‌ها</h2>
        <p>
          محاسبات مالی، کمیسیون، رهن و اجاره، قراردادها، گزارش‌ها و فایل‌های PDF
          ابزار کمکی هستند و تضمین حقوقی، مالی یا کارشناسی محسوب نمی‌شوند. پیش
          از تصمیم‌گیری یا امضای سند، نتیجه باید توسط فرد واجد صلاحیت بررسی شود.
        </p>

        <h2>نگهداری اطلاعات</h2>
        <p>
          داده‌های اصلی متراژ روی دستگاه کاربر نگهداری می‌شوند. حفاظت از دستگاه،
          انتخاب رمز امن، تهیه پشتیبان رمزگذاری‌شده و نگهداری جداگانه رمز و فایل
          پشتیبان بر عهده کاربر است.
        </p>

        <h2>سرویس‌های شخص ثالث</h2>
        <p>
          نقشه، پرداخت، موقعیت، تشخیص گفتار، اشتراک‌گذاری و مسیریابی ممکن است از
          سرویس‌ها یا برنامه‌های شخص ثالث استفاده کنند. ادامه استفاده از آن
          سرویس‌ها تابع شرایط و سیاست‌های همان ارائه‌دهنده است.
        </p>

        <h2>مالکیت محتوا</h2>
        <p>
          نام MAHSAI، نام و نشان متراژ، طراحی‌ها و محتوای اختصاصی این وب‌سایت
          متعلق به مالک مربوط هستند. استفاده مجدد تجاری یا انتساب نادرست آن‌ها
          بدون اجازه مجاز نیست.
        </p>

        <h2>تماس</h2>
        <p>
          برای پرسش درباره این شرایط با
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
            >{siteConfig.supportEmail}</a
          >
          تماس بگیرید.
        </p>
      </article>
      <aside class="content-aside">
        <p>آخرین به‌روزرسانی: ۱۴۰۵/۰۵/۱۰</p>
      </aside>
    </div>
  </section>
</BaseLayout>
