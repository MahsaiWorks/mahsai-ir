---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import PageStage from '../components/PageStage.astro';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const metrazhApp = (await getCollection('apps')).find(
  (app) => app.id === 'metrazh',
);

if (!metrazhApp) {
  throw new Error('Metrazh content entry is missing.');
}

const bazaarLink = getCafeBazaarLink(metrazhApp.data.storeLinks);
---

<BaseLayout
  title={`شرایط استفاده | ${siteConfig.brandName}`}
  description={`شرایط استفاده از وب‌سایت مهسای و نسخه عمومی ${metrazhApp.data.version} اپلیکیشن متراژ.`}
>
  <PageStage
    eyebrow="شرایط استفاده"
    title="چارچوب روشن برای استفاده"
    highlight="آگاهانه."
    lead="با استفاده از این وب‌سایت یا اپلیکیشن متراژ، مسئولیت بررسی اطلاعات، حفاظت از داده‌ها و ارزیابی خروجی‌های کمکی برنامه را می‌پذیرید."
    note="محاسبات، گزارش‌ها و خروجی‌های برنامه ابزار کمکی‌اند و جای بررسی حقوقی، مالی یا کارشناسی را نمی‌گیرند."
    signals={['نسخه عمومی رسمی', 'مسئولیت صحت داده‌ها', 'استفاده مسئولانه']}
    tone="apricot"
  />

  <section class="page-section legal-section">
    <div class="shell legal-layout">
      <aside class="legal-aside">
        <span>آخرین به‌روزرسانی</span>
        <strong>۱۴۰۵/۰۶/۱۷</strong>
        <p>پرسش درباره این شرایط را از مسیر رسمی پشتیبانی بفرستید.</p>
        <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
          >{siteConfig.supportEmail}</a
        >
      </aside>
      <article class="prose legal-prose">
        <h2>وضعیت محصول</h2>
        <p>
          نسخه عمومی {metrazhApp.data.version} متراژ منتشر شده است. قابلیت‌ها، ظاهر
          برنامه، شیوه ارائه و شرایط اشتراک ممکن است در به‌روزرسانی‌های بعدی تغییر
          کنند. مسیرهای دریافت نسخهٔ رسمی در <a href="/apps/metrazh/download/"
            >صفحهٔ دانلود متراژ</a
          >
          معرفی می‌شوند؛ از جمله
          {
            bazaarLink ? (
              <a
                href={getTrackedCafeBazaarUrl(bazaarLink.url, 'terms_store')}
                target="_blank"
                rel="noopener"
              >
                صفحه متراژ در کافه‌بازار
              </a>
            ) : (
              'مسیر رسمی اعلام‌شده در سایت'
            )
          }
          .
        </p>

        <h2 id="direct-purchase">شرایط خرید مستقیم اشتراک اندروید</h2>
        <p>
          قیمت و مدت هر پلن پیش از پرداخت نمایش داده می‌شود. مبالغ برنامه تومان
          است؛ مبلغ درگاه بانکی ممکن است به ریال نمایش داده شود و هر تومان برابر
          ۱۰ ریال است. خرید مستقیم از طریق زیبال انجام می‌شود و تمدید خودکار
          ندارد.
        </p>
        <p>
          اشتراک با تأیید پرداخت توسط سرور و با درخواست شما فعال می‌شود. خرید
          مستقیم به حساب تأییدشده با شمارهٔ همراه متصل است و با همان حساب روی
          گوشی اندرویدی دیگر قابل بازیابی است. بازیابی اشتراک، فایل‌های ملکی و
          اطلاعات مشتریان را از گوشی قبلی منتقل نمی‌کند؛ انتقال آن‌ها از مسیر
          پشتیبان‌گیری و بازیابی داخل برنامه انجام می‌شود. روزهای باقی‌ماندهٔ
          اشتراک مستقیم در تمدید یا ارتقای آن حفظ می‌شود. خریدهای قبلی بازار از
          مسیر بازیابی و مدیریت همان فروشگاه پیگیری می‌شوند.
        </p>
        <h3>پرداخت ناموفق، تکراری یا اشتراک فعال‌نشده</h3>
        <p>
          اگر مبلغ کسر شده اما نتیجه مشخص نیست، دوباره خرید نکنید؛ ابتدا نتیجهٔ
          همان پرداخت را در برنامه پیگیری کنید. برای پرداخت تکراری یا پرداخت
          تأییدشده بدون ارائهٔ اشتراک، شناسهٔ تراکنش را به پشتیبانی بفرستید. پس
          از بررسی، وجه اضافی بازگردانده می‌شود؛ اگر ارائهٔ اشتراک خریداری‌شده
          ممکن نباشد، وجه همان خرید مسترد خواهد شد.
        </p>
        <h3>انصراف و درخواست شروع فوری</h3>
        <p>
          حق انصراف قانونی در موارد مشمول برقرار است. برای خدماتی که هنوز ارائه
          نشده، مهلت قانونی حداقل هفت روز کاری با رعایت شرایط آغاز مهلت است. اگر
          با درخواست و توافق شما ارائهٔ خدمت پیش از پایان این مهلت آغاز شود،
          موضوع تابع استثنای خدمات در آیین‌نامهٔ مواد ۳۸ و ۴۲ قانون تجارت
          الکترونیکی است. این بند حق پیگیری عدم ارائهٔ خدمت یا دریافت وجه اضافی
          را حذف نمی‌کند. ضمانت بازپرداخت بی‌قیدوشرط صرفاً به علت تغییر نظر پس
          از استفاده، به‌صورت تعهد اضافی ارائه نمی‌شود.
        </p>
        <p>
          پیش از پرداخت، انتخاب زیر به‌صورت پیش‌فرض خالی است: «شرایط خرید را
          خوانده‌ام و می‌پذیرم؛ درخواست می‌کنم اشتراک پس از تأیید پرداخت فوراً
          فعال شود.» نسخهٔ شرایط پذیرفته‌شده همراه سفارش ثبت می‌شود.
        </p>
        <p>
          حداقل اطلاعات حساب و رسید، مانند شناسهٔ سفارش، مبلغ، زمان، وضعیت و
          شناسهٔ تراکنش، برای پیگیری، بازیابی و تکالیف قانونی نگهداری می‌شود.
          مدت نگهداری تابع همین نیازها و تکالیف است. اطلاعات کارت بانکی در متراژ
          ذخیره نمی‌شود.
          <a href="/privacy/#direct-account">جزئیات حریم خصوصی حساب و خرید</a>
          را نیز بخوانید.
        </p>
        <p>
          شناسهٔ این شرایط: <span dir="ltr"
            >metrazh-android-sale-2026-09-08-v1</span
          >
        </p>

        <h2>استفاده مسئولانه</h2>
        <p>
          کاربر مسئول صحت اطلاعاتی است که در برنامه ثبت، ویرایش یا اشتراک‌گذاری
          می‌کند. پیش از ثبت یا انتشار اطلاعات مالک، مشتری، تصویر، مدرک یا
          نشانی، باید مجوزهای لازم دریافت شود.
        </p>

        <h2>محاسبات، قراردادها و خروجی‌ها</h2>
        <p>
          محاسبات مالی، کمیسیون، رهن و اجاره، قراردادها، گزارش‌ها و فایل‌های PDF
          ابزار کمکی هستند و تضمین حقوقی، مالی یا کارشناسی محسوب نمی‌شوند. پیش
          از تصمیم‌گیری یا امضای سند، نتیجه باید توسط فرد واجد صلاحیت بررسی شود.
        </p>

        <h2>نگهداری اطلاعات</h2>
        <p>
          داده‌های اصلی متراژ روی دستگاه کاربر نگهداری می‌شوند. حفاظت از دستگاه،
          انتخاب رمز امن، تهیه پشتیبان رمزگذاری‌شده و نگهداری جداگانه رمز و فایل
          پشتیبان بر عهده کاربر است.
        </p>

        <h2>سرویس‌های شخص ثالث</h2>
        <p>
          نقشه، پرداخت، موقعیت، تشخیص گفتار، اشتراک‌گذاری و مسیریابی ممکن است از
          سرویس‌ها یا برنامه‌های شخص ثالث استفاده کنند. ادامه استفاده از آن
          سرویس‌ها تابع شرایط و سیاست‌های همان ارائه‌دهنده است.
        </p>

        <h2>مالکیت محتوا</h2>
        <p>
          نام مهسای (MAHSAI)، نام و نشان متراژ، طراحی‌ها و محتوای اختصاصی این
          وب‌سایت متعلق به مالک مربوط هستند. استفاده مجدد تجاری یا انتساب نادرست
          آن‌ها بدون اجازه مجاز نیست.
        </p>

        <h2>تماس</h2>
        <p>
          برای پرسش درباره این شرایط با
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
            >{siteConfig.supportEmail}</a
          >
          تماس بگیرید.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
