---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import PageStage from '../components/PageStage.astro';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const metrazhApp = (await getCollection('apps')).find(
  (app) => app.id === 'metrazh',
);

if (!metrazhApp) {
  throw new Error('Metrazh content entry is missing.');
}

const bazaarLink = getCafeBazaarLink(metrazhApp.data.storeLinks);
---

<BaseLayout
  title={`شرایط استفاده | ${siteConfig.brandName}`}
  description={`شرایط استفاده از وب‌سایت مهسای و نسخه عمومی ${metrazhApp.data.version} اپلیکیشن متراژ.`}
>
  <PageStage
    eyebrow="شرایط استفاده"
    title="چارچوب روشن برای استفاده"
    highlight="آگاهانه."
    lead="با استفاده از این وب‌سایت یا اپلیکیشن متراژ، مسئولیت بررسی اطلاعات، حفاظت از داده‌ها و ارزیابی خروجی‌های کمکی برنامه را می‌پذیرید."
    note="محاسبات، گزارش‌ها و خروجی‌های برنامه ابزار کمکی‌اند و جای بررسی حقوقی، مالی یا کارشناسی را نمی‌گیرند."
    signals={['نسخه عمومی رسمی', 'مسئولیت صحت داده‌ها', 'استفاده مسئولانه']}
    tone="apricot"
  />

  <section class="page-section legal-section">
    <div class="shell legal-layout">
      <aside class="legal-aside">
        <span>آخرین به‌روزرسانی</span>
        <strong>۱۴۰۵/۰۵/۲۲</strong>
        <p>پرسش درباره این شرایط را از مسیر رسمی پشتیبانی بفرستید.</p>
        <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
          >{siteConfig.supportEmail}</a
        >
      </aside>
      <article class="prose legal-prose">
        <h2>وضعیت محصول</h2>
        <p>
          نسخه عمومی {metrazhApp.data.version} متراژ منتشر شده است. قابلیت‌ها، ظاهر
          برنامه، شیوه ارائه و شرایط اشتراک ممکن است در به‌روزرسانی‌های بعدی تغییر
          کنند. دریافت نسخه رسمی فقط از
          {
            bazaarLink ? (
              <a
                href={getTrackedCafeBazaarUrl(bazaarLink.url, 'terms_store')}
                target="_blank"
                rel="noopener"
              >
                صفحه متراژ در کافه‌بازار
              </a>
            ) : (
              'مسیر رسمی اعلام‌شده در سایت'
            )
          }
          انجام می‌شود.
        </p>

        <h2>استفاده مسئولانه</h2>
        <p>
          کاربر مسئول صحت اطلاعاتی است که در برنامه ثبت، ویرایش یا اشتراک‌گذاری
          می‌کند. پیش از ثبت یا انتشار اطلاعات مالک، مشتری، تصویر، مدرک یا
          نشانی، باید مجوزهای لازم دریافت شود.
        </p>

        <h2>محاسبات، قراردادها و خروجی‌ها</h2>
        <p>
          محاسبات مالی، کمیسیون، رهن و اجاره، قراردادها، گزارش‌ها و فایل‌های PDF
          ابزار کمکی هستند و تضمین حقوقی، مالی یا کارشناسی محسوب نمی‌شوند. پیش
          از تصمیم‌گیری یا امضای سند، نتیجه باید توسط فرد واجد صلاحیت بررسی شود.
        </p>

        <h2>نگهداری اطلاعات</h2>
        <p>
          داده‌های اصلی متراژ روی دستگاه کاربر نگهداری می‌شوند. حفاظت از دستگاه،
          انتخاب رمز امن، تهیه پشتیبان رمزگذاری‌شده و نگهداری جداگانه رمز و فایل
          پشتیبان بر عهده کاربر است.
        </p>

        <h2>سرویس‌های شخص ثالث</h2>
        <p>
          نقشه، پرداخت، موقعیت، تشخیص گفتار، اشتراک‌گذاری و مسیریابی ممکن است از
          سرویس‌ها یا برنامه‌های شخص ثالث استفاده کنند. ادامه استفاده از آن
          سرویس‌ها تابع شرایط و سیاست‌های همان ارائه‌دهنده است.
        </p>

        <h2>مالکیت محتوا</h2>
        <p>
          نام مهسای (MAHSAI)، نام و نشان متراژ، طراحی‌ها و محتوای اختصاصی این
          وب‌سایت متعلق به مالک مربوط هستند. استفاده مجدد تجاری یا انتساب نادرست
          آن‌ها بدون اجازه مجاز نیست.
        </p>

        <h2>تماس</h2>
        <p>
          برای پرسش درباره این شرایط با
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
            >{siteConfig.supportEmail}</a
          >
          تماس بگیرید.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
