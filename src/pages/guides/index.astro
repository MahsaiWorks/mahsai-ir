---
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import GuideCard from '../../components/GuideCard.astro';
import { siteConfig } from '../../config/site';
import { guideTopics } from '../../data/guideTopics';
import BaseLayout from '../../layouts/BaseLayout.astro';

const collectionStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'راهنماهای جامع کار مشاور املاک',
  description:
    'چهار راهنمای جامع و مرحله‌به‌مرحله برای فایل‌گیری، شناخت مشتری، بازدید و آگهی ملک در بازار ایران.',
  url: new URL('/guides/', Astro.site).toString(),
  inLanguage: 'fa-IR',
  hasPart: guideTopics.map((guide) => ({
    '@type': 'WebPage',
    name: guide.title,
    url: new URL(`/guides/${guide.slug}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title={`راهنمای کار مشاور املاک؛ فایل، مشتری و بازدید | ${siteConfig.brandName}`}
  description="چهار راهنمای جامع، روان و اجرایی برای کار روزانهٔ مشاور املاک؛ از ثبت فایل و نیازسنجی مشتری تا برنامه‌ریزی بازدید و نوشتن آگهی ملک."
  keywords={[
    'آموزش مشاور املاک',
    'فایل گیری املاک',
    'مدیریت مشتری املاک',
    'بازدید ملک',
    'نوشتن آگهی ملک',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(collectionStructuredData)}
  />

  <header class="guide-index-hero">
    <div class="shell guide-index-hero-grid">
      <div>
        <p class="kicker">راهنمای کارهای روزمرهٔ املاک</p>
        <h1>برای دغدغهٔ امروزت، خیلی سریع راهنمای مناسب رو پیدا کن</h1>
        <p class="lead">
          از گرفتن فایل و شناخت مشتری تا بازدید و نوشتن آگهی، راهنما داریم.
          موضوعی رو که لازم داری انتخاب کن و مرحله‌هاش رو به‌ترتیب انجام بده.
        </p>
        <ul class="trust-list">
          <li>توضیح کوتاه و روشن</li>
          <li>نمونه‌های آشنا از کار املاک</li>
          <li>چک‌لیست آمادهٔ استفاده</li>
        </ul>
      </div>
      <figure>
        <ResponsiveImage
          src="/images/editorial/real/property-file-review.jpg"
          alt="بررسی دقیق اطلاعات یک فایل ملکی پیش از معرفی به مشتری"
          width="1800"
          height="1200"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  <section
    class="section guide-directory"
    aria-labelledby="guide-directory-title"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">چهار مسیر اصلی</p>
          <h2 id="guide-directory-title">از کدام بخش کارتان شروع کنیم؟</h2>
        </div>
        <p>
          موضوعی را انتخاب کنید که به کار امروزتان نزدیک‌تر است. داخل هر راهنما،
          لینک ادامهٔ کار را هم می‌بینید.
        </p>
      </header>
      <div class="guide-card-grid">
        {guideTopics.map((guide) => <GuideCard guide={guide} />)}
      </div>
    </div>
  </section>

  <section class="guide-index-method" aria-labelledby="guide-method-title">
    <div class="shell guide-index-method-grid">
      <div>
        <p class="kicker kicker-light">داخل هر راهنما چه می‌بینید؟</p>
        <h2 id="guide-method-title">
          اول جواب کوتاه را بخوانید، بعد سراغ مراحل کار بروید
        </h2>
      </div>
      <ul>
        <li>
          <strong>جواب کوتاه:</strong> اصل مطلب همان اول صفحه آمده است.
        </li>
        <li><strong>مراحل کار:</strong> هر قدم روشن و قابل انجام است.</li>
        <li>
          <strong>اشتباه‌های رایج:</strong> می‌بینید کجا ممکن است کار خراب شود و چطور
          درستش کنید.
        </li>
        <li>
          <strong>مطالب مرتبط:</strong> مقاله و آموزش بعدی همان‌جا معرفی شده است.
        </li>
      </ul>
      <a class="button button-light" href="/academy/">دیدن آموزش‌های رایگان</a>
    </div>
  </section>
</BaseLayout>
