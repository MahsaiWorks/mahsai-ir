---
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import ShareActions from '../../components/ShareActions.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import { siteConfig } from '../../config/site';
import { guideTopics, type GuideTopic } from '../../data/guideTopics';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return guideTopics.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideTopic;
}

const { guide } = Astro.props;
const allArticles = (await getCollection('articles')).filter(
  (article) => !article.data.draft,
);
const relatedArticles = guide.articleIds
  .map((id) => allArticles.find((article) => article.id === id))
  .filter((article) => article !== undefined);
const canonical = new URL(Astro.url.pathname, Astro.site);
const updatedAt = new Date(guide.updatedAt);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const pageStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: guide.title,
  description: guide.description,
  url: canonical.toString(),
  image: new URL(guide.cover, Astro.site).toString(),
  dateModified: updatedAt.toISOString(),
  inLanguage: 'fa-IR',
  author: {
    '@type': 'Organization',
    name: siteConfig.brandName,
    url: new URL('/about/', Astro.site).toString(),
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: guide.steps.map((step, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: step.title,
      description: step.description,
    })),
  },
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'خانه',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'راهنماهای جامع',
      item: new URL('/guides/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: guide.navTitle,
      item: canonical.toString(),
    },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.questions.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={`${guide.title} | ${siteConfig.brandName}`}
  description={guide.description}
  image={guide.cover}
  imageAlt={guide.coverAlt}
  imageWidth={guide.coverWidth}
  imageHeight={guide.coverHeight}
  preloadImage={guide.cover}
  preloadImageWidth={guide.coverWidth}
  keywords={guide.keywords}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(pageStructuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbStructuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqStructuredData)}
  />

  <article class="guide-page" data-view-event="guide_reading_started">
    <header class="guide-stage">
      <div class="shell">
        <nav class="breadcrumbs" aria-label="مسیر صفحه">
          <a href="/">خانه</a><span aria-hidden="true">/</span>
          <a href="/guides/">راهنماهای جامع</a><span aria-hidden="true">/</span>
          <span>{guide.navTitle}</span>
        </nav>

        <div class="guide-stage-grid">
          <div class="guide-stage-copy">
            <p class="kicker">{guide.kicker}</p>
            <h1>{guide.title}</h1>
            <p class="lead">{guide.description}</p>
            <ul class="guide-outcomes">
              {guide.outcomes.map((outcome) => <li>{outcome}</li>)}
            </ul>
            <p class="guide-updated">
              مسئول محتوا: تحریریهٔ {siteConfig.brandName} · آخرین بازبینی: {
                formatDate(updatedAt)
              }
            </p>
          </div>
          <figure class="guide-stage-cover">
            <ResponsiveImage
              src={guide.cover}
              alt={guide.coverAlt}
              width={guide.coverWidth}
              height={guide.coverHeight}
              sizes="(max-width: 56.25rem) 100vw, 50vw"
              fetchpriority="high"
            />
          </figure>
        </div>
      </div>
    </header>

    <section class="guide-answer-band" aria-labelledby="guide-answer-title">
      <div class="shell guide-answer-grid">
        <div>
          <span>جواب کوتاه</span>
          <h2 id="guide-answer-title">اصل کار چیست؟</h2>
        </div>
        <p>{guide.answer}</p>
      </div>
    </section>

    <div class="shell guide-reading-layout">
      <aside class="guide-side-nav" aria-label="فهرست راهنما">
        <strong>در این راهنما</strong>
        <a href="#workflow">مسیر اجرای کار</a>
        <a href="#checklist">چک‌لیست کنترل</a>
        <a href="#mistakes">اشتباه‌های رایج</a>
        <a href="#questions">پرسش‌های پرتکرار</a>
        <a
          class="guide-side-product"
          href="/apps/metrazh/"
          data-event="guide_to_metrazh"
          data-event-location="guide_toc"
          >اپلیکیشن متراژ برای این کار <span aria-hidden="true">←</span></a
        >
      </aside>

      <div class="guide-main">
        <section
          id="workflow"
          class="guide-section"
          aria-labelledby="workflow-title"
        >
          <p class="kicker">مسیر اجرا</p>
          <h2 id="workflow-title">کار را به چهار بخش قابل کنترل تقسیم کنید.</h2>
          <div class="guide-step-list">
            {
              guide.steps.map((step) => (
                <article class="guide-step">
                  <span>{step.label}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                    <strong>{step.output}</strong>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section
          id="checklist"
          class="guide-section"
          aria-labelledby="checklist-title"
        >
          <p class="kicker">کنترل سریع</p>
          <h2 id="checklist-title">
            قبل از رفتن به مرحلهٔ بعد، این موارد را ببینید.
          </h2>
          <ul class="guide-checklist">
            {guide.checklist.map((item) => <li>{item}</li>)}
          </ul>
          <a
            class="text-link guide-print-link"
            href={`/resources/real-estate-checklists/#${guide.slug}`}
          >
            نسخهٔ چاپی رایگان این چک‌لیست ←
          </a>
        </section>

        <section
          id="mistakes"
          class="guide-section"
          aria-labelledby="mistakes-title"
        >
          <p class="kicker">جایی که کار معمولاً گیر می‌کند</p>
          <h2 id="mistakes-title">اشتباه را همراه راه اصلاح ببینید.</h2>
          <div class="guide-mistake-grid">
            {
              guide.mistakes.map((mistake) => (
                <article>
                  <h3>{mistake.title}</h3>
                  <p>{mistake.problem}</p>
                  <div>
                    <strong>راه اصلاح:</strong> {mistake.fix}
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section
          id="questions"
          class="guide-section guide-faq"
          aria-labelledby="questions-title"
        >
          <p class="kicker">پرسش‌های واقعی</p>
          <h2 id="questions-title">
            جواب کوتاه به سؤال‌هایی که وسط کار پیش می‌آید.
          </h2>
          <div>
            {
              guide.questions.map((item) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>
        </section>

        <aside class="guide-editorial-note">
          <strong>این راهنما چگونه تهیه شده است؟</strong>
          <p>
            متن برای حل مسئلهٔ روزانهٔ مشاور املاک نوشته شده و با مقاله‌های
            جزئی‌تر همین سایت و قابلیت‌های مستند نسخهٔ عمومی متراژ پیوند دارد.
            ادعای حقوقی، آمار نتیجه یا تجربهٔ کاربر بدون مدرک به آن اضافه نشده
            است.
          </p>
          <a href="/editorial-policy/">سیاست تحریریه و مسیر گزارش اصلاح</a>
        </aside>
        <ShareActions title={guide.title} location="guide" />
      </div>
    </div>
  </article>

  <section class="guide-related" aria-labelledby="guide-related-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">برای اجرای دقیق‌تر</p>
          <h2 id="guide-related-title">
            حالا سراغ راهنمای جزئی هر مرحله بروید.
          </h2>
        </div>
        <a class="text-link" href="/articles/">همهٔ مقاله‌ها ←</a>
      </header>
      <div class="editorial-grid">
        {
          relatedArticles.map((article, index) => (
            <ArticleCard article={article} featured={index === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="guide-product-panel" aria-labelledby="guide-product-title">
    <div class="shell guide-product-grid">
      <div>
        <p class="kicker kicker-light">اجرای همین روش در متراژ</p>
        <h2 id="guide-product-title">{guide.metrazhTitle}</h2>
        <p>{guide.metrazhDescription}</p>
        <div class="hero-actions">
          <a
            class="button button-light"
            href="/apps/metrazh/"
            data-event="guide_to_metrazh"
            data-event-location="guide_bottom">دیدن اپلیکیشن متراژ</a
          >
          <a class="text-link text-link-light" href="/guides/">راهنمای دیگر ←</a
          >
        </div>
      </div>
      <figure>
        <ResponsiveImage
          src={guide.productImage}
          alt={guide.productImageAlt}
          width="1080"
          height="1920"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
