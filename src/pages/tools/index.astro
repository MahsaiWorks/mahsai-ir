---
import { getCollection } from 'astro:content';
import PropertyFileNameBuilder from '../../components/PropertyFileNameBuilder.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { siteConfig } from '../../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../../data/appPresentation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/real-estate-tools.css';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      name: 'ابزارهای رایگان مشاور املاک',
      description:
        'ابزارهای ساده و رایگان برای نام‌گذاری فایل، کنترل کار روزانه و استفاده از چک‌لیست‌های مشاور املاک.',
      url: canonical.toString(),
      inLanguage: 'fa-IR',
      isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
    },
    {
      '@type': 'ItemList',
      name: 'میز ابزار رایگان MAHSAI',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'سازندهٔ عنوان فایل ملک',
          url: `${canonical}#file-name-tool`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'چک‌لیست‌های چاپی مشاور املاک',
          url: new URL(
            '/resources/real-estate-checklists/',
            Astro.site,
          ).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'راهنمای انتخاب نرم‌افزار مشاور املاک',
          url: new URL('/real-estate-software/', Astro.site).toString(),
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`ابزارهای رایگان مشاور املاک؛ عنوان فایل و چک‌لیست | ${siteConfig.brandName}`}
  description="ابزارهای رایگان و بدون ثبت‌نام برای مشاوران املاک؛ ساخت عنوان یکدست فایل، چک‌لیست چاپی فایل‌گیری و بازدید و راهنمای انتخاب نرم‌افزار املاک."
  image="/images/editorial/real/property-file-review.jpg"
  imageAlt="ابزارها و چک‌لیست‌های منظم روی میز کار مشاور املاک"
  imageWidth={1800}
  imageHeight={1200}
  preloadImage="/images/editorial/real/property-file-review.jpg"
  preloadImageWidth={1800}
  keywords={[
    'ابزار مشاور املاک',
    'فرم فایل املاک',
    'نام گذاری فایل ملک',
    'چک لیست مشاور املاک',
    'چک لیست بازدید ملک',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <header class="tool-index-hero">
    <div class="shell tool-index-hero-grid">
      <div>
        <nav class="breadcrumbs" aria-label="مسیر صفحه">
          <a href="/">خانه</a><span aria-hidden="true">/</span>
          <span>ابزارهای رایگان</span>
        </nav>
        <p class="kicker">ابزارهای رایگان</p>
        <h1>چند ابزار مهم برای مشاور املاک حرفه‌ای</h1>
        <p class="lead">
          عنوان فایل بسازید، چک‌لیست‌های آماده را چاپ کنید و راهنمای موردنیازتان
          را پیدا کنید؛ بدون ثبت‌نام و بدون دادن شماره تلفن.
        </p>
        <ul class="tool-trust-list">
          <li>رایگان و بدون ثبت‌نام</li>
          <li>اطلاعات شما از مرورگر خارج نمی‌شود</li>
          <li>چک‌لیست‌ها آمادهٔ چاپ هستند</li>
        </ul>
        <a class="button" href="#file-name-tool">ساختن عنوان فایل</a>
      </div>

      <figure class="tool-index-visual">
        <ResponsiveImage
          src="/images/editorial/real/property-file-review.jpg"
          alt="بررسی مرحله‌ای اطلاعات یک فایل ملکی روی میز کار"
          width="1800"
          height="1200"
          sizes="(max-width: 56.25rem) 100vw, 46vw"
          fetchpriority="high"
        />
        <figcaption>
          <span>فایل تازه رسیده؟</span>
          <strong>اول یک اسم مشخص برایش بگذارید.</strong>
        </figcaption>
      </figure>
    </div>
  </header>

  <section
    class="tool-workbench"
    id="file-name-tool"
    aria-labelledby="tool-workbench-title"
  >
    <div class="shell tool-workbench-layout">
      <header>
        <p class="section-sign">عنوان‌ساز فایل</p>
        <h2 id="tool-workbench-title">
          برای فایلتان یک اسم مرتب و مشخص بسازید
        </h2>
        <p>
          عنوان داخل همین صفحه ساخته می‌شود و جایی فرستاده نمی‌شود. نام مالک،
          شماره تماس، نشانی دقیق یا اطلاعات محرمانه را در عنوان فایل ننویسید.
        </p>
      </header>
      <PropertyFileNameBuilder />
    </div>
  </section>

  <section class="tool-shelf" aria-labelledby="tool-shelf-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">چک‌لیست‌ها و راهنماها</p>
          <h2 id="tool-shelf-title">
            هر چیزی را که امروز لازم دارید، از اینجا بردارید
          </h2>
        </div>
        <p>
          برای فایل‌گیری، شناخت مشتری، بازدید و انتخاب نرم‌افزار، راهنما و
          چک‌لیست آماده داریم.
        </p>
      </header>

      <div class="tool-shelf-grid">
        <a
          class="tool-shelf-card tool-shelf-card-paper"
          href="/resources/real-estate-checklists/"
        >
          <span>چاپ یا ذخیرهٔ PDF</span>
          <h3>چک‌لیست روز کاری مشاور املاک</h3>
          <p>
            چهار برگه برای فایل‌گیری، شناخت مشتری، بازدید و آماده‌سازی آگهی.
          </p>
          <strong>گرفتن چک‌لیست‌ها ←</strong>
        </a>

        <a class="tool-shelf-card tool-shelf-card-guide" href="/guides/">
          <span>آموزش ساده و کاربردی</span>
          <h3>راهنماهای کار املاک</h3>
          <p>از اولین تماس تا پیگیری بعدی، همه‌چیز ساده توضیح داده شده است.</p>
          <strong>دیدن راهنماها ←</strong>
        </a>

        <a
          class="tool-shelf-card tool-shelf-card-choice"
          href="/real-estate-software/"
        >
          <span>قبل از نصب</span>
          <h3>معیار انتخاب نرم‌افزار املاک</h3>
          <p>سرعت کار، امنیت اطلاعات، پشتیبانی و گرفتن خروجی را بررسی کنید.</p>
          <strong>دیدن معیارهای انتخاب ←</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="tool-product-bridge" aria-labelledby="tool-product-title">
    <div class="shell tool-product-bridge-grid">
      <div>
        <p class="kicker kicker-light">وقتی یک ابزار کافی نیست</p>
        <h2 id="tool-product-title">
          فایل، مشتری و پیگیری را کنار هم می‌خواهید؟ متراژ برای همین ساخته شده.
        </h2>
        <p>
          ابزارهای رایگان این صفحه برای یک کار کوتاه هستند. اگر می‌خواهید
          فایل‌ها، مشتری‌ها و پیگیری‌ها را با گوشی مدیریت کنید، متراژ همه را
          یک‌جا نگه می‌دارد.
        </p>
      </div>
      <div class="tool-product-actions">
        <a class="button button-light" href="/apps/metrazh/">
          دیدن محیط و امکانات متراژ
        </a>
        {
          bazaarLink && (
            <a
              class="arrow-link arrow-link-light"
              href={getTrackedCafeBazaarUrl(bazaarLink.url, 'tools_footer')}
              target="_blank"
              rel="noopener"
              data-event="metrazh_bazaar_click"
              data-event-location="tools_footer"
            >
              نصب رایگان از کافه‌بازار <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
