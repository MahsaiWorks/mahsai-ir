---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { getCafeBazaarLink } from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const apps = (await getCollection('apps')).filter(
  (entry) => entry.data.status === 'available',
);
const app = apps.find((entry) => entry.id === 'metrazh');
if (!app) throw new Error('Published Metrazh content entry is missing.');
const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
---

<BaseLayout
  title={`پشتیبانی رسمی متراژ و سایت | ${siteConfig.brandName}`}
  description="راه‌های رسمی پشتیبانی اپلیکیشن متراژ و وب‌سایت MAHSAI؛ اطلاعات لازم برای گزارش خطا، ایمیل و کانال‌های ارتباطی."
>
  <header class="inner-hero support-hero">
    <div class="shell inner-hero-grid">
      <div>
        <p class="kicker">پشتیبانی رسمی</p>
        <h1>مشکل را روشن بفرستید؛ بررسی را سریع‌تر کنید.</h1>
        <p class="lead">
          برای مسئلهٔ فنی متراژ یا مشکل سایت از مسیرهای همین صفحه استفاده کنید.
          پیش از ارسال تصویر، اطلاعات مالک و مشتری را حذف یا بپوشانید.
        </p>
        <div class="hero-actions">
          <a class="button" href="#support-form">ساخت پیام پشتیبانی</a>
          {
            bazaarLink && (
              <a
                class="text-link"
                href={bazaarLink.url}
                target="_blank"
                rel="noopener"
              >
                صفحهٔ رسمی متراژ ↗
              </a>
            )
          }
        </div>
      </div>
      <figure>
        <ResponsiveImage
          src="/images/editorial/secure-real-estate-data.webp"
          alt="حفاظت از اطلاعات و پرونده‌های کاری املاک"
          width="1536"
          height="1024"
        />
      </figure>
    </div>
  </header>

  <section class="section support-report" aria-labelledby="report-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">گزارش قابل بررسی</p>
          <h2 id="report-title">این چهار مورد را همراه پیام بفرستید.</h2>
        </div>
        <p>
          گزارش کوتاه و دقیق، از چند پیام پراکنده مفیدتر است و احتمال بازسازی
          مشکل را بیشتر می‌کند.
        </p>
      </header>
      <div class="support-step-grid">
        <article>
          <h3>نسخهٔ برنامه</h3><p>شمارهٔ نسخهٔ متراژ را بنویسید.</p>
        </article>
        <article>
          <h3>مدل دستگاه</h3><p>مدل گوشی و نسخهٔ اندروید را اضافه کنید.</p>
        </article>
        <article>
          <h3>مراحل تکرار</h3><p>از کجا شروع کردید و چه اتفاقی افتاد؟</p>
        </article>
        <article>
          <h3>تصویر امن</h3><p>اطلاعات محرمانه را قبل از ارسال بپوشانید.</p>
        </article>
      </div>
    </div>
  </section>

  <section
    class="section support-form-section"
    aria-labelledby="support-form-title"
  >
    <div class="shell support-form-layout">
      <div class="support-form-intro">
        <p class="kicker">یک پیام کامل، در یک مرحله</p>
        <h2 id="support-form-title">
          موضوع را دسته‌بندی کنید؛ ایمیل آماده شود.
        </h2>
        <p>
          این فرم چیزی را روی سایت ذخیره یا ارسال نمی‌کند. پس از تکمیل، برنامهٔ
          ایمیل شما با متن آماده باز می‌شود و دکمهٔ ارسال را خودتان می‌زنید.
        </p>
        <div class="support-response-note">
          <strong>هدف پاسخ اولیه: تا دو روز کاری</strong>
          <span
            >برای مسئله‌های پیچیده، زمان بررسی در پاسخ اول اعلام می‌شود.</span
          >
        </div>
      </div>

      <form class="support-form" id="support-form" novalidate>
        <div class="support-field-grid">
          <label>
            <span>موضوع پیام</span>
            <select name="category" required>
              <option value="">انتخاب کنید</option>
              <option value="technical">خطا یا مشکل فنی متراژ</option>
              <option value="backup">پشتیبان‌گیری یا بازیابی</option>
              <option value="purchase">خرید و فعال‌سازی</option>
              <option value="privacy">حریم خصوصی و امنیت</option>
              <option value="website">اشکال یا پیشنهاد برای سایت</option>
              <option value="feedback">نظر و تجربهٔ استفاده</option>
            </select>
          </label>

          <label>
            <span>ایمیل شما</span>
            <input
              name="replyEmail"
              type="email"
              inputmode="email"
              autocomplete="email"
              placeholder="name@example.com"
              dir="ltr"
              required
            />
          </label>

          <label>
            <span>نسخهٔ متراژ</span>
            <input name="appVersion" value={app.data.version} maxlength="30" />
          </label>

          <label>
            <span>مدل گوشی و اندروید</span>
            <input
              name="device"
              maxlength="100"
              placeholder="مثلاً پوکو X5، اندروید ۱۳"
            />
          </label>
        </div>

        <label>
          <span>چه اتفاقی افتاد و چطور تکرار می‌شود؟</span>
          <textarea
            name="description"
            rows="6"
            minlength="20"
            maxlength="1500"
            placeholder="از مرحلهٔ اول تا نتیجه‌ای که دیدید، کوتاه و دقیق بنویسید."
            required></textarea>
        </label>

        <label class="support-safety-check">
          <input name="safeToSend" type="checkbox" required />
          <span
            >اطلاعات مالک، مشتری، شماره تماس، مدرک و تصویر محرمانه را وارد
            نکرده‌ام.</span
          >
        </label>

        <div class="support-form-actions">
          <button class="button" type="submit">آماده‌کردن ایمیل</button>
          <small>پیوست امن را پس از بازشدن برنامهٔ ایمیل اضافه کنید.</small>
        </div>
        <div
          class="support-form-result"
          role="status"
          aria-live="polite"
          hidden
        >
        </div>
      </form>
    </div>
  </section>

  <section class="section support-channels" aria-labelledby="channels-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">راه‌های ارتباط</p>
          <h2 id="channels-title">فقط از کانال رسمی استفاده کنید.</h2>
        </div>
      </header>
      <div class="support-channel-grid">
        <article class="support-channel support-channel-primary">
          <span>پشتیبانی مستقیم</span>
          <h3>ایمیل رسمی MAHSAI</h3>
          <p>برای گزارش فنی، حریم خصوصی یا موضوعی که نیاز به توضیح دارد.</p>
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr">
            {siteConfig.supportEmail}
          </a>
        </article>
        {
          app.data.supportLinks.map((link) => (
            <article class="support-channel">
              <span>متراژ</span>
              <h3>{link.label}</h3>
              <p>مسیر رسمی اعلام‌شده برای پشتیبانی یا اطلاع‌رسانی محصول.</p>
              <a href={link.url} target="_blank" rel="noopener">
                باز کردن پیوند رسمی ↗
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section support-feedback" aria-labelledby="feedback-title">
    <div class="shell cta-panel">
      <p class="eyebrow">تجربهٔ واقعی شما</p>
      <h2 id="feedback-title">
        متراژ را در کار واقعی استفاده کرده‌اید؟ تجربه‌تان را بفرستید.
      </h2>
      <p>
        بگویید در چه کاری از برنامه استفاده کرده‌اید، چه چیزی مفید بوده و کجا
        نیاز به اصلاح دارد. هیچ نقل‌قولی بدون بررسی، هماهنگی متن و اجازهٔ روشن
        شما در سایت منتشر نمی‌شود.
      </p>
      <a
        class="button"
        href={`mailto:${siteConfig.supportEmail}?subject=${encodeURIComponent('تجربه استفاده از متراژ')}`}
        data-event="metrazh_feedback_email"
        data-event-location="support_page">ارسال تجربهٔ استفاده</a
      >
      {
        bazaarLink && (
          <a
            class="button button-secondary"
            href={bazaarLink.url}
            target="_blank"
            rel="noopener"
            data-event="metrazh_bazaar_review_open"
            data-event-location="support_feedback"
          >
            ثبت نظر صادقانه در کافه‌بازار
          </a>
        )
      }
      <p class="support-review-note">
        امتیاز یا نظر را فقط بر پایهٔ تجربهٔ واقعی بنویسید؛ برای نظر مثبت جایزه
        یا مزیت در نظر گرفته نمی‌شود.
      </p>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="support-faq-title">
    <div class="shell faq-layout">
      <div>
        <p class="kicker">پیش از ارسال</p>
        <h2 id="support-faq-title">پاسخ چند پرسش رایج.</h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>نسخهٔ رسمی متراژ را از کجا دریافت کنم؟</summary>
          <p>
            نسخهٔ {app.data.version} فقط از
            {
              bazaarLink ? (
                <a href={bazaarLink.url} target="_blank" rel="noopener">
                  صفحهٔ رسمی متراژ در کافه‌بازار
                </a>
              ) : (
                'مسیر رسمی اعلام‌شده در سایت'
              )
            }
            دریافت و به‌روزرسانی می‌شود.
          </p>
        </details>
        <details>
          <summary>برای گزارش خطا چه اطلاعاتی نفرستم؟</summary>
          <p>
            نام، شماره تماس، تصویر مدرک و اطلاعات محرمانهٔ مالک یا مشتری را حذف
            یا پوشانده کنید.
          </p>
        </details>
        <details>
          <summary>سیاست نگهداری داده‌های متراژ کجاست؟</summary>
          <p>
            جزئیات ذخیرهٔ محلی، دسترسی‌ها و پشتیبان در صفحهٔ
            <a href="/privacy/">حریم خصوصی</a> توضیح داده شده است.
          </p>
        </details>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ supportEmail: siteConfig.supportEmail }}>
    (() => {
      const form = document.querySelector('#support-form');
      const result = form?.querySelector('.support-form-result');
      if (
        !(form instanceof HTMLFormElement) ||
        !(result instanceof HTMLElement)
      )
        return;

      const categoryLabels = {
        technical: 'خطا یا مشکل فنی متراژ',
        backup: 'پشتیبان‌گیری یا بازیابی',
        purchase: 'خرید و فعال‌سازی',
        privacy: 'حریم خصوصی و امنیت',
        website: 'اشکال یا پیشنهاد برای سایت',
        feedback: 'نظر و تجربهٔ استفاده',
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const data = new FormData(form);
        const category = String(data.get('category') || '');
        const categoryLabel = categoryLabels[category];
        if (!categoryLabel) return;

        const datePart = new Date()
          .toISOString()
          .slice(2, 10)
          .replaceAll('-', '');
        const randomPart = crypto
          .getRandomValues(new Uint16Array(1))[0]
          .toString(36)
          .padStart(3, '0')
          .slice(-3)
          .toUpperCase();
        const reference = `MHS-${datePart}-${randomPart}`;
        const lines = [
          `کد مرجع پیام: ${reference}`,
          `موضوع: ${categoryLabel}`,
          `ایمیل پاسخ: ${String(data.get('replyEmail') || '').trim()}`,
          `نسخهٔ متراژ: ${String(data.get('appVersion') || 'ذکر نشده').trim()}`,
          `دستگاه: ${String(data.get('device') || 'ذکر نشده').trim()}`,
          '',
          'شرح و مراحل تکرار:',
          String(data.get('description') || '').trim(),
          '',
          'اطلاعات محرمانهٔ مالک و مشتری حذف شده است.',
        ];
        const subject = `[${reference}] ${categoryLabel}`;
        const mailto = `mailto:${supportEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;

        result.hidden = false;
        result.innerHTML = `<strong>کد مرجع پیام: <span dir="ltr">${reference}</span></strong><p>برنامهٔ ایمیل باز می‌شود. این کد را از موضوع حذف نکنید؛ ثبت نهایی فقط پس از زدن دکمهٔ ارسال در برنامهٔ ایمیل انجام می‌شود.</p>`;
        window.mahsaiMeasure?.('support_email_prepared', { category });
        window.location.href = mailto;
      });
    })();
  </script>
</BaseLayout>
