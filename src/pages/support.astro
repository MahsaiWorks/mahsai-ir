---
import { getCollection } from 'astro:content';
import PageStage from '../components/PageStage.astro';
import { siteConfig } from '../config/site';
import { getCafeBazaarLink } from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const apps = (await getCollection('apps')).sort(
  (a, b) => a.data.order - b.data.order,
);
const metrazhApp = apps.find((app) => app.id === 'metrazh');
const bazaarLink = metrazhApp
  ? getCafeBazaarLink(metrazhApp.data.storeLinks)
  : undefined;
---

<BaseLayout
  title={`پشتیبانی سایت و متراژ | ${siteConfig.brandName}`}
  description="مسیر رسمی پشتیبانی MAHSAI؛ گزارش خطای محتوایی مرکز هوش مصنوعی، مشکل سایت یا مسئلهٔ فنی اپلیکیشن متراژ."
>
  <PageStage
    eyebrow="مرکز راهنما"
    title="گزارش دقیق، از مسیر"
    highlight="رسمی."
    lead="برای خطای محتوایی بخش هوش مصنوعی، مشکل سایت یا مسئلهٔ فنی متراژ ایمیل بفرستید. لینک صفحه و توضیح دقیق را اضافه کنید و اطلاعات محرمانه را از پیام و تصویر حذف کنید."
    note="پشتیبانی سایت MAHSAI و اپلیکیشن متراژ فقط از کانال‌های درج‌شده در همین صفحه انجام می‌شود."
    signals={['گزارش خطای محتوا', 'مشکل سایت', 'پشتیبانی متراژ', 'ایمیل رسمی']}
    tone="mint"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href={`mailto:${siteConfig.supportEmail}`}>
        ارسال ایمیل پشتیبانی
      </a>
      {
        bazaarLink && metrazhApp && (
          <a
            class="page-stage-link"
            href={bazaarLink.url}
            target="_blank"
            rel="noopener"
          >
            دانلود {metrazhApp.data.name} از کافه‌بازار
          </a>
        )
      }
    </div>
  </PageStage>

  <section class="page-section" aria-labelledby="report-title">
    <div class="shell support-process">
      <header class="split-intro">
        <div class="split-intro-heading">
          <p class="eyebrow">گزارش دقیق</p>
          <h2 id="report-title">چهار موردی که بررسی را سریع‌تر می‌کنند.</h2>
        </div>
        <p>
          یک گزارش کوتاه اما ساختاریافته از چند پیام پراکنده مفیدتر است. همین
          چهار بخش کمک می‌کنند مشکل قابل بازسازی و پیگیری باشد.
        </p>
      </header>
      <ol class="support-steps">
        <li>
          <div>
            <h3>نسخه برنامه</h3><p>
              شماره نسخه متراژ را از بخش اطلاعات برنامه بنویسید.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>مشخصات دستگاه</h3><p>مدل گوشی و نسخهٔ اندروید را اضافه کنید.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>مراحل تکرار</h3><p>
              از کدام صفحه شروع کردید و دقیقاً چه اتفاقی افتاد؟
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>تصویر امن</h3><p>
              در صورت نیاز اسکرین‌شات بفرستید، اما اطلاعات مشتری را بپوشانید.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section
    class="page-section page-section-soft"
    aria-labelledby="channels-title"
  >
    <div class="shell">
      <header class="section-heading compact-heading">
        <p class="eyebrow">راه‌های ارتباط</p>
        <h2 id="channels-title">کانال مناسب را انتخاب کنید.</h2>
      </header>
      <div class="support-channel-grid">
        <article class="support-channel">
          <span>MAHSAI</span>
          <h3>گزارش خطای محتوایی</h3>
          <p>لینک صفحه، جملهٔ موردنظر و منبع اصلاحی پیشنهادی را بفرستید.</p>
          <a
            href={`mailto:${siteConfig.supportEmail}?subject=${encodeURIComponent('گزارش خطای محتوایی MAHSAI')}`}
          >
            ارسال گزارش محتوا ←
          </a>
        </article>
        <article class="support-channel support-channel-primary">
          <span>پشتیبانی مستقیم</span>
          <h3>ایمیل رسمی مهسای</h3>
          <p>
            برای گزارش فنی، پرسش حریم خصوصی یا موضوعی که نیاز به توضیح دارد.
          </p>
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr">
            {siteConfig.supportEmail}
          </a>
        </article>
        {
          apps.flatMap((app) =>
            app.data.supportLinks.map((link) => (
              <article class="support-channel">
                <span>{app.data.name}</span>
                <h3>{link.label}</h3>
                <p>مسیر رسمی اعلام‌شده برای پشتیبانی یا اطلاع‌رسانی محصول.</p>
                <a href={link.url} target="_blank" rel="noopener">
                  باز کردن پیوند رسمی ←
                </a>
              </article>
            )),
          )
        }
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="support-faq-title">
    <div class="shell faq-layout">
      <header>
        <p class="eyebrow">پیش از ارسال</p>
        <h2 id="support-faq-title">پاسخ چند پرسش رایج</h2>
      </header>
      <div class="faq-list">
        <details>
          <summary>نسخه رسمی متراژ را از کجا دانلود کنم؟</summary>
          <p>
            نسخه {metrazhApp?.data.version} از
            {
              bazaarLink ? (
                <a href={bazaarLink.url} target="_blank" rel="noopener">
                  صفحه رسمی متراژ در کافه‌بازار
                </a>
              ) : (
                'صفحه رسمی محصول'
              )
            }
            قابل دریافت است. برای نصب و بروزرسانی فقط از همین مسیر استفاده کنید.
          </p>
        </details>
        <details>
          <summary>برای گزارش خطا چه اطلاعاتی نفرستم؟</summary>
          <p>
            نام، شماره تماس، تصویر مدرک و اطلاعات محرمانه مالک یا مشتری را حذف
            یا پوشانده کنید.
          </p>
        </details>
        <details>
          <summary>سیاست نگهداری داده‌های متراژ کجاست؟</summary>
          <p>
            جزئیات ذخیره محلی، دسترسی‌ها و پشتیبان در صفحه <a href="/privacy/"
              >حریم خصوصی</a
            > توضیح داده شده است.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
