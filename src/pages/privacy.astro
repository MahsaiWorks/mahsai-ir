---
import { siteConfig } from '../config/site';
import PageStage from '../components/PageStage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`حریم خصوصی متراژ | ${siteConfig.brandName}`}
  description="سیاست حریم خصوصی اپلیکیشن متراژ و وب‌سایت مهسای؛ نحوه نگهداری محلی داده‌ها، دسترسی‌های دستگاه و سرویس‌های ثالث."
>
  <PageStage
    eyebrow="سیاست حریم خصوصی"
    title="داده‌های کاری شما، زیر"
    highlight="کنترل شما."
    lead="این صفحه توضیح می‌دهد متراژ چه اطلاعاتی را روی دستگاه نگهداری می‌کند، دسترسی‌ها چه زمانی استفاده می‌شوند و مسئولیت فایل پشتیبان چگونه است."
    note="متراژ در نسخه فعلی سرویس همگام‌سازی ابری اختصاصی برای داده‌های اصلی کاربر ندارد."
    signals={[
      'ذخیره اصلی روی دستگاه',
      'پشتیبان رمزگذاری‌شده',
      'آمار تجمیعی وب بدون کوکی',
    ]}
  />

  <section class="page-section legal-section">
    <div class="shell legal-layout">
      <aside class="legal-aside">
        <span>آخرین به‌روزرسانی</span>
        <strong>۱۴۰۵/۰۵/۲۸</strong>
        <p>برای پرسش حریم خصوصی از ایمیل رسمی پشتیبانی استفاده کنید.</p>
        <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
          >{siteConfig.supportEmail}</a
        >
      </aside>
      <article class="prose legal-prose">
        <h2>اطلاعات ذخیره‌شده روی دستگاه</h2>
        <p>
          اطلاعات فایل‌های ملکی، مالکان، مشتریان، متقاضیان، بازدیدها،
          یادآوری‌ها، تعاملات، معاملات، کمیسیون‌ها، تنظیمات، تصاویر و مدارکی که
          کاربر انتخاب می‌کند به‌صورت محلی روی دستگاه نگهداری می‌شوند. متراژ در
          نسخه فعلی سرویس همگام‌سازی ابری اختصاصی برای این داده‌ها ندارد.
        </p>
        <p>
          کاربر می‌تواند یک فایل پشتیبان رمزگذاری‌شده ایجاد کند. رمز فایل را خود
          کاربر انتخاب می‌کند و نگهداری امن فایل و رمز آن بر عهده اوست.
        </p>

        <h2>دسترسی‌های دستگاه</h2>
        <ul>
          <li>
            دوربین فقط هنگام درخواست کاربر برای افزودن تصویر استفاده می‌شود.
          </li>
          <li>
            میکروفن فقط برای قابلیت‌های صوتی و پس از اجازه کاربر استفاده می‌شود.
          </li>
          <li>
            موقعیت مکانی هنگام استفاده از نقشه برای نمایش موقعیت یا انتخاب نقطه
            مصرف می‌شود؛ انتخاب دستی نقطه نیز امکان‌پذیر است.
          </li>
          <li>
            اعلان‌ها، راه‌اندازی دستگاه، لرزش و بیدار نگه‌داشتن کوتاه دستگاه
            برای یادآوری‌های ثبت‌شده توسط کاربر استفاده می‌شوند.
          </li>
          <li>
            بیومتریک دستگاه فقط برای قفل اختیاری برنامه به کار می‌رود و داده خام
            اثر انگشت یا چهره توسط متراژ دریافت یا ذخیره نمی‌شود.
          </li>
        </ul>

        <h2>ارتباط اینترنتی و سرویس‌های ثالث</h2>
        <p>
          بخش اصلی مدیریت اطلاعات به‌صورت محلی کار می‌کند. نمایش نقشه، انجام یا
          بازیابی خرید، تشخیص گفتار و اشتراک‌گذاری می‌توانند به اینترنت، سرویس
          دستگاه یا برنامه‌های دیگر نیاز داشته باشند.
        </p>
        <p>
          سرویس‌های نشان، منابع فنی Leaflet، سرویس موقعیت Google Play Services،
          تشخیص گفتار دستگاه و کافه‌بازار ممکن است مطابق سیاست‌های خود اطلاعات
          فنی لازم برای ارائه سرویس را پردازش کنند. پرداخت توسط کافه‌بازار انجام
          می‌شود و متراژ رمز حساب بازار یا اطلاعات بانکی کاربر را دریافت و ذخیره
          نمی‌کند.
        </p>

        <h2>گزارش خطا و تحلیل آماری</h2>
        <p>
          در نسخه فعلی سرویس‌هایی مانند Firebase Analytics، Crashlytics، Sentry
          یا PostHog در پروژه استفاده نشده‌اند. نسخه انتشار، گزارش خطا را به‌طور
          خودکار برای توسعه‌دهنده ارسال نمی‌کند. فایل پشتیبانی فقط با اقدام
          آگاهانه کاربر و از طریق برنامه‌ای که خود او انتخاب می‌کند اشتراک‌گذاری
          می‌شود.
        </p>

        <h2>نگهداری و حذف اطلاعات</h2>
        <p>
          داده‌های محلی تا زمانی که کاربر آن‌ها را داخل برنامه حذف کند، داده
          برنامه را از تنظیمات Android پاک کند یا برنامه را حذف کند روی دستگاه
          باقی می‌مانند. فایل‌های پشتیبان ذخیره‌شده خارج از برنامه باید جداگانه
          توسط کاربر حذف شوند.
        </p>

        <h2>امنیت</h2>
        <p>
          متراژ برای پایگاه داده محلی، PIN و فایل پشتیبان از سازوکارهای امنیتی و
          رمزنگاری استفاده می‌کند. کاربر باید از قفل امن دستگاه استفاده کند،
          فایل پشتیبان و رمز آن را جدا نگه دارد و اطلاعات محرمانه مشتریان را
          بدون مجوز منتشر نکند.
        </p>

        <h2>حریم خصوصی وب‌سایت</h2>
        <p>
          وب‌سایت مهسای به‌صورت ایستا ارائه می‌شود و در نسخه فعلی حساب کاربری،
          پرداخت یا ذخیرهٔ اطلاعات فرم روی سرور ندارد. فرم پشتیبانی فقط متن یک
          ایمیل را روی همان دستگاه آماده می‌کند و تا زمانی که کاربر در برنامهٔ
          ایمیل دکمهٔ ارسال را نزند، چیزی به MAHSAI فرستاده نمی‌شود.
        </p>
        <p>
          عضویت اختیاری خبرنامه نیز با ایمیل روشن کاربر انجام می‌شود. نشانی فقط
          برای ارسال همان خبرنامه نگه داشته می‌شود و کاربر می‌تواند با پاسخ
          «لغو» درخواست حذف آن را بدهد. تا زمان راه‌اندازی سامانهٔ مستقل، هیچ
          فهرست خودکار یا فروش داده‌ای وجود ندارد.
        </p>
        <p>
          برای سنجش تجمیعی بازدید صفحه‌ها و مسیرهای معرفی، ممکن است از
          Cloudflare Web Analytics استفاده شود. این ابزار بدون کوکی و
          localStorage کار می‌کند و برای دنبال‌کردن اشخاص در سایت‌های مختلف
          طراحی نشده است؛ داده‌هایی مانند مسیر صفحه، منبع ارجاع، نوع مرورگر و
          شاخص‌های فنی بارگذاری به‌صورت آماری گزارش می‌شوند. کلیک روی ایمیل،
          تلگرام، واتس‌اپ، اینستاگرام یا کافه‌بازار، کاربر را به سرویس مربوط
          منتقل می‌کند و سیاست همان سرویس بر ادامهٔ تعامل حاکم است.
        </p>

        <h2>تغییرات این سیاست</h2>
        <p>
          در صورت تغییر قابلیت‌ها یا شیوه پردازش اطلاعات، این سیاست به‌روزرسانی
          خواهد شد و تاریخ نسخه جدید در این صفحه درج می‌شود.
        </p>

        <h2>تماس</h2>
        <p>
          برای پرسش‌های مرتبط با حریم خصوصی با
          <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
            >{siteConfig.supportEmail}</a
          >
          تماس بگیرید.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
