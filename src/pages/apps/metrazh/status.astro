---
import { getCollection } from 'astro:content';
import PageStage from '../../../components/PageStage.astro';
import { siteConfig } from '../../../config/site';
import {
  getReleaseCheckpoints,
  releasePrinciples,
} from '../../../data/metrazhRelease';
import { getTrackedCafeBazaarUrl } from '../../../data/appPresentation';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) {
  throw new Error('Metrazh content entry is missing.');
}

const bazaarLink = app.data.storeLinks.find((link) =>
  link.url.includes('cafebazaar.ir'),
);
const releaseCheckpoints = getReleaseCheckpoints(app.data.version);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
const storeUpdatedAt = formatDate(app.data.storeUpdatedAt);
const storeCheckedAt = formatDate(app.data.storeCheckedAt);
---

<BaseLayout
  title={`وضعیت انتشار متراژ | ${siteConfig.brandName}`}
  description={`وضعیت رسمی انتشار متراژ، نسخه عمومی ${app.data.version} و مسیر دانلود تأییدشده از کافه‌بازار.`}
>
  <PageStage
    eyebrow="وضعیت رسمی محصول"
    title={`نسخه ${app.data.version}`}
    highlight="در کافه‌بازار منتشر شده است."
    lead="نسخه عمومی متراژ از صفحه رسمی کافه‌بازار قابل دریافت است. وضعیت به‌روزرسانی‌های بعدی پس از تأیید بازار در همین صفحه اعلام می‌شود."
    index="متراژ / وضعیت"
    note={app.data.releaseNote}
    signals={[
      app.data.minOs,
      `به‌روزرسانی بازار: ${storeUpdatedAt}`,
      `بازبینی لینک: ${storeCheckedAt}`,
    ]}
    tone="apricot"
  >
    <div slot="actions" class="page-stage-actions">
      {
        bazaarLink && (
          <a
            class="button"
            href={getTrackedCafeBazaarUrl(bazaarLink.url, 'status_hero')}
            target="_blank"
            rel="noopener"
          >
            دانلود از کافه‌بازار
          </a>
        )
      }
      <a class="page-stage-link" href="/apps/metrazh/">بازگشت به معرفی متراژ</a>
      <a class="page-stage-link" href="/apps/metrazh/changelog/"
        >تاریخچهٔ نسخه‌ها</a
      >
    </div>
  </PageStage>

  <section class="page-section" aria-labelledby="release-path-title">
    <div class="shell release-status-header">
      <div>
        <p class="eyebrow">مسیر انتشار</p>
        <h2 id="release-path-title">
          هر مرحله فقط پس از تأیید واقعی جلو می‌رود.
        </h2>
      </div>
      <p>
        این وضعیت برای جلوگیری از انتشار لینک‌های نامعتبر یا وعده‌های مبهم ثبت
        می‌شود. آخرین اطلاعات تأییدشده همیشه در همین صفحه قرار می‌گیرد.
      </p>
    </div>

    <div class="shell release-status-grid">
      {
        releaseCheckpoints.map((checkpoint) => (
          <article data-status={checkpoint.status}>
            <div>
              <span class="status-dot" aria-hidden="true" />
              <p>{checkpoint.eyebrow}</p>
            </div>
            <h3>{checkpoint.title}</h3>
            <p>{checkpoint.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="page-section page-section-ink"
    aria-labelledby="version-title"
  >
    <div class="shell release-version-layout">
      <div>
        <p class="eyebrow">یادداشت نسخه فعلی</p>
        <h2 id="version-title">متراژ {app.data.version}</h2>
        <p>
          این شماره، نسخه عمومی فعلی متراژ در کافه‌بازار است. صفحهٔ بازار در
          {storeCheckedAt} بررسی شد و آخرین به‌روزرسانی را {storeUpdatedAt} نشان می‌دهد.
          به‌روزرسانی بعدی فقط پس از قابل‌دریافت‌شدن برای کاربران در این صفحه ثبت
          می‌شود.
        </p>
      </div>
      <ul>
        {releasePrinciples.map((principle) => <li>{principle}</li>)}
      </ul>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell cta-panel">
      <p class="eyebrow">دانلود رسمی</p>
      <h2>متراژ را از کافه‌بازار دریافت کنید.</h2>
      <p>این لینک به صفحه عمومی و تأییدشده متراژ در کافه‌بازار متصل است.</p>
      <div class="cta-actions">
        {
          bazaarLink && (
            <a
              class="button"
              href={getTrackedCafeBazaarUrl(bazaarLink.url, 'status_download')}
              target="_blank"
              rel="noopener"
            >
              دانلود از کافه‌بازار
            </a>
          )
        }
        <a class="button button-secondary" href="/support/">پشتیبانی رسمی</a>
      </div>
    </div>
  </section>
</BaseLayout>
