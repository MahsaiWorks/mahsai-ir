---
import { getCollection } from 'astro:content';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import StoreBadge from '../../../components/StoreBadge.astro';
import { siteConfig } from '../../../config/site';
import { getCafeBazaarLink } from '../../../data/appPresentation';
import { metrazhDirectRelease as direct } from '../../../data/metrazhDirectRelease';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
if (!bazaarLink) throw new Error('Published Cafe Bazaar link is missing.');

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const appId = new URL('/apps/metrazh/#software', Astro.site).toString();
const organizationId = new URL('/#organization', Astro.site).toString();
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const installSteps = [
  {
    title: 'نسخهٔ مستقیم را دریافت کنید',
    description:
      'روی «دانلود مستقیم متراژ» بزنید و فایل متراژ را از همین سایت دریافت کنید. دریافت و نصب برنامه رایگان است.',
  },
  {
    title: 'فایل دانلودشده را باز کنید',
    description: `نسخهٔ مستقیم ${direct.versionFa} روی ${direct.minOs} نصب می‌شود. اگر اندروید درخواست کرد، اجازهٔ نصب را برای همان مرورگر یا برنامهٔ فایل‌ها فعال کنید.`,
  },
  {
    title: 'نصب یا به‌روزرسانی را تأیید کنید',
    description:
      'اگر متراژ را دارید، فایل جدید را روی همان برنامه نصب کنید؛ برنامهٔ قبلی را حذف نکنید. فایل‌ها، مشتری‌ها و اطلاعات فعلی شما در به‌روزرسانی حفظ می‌شوند.',
  },
  {
    title: 'کارهای روزانه‌تان را یک‌جا پیش ببرید',
    description:
      'اولین فایل و مشتری را ثبت کنید، پیشنهادهای تطبیق را ببینید و برای بازدید و پیگیری بعدی یادآوری بگذارید.',
  },
] as const;

const faqs = [
  {
    question: 'لینک رسمی دانلود متراژ کدام است؟',
    answer:
      'متراژ را از دکمهٔ دانلود مستقیم همین صفحه یا صفحهٔ رسمی آن در کافه‌بازار دریافت کنید. هر دو نسخه شناسهٔ ir.fileryar.amlakyar دارند.',
  },
  {
    question: 'آیا دانلود و نصب متراژ رایگان است؟',
    answer:
      'بله. نصب رایگان است و برای امکانات اشتراکی، پلن ماهانه یا سالانه را داخل برنامه انتخاب می‌کنید. خرید جدید نسخهٔ سایت از طریق زیبال انجام می‌شود و تمدید خودکار ندارد.',
  },
  {
    question: 'با نصب نسخهٔ سایت، اطلاعات و خرید قبلی من چه می‌شود؟',
    answer:
      'با نصب روی برنامهٔ فعلی، اطلاعات شما حفظ می‌شود. خریدهای بازار را از گزینهٔ «قبلاً از بازار خریده‌ام» بازیابی و مدیریت کنید؛ برای این کار بازار و حساب خریدار باید در دسترس باشند. خرید مستقیم با شمارهٔ همراه تأییدشده بازیابی می‌شود.',
  },
  {
    question: 'متراژ روی چه نسخه‌ای از اندروید نصب می‌شود؟',
    answer: `نسخهٔ مستقیم روی ${direct.minOs} نصب می‌شود. اگر نصب انجام نشد، متن خطا را برای پشتیبانی بفرستید؛ برنامهٔ فعلی را حذف نکنید.`,
  },
  {
    question: 'برای انتقال اطلاعات به گوشی جدید چه کار کنم؟',
    answer:
      'پیش از تعویض گوشی، نسخهٔ پشتیبان رمزگذاری‌شده بسازید و فایل و رمز را جدا و امن نگه دارید. سپس مسیر بازیابی را روی گوشی مقصد اجرا کنید.',
  },
  {
    question: 'اگر نصب یا به‌روزرسانی انجام نشد چه کنم؟',
    answer:
      'فضای خالی، کامل‌شدن دانلود، اجازهٔ نصب برای مرورگر و نسخهٔ اندروید را بررسی کنید. اگر مشکل ادامه داشت، مشخصات نسخه و متن خطا را از صفحهٔ پشتیبانی بفرستید.',
  },
] as const;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: `دانلود متراژ برای اندروید؛ مستقیم و کافه‌بازار | ${siteConfig.brandName}`,
      description:
        'دانلود مستقیم نسخهٔ جدید متراژ برای اندروید؛ مدیریت فایل و مشتری، تطبیق پیشنهادها و مسیریابی بازدید، همراه راهنمای نصب و به‌روزرسانی.',
      inLanguage: 'fa-IR',
      about: { '@id': appId },
      publisher: { '@id': organizationId },
      potentialAction: {
        '@type': 'ViewAction',
        name: 'دانلود مستقیم متراژ برای اندروید',
        target: new URL(direct.downloadUrl, Astro.site).toString(),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'خانه',
          item: new URL('/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'اپلیکیشن متراژ',
          item: new URL('/apps/metrazh/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'دانلود و نصب متراژ',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={`دانلود متراژ برای اندروید؛ مستقیم و کافه‌بازار | ${siteConfig.brandName}`}
  description="دانلود مستقیم نسخهٔ جدید متراژ برای اندروید؛ مدیریت فایل و مشتری، تطبیق پیشنهادها و مسیریابی بازدید، همراه راهنمای نصب و به‌روزرسانی."
  image="/og-mahsai-metrazh-v2.jpg"
  imageAlt="دانلود رسمی متراژ، دستیار فارسی مشاور املاک از MAHSAI"
  imageWidth={1600}
  imageHeight={900}
  preloadImage="/images/apps/metrazh/current/workspace.webp"
  preloadImageWidth={1080}
  preloadImageSizes="(max-width: 56.25rem) 60vw, 21rem"
  keywords={[
    'دانلود متراژ',
    'دانلود برنامه متراژ',
    'نصب متراژ',
    'متراژ اندروید',
    'اپلیکیشن متراژ املاک',
    'دانلود برنامه مشاور املاک',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <header class="download-guide-hero">
    <div class="shell">
      <nav class="product-breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a><span aria-hidden="true">/</span>
        <a href="/apps/metrazh/">اپلیکیشن متراژ</a><span aria-hidden="true"
          >/</span
        >
        <span>دانلود و نصب</span>
      </nav>

      <div class="download-guide-hero-grid">
        <div>
          <p class="product-status-line">
            <span aria-hidden="true"></span> نسخهٔ رسمی اندروید
          </p>
          <h1>دانلود متراژ برای اندروید</h1>
          <p class="lead">
            برای هر مشتری فایل مناسب پیدا کنید، مسیر بازدید را باز کنید و پیگیری
            بعدی را به خاطر بسپارید. فایل‌ها، مشتری‌ها و کارهای روزانهٔ دفترتان
            را با متراژ یک‌جا پیش ببرید.
          </p>
          <div class="hero-actions">
            <a class="button" href={direct.downloadUrl} download>
              دانلود مستقیم متراژ
            </a>
            <StoreBadge href={bazaarLink.url} location="download_hero" />
          </div>
          <dl class="download-guide-facts">
            <div><dt>نسخهٔ مستقیم</dt><dd>{direct.versionFa}</dd></div>
            <div><dt>هزینهٔ دریافت</dt><dd>رایگان</dd></div>
            <div><dt>پرداخت داخل برنامه</dt><dd>دارد</dd></div>
            <div>
              <dt>آخرین بررسی فروشگاه</dt><dd>
                {formatDate(app.data.storeCheckedAt)}
              </dd>
            </div>
          </dl>
        </div>

        <figure class="download-guide-visual">
          <ResponsiveImage
            src="/images/apps/metrazh/current/workspace.webp"
            alt="میزکار متراژ با بازدیدها و پیگیری‌های نمونه"
            width="1080"
            height="2460"
            sizes="(max-width: 56.25rem) 68vw, 21rem"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </header>

  <section class="download-answer" aria-labelledby="download-answer-title">
    <div class="shell download-answer-grid">
      <div>
        <p class="section-sign section-sign-light">پاسخ کوتاه</p>
        <h2 id="download-answer-title">از کجا متراژ را دانلود کنیم؟</h2>
      </div>
      <div>
        <p>
          فایل APK رسمی را از همین سایت دریافت کنید یا از کافه‌بازار نصب کنید.
          نسخهٔ سایت خرید از زیبال و ورود با شمارهٔ همراه دارد؛ خریدهای قبلی
          بازار هم از بخش بازیابی خرید بازار قابل مدیریت هستند.
        </p>
        <StoreBadge href={bazaarLink.url} location="download_answer" light />
      </div>
    </div>
  </section>

  <section
    class="download-steps"
    aria-labelledby="download-steps-title"
    data-view-event="download_guide_viewed"
  >
    <div class="shell download-steps-layout">
      <header>
        <p class="section-sign">روش نصب</p>
        <h2 id="download-steps-title">نصب متراژ در چهار مرحله</h2>
        <p>اگر برنامه را دارید، نسخهٔ جدید را روی همان برنامه نصب کنید.</p>
      </header>
      <ol>
        {
          installSteps.map((step) => (
            <li>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="download-steps" aria-labelledby="direct-changes-title">
    <div class="shell download-steps-layout">
      <header>
        <p class="section-sign">تازه‌های نسخهٔ مستقیم {direct.versionFa}</p>
        <h2 id="direct-changes-title">دسترسی آسان‌تر به اطلاعات و اشتراک</h2>
      </header>
      <ul>
        {
          direct.changes.map((change) => (
            <li>
              <p>{change}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="download-readiness"
    aria-labelledby="download-readiness-title"
  >
    <div class="shell download-readiness-grid">
      <div>
        <p class="section-sign">قبل از واردکردن فایل‌ها</p>
        <h2 id="download-readiness-title">
          این سه نکته بعداً جلوی دردسر را می‌گیرد
        </h2>
      </div>
      <div class="download-readiness-list">
        <article>
          <h3>اطلاعات اصلی روی همان دستگاه است</h3>
          <p>
            نسخهٔ عمومی فعلی همگام‌سازی ابری اختصاصی ندارد؛ پس نگهداری گوشی و
            فایل پشتیبان اهمیت دارد.
          </p>
        </article>
        <article>
          <h3>پشتیبان را قبل از نیاز بسازید</h3>
          <p>
            فایل پشتیبان رمزگذاری‌شده و رمز آن را در دو جای امن و جدا نگه دارید
            و یک‌بار بازیابی آزمایشی انجام دهید.
          </p>
        </article>
        <article>
          <h3>نسخه را از منبع رسمی تازه کنید</h3>
          <p>
            برای به‌روزرسانی از همین صفحه یا کافه‌بازار استفاده کنید. نصب نسخهٔ
            جدید روی برنامهٔ فعلی، اطلاعات ثبت‌شدهٔ شما را حفظ می‌کند.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="download-next" aria-labelledby="download-next-title">
    <div class="shell download-next-grid">
      <div>
        <p class="section-sign section-sign-light">بعد از نصب</p>
        <h2 id="download-next-title">اولین فایل را درست ثبت کنید</h2>
        <p>
          یک آموزش رایگان آماده کرده‌ایم تا با یک فایل ساختگی، روش ثبت اطلاعات و
          کنترل کامل بودن فایل را یاد بگیرید.
        </p>
      </div>
      <div class="download-next-actions">
        <a
          class="button button-light"
          href="/academy/first-organized-property-file/"
        >
          شروع آموزش فایل مرتب
        </a>
        <a class="arrow-link arrow-link-light" href="/guides/property-files/">
          راهنمای جامع فایل‌گیری املاک <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <section
    class="metrazh-faq download-faq"
    aria-labelledby="download-faq-title"
  >
    <div class="shell metrazh-faq-layout">
      <header>
        <p class="section-sign">پرسش‌های دانلود و نصب</p>
        <h2 id="download-faq-title">قبل از نصب سؤال دارید؟</h2>
      </header>
      <div class="metrazh-faq-list">
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
        <p class="faq-footnote">
          مشکل حل نشد؟ از <a href="/support/">پشتیبانی رسمی متراژ</a> کمک بگیرید.
        </p>
      </div>
    </div>
  </section>

  <section class="metrazh-download" aria-labelledby="download-final-title">
    <div class="shell metrazh-download-grid">
      <div class="metrazh-download-brand">
        <ResponsiveImage
          src={app.data.icon}
          alt="نشان اپلیکیشن متراژ"
          width="512"
          height="512"
          sizes="6rem"
          loading="lazy"
          decoding="async"
        />
        <ResponsiveImage
          class="metrazh-wordmark-surface"
          src={app.data.wordmark}
          alt="متراژ"
          width="702"
          height="425"
          sizes="9rem"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <h2 id="download-final-title">فایل مرتب، مشتری مناسب، بازدید آماده</h2>
        <p>متراژ را رایگان دریافت کنید و اولین فایل و مشتری خود را ثبت کنید.</p>
      </div>
      <div class="metrazh-download-actions">
        <a class="button button-light" href={direct.downloadUrl} download>
          دانلود مستقیم متراژ
        </a>
        <StoreBadge href={bazaarLink.url} location="download_bottom" light />
        <a class="arrow-link arrow-link-light" href="/support/">
          پشتیبانی نصب <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
