---
import { getCollection } from 'astro:content';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import StoreBadge from '../../components/StoreBadge.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = app.data.storeLinks.find((link) =>
  link.url.includes('cafebazaar.ir'),
);
const productGuides = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      a.data.seriesOrder - b.data.seriesOrder,
  )
  .slice(0, 3);

const interfaceStories = [
  {
    moment: 'وقتی مشتری تماس می‌گیرد',
    title: 'تماس بعدی را از صفر شروع نمی‌کنید.',
    description:
      'بودجه، محله، نوع معامله و نکته‌های مهم را کنار نام مشتری نگه می‌دارید؛ دفعهٔ بعد دقیقاً می‌دانید گفت‌وگو کجا مانده بود.',
    outcome: 'اسم مشتری را بزنید؛ خواسته‌ها و یادداشت آخر روبه‌روی شماست.',
    image: '/images/apps/metrazh/ui/customers.webp',
    alt: 'فهرست مشتری‌ها و وضعیت پیگیری آن‌ها در متراژ',
  },
  {
    moment: 'وقتی فایل تازه می‌رسد',
    title: 'فایل تازه، قبل از گم‌شدن جای خودش را پیدا می‌کند.',
    description:
      'مشخصات فروش، رهن یا اجاره را همان موقع ثبت می‌کنید و بعد با کد، محله یا ویژگی‌های ملک پیدایش می‌کنید.',
    outcome: 'به‌جای ورق‌زدن دفتر و پیام‌ها، مستقیم سراغ همان فایل بروید.',
    image: '/images/apps/metrazh/ui/properties.webp',
    alt: 'فهرست فایل‌های فروش، رهن و اجاره در متراژ',
  },
  {
    moment: 'وقتی باید پیشنهاد بدهید',
    title: 'به‌جای حدس، چند گزینهٔ نزدیک‌تر برای بررسی دارید.',
    description:
      'متراژ خواسته‌های ثبت‌شدهٔ مشتری را با فایل‌های شما مقایسه می‌کند و دلیل هر پیشنهاد را هم نشان می‌دهد؛ انتخاب نهایی با خودتان است.',
    outcome: 'وقت شما برای بررسی گزینه‌های بی‌ربط کمتر گرفته می‌شود.',
    image: '/images/apps/metrazh/ui/matching.webp',
    alt: 'نمای پیشنهاد فایل بر اساس معیارهای ثبت‌شدهٔ مشتری در متراژ',
  },
] as const;

const capabilityGroups = [
  {
    title: 'فایل و مشتری را پیدا کنید',
    description:
      'هر چیزی که ثبت می‌کنید، بعداً با چند نشانهٔ آشنا پیدا می‌شود.',
    items: [
      'پروندهٔ فایل‌های فروش، رهن و اجاره',
      'پروندهٔ مشتری و محدودهٔ نیاز',
      'جست‌وجو و فیلتر برای رسیدن سریع‌تر به نتیجه',
    ],
  },
  {
    title: 'پیگیری را عقب نیندازید',
    description: 'نتیجهٔ تماس و بازدید می‌ماند تا قدم بعدی فراموش نشود.',
    items: [
      'ثبت بازدید و اقدام بعدی',
      'یادآوری کارهای زمان‌دار',
      'نگه‌داشتن ارتباط فایل و مشتری',
    ],
  },
  {
    title: 'پیشنهاد را سریع‌تر آماده کنید',
    description:
      'اطلاعاتی که یک‌بار ثبت شده در تصمیم و خروجی دوباره به کار می‌آید.',
    items: [
      'پیشنهاد فایل متناسب با معیار مشتری',
      'متن پیشنهادی آگهی از روی مشخصات ملک',
      'خروجی PDF، کاتالوگ و گزارش‌های کاری',
    ],
  },
  {
    title: 'کارهای ریز را همان‌جا انجام دهید',
    description: 'محاسبه و برنامه‌ریزی لازم از پروندهٔ اصلی کار جدا نمی‌ماند.',
    items: [
      'محاسبات پرکاربرد املاک',
      'برنامه‌ریزی مسیر بازدید',
      'پشتیبان‌گیری، بازیابی و قفل برنامه',
    ],
  },
] as const;

const faqs = [
  {
    question: 'اطلاعات فایل‌ها و مشتری‌ها کجا نگهداری می‌شوند؟',
    answer:
      'داده‌های اصلی روی همان دستگاه نگهداری می‌شوند و نسخهٔ عمومی فعلی همگام‌سازی ابری اختصاصی ندارد. جزئیات بیشتر در صفحهٔ حریم خصوصی آمده است.',
  },
  {
    question: 'آیا همهٔ بخش‌های برنامه به اینترنت نیاز دارند؟',
    answer:
      'بخش اصلی مدیریت اطلاعات محلی است. نقشه، خرید، تشخیص گفتار و بعضی مسیرهای اشتراک‌گذاری ممکن است به اینترنت یا برنامه‌های دیگر نیاز داشته باشند.',
  },
  {
    question: 'اگر گوشی عوض شود، چطور اطلاعات را منتقل کنم؟',
    answer:
      'پیش از جابه‌جایی باید خودتان نسخهٔ پشتیبان رمزگذاری‌شده بسازید و فایل و رمز آن را امن نگه دارید؛ سپس از مسیر بازیابی برنامه استفاده کنید.',
  },
  {
    question: 'متراژ برای مشاور مستقل است یا دفتر املاک؟',
    answer:
      'ساختار برنامه برای مشاور مستقل، مسئول فایل و مشتری و کار روزانهٔ دفتر املاک طراحی شده است. هر کاربر داده‌های همان دستگاه را مدیریت می‌کند.',
  },
  {
    question: 'متراژ روی چه گوشی‌هایی نصب می‌شود؟',
    answer: `${app.data.minOs} پشتیبانی می‌شود. برای نصب و به‌روزرسانی، صفحهٔ رسمی کافه‌بازار معیار است.`,
  },
  {
    question: 'نسخهٔ رسمی و پشتیبانی را از کجا بگیرم؟',
    answer:
      'دانلود و به‌روزرسانی فقط از صفحهٔ رسمی متراژ در کافه‌بازار انجام می‌شود. مسیرهای ایمیل و تلگرام رسمی در صفحهٔ پشتیبانی سایت قرار دارند.',
  },
] as const;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pageId = new URL('/apps/metrazh/#webpage', Astro.site).toString();
const appId = new URL('/apps/metrazh/#software', Astro.site).toString();
const organizationId = new URL('/#organization', Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageId,
      url: pageUrl,
      name: `متراژ؛ اپلیکیشن مدیریت فایل و مشتری املاک | ${siteConfig.brandName}`,
      description: app.data.shortDescription,
      inLanguage: 'fa-IR',
      mainEntity: { '@id': appId },
      about: { '@id': appId },
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': appId,
      name: app.data.name,
      alternateName: 'Metrazh',
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'مدیریت فایل و مشتری املاک',
      operatingSystem: 'ANDROID',
      softwareVersion: app.data.version,
      dateModified: app.data.storeUpdatedAt.toISOString(),
      description: app.data.shortDescription,
      url: pageUrl,
      mainEntityOfPage: { '@id': pageId },
      image: new URL(app.data.icon, Astro.site).toString(),
      downloadUrl: bazaarLink?.url,
      installUrl: bazaarLink?.url,
      sameAs: bazaarLink ? [bazaarLink.url] : undefined,
      author: { '@id': organizationId },
      publisher: { '@id': organizationId },
      inLanguage: 'fa-IR',
      softwareRequirements: app.data.minOs,
      featureList: app.data.features,
      releaseNotes: app.data.releaseNote,
      offers: {
        '@type': 'Offer',
        price: app.data.pricing.installPrice,
        priceCurrency: app.data.pricing.currency,
        url: bazaarLink?.url,
        availability: 'https://schema.org/InStock',
      },
      screenshot: app.data.screenshots.map((shot) =>
        new URL(shot.src, Astro.site).toString(),
      ),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'خانه',
          item: new URL('/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'محصولات MAHSAI',
          item: new URL('/apps/', Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'اپلیکیشن متراژ',
          item: pageUrl,
        },
      ],
    },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const videoStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  '@id': new URL('/apps/metrazh/#video', Astro.site).toString(),
  name: 'متراژ؛ وقتی مشتری تماس گرفته و دنبال فایل مناسب هستید',
  description:
    'روایتی کوتاه از پیدا کردن فایل مناسب برای مشتری و یک‌جا نگه‌داشتن فایل، مشتری و پیگیری در اپلیکیشن متراژ.',
  thumbnailUrl: new URL(
    '/images/apps/metrazh/metrazh-site-story-poster-v1.webp',
    Astro.site,
  ).toString(),
  uploadDate: '2026-08-21T11:19:02+03:30',
  duration: 'PT12S',
  contentUrl: new URL(
    '/videos/metrazh-site-story-v1.mp4',
    Astro.site,
  ).toString(),
  inLanguage: 'fa-IR',
  publisher: { '@id': organizationId },
  about: { '@id': appId },
  isPartOf: { '@id': pageId },
};
---

<BaseLayout
  title={`متراژ؛ اپلیکیشن مدیریت فایل و مشتری املاک | ${siteConfig.brandName}`}
  description={app.data.shortDescription}
  image="/og-mahsai-metrazh-v2.jpg"
  imageAlt="معرفی متراژ، دستیار فارسی مشاور املاک از MAHSAI"
  imageWidth={1600}
  imageHeight={900}
  preloadImage="/images/apps/metrazh/ui/properties.webp"
  preloadImageWidth={720}
  preloadImageSizes="(max-width: 56.25rem) 62vw, 22rem"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqStructuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(videoStructuredData)}
  />

  <header class="metrazh-product-hero">
    <div class="shell">
      <nav class="product-breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a><span aria-hidden="true">/</span>
        <a href="/apps/">محصولات</a><span aria-hidden="true">/</span>
        <span>متراژ</span>
      </nav>

      <div class="metrazh-product-grid">
        <div class="metrazh-hero-copy">
          <ResponsiveImage
            class="metrazh-title-wordmark metrazh-wordmark-dark"
            src={app.data.wordmark}
            alt="متراژ"
            width="702"
            height="425"
            sizes="(max-width: 56.25rem) 8.5rem, 9.5rem"
          />
          <h1>فایل‌ها، مشتری‌ها و پیگیری‌های امروز؛ همه یک‌جا در متراژ.</h1>
          <p class="lead">
            متراژ برای مشاور املاکی ساخته شده که می‌خواهد وسط تماس، مشخصات ملک و
            نیاز مشتری را سریع پیدا کند و پیگیری بعدی را از یاد نبرد.
          </p>
          <div class="hero-actions">
            {
              bazaarLink && (
                <StoreBadge href={bazaarLink.url} location="metrazh_hero" />
              )
            }
            <a class="arrow-link" href="#inside-metrazh">
              دیدن روش کار <span aria-hidden="true">←</span>
            </a>
          </div>
          <ul class="metrazh-hero-notes">
            <li>اطلاعات روی گوشی خودتان می‌ماند</li>
            <li>از اول برای زبان فارسی طراحی شده</li>
            <li>پشتیبانی فارسی از MAHSAI</li>
          </ul>
        </div>

        <div class="metrazh-hero-screen">
          <figure>
            <ResponsiveImage
              src="/images/apps/metrazh/ui/properties.webp"
              alt="نمای واقعی فهرست فایل‌های ملکی در متراژ"
              width="720"
              height="1600"
              sizes="(max-width: 56.25rem) 64vw, 22rem"
              fetchpriority="high"
            />
          </figure>
        </div>
      </div>
    </div>
  </header>

  <section class="metrazh-fact-band" aria-label="مشخصات نسخهٔ منتشرشده">
    <div class="shell">
      <dl>
        <div><dt>نسخهٔ منتشرشده</dt><dd>{app.data.version}</dd></div>
        <div><dt>سیستم‌عامل</dt><dd>{app.data.minOs}</dd></div>
        <div><dt>محل دریافت</dt><dd>کافه‌بازار</dd></div>
        <div><dt>وضعیت</dt><dd>قابل دانلود</dd></div>
      </dl>
    </div>
  </section>

  <section
    class="metrazh-site-story"
    aria-labelledby="metrazh-site-story-title"
    data-view-event="metrazh_site_story_seen"
  >
    <div class="shell metrazh-site-story-shell">
      <header>
        <p class="section-sign">یک موقعیت واقعی</p>
        <h2 id="metrazh-site-story-title">
          مشتری تماس گرفته؛ فایل مناسب کجاست؟
        </h2>
        <p id="metrazh-site-story-description">
          وقتی نیاز مشتری و مشخصات فایل‌ها ثبت شده باشند، متراژ گزینه‌های
          نزدیک‌تر را برای بررسی کنار هم می‌گذارد.
        </p>
      </header>

      <div class="metrazh-site-story-stage">
        <div class="metrazh-site-story-video" data-install-dock-trigger>
          <video
            controls
            playsinline
            preload="none"
            poster="/images/apps/metrazh/metrazh-site-story-poster-v1.webp"
            aria-label="ویدیوی متراژ درباره پیدا کردن فایل مناسب برای مشتری"
            aria-describedby="metrazh-site-story-description"
          >
            <source src="/videos/metrazh-site-story-v1.mp4" type="video/mp4" />
            مرورگر شما نمایش ویدیو را پشتیبانی نمی‌کند.
          </video>
        </div>
      </div>
    </div>
  </section>

  <section
    class="metrazh-definition"
    aria-labelledby="metrazh-definition-title"
  >
    <div class="shell metrazh-definition-grid">
      <div>
        <p class="section-sign">معرفی کوتاه</p>
        <h2 id="metrazh-definition-title">
          متراژ چه کاری برای مشاور املاک انجام می‌دهد؟
        </h2>
      </div>
      <div>
        <p>
          دفترچه برای یادداشت خوب است، واتساپ برای گفت‌وگو و گالری برای عکس؛ اما
          وقتی اطلاعات یک مشتری بین هر سه پخش می‌شود، پیدا کردنش وقت می‌گیرد.
          متراژ این تکه‌ها را در یک پروندهٔ قابل جست‌وجو کنار هم می‌گذارد.
        </p>
        <p>
          دریافت برنامه رایگان است و بعضی امکانات پرداخت درون‌برنامه‌ای دارند.
          نسخهٔ رسمی فقط از کافه‌بازار منتشر می‌شود.
        </p>
        <a class="arrow-link" href="/apps/metrazh/download/">
          دانلود رسمی اپلیکیشن متراژ <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  <section
    id="inside-metrazh"
    class="interface-tour"
    aria-labelledby="interface-tour-title"
  >
    <div class="shell">
      <header class="interface-tour-head">
        <p class="section-sign">سه موقعیت آشنا در کار روزانه</p>
        <h2 id="interface-tour-title">
          ببینید متراژ در کار روزانه چطور استفاده می‌شود
        </h2>
        <p>
          این‌ها ماکت تبلیغاتی نیستند؛ سه تصویر از خود برنامه‌اند، کنار همان
          لحظه‌ای که در کار روزانه به آن‌ها نیاز پیدا می‌کنید.
        </p>
      </header>

      <div
        class="interface-story-list"
        data-view-event="metrazh_interface_seen"
      >
        {
          interfaceStories.map((story, index) => (
            <article
              class:list={[
                'interface-story',
                { 'interface-story-reverse': index % 2 === 1 },
              ]}
            >
              <figure>
                <ResponsiveImage
                  src={story.image}
                  alt={story.alt}
                  width="720"
                  height="1600"
                  sizes="(max-width: 56.25rem) 72vw, 23rem"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div>
                <p class="story-moment">{story.moment}</p>
                <h3>{story.title}</h3>
                <p>{story.description}</p>
                <strong>{story.outcome}</strong>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="capability-ledger" aria-labelledby="capability-ledger-title">
    <div class="shell capability-ledger-layout">
      <header>
        <p class="section-sign section-sign-light">امکانات نسخهٔ فعلی</p>
        <h2 id="capability-ledger-title">
          کارهای تکراری دفتر را یک‌جا انجام دهید
        </h2>
        <p>
          هر بخش برای یکی از کارهای روزمرهٔ دفتر املاک ساخته شده است. فقط
          امکاناتی را می‌بینید که در نسخهٔ فعلی وجود دارند.
        </p>
        <div class="ledger-links">
          <a href="/apps/metrazh/status/">وضعیت رسمی انتشار ←</a>
          <a href="/apps/metrazh/changelog/">تاریخچهٔ نسخه‌ها ←</a>
        </div>
      </header>
      <div class="capability-group-list">
        {
          capabilityGroups.map((group) => (
            <article>
              <div>
                <h3>{group.title}</h3>
                <p>{group.description}</p>
              </div>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="metrazh-data-home" aria-labelledby="metrazh-data-home-title">
    <div class="shell metrazh-data-home-panel">
      <header class="metrazh-data-home-head">
        <div>
          <p class="section-sign">قبل از وارد کردن اطلاعات واقعی</p>
          <h2 id="metrazh-data-home-title">اطلاعات من کجا می‌ماند؟</h2>
        </div>
        <p>
          جواب کوتاه: فایل‌های ملک، اطلاعات مشتری و پیگیری‌ها روی همان گوشی
          نگهداری می‌شوند؛ نسخهٔ عمومی فعلی حساب ابری برای این داده‌ها ندارد.
        </p>
      </header>

      <div class="metrazh-data-home-grid">
        <article>
          <strong>روی همین گوشی</strong>
          <p>
            اطلاعات اصلی داخل حافظهٔ برنامه می‌ماند و تا وقتی خودتان آن را پاک
            نکنید، دادهٔ برنامه را حذف نکنید یا برنامه را پاک نکنید باقی
            می‌ماند.
          </p>
        </article>
        <article>
          <strong>وقت تعویض گوشی</strong>
          <p>
            باید از داخل متراژ فایل پشتیبان رمزگذاری‌شده بسازید و فایل و رمز آن
            را جدا نگه دارید؛ انتقال خودکار ابری انجام نمی‌شود.
          </p>
        </article>
        <article>
          <strong>هنگام استفاده از سرویس‌های دیگر</strong>
          <p>
            نقشه، خرید، تشخیص گفتار و اشتراک‌گذاری ممکن است به اینترنت یا
            برنامه‌های دیگر نیاز داشته باشند و تابع مقررات همان سرویس‌ها هستند.
          </p>
        </article>
      </div>

      <div class="metrazh-data-home-note">
        <p>
          اگر اطلاعات گوشی پاک شود و فایل پشتیبان سالم نداشته باشید، MAHSAI
          نسخه‌ای روی سرور ندارد که آن را برگرداند.
        </p>
        <a class="arrow-link" href="/privacy/">
          جزئیات حریم خصوصی متراژ <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>

  {
    productGuides.length > 0 && (
      <section class="metrazh-guides" aria-labelledby="metrazh-guides-title">
        <div class="shell metrazh-guides-layout">
          <header>
            <p class="section-sign">آموزش‌های متراژ</p>
            <h2 id="metrazh-guides-title">
              کار با متراژ را با آموزش‌های کوتاه یاد بگیرید
            </h2>
            <p>
              هر راهنما یک سؤال واقعی را جواب می‌دهد و با کاری تمام می‌شود که
              همان روز می‌توانید در متراژ انجامش دهید.
            </p>
            <a class="arrow-link" href="/academy/">
              همهٔ آموزش‌ها <span aria-hidden="true">←</span>
            </a>
          </header>
          <div class="guide-ledger">
            {productGuides.map((guide) => (
              <article>
                <p>
                  {guide.data.category} · {guide.data.readingTime}
                </p>
                <h3>
                  <a href={`/articles/${guide.id}/`}>{guide.data.title}</a>
                </h3>
                <span>{guide.data.description}</span>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="metrazh-faq" aria-labelledby="metrazh-faq-title">
    <div class="shell metrazh-faq-layout">
      <header>
        <p class="section-sign">پیش از نصب</p>
        <h2 id="metrazh-faq-title">قبل از نصب، چه چیزی می‌خواهید بدانید؟</h2>
        <p>
          دربارهٔ نگهداری داده، اینترنت، انتقال اطلاعات و نسخهٔ رسمی، جواب روشن
          و کوتاه را همین‌جا بخوانید.
        </p>
      </header>
      <div class="metrazh-faq-list">
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
        <p class="faq-footnote">
          جزئیات بیشتر در <a href="/privacy/">حریم خصوصی</a> و راه‌های تماس در
          <a href="/support/"> پشتیبانی رسمی</a> قرار دارد.
        </p>
      </div>
    </div>
  </section>

  <section class="metrazh-download" aria-labelledby="metrazh-download-title">
    <div class="shell metrazh-download-grid">
      <div class="metrazh-download-brand">
        <ResponsiveImage
          src={app.data.icon}
          alt="نشان اپلیکیشن متراژ"
          width="512"
          height="512"
          sizes="6rem"
          loading="lazy"
          decoding="async"
        />
        <ResponsiveImage
          class="metrazh-wordmark-surface"
          src={app.data.wordmark}
          alt="متراژ"
          width="702"
          height="425"
          sizes="9rem"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div>
        <h2 id="metrazh-download-title">
          متراژ را نصب کنید و اولین فایل را مرتب ثبت کنید
        </h2>
        <p>نصب و به‌روزرسانی فقط از صفحهٔ رسمی متراژ در کافه‌بازار.</p>
      </div>
      <div class="metrazh-download-actions">
        {
          bazaarLink && (
            <StoreBadge href={bazaarLink.url} location="metrazh_bottom" light />
          )
        }
        <a class="arrow-link arrow-link-light" href="/support/">
          نیاز به راهنمایی دارید؟ <span aria-hidden="true">←</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
