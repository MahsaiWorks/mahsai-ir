---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import StoreBadge from '../../components/StoreBadge.astro';
import { siteConfig } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh' && entry.data.status === 'available',
);

if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = app.data.storeLinks.find((link) =>
  link.url.includes('cafebazaar.ir'),
);
const productGuides = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      a.data.seriesOrder - b.data.seriesOrder,
  )
  .slice(0, 3);

const benefits = [
  {
    title: 'فایل‌ها قابل پیدا کردن می‌مانند',
    description:
      'مشخصات، تصویر، مالک و موقعیت هر ملک در یک پروندهٔ ساختاریافته قرار می‌گیرد.',
  },
  {
    title: 'نیاز مشتری فراموش نمی‌شود',
    description:
      'بودجه، محدوده و معیارهای متقاضی ثبت می‌شوند تا هر گفت‌وگو از صفر شروع نشود.',
  },
  {
    title: 'بازدید و پیگیری ادامه پیدا می‌کند',
    description:
      'نتیجهٔ بازدید، یادآوری و اقدام بعدی کنار همان فایل و مشتری باقی می‌ماند.',
  },
  {
    title: 'خروجی آماده‌تر است',
    description:
      'برای آگهی، گزارش و محاسبات کاری از اطلاعات ثبت‌شده استفاده می‌کنید.',
  },
] as const;

const quickStart = [
  {
    title: 'نیاز یک مشتری را ثبت کنید',
    description:
      'نوع درخواست، اولویت و محدودهٔ نیاز را بنویسید تا پیگیری بعدی از حافظه شروع نشود.',
    image: '/images/apps/metrazh/bazaar/customer-follow-up.webp',
    alt: 'معرفی رسمی پیگیری مشتری در متراژ',
  },
  {
    title: 'فایل‌های نزدیک‌تر را مقایسه کنید',
    description:
      'با تطبیق سراسری، فایل‌ها و مشتری‌های نزدیک‌تر را برای بررسی اولیه کنار هم ببینید.',
    image: '/images/apps/metrazh/bazaar/smart-matching.webp',
    alt: 'معرفی رسمی تطبیق هوشمند فایل و مشتری در متراژ',
  },
  {
    title: 'از روی فایل، متن آگهی بسازید',
    description:
      'اطلاعات ثبت‌شدهٔ ملک را به یک متن پیشنهادی تبدیل کنید و قبل از انتشار خودتان بازبینی‌اش کنید.',
    image: '/images/apps/metrazh/bazaar/smart-listing.webp',
    alt: 'معرفی رسمی ساخت آگهی از اطلاعات فایل در متراژ',
  },
  {
    title: 'بازدیدها را روی مسیر بچینید',
    description:
      'مبدأ و مقصد بازدیدها را مشخص کنید تا رفت‌وآمد روزانه منظم‌تر پیش برود.',
    image: '/images/apps/metrazh/bazaar/visit-routing.webp',
    alt: 'معرفی رسمی برنامه‌ریزی بازدیدها در متراژ',
  },
] as const;

const realScenarios = [
  {
    label: 'فایل تازه از مالک',
    title: 'اطلاعات تماس و ملک در پیام‌ها گم نمی‌شود',
    description:
      'همان زمان تماس، پروندهٔ ملک را بسازید، منبع فایل و اطلاعات مالک را ثبت کنید و موارد ناقص را برای تماس بعدی نگه دارید.',
    outcome: 'نتیجه: هنگام معرفی، یک پروندهٔ قابل جست‌وجو دارید.',
    image: '/images/apps/metrazh/bazaar/smart-listing.webp',
    alt: 'معرفی رسمی آماده‌سازی آگهی ملک در متراژ',
  },
  {
    label: 'مراجعهٔ مشتری',
    title: 'معیارهای متقاضی به یک فهرست روشن تبدیل می‌شود',
    description:
      'بودجه، محدوده، نوع معامله و اولویت‌ها را کنار نام متقاضی ثبت کنید تا فایل‌های نزدیک‌تر را هدفمندتر بررسی کنید.',
    outcome: 'نتیجه: معرفی فایل از حدس و حافظه فاصله می‌گیرد.',
    image: '/images/apps/metrazh/bazaar/smart-matching.webp',
    alt: 'معرفی رسمی تطبیق نیاز متقاضی با فایل در متراژ',
  },
  {
    label: 'بعد از بازدید',
    title: 'نتیجهٔ بازدید و تماس بعدی نیمه‌کاره نمی‌ماند',
    description:
      'بازخورد مشتری را ثبت کنید، اقدام بعدی را بنویسید و برای پیگیری زمان بگذارید.',
    outcome: 'نتیجه: پرونده می‌گوید قدم بعدی چیست.',
    image: '/images/apps/metrazh/bazaar/visit-routing.webp',
    alt: 'معرفی رسمی ثبت موقعیت و برنامه‌ریزی بازدید در متراژ',
  },
] as const;

const featureBenefits = [
  {
    feature: 'پروندهٔ کامل ملک',
    detail: 'تصویر، مدرک، مالک، قیمت، امکانات و موقعیت در یک رکورد می‌ماند.',
    benefit:
      'برای پیدا کردن جزئیات میان دفتر، گالری و پیام‌رسان جابه‌جا نمی‌شوید.',
  },
  {
    feature: 'پروندهٔ مشتری و متقاضی',
    detail: 'نیاز، بودجه، محدوده و پیگیری هر متقاضی ثبت می‌شود.',
    benefit: 'گفت‌وگوی بعدی با اطلاعات قبلی ادامه پیدا می‌کند.',
  },
  {
    feature: 'جست‌وجو و فیلتر فایل',
    detail: 'فایل‌های فروش، رهن و اجاره با معیارهای کاری محدود می‌شوند.',
    benefit: 'به‌جای مرور همهٔ موارد، زودتر به گزینهٔ مرتبط می‌رسید.',
  },
  {
    feature: 'تطبیق فایل و متقاضی',
    detail: 'معیار ثبت‌شدهٔ مشتری با فایل‌های موجود کنار هم قرار می‌گیرد.',
    benefit: 'فهرست اولیهٔ بررسی کوتاه‌تر و هدفمندتر می‌شود.',
  },
  {
    feature: 'بازدید و یادآوری',
    detail: 'بازدیدهای کاری و اقدام‌های زمان‌دار در برنامه ثبت می‌شوند.',
    benefit: 'کار بعدی وسط شلوغی دفتر جا نمی‌ماند.',
  },
  {
    feature: 'دستیار آگهی هوشمند',
    detail: 'از اطلاعات ثبت‌شدهٔ ملک، متن پیشنهادی آگهی ساخته می‌شود.',
    benefit: 'دوباره‌نویسی کمتر و خروجی یکدست‌تر می‌شود.',
  },
  {
    feature: 'محاسبات پرکاربرد املاک',
    detail: 'کمیسیون، رهن و اجاره، اقساط، مشارکت و تبدیل واحد در دسترس است.',
    benefit: 'محاسبه‌های روزمره از پروندهٔ کار جدا نمی‌ماند.',
  },
  {
    feature: 'مسیریاب بازدید',
    detail: 'مبدأ و مقصد بازدیدها برای برنامه‌ریزی رفت‌وآمد انتخاب می‌شوند.',
    benefit: 'مسیر بازدیدهای روزانه روشن‌تر و منظم‌تر می‌شود.',
  },
  {
    feature: 'خروجی PDF',
    detail:
      'فایل مشخصات ملک، کاتالوگ و قرارداد از اطلاعات ثبت‌شده ساخته می‌شود.',
    benefit: 'اطلاعات یک‌بار ثبت می‌شود و در خروجی‌های کاری به کار می‌رود.',
  },
  {
    feature: 'پشتیبان‌گیری و امنیت',
    detail:
      'پشتیبان‌گیری و بازیابی فایل همراه با تنظیمات امنیت و قفل در دسترس است.',
    benefit: 'برای بازیابی اطلاعات و محدودکردن دسترسی، مسیر مشخص‌تری دارید.',
  },
] as const;

const faqs = [
  {
    question: 'اطلاعات فایل‌ها و مشتری‌ها کجا نگهداری می‌شوند؟',
    answer:
      'داده‌های اصلی روی همان دستگاه نگهداری می‌شوند و نسخهٔ عمومی فعلی همگام‌سازی ابری اختصاصی ندارد. جزئیات بیشتر در صفحهٔ حریم خصوصی آمده است.',
  },
  {
    question: 'آیا همهٔ بخش‌های برنامه به اینترنت نیاز دارند؟',
    answer:
      'بخش اصلی مدیریت اطلاعات محلی است. نقشه، خرید، تشخیص گفتار و بعضی مسیرهای اشتراک‌گذاری ممکن است به اینترنت یا برنامه‌های دیگر نیاز داشته باشند.',
  },
  {
    question: 'اگر گوشی عوض شود، چطور اطلاعات را منتقل کنم؟',
    answer:
      'پیش از جابه‌جایی باید خودتان نسخهٔ پشتیبان رمزگذاری‌شده بسازید و فایل و رمز آن را امن نگه دارید؛ سپس از مسیر بازیابی برنامه استفاده کنید.',
  },
  {
    question: 'متراژ برای مشاور مستقل است یا دفتر املاک؟',
    answer:
      'ساختار برنامه برای مشاور مستقل، مسئول فایل و مشتری و کار روزانهٔ دفتر املاک طراحی شده است. هر کاربر داده‌های همان دستگاه را مدیریت می‌کند.',
  },
  {
    question: 'متراژ روی چه گوشی‌هایی نصب می‌شود؟',
    answer: `${app.data.minOs} پشتیبانی می‌شود. برای نصب و به‌روزرسانی، صفحهٔ رسمی کافه‌بازار معیار است.`,
  },
  {
    question: 'نسخهٔ رسمی و پشتیبانی را از کجا بگیرم؟',
    answer:
      'دانلود و به‌روزرسانی فقط از صفحهٔ رسمی متراژ در کافه‌بازار انجام می‌شود. مسیرهای ایمیل و تلگرام رسمی در صفحهٔ پشتیبانی سایت قرار دارند.',
  },
] as const;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.data.name,
  alternateName: 'Metrazh',
  applicationCategory: 'BusinessApplication',
  operatingSystem: app.data.minOs,
  softwareVersion: app.data.version,
  dateModified: app.data.storeUpdatedAt.toISOString(),
  description: app.data.shortDescription,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: new URL(app.data.icon, Astro.site).toString(),
  downloadUrl: bazaarLink?.url,
  sameAs: bazaarLink ? [bazaarLink.url] : undefined,
  author: { '@type': 'Organization', name: siteConfig.brandName },
  inLanguage: 'fa-IR',
  screenshot: app.data.screenshots.map((shot) =>
    new URL(shot.src, Astro.site).toString(),
  ),
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={`متراژ؛ اپلیکیشن مدیریت فایل و مشتری املاک | ${siteConfig.brandName}`}
  description={app.data.shortDescription}
  image="/og-metrazh-display-v1.png"
  imageAlt="معرفی اپلیکیشن متراژ برای مشاوران املاک"
  imageWidth={1200}
  imageHeight={630}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqStructuredData)}
  />

  <header class="metrazh-hero" data-view-event="metrazh_page_view">
    <div class="shell metrazh-hero-grid">
      <div class="metrazh-hero-copy">
        <p class="kicker">ساخته‌شده برای مشاوران املاک ایران</p>
        <img
          class="metrazh-wordmark metrazh-wordmark-dark"
          src={app.data.wordmark}
          alt="متراژ"
          width="702"
          height="425"
        />
        <h1>فایل، مشتری و پیگیری؛ بدون دفترهای پراکنده.</h1>
        <p class="lead">
          متراژ اپلیکیشن فارسی اندروید برای مدیریت کار روزانهٔ مشاور املاک است؛
          از ثبت فایل و نیاز مشتری تا بازدید، یادآوری و خروجی‌های کاری.
        </p>
        <div class="hero-actions">
          {
            bazaarLink && (
              <StoreBadge href={bazaarLink.url} location="metrazh_hero" />
            )
          }
          <a
            class="text-link"
            href="#screenshots"
            data-event="metrazh_screenshots_open"
            data-event-location="metrazh_hero">دیدن محیط برنامه ←</a
          >
        </div>
        <ul class="trust-list">
          <li>نسخهٔ {app.data.version}</li>
          <li>{app.data.minOs}</li>
          <li>رابط کامل فارسی</li>
        </ul>
      </div>

      <div class="metrazh-device-stage" aria-label="تصاویر رسمی متراژ">
        <div class="metrazh-orbit" aria-hidden="true"></div>
        <figure class="device-card device-card-back">
          <img
            src="/images/apps/metrazh/bazaar/smart-matching.webp"
            alt="معرفی رسمی تطبیق هوشمند فایل و مشتری در متراژ"
            width="1080"
            height="1920"
          />
        </figure>
        <figure class="device-card device-card-front">
          <img
            src="/images/apps/metrazh/bazaar/customer-follow-up.webp"
            alt="معرفی رسمی پیگیری نیاز مشتری در متراژ"
            width="1080"
            height="1920"
          />
        </figure>
        <span class="release-chip">منتشرشده در کافه‌بازار</span>
        {
          bazaarLink && (
            <aside class="desktop-install-qr">
              <img
                src="/images/apps/metrazh/bazaar-qr.png"
                alt="رمزینهٔ صفحهٔ رسمی متراژ در کافه‌بازار"
                width="512"
                height="512"
              />
              <span>
                <strong>نصب با گوشی</strong>
                <small>دوربین را روی رمزینه بگیرید</small>
              </span>
            </aside>
          )
        }
      </div>
    </div>
  </header>

  {
    bazaarLink && (
      <a
        class="mobile-install-dock"
        href={bazaarLink.url}
        target="_blank"
        rel="noopener"
        data-event="metrazh_bazaar_click"
        data-event-location="mobile_sticky_install"
      >
        <img
          src="/images/apps/metrazh/icon-app-official.webp"
          alt=""
          width="512"
          height="512"
        />
        <span>
          <strong>متراژ</strong>
          <small>نسخهٔ رسمی کافه‌بازار</small>
        </span>
        <b>نصب</b>
      </a>
    )
  }

  <section class="section problem-solution" aria-labelledby="benefits-title">
    <div class="shell problem-solution-grid">
      <figure>
        <img
          src="/images/editorial/property-workflow.webp"
          alt="میز کار املاک با پرونده‌ها، نقشه و ماکت ساختمان"
          width="1536"
          height="1024"
        />
        <figcaption>
          هدف متراژ ساده است: اطلاعات کاری از دست نرود و اقدام بعدی روشن بماند.
        </figcaption>
      </figure>
      <div>
        <p class="kicker">از پراکندگی تا جریان مشخص</p>
        <h2 id="benefits-title">
          چیزی که امروز ثبت می‌کنید، فردا پیدا می‌شود.
        </h2>
        <div class="benefit-grid">
          {
            benefits.map((benefit) => (
              <article>
                <h3>{benefit.title}</h3>
                <p>{benefit.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="metrazh-gallery"
    id="screenshots"
    aria-labelledby="gallery-title"
  >
    <div class="shell">
      <header class="section-head section-head-light">
        <div>
          <p class="kicker kicker-light">تصاویر رسمی کافه‌بازار</p>
          <h2 id="gallery-title">کاربرد متراژ را قبل از نصب ببینید.</h2>
        </div>
        <p>
          این پنج تصویر از صفحهٔ رسمی نسخهٔ عمومی متراژ در کافه‌بازار دریافت
          شده‌اند؛ یعنی نمایشی که می‌بینید مربوط به محصول منتشرشده است.
        </p>
      </header>
      <div class="screenshot-gallery">
        {
          app.data.screenshots.map((screenshot) => (
            <figure>
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                width="1080"
                height="1920"
                loading="lazy"
              />
              <figcaption>{screenshot.alt}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section product-quick-start"
    id="first-ten-minutes"
    aria-labelledby="quick-start-title"
    data-view-event="metrazh_quick_start_view"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">اولین ۱۰ دقیقه با متراژ</p>
          <h2 id="quick-start-title">
            با یک کار واقعی شروع کنید، نه تنظیمات طولانی.
          </h2>
        </div>
        <p>
          برای شناخت برنامه لازم نیست همهٔ بخش‌ها را یک‌جا پر کنید. این مسیر
          کوتاه کمک می‌کند همان روز اول یک پروندهٔ قابل استفاده بسازید.
        </p>
      </header>
      <div class="quick-start-grid">
        {
          quickStart.map((step) => (
            <article>
              <figure>
                <img
                  src={step.image}
                  alt={step.alt}
                  width="1080"
                  height="1920"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section metrazh-workflow"
    aria-labelledby="workflow-title"
    data-view-event="metrazh_scenarios_view"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">در دل روز کاری</p>
          <h2 id="workflow-title">
            سه موقعیت واقعی که متراژ در آن‌ها به کار می‌آید.
          </h2>
        </div>
        <p>
          برنامه جای تجربه و تصمیم مشاور را نمی‌گیرد؛ اطلاعات و اقدام بعدی را
          مرتب نگه می‌دارد تا کار از جایی روشن ادامه پیدا کند.
        </p>
      </header>
      <div class="scenario-grid">
        {
          realScenarios.map((scenario) => (
            <article>
              <div class="scenario-copy">
                <span>{scenario.label}</span>
                <h3>{scenario.title}</h3>
                <p>{scenario.description}</p>
                <strong>{scenario.outcome}</strong>
              </div>
              <figure>
                <img
                  src={scenario.image}
                  alt={scenario.alt}
                  width="1080"
                  height="1920"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="product-facts" aria-label="مشخصات متراژ">
    <div class="shell facts-grid">
      <div><span>پلتفرم</span><strong>اندروید</strong></div>
      <div><span>حداقل نسخه</span><strong>اندروید ۷</strong></div>
      <div><span>نسخهٔ فعلی</span><strong>{app.data.version}</strong></div>
      <div><span>وضعیت</span><strong>قابل دانلود</strong></div>
    </div>
  </section>

  <section
    class="section capability-section"
    aria-labelledby="capability-title"
  >
    <div class="shell capability-grid">
      <div>
        <p class="kicker">قابلیت و نتیجه</p>
        <h2 id="capability-title">
          هر ابزار دقیقاً چه چیزی را ساده‌تر می‌کند؟
        </h2>
        <p>
          این فهرست بر پایهٔ قابلیت‌های موجود نسخهٔ عمومی است. کنار هر قابلیت،
          نتیجهٔ عملی آن را هم نوشته‌ایم؛ بدون وعدهٔ آینده.
        </p>
        <a class="text-link" href="/apps/metrazh/status/">
          وضعیت رسمی انتشار ←
        </a>
      </div>
      <div class="capability-list">
        {
          featureBenefits.map((item) => (
            <article>
              <h3>{item.feature}</h3>
              <p>{item.detail}</p>
              <strong>{item.benefit}</strong>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    productGuides.length > 0 && (
      <section
        class="section latest-reading"
        aria-labelledby="product-guides-title"
      >
        <div class="shell">
          <header class="section-head">
            <div>
              <p class="kicker">آموزش مرتبط با متراژ</p>
              <h2 id="product-guides-title">
                روش را یاد بگیرید؛ داخل ابزار ادامه دهید.
              </h2>
            </div>
            <a class="text-link" href="/academy/">
              همهٔ آموزش‌ها ←
            </a>
          </header>
          <div class="editorial-grid">
            {productGuides.map((guide) => (
              <ArticleCard article={guide} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="shell faq-layout">
      <div>
        <p class="kicker">پیش از نصب</p>
        <h2 id="faq-title">پاسخ کوتاه به پرسش‌های مهم.</h2>
        <p>
          اگر پاسخ پرسش دیگری را پیدا نکردید، از صفحهٔ پشتیبانی با ما در ارتباط
          باشید.
        </p>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
        <p class="faq-footnote">
          جزئیات نگهداری داده در <a href="/privacy/">حریم خصوصی</a> و مسیرهای تماس
          در <a href="/support/">پشتیبانی رسمی</a> قرار دارد.
        </p>
      </div>
    </div>
  </section>

  <section class="download-panel">
    <div class="shell download-panel-grid">
      <img
        class="metrazh-wordmark-surface"
        src="/images/apps/metrazh/wordmark-dark.png"
        alt="متراژ"
        width="702"
        height="425"
      />
      <div>
        <h2>کار روزانه را از یک جای مشخص ادامه دهید.</h2>
        <p>برای نصب و به‌روزرسانی فقط از صفحهٔ رسمی کافه‌بازار استفاده کنید.</p>
      </div>
      <div class="download-panel-install">
        <img
          class="download-qr"
          src="/images/apps/metrazh/bazaar-qr.png"
          alt="رمزینهٔ نصب متراژ از کافه‌بازار"
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
        />
        {
          bazaarLink && (
            <StoreBadge href={bazaarLink.url} location="metrazh_bottom" light />
          )
        }
        <a class="text-link text-link-light" href="/support/">پشتیبانی ←</a>
      </div>
    </div>
  </section>
</BaseLayout>
