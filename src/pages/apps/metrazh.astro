---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import {
  metrazhStory,
  metrazhWorkflowComparison,
} from '../../data/metrazhStory';
import BaseLayout from '../../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).find(
  (entry) => entry.id === 'metrazh',
);

const productGuides = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.cluster !== 'legal')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

if (!app) {
  throw new Error('Metrazh content entry is missing.');
}

const releaseChannel = app.data.supportLinks.find((link) =>
  link.url.includes('t.me/metrazhapp'),
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.data.name,
  alternateName: 'Metrazh',
  applicationCategory: 'BusinessApplication',
  operatingSystem: app.data.minOs,
  softwareVersion: app.data.version,
  description: app.data.shortDescription,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  author: {
    '@type': 'Organization',
    name: siteConfig.brandName,
  },
  inLanguage: 'fa-IR',
};
---

<BaseLayout
  title={`متراژ؛ دستیار مشاوران املاک | ${siteConfig.brandName}`}
  description={app.data.shortDescription}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <section class="product-hero product-page-stage">
    <div class="shell product-hero-grid product-hero-frame">
      <div class="product-copy">
        <p class="product-brand-line">
          <span lang="en" dir="ltr">MAHSAI</span><i aria-hidden="true"></i> محصول
          اول
        </p>
        <div class="product-identity">
          <img
            class="product-wordmark"
            src={app.data.logo.dark}
            alt="لوگوی متراژ"
            width="190"
            height="115"
          />
          <div>
            <p class="eyebrow">اپلیکیشن اندروید</p>
            <p class="status-badge">در حال توسعه و پیش‌انتشار</p>
          </div>
        </div>
        <p class="product-kicker">مدیریت املاک، یکپارچه و در دسترس</p>
        <h1>فایل، مشتری و پیگیری؛ <span>بدون پراکندگی.</span></h1>
        <p class="product-tagline">{app.data.tagline}</p>
        <p class="page-lead">{app.data.fullDescription}</p>
        <div class="hero-actions">
          {
            releaseChannel && (
              <a
                class="button"
                href={releaseChannel.url}
                target="_blank"
                rel="noopener"
              >
                خبرم کن وقتی منتشر شد
              </a>
            )
          }
          <a class="button button-secondary" href="/apps/metrazh/status/">
            وضعیت انتشار
          </a>
        </div>
        <p class="release-note">{app.data.releaseNote}</p>
      </div>
      <div class="product-showcase" aria-label="پیش‌نمایش اپلیکیشن متراژ">
        <div class="product-device product-device-back" aria-hidden="true">
          <img src="/images/apps/metrazh/files.png" alt="" />
        </div>
        <div class="product-device product-device-front">
          <img
            src="/images/apps/metrazh/dashboard.png"
            alt="میز کار متراژ با برنامه‌های روزانه و دسترسی‌های سریع"
          />
        </div>
        <p class="showcase-note">
          <strong>طراحی‌شده برای فارسی</strong><span>تجربه کامل راست‌به‌چپ</span
          >
        </p>
      </div>
    </div>
  </section>

  <section
    class="product-origin-section"
    id="origin-story"
    aria-labelledby="origin-title"
  >
    <div class="shell product-origin-intro">
      <div>
        <p class="eyebrow">داستان شکل‌گیری</p>
        <h2 id="origin-title">{metrazhStory.title}</h2>
      </div>
      <p>{metrazhStory.lead}</p>
    </div>

    <div
      class="shell product-origin-markers"
      aria-label="چند نشانه از تجربه اولیه"
    >
      {
        metrazhStory.markers.map((marker) => (
          <article>
            <strong>{marker.value}</strong>
            <p>{marker.label}</p>
          </article>
        ))
      }
    </div>

    <div class="shell product-origin-chapters">
      {
        metrazhStory.chapters.map((chapter) => (
          <article>
            <span>{chapter.number}</span>
            <div>
              <h3>{chapter.title}</h3>
              <p>{chapter.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="shell product-origin-turning-point">
      <p class="eyebrow">نقطه تغییر</p>
      <p>{metrazhStory.turningPoint}</p>
      <strong>روایت سازنده متراژ</strong>
    </div>
  </section>

  <section class="product-compare-section" aria-labelledby="comparison-title">
    <div class="shell product-compare-header">
      <div>
        <p class="eyebrow">قبل و بعد</p>
        <h2 id="comparison-title">
          از دفترهای پراکنده به یک جریان قابل پیگیری.
        </h2>
      </div>
      <p>
        متراژ قرار نیست تجربه و مهارت مشاور را جایگزین کند؛ کارهای تکراری و
        اطلاعات پراکنده را منظم می‌کند تا تصمیم و ارتباط انسانی جای بیشتری داشته
        باشند.
      </p>
    </div>
    <div class="shell product-compare-table" role="list">
      <div class="product-compare-labels" aria-hidden="true">
        <span>روش پراکنده</span><span>در متراژ</span>
      </div>
      {
        metrazhWorkflowComparison.map((item) => (
          <article role="listitem">
            <span>{item.number}</span>
            <p>{item.before}</p>
            <p>{item.after}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="product-flow-section" aria-labelledby="flow-title">
    <div class="shell product-flow-grid">
      <header>
        <p class="eyebrow">سرعت در جریان کار</p>
        <h2 id="flow-title">
          کار کمتر بین ابزارها؛ دسترسی سریع‌تر به اطلاعات.
        </h2>
        <p>
          متراژ قرار نیست سرعت را با یک عدد تبلیغاتی تعریف کند؛ مسیرهای تکراری
          بین یادداشت، گالری، ماشین‌حساب و پیام‌رسان را در یک جریان منظم جمع
          می‌کند.
        </p>
      </header>
      <ol>
        <li>
          <span>01</span><div>
            <h3>ثبت ساختاریافته</h3><p>
              جزئیات ملک، مالک، تصاویر و موقعیت در یک پرونده قابل جست‌وجو قرار
              می‌گیرند.
            </p>
          </div>
        </li>
        <li>
          <span>02</span><div>
            <h3>بازیابی هدفمند</h3><p>
              فیلتر پیشرفته و جست‌وجوی صوتیِ دارای مرحله تأیید، رسیدن به فایل
              مناسب را کوتاه‌تر می‌کنند.
            </p>
          </div>
        </li>
        <li>
          <span>03</span><div>
            <h3>اقدام بعدی</h3><p>
              بازدید، یادآوری، تعامل و معامله کنار همان جریان کاری ثبت و پیگیری
              می‌شوند.
            </p>
          </div>
        </li>
        <li>
          <span>04</span><div>
            <h3>خروجی آماده</h3><p>
              متن آگهی قالب‌محور، PDF مشخصات و محاسبات کاربردی از داده‌های
              ثبت‌شده ساخته می‌شوند.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="product-facts" aria-label="مشخصات فنی متراژ">
    <div class="shell facts-grid">
      <div><span>پلتفرم</span><strong>Android</strong></div>
      <div><span>حداقل نسخه</span><strong>Android 7.0</strong></div>
      <div><span>نسخه فعلی</span><strong>{app.data.version}</strong></div>
      <div><span>وضعیت</span><strong>پیش‌انتشار</strong></div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">قابلیت‌های فعلی</p>
        <h2 id="features-title">از ثبت فایل تا پیگیری معامله</h2>
        <p class="section-description">
          امکاناتی که در نسخه فعلی پروژه پیاده‌سازی شده‌اند و برای کار روزانه
          مشاوران املاک طراحی شده‌اند.
        </p>
      </header>
      <ol class="feature-list">
        {
          app.data.features.map((feature, index) => (
            <li>
              <span>
                {new Intl.NumberFormat('fa-IR', {
                  minimumIntegerDigits: 2,
                }).format(index + 1)}
              </span>
              <p>{feature}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="screenshots-title">
    <div class="shell">
      <header class="section-heading">
        <p class="eyebrow">نمای برنامه</p>
        <h2 id="screenshots-title">متراژ در عمل</h2>
        <p class="section-description">
          این تصاویر از نسخه پیش‌انتشار و محیط آزمون تهیه شده‌اند و ممکن است تا
          انتشار نهایی تغییر کنند.
        </p>
      </header>
      <div class="screenshot-track">
        {
          app.data.screenshots.map((screenshot) => (
            <figure>
              <img src={screenshot.src} alt={screenshot.alt} loading="lazy" />
              <figcaption>{screenshot.alt}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="audience-title">
    <div class="shell audience-layout">
      <div>
        <p class="eyebrow">برای چه کسانی؟</p>
        <h2 id="audience-title">ابزاری برای جریان واقعی کار املاک</h2>
      </div>
      <ul class="audience-list">
        {app.data.audience.map((audience) => <li>{audience}</li>)}
      </ul>
    </div>
  </section>

  {
    productGuides.length > 0 && (
      <section
        class="page-section product-guides"
        aria-labelledby="product-guides-title"
      >
        <div class="shell">
          <header class="home-section-header">
            <div>
              <p class="eyebrow">متراژ در جریان واقعی کار</p>
              <h2 id="product-guides-title">
                از راهنما شروع کنید، داخل ابزار ادامه دهید.
              </h2>
            </div>
            <a class="page-stage-link" href="/articles/">
              همه مقالات
            </a>
          </header>
          <div class="product-guide-grid">
            {productGuides.map((guide) => (
              <article>
                <a href={`/articles/${guide.id}/`}>
                  <img
                    src={guide.data.cover}
                    alt={guide.data.coverAlt}
                    loading="lazy"
                  />
                </a>
                <span>{guide.data.category}</span>
                <h3>
                  <a href={`/articles/${guide.id}/`}>{guide.data.title}</a>
                </h3>
                <p>{guide.data.description}</p>
                <a class="text-link" href={`/articles/${guide.id}/`}>
                  مطالعه راهنما ←
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="cta-section">
    <div class="shell cta-panel">
      <p class="eyebrow">قدم بعدی</p>
      <h2>خبر انتشار متراژ را از مسیر رسمی بگیرید.</h2>
      <p>
        وضعیت نسخه و لینک دانلود عمومی فقط پس از تأیید در سایت مهسای و کانال
        رسمی متراژ اعلام می‌شوند.
      </p>
      <div class="cta-actions">
        {
          releaseChannel && (
            <a
              class="button"
              href={releaseChannel.url}
              target="_blank"
              rel="noopener"
            >
              عضویت در کانال رسمی متراژ
            </a>
          )
        }
        <a class="button button-secondary" href="/apps/metrazh/status/">
          مشاهده وضعیت انتشار
        </a>
        <a class="button button-secondary" href="/support/">پشتیبانی</a>
      </div>
    </div>
  </section>
</BaseLayout>
