---
import PageStage from '../components/PageStage.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`صفحه پیدا نشد | ${siteConfig.brandName}`}
  description="صفحه درخواستی در وب‌سایت مهسای پیدا نشد."
  noindex
>
  <PageStage
    eyebrow="صفحه پیدا نشد"
    title="مسیر را دوباره"
    highlight="پیدا کنیم."
    lead="ممکن است نشانی تغییر کرده باشد یا صفحه‌ای که می‌خواهید دیگر در این مسیر وجود نداشته باشد."
    note="از مرکز هوش مصنوعی، آموزش‌های رایگان یا معرفی متراژ می‌توانید مسیر درست را ادامه دهید."
    signals={['مرکز هوش مصنوعی', 'آموزش رایگان', 'معرفی متراژ']}
    tone="apricot"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href="/">بازگشت به خانه</a>
      <a class="page-stage-link" href="/ai/">مرکز هوش مصنوعی</a>
    </div>
  </PageStage>

  <section class="page-section compact-page-section">
    <div class="shell route-grid">
      <a href="/ai/today/"
        ><strong>تازه‌های مهم</strong><p>
          تغییرهای اثرگذار همراه با منبع اصلی
        </p></a
      >
      <a href="/ai/learn/"
        ><strong>راهنماهای رایگان</strong><p>راهنماهای ساده و قدم‌به‌قدم</p></a
      >
      <a href="/apps/metrazh/"
        ><strong>معرفی متراژ</strong><p>قابلیت‌ها و تصاویر واقعی محصول</p></a
      >
      <a href="/support/"
        ><strong>پشتیبانی</strong><p>راه ارتباط رسمی با مهسای</p></a
      >
    </div>
  </section>
</BaseLayout>
