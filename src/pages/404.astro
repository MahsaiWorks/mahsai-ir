---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`صفحه پیدا نشد | ${siteConfig.brandName}`}
  description="صفحهٔ درخواستی در وب‌سایت MAHSAI پیدا نشد."
  noindex
>
  <header class="not-found-hero">
    <div class="shell not-found-grid">
      <div>
        <p class="kicker">صفحه پیدا نشد</p>
        <h1>این صفحه پیدا نشد</h1>
        <p class="lead">
          ممکن است آدرس صفحه عوض شده باشد. از لینک‌های زیر به بخش موردنظرتان
          بروید.
        </p>
        <a class="button" href="/">بازگشت به صفحهٔ اصلی</a>
      </div>
      <ResponsiveImage
        src="/images/editorial/visit-route-planning.webp"
        alt="برنامه‌ریزی مسیر برای رسیدن به مقصد"
        width="1536"
        height="1024"
      />
    </div>
  </header>
  <nav class="section" aria-label="لینک‌های پیشنهادی">
    <div class="shell route-grid">
      <a href="/apps/metrazh/">
        <strong>متراژ</strong><span>معرفی و نصب اپلیکیشن ←</span>
      </a>
      <a href="/academy/">
        <strong>آموزش املاک</strong><span>آموزش‌های رایگان و کاربردی ←</span>
      </a>
      <a href="/articles/">
        <strong>مجلهٔ املاک</strong><span>همهٔ مقاله‌ها و راهنماها ←</span>
      </a>
      <a href="/support/">
        <strong>پشتیبانی</strong><span>راه‌های ارتباط رسمی ←</span>
      </a>
    </div>
  </nav>
</BaseLayout>
