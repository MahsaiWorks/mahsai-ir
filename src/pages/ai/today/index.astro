---
import { getCollection } from 'astro:content';
import AIUpdateCard from '../../../components/AIUpdateCard.astro';
import PageStage from '../../../components/PageStage.astro';
import {
  updateCategoryLabels,
  updateUrgencyLabels,
} from '../../../data/aiNavigation';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const updates = (await getCollection('aiUpdates'))
  .filter((update) => !update.data.draft)
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      b.data.priority - a.data.priority,
  );
const briefUpdates = updates.slice(0, 4);
const latestVerifiedAt = updates.reduce(
  (latest, update) =>
    update.data.verifiedAt > latest ? update.data.verifiedAt : latest,
  updates[0]?.data.verifiedAt ?? new Date(),
);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const faqs = [
  {
    question: 'تازه‌های مهم MAHSAI چند بار به‌روز می‌شود؟',
    answer:
      'در روزهای کاری منابع اصلی را بررسی می‌کنیم، اما فقط وقتی مطلب تازه منتشر می‌کنیم که یک تغییر روی انتخاب، هزینه، امنیت یا روش کار شما اثر واقعی داشته باشد.',
  },
  {
    question: 'چرا تعداد مطالب کمتر از سایت‌های خبری است؟',
    answer:
      'هدف ما پوشش همهٔ تیترها نیست. هر مورد باید منبع اصلی، تاریخ بررسی، اثر واقعی و یک پیشنهاد عملی روشن داشته باشد.',
  },
  {
    question: 'از کجا بفهمم یک ادعا واقعاً آزموده شده است؟',
    answer:
      'در هر مطلب میان گفتهٔ سازنده، بررسی منبع و آزمون دست‌اول فرق می‌گذاریم. نتیجهٔ آزمون فقط همراه با روش و خروجی قابل بررسی منتشر می‌شود.',
  },
];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'تازه‌های مهم هوش مصنوعی در MAHSAI',
  numberOfItems: updates.length,
  itemListElement: updates.map((update, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: update.data.title,
    url: new URL(`/ai/today/${update.id}/`, Astro.site).toString(),
  })),
};
const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'تازه‌های مهم هوش مصنوعی با منبع اصلی',
  description:
    'تغییرهای مهم هوش مصنوعی به زبان ساده، همراه با اثر واقعی، پیشنهاد عملی و منبع قابل بررسی.',
  url: new URL('/ai/today/', Astro.site).toString(),
  inLanguage: 'fa-IR',
  dateModified: latestVerifiedAt.toISOString(),
  mainEntity: itemList,
};
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="تازه‌های مهم هوش مصنوعی با توضیح ساده و منبع | MAHSAI"
  description="تغییرهای مهم هوش مصنوعی برای کاربر فارسی‌زبان؛ کوتاه، روشن، منبع‌دار و همراه با کاری که بهتر است انجام دهید."
  image="/og.png"
  imageAlt="تازه‌های مهم و راهنماهای فارسی هوش مصنوعی در MAHSAI"
  keywords={[
    'تازه‌های هوش مصنوعی',
    'خبر هوش مصنوعی به زبان ساده',
    'تغییرات ابزارهای هوش مصنوعی',
    'هوش مصنوعی برای کاربران ایرانی',
  ]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(collectionPage)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(itemList)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqPage)}
  />

  <PageStage
    eyebrow="تازه‌های مهم هوش مصنوعی"
    title="چه چیزی عوض شده و"
    highlight="برای شما چه معنایی دارد؟"
    lead="به‌جای مرور ده‌ها خبر، تغییرهایی را ببینید که روی کار، هزینه، امنیت یا انتخاب ابزار شما اثر می‌گذارند. هر مطلب با جواب کوتاه شروع می‌شود و با منبع اصلی تمام می‌شود."
    note={`منابع این صفحه آخرین بار در ${formatDate(latestVerifiedAt)} بررسی شده‌اند. تاریخ هر مطلب مربوط به بررسی منبع است، نه یک تاریخ نمایشی برای تازه به نظر رسیدن.`}
    signals={['جواب کوتاه', 'اثر واقعی', 'کار پیشنهادی', 'منبع اصلی']}
    tone="apricot"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href="#important-now">مهم‌ترین تغییرها</a>
      <a class="page-stage-link" href="/ai/rss.xml">دنبال‌کردن خوراک مطالب</a>
    </div>
  </PageStage>

  <section id="important-now" class="section mahsa-today-brief">
    <div class="shell">
      <header class="mahsa-section-heading">
        <div>
          <p class="eyebrow">خلاصهٔ سریع</p>
          <h2>اول این تغییرها را ببینید.</h2>
        </div>
        <p>
          هر کارت با کاری که می‌توانید انجام دهید شروع می‌شود. برای دلیل،
          محدودیت و منبع، وارد مطلب شوید.
        </p>
      </header>
      <div class="mahsa-today-brief-grid">
        {
          briefUpdates.map((update, index) => (
            <article
              class:list={[
                'mahsa-today-brief-card',
                {
                  'is-primary': index === 0,
                  'is-action': update.data.urgency === 'act',
                },
              ]}
            >
              <div class="mahsa-today-brief-card-top">
                <span
                  class:list={['mahsa-status', `is-${update.data.urgency}`]}
                >
                  {updateUrgencyLabels[update.data.urgency]}
                </span>
                <span>{updateCategoryLabels[update.data.category]}</span>
              </div>
              <h3>
                <a href={`/ai/today/${update.id}/`}>{update.data.title}</a>
              </h3>
              <p>{update.data.action}</p>
              <a class="story-link" href={`/ai/today/${update.id}/`}>
                دلیل و منبع <span aria-hidden="true">←</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <aside class="mahsa-today-trust" aria-label="روش انتخاب تازه‌های مهم">
    <div class="shell">
      <strong>خبر کمتر، تصمیم بهتر</strong>
      <p>
        مطلبی که فقط هیجان ایجاد کند اما به تصمیم شما کمک نکند، وارد این صفحه
        نمی‌شود.
      </p>
      <a href="/ai/sources/">روش انتخاب منبع و اصلاح مطالب ←</a>
    </div>
  </aside>

  <section class="section mahsa-today-archive">
    <div class="shell">
      <header class="mahsa-section-heading">
        <div>
          <p class="eyebrow">بایگانی قابل بررسی</p>
          <h2>تغییرها را با زمینهٔ کامل بخوانید.</h2>
        </div>
        <p>
          بالای هر کارت زمان آخرین بررسی منبع نوشته شده است؛ اگر اطلاعات مهمی
          عوض شود، همان مطلب اصلاح می‌شود.
        </p>
      </header>
      <div class="ai-update-grid">
        {
          updates.map((update, index) => (
            <AIUpdateCard update={update} featured={index === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section mahsa-today-method">
    <div class="shell mahsa-today-method-grid">
      <div>
        <p class="eyebrow">فرم ثابت هر مطلب</p>
        <h2>اول بفهمید؛ بعد تصمیم بگیرید.</h2>
        <p>
          متن با جواب کوتاه شروع می‌شود، اثر تغییر را جدا می‌کند و بعد
          محدودیت‌ها، قدم بعدی و لینک منبع اصلی را نشان می‌دهد.
        </p>
        <ul>
          <li>
            <strong>چه اتفاقی افتاده؟</strong><span
              >جواب کوتاه و بدون حاشیه</span
            >
          </li>
          <li>
            <strong>برای چه کسی مهم است؟</strong><span>اثر واقعی روی کاربر</span
            >
          </li>
          <li>
            <strong>حالا چه کار کنم؟</strong><span>پیشنهاد عملی و کم‌ریسک</span>
          </li>
          <li>
            <strong>چه چیزی هنوز قطعی نیست؟</strong><span>مرز روشن اطمینان</span
            >
          </li>
        </ul>
      </div>
      <div class="mahsa-today-faq">
        <p class="eyebrow">پرسش‌های کوتاه</p>
        <h2>این بخش چگونه به‌روز می‌شود؟</h2>
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
        <a class="button button-secondary" href="/support/">
          گزارش خطا یا پیشنهاد منبع
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
