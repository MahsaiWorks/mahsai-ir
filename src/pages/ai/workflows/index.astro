---
import { getCollection } from 'astro:content';
import AIGuideCard from '../../../components/AIGuideCard.astro';
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const workflows = (await getCollection('aiGuides')).filter(
  (guide) => !guide.data.draft && guide.data.kind === 'workflow',
);
---

<BaseLayout
  title="جریان‌های کاری هوش مصنوعی | MAHSAI"
  description="روش‌های مرحله‌به‌مرحله برای استفادهٔ قابل اعتماد از هوش مصنوعی در پژوهش، نوشتن، تحلیل و کار روزانه."
>
  <PageStage
    eyebrow="جریان‌های کاری"
    title="از یک پاسخ جذاب"
    highlight="به خروجی قابل تحویل."
    lead="هر جریان ورودی، خروجی، معیار پذیرش، نقطهٔ کنترل انسانی و نسخهٔ قابل تکرار دارد."
    index={`${workflows.length} جریان منتشرشده`}
    note="هدف حذف بازبینی انسان نیست؛ هدف کوتاه‌کردن کار تکراری و روشن‌کردن نقطه‌های تصمیم است."
    signals={['ورودی مشخص', 'قالب خروجی', 'معیار پذیرش', 'کنترل انسانی']}
    tone="paper"
  />
  <section class="section">
    <div class="shell ai-guide-grid">
      {
        workflows.map((guide, index) => (
          <AIGuideCard guide={guide} featured={index === 0} />
        ))
      }
    </div>
  </section>
</BaseLayout>
