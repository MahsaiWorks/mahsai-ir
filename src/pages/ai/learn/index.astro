---
import { getCollection } from 'astro:content';
import AIGuideCard from '../../../components/AIGuideCard.astro';
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const guides = (await getCollection('aiGuides'))
  .filter((guide) => !guide.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

const startingPoints = [
  {
    title: 'برای اولین استفاده',
    description:
      'یاد بگیرید مسئله را روشن بنویسید و جواب را بدون اعتماد کورکورانه بررسی کنید.',
    href: '/ai/course/',
    action: 'انجام تمرین رایگان',
  },
  {
    title: 'برای انتخاب دستیار مناسب',
    description:
      'بفهمید کدام ویژگی واقعاً به کارتان می‌آید و کجا باید محتاط باشید.',
    href: '/ai/learn/choose-ai-assistant/',
    action: 'خواندن راهنمای انتخاب',
  },
  {
    title: 'برای استفاده بدون اینترنت',
    description:
      'پیش از دانلود، توان دستگاه، فضای لازم و مرز حریم خصوصی را بررسی کنید.',
    href: '/ai/learn/offline-ai-windows-ollama-lm-studio/',
    action: 'دیدن راهنمای شروع',
  },
] as const;
---

<BaseLayout
  title="آموزش رایگان و سادهٔ هوش مصنوعی برای فارسی‌زبانان | MAHSAI"
  description="راهنماهای تصویری و قدم‌به‌قدم هوش مصنوعی برای کار واقعی؛ از شروع ساده و انتخاب ابزار تا تحقیق، کار روزانه و استفاده بدون اینترنت."
>
  <PageStage
    eyebrow="یادگیری بدون پیچیدگی"
    title="یک مسئله انتخاب کنید؛"
    highlight="با یک نتیجه بیرون بیایید."
    lead="هر راهنما برای یک نیاز واقعی نوشته شده است: زمان تقریبی، سطح، محدودیت و نتیجهٔ آخر از همان ابتدا روشن است. لازم نیست برنامه‌نویس باشید یا ابزار خاصی بخرید."
    note="همهٔ مطالب این بخش رایگان‌اند و برای خواندن آن‌ها ثبت‌نام لازم نیست. اگر یک قابلیت یا اطلاعات مهم تغییر کند، تاریخ بررسی مطلب هم به‌روز می‌شود."
    signals={[
      'زبان ساده و صمیمی',
      'مثال قابل اجرا',
      'تصویر و ساختار خوانا',
      'منبع قابل بررسی',
    ]}
    tone="mint"
  />

  <section
    class="section mahsa-learn-start"
    aria-labelledby="learn-start-title"
  >
    <div class="shell">
      <header class="mahsa-section-heading">
        <div>
          <p class="eyebrow">شروع بر اساس نیاز</p>
          <h2 id="learn-start-title">کدام جمله به شما نزدیک‌تر است؟</h2>
        </div>
        <p>یکی را انتخاب کنید؛ هر مسیر با یک نتیجهٔ مشخص تمام می‌شود.</p>
      </header>
      <div class="mahsa-learn-start-grid">
        {
          startingPoints.map((item) => (
            <article>
              <span aria-hidden="true">
                <>
                  <i />
                  <b />
                  <em />
                </>
              </span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="story-link" href={item.href}>
                {item.action} ←
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section mahsa-learning" aria-labelledby="all-guides-title">
    <div class="shell">
      <header class="mahsa-section-heading">
        <div>
          <p class="eyebrow">کتابخانهٔ راهنماها</p>
          <h2 id="all-guides-title">آرام بخوانید؛ سریع امتحان کنید.</h2>
        </div>
        <p>
          روی هر راهنما سطح، زمان مطالعه و تاریخ بررسی نوشته شده تا پیش از شروع
          بدانید با چه مطلبی روبه‌رو هستید.
        </p>
      </header>
      <div class="ai-guide-grid">
        {
          guides.map((guide, index) => (
            <AIGuideCard guide={guide} featured={index === 0} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
