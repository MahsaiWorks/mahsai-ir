---
import { getCollection, render } from 'astro:content';
import AISources from '../../../components/AISources.astro';
import { guideKindLabels, guideLevelLabels } from '../../../data/aiNavigation';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const guides = (await getCollection('aiGuides')).filter(
    (guide) => !guide.data.draft,
  );
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const canonical = new URL(Astro.url.pathname, Astro.site);
const published = guide.data.publishedAt;
const modified = guide.data.updatedAt ?? guide.data.publishedAt;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  image: new URL('/og.png', Astro.site).toString(),
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  mainEntityOfPage: canonical.toString(),
  author: {
    '@type': 'Organization',
    name: 'MAHSAI',
    url: new URL('/about/', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'MAHSAI',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/brand/mahsai-symbol.png', Astro.site).toString(),
    },
  },
  inLanguage: 'fa-IR',
  keywords: guide.data.keywords.join(', '),
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'خانه',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'هوش مصنوعی',
      item: new URL('/ai/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'آموزش',
      item: new URL('/ai/learn/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: guide.data.title,
      item: canonical.toString(),
    },
  ],
};
---

<BaseLayout
  title={`${guide.data.title} | MAHSAI AI`}
  description={guide.data.description}
  type="article"
  keywords={guide.data.keywords}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbs)}
  />
  <article class="ai-reading-page">
    <header class="ai-reading-stage">
      <div class="shell">
        <nav class="breadcrumbs" aria-label="مسیر صفحه">
          <a href="/">خانه</a><span aria-hidden="true">/</span>
          <a href="/ai/">هوش مصنوعی</a><span aria-hidden="true">/</span>
          <a href="/ai/learn/">آموزش</a>
        </nav>
        <div class="ai-reading-stage-grid">
          <div>
            <p class="ai-kicker">
              {guideKindLabels[guide.data.kind]} · {
                guideLevelLabels[guide.data.level]
              }
            </p>
            <h1>{guide.data.title}</h1>
            <p class="ai-reading-deck">{guide.data.description}</p>
            <div class="ai-reading-byline">
              <span>تحریریه MAHSAI AI</span>
              <time datetime={published.toISOString()}
                >{formatDate(published)}</time
              >
              <span>{guide.data.readingTime} مطالعه</span>
            </div>
          </div>
          <aside class="ai-reading-summary">
            <span>بعد از این راهنما</span>
            <ul>{guide.data.takeaways.map((item) => <li>{item}</li>)}</ul>
          </aside>
        </div>
      </div>
    </header>
    <div class="shell ai-reading-layout">
      <aside class="ai-reading-toc" aria-label="فهرست راهنما">
        <p>در این راهنما</p>
        <ol>
          {
            headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))
          }
        </ol>
      </aside>
      <div class="ai-reading-content prose"><Content /></div>
    </div>
    <div class="shell">
      <AISources
        sources={guide.data.sources}
        verifiedAt={guide.data.verifiedAt}
      />
    </div>
  </article>
</BaseLayout>
