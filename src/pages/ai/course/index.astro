---
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lessons = [
  {
    id: '01',
    title: 'کار را روشن کنید',
    time: '۸ دقیقه',
    result: 'یک مسئلهٔ مبهم را به ورودی، خروجی و معیار قبولی تبدیل می‌کنید.',
  },
  {
    id: '02',
    title: 'پرامپت قابل بررسی بنویسید',
    time: '۱۰ دقیقه',
    result: 'یک دستور کوتاه می‌سازید که قالب، منبع و محدودیت دارد.',
  },
  {
    id: '03',
    title: 'جواب را راستی‌آزمایی کنید',
    time: '۱۲ دقیقه',
    result: 'ادعا، منبع و بخش نامطمئن را از هم جدا می‌کنید.',
  },
  {
    id: '04',
    title: 'یک جریان کاری ذخیره کنید',
    time: '۱۰ دقیقه',
    result: 'نسخهٔ تکرارپذیر کار را برای استفادهٔ بعدی نگه می‌دارید.',
  },
];
const promptTemplate = `نقش تو: کمک به آماده‌سازی یک پیش‌نویس
ورودی: [متن یا منبع]
خروجی: [قالب دقیق]
محدودیت: چیزی خارج از منبع نساز
معیار قبولی: [سه شرط روشن]
اگر اطلاعات کافی نیست، واضح اعلام کن.`;
const courseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'اولین جریان کاری مطمئن با هوش مصنوعی',
  description:
    'دورهٔ رایگان و کوتاه برای ساخت یک جریان کاری قابل بررسی با هوش مصنوعی.',
  provider: {
    '@type': 'Organization',
    name: 'MAHSAI',
    url: new URL('/', Astro.site).toString(),
  },
  inLanguage: 'fa-IR',
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="دوره رایگان هوش مصنوعی؛ اولین جریان کاری مطمئن | MAHSAI"
  description="دوره رایگان ۴۰ دقیقه‌ای برای یادگیری پرامپت، بررسی منبع و ساخت اولین جریان کاری قابل اعتماد با هوش مصنوعی؛ ساده و تمرین‌محور."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(courseStructuredData)}
  />
  <PageStage
    eyebrow="دورهٔ رایگان MAHSAI"
    title="در ۴۰ دقیقه، اولین کار واقعی‌تان را"
    highlight="مطمئن‌تر انجام دهید."
    lead="چهار درس کوتاه، یک تمرین واقعی و یک خروجی قابل استفاده. لازم نیست برنامه‌نویس باشید یا اشتراک خاصی بخرید."
    index="۴ درس · رایگان · مقدماتی"
    note="این دوره دربارهٔ انتخاب یک برند خاص نیست؛ روشی یاد می‌گیرید که با ابزارهای مختلف قابل اجراست."
    signals={['بدون پیش‌نیاز', 'تمرین واقعی', 'چک‌لیست آماده', 'بدون ثبت‌نام']}
    tone="mint"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href="#lesson-01">شروع درس اول</a><a
        class="page-stage-link"
        href="/ai/learn/first-reliable-ai-workflow/">نسخهٔ کامل راهنما</a
      >
    </div>
  </PageStage>
  <section class="section course-outcome">
    <div class="shell course-outcome-grid">
      <div>
        <p class="eyebrow">نتیجهٔ دوره</p><h2>آخر کار چه چیزی دارید؟</h2>
      </div><p>
        یک قالب شخصی برای تعریف کار، یک پرامپت قابل تکرار و یک چک‌لیست کنترل
        کیفیت. یعنی دفعهٔ بعد از صفر شروع نمی‌کنید.
      </p>
    </div>
  </section>
  <section class="section course-lessons">
    <div class="shell course-lesson-list">
      {
        lessons.map((lesson) => (
          <article id={`lesson-${lesson.id}`}>
            <>
              <header>
                <>
                  <span>درس {lesson.id}</span>
                  <time>{lesson.time}</time>
                </>
              </header>
              <h2>{lesson.title}</h2>
              <p>{lesson.result}</p>
            </>
            {lesson.id === '01' && (
              <div class="course-exercise">
                <h3>تمرین</h3>
                <p>
                  این جمله را کامل کنید: «می‌خواهم با استفاده از [ورودی] به
                  [خروجی] برسم و نتیجه وقتی قابل قبول است که [معیار]».
                </p>
              </div>
            )}
            {lesson.id === '02' && (
              <div class="course-exercise">
                <h3>قالب آماده</h3>
                <pre>
                  <code>{promptTemplate}</code>
                </pre>
              </div>
            )}
            {lesson.id === '03' && (
              <div class="course-exercise">
                <h3>سه سؤال کنترل</h3>
                <ul>
                  <li>کدام ادعا به منبع نیاز دارد؟</li>
                  <li>کدام بخش حدس یا برداشت است؟</li>
                  <li>اگر این جواب اشتباه باشد، چه آسیبی می‌زند؟</li>
                </ul>
              </div>
            )}
            {lesson.id === '04' && (
              <div class="course-exercise">
                <h3>نسخهٔ قابل تکرار</h3>
                <p>
                  پرامپت نهایی، یک نمونهٔ ورودی خوب، چک‌لیست و تاریخ آخرین اصلاح
                  را کنار هم نگه دارید. اطلاعات محرمانه را داخل قالب نمونه
                  نگذارید.
                </p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
  <section class="course-finish">
    <div class="shell course-finish-card">
      <p class="eyebrow">تمام شد؛ حالا اجرا کنید</p><h2>
        یک کار کوچک واقعی را همین امروز انجام دهید.
      </h2><p>
        برای شروع، یک متن غیرمحرمانه انتخاب کنید. قالب درس دوم را اجرا کنید و با
        سه سؤال درس سوم جواب را بررسی کنید.
      </p><div>
        <a class="button" href="/ai/persian-lab/">گرفتن بستهٔ آزمون فارسی</a><a
          class="button button-secondary"
          href="/ai/learn/">دیدن همهٔ آموزش‌ها</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
