---
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const steps = [
  {
    id: 'choose-text',
    label: 'ورودی را انتخاب کنید',
    time: 'حدود ۵ دقیقه',
    result:
      'یک متن غیرمحرمانه و شلوغ، مثل یادداشت جلسه یا توضیح یک کار، انتخاب می‌کنید.',
  },
  {
    id: 'give-instruction',
    label: 'درخواست روشن بنویسید',
    time: 'حدود ۱۰ دقیقه',
    result:
      'از قالب آماده استفاده می‌کنید تا شکل خروجی، محدودیت و معیار قبول از ابتدا معلوم باشد.',
  },
  {
    id: 'check-answer',
    label: 'جواب را بررسی کنید',
    time: 'حدود ۱۵ دقیقه',
    result:
      'جمله‌های بدون پشتوانه، نکته‌های جاافتاده و بخش‌هایی را که نیاز به بازبینی دارند جدا می‌کنید.',
  },
  {
    id: 'save-method',
    label: 'روش خودتان را نگه دارید',
    time: 'حدود ۱۰ دقیقه',
    result:
      'نسخهٔ اصلاح‌شدهٔ درخواست و یک فهرست کنترل کوتاه برای استفاده‌های بعدی دارید.',
  },
] as const;

const instructionTemplate = `این متن را فقط بر اساس اطلاعاتی که داخل آن است مرتب کن.

خروجی موردنیاز:
- خلاصهٔ کوتاه در سه جمله
- کارهای قابل انجام به شکل فهرست
- زمان یا مسئول هر کار، فقط اگر در متن آمده است
- پرسش‌هایی که برای تکمیل اطلاعات باید جواب داده شوند

محدودیت‌ها:
- اطلاعات تازه نساز
- اگر چیزی قطعی نیست، کنار آن بنویس «نیازمند بررسی»
- جمله‌ها را کوتاه و فارسی روان بنویس`;

const howToStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'تبدیل یک متن شلوغ به خروجی قابل استفاده با هوش مصنوعی',
  description:
    'تمرین رایگان و کوتاه برای نوشتن درخواست روشن، بررسی پاسخ و ساخت یک روش قابل تکرار.',
  inLanguage: 'fa-IR',
  totalTime: 'PT40M',
  step: steps.map((step) => ({
    '@type': 'HowToStep',
    name: step.label,
    text: step.result,
    url: new URL(`/ai/course/#${step.id}`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title="تمرین عملی رایگان هوش مصنوعی؛ از متن شلوغ تا خروجی روشن | MAHSAI"
  description="یک تمرین رایگان و حدود چهل‌دقیقه‌ای برای تبدیل متن شلوغ به خلاصه و فهرست کار؛ همراه با قالب آماده و روش بررسی جواب."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(howToStructuredData)}
  />

  <PageStage
    eyebrow="تمرین عملی رایگان"
    title="یک متن شلوغ را به"
    highlight="خروجی قابل استفاده تبدیل کنید."
    lead="در پایان این تمرین، یک خلاصهٔ روشن، فهرست کار و قالبی دارید که دفعهٔ بعد هم می‌توانید استفاده کنید. هیچ خرید یا ثبت‌نامی لازم نیست."
    note="برای تمرین از متن غیرمحرمانه استفاده کنید. اطلاعات شخصی، مالی، پروندهٔ مشتری یا رمزها را داخل ابزارهای عمومی وارد نکنید."
    signals={['حدود چهل دقیقه', 'قالب آماده', 'خروجی واقعی', 'بدون ثبت‌نام']}
    tone="mint"
  >
    <div slot="actions" class="page-stage-actions">
      <a class="button" href="#choose-text">شروع تمرین</a>
      <a class="page-stage-link" href="/ai/learn/first-reliable-ai-workflow/">
        راهنمای کامل‌تر همین روش
      </a>
    </div>
  </PageStage>

  <section class="section course-outcome">
    <div class="shell course-outcome-grid">
      <div>
        <p class="eyebrow">چیزی که تحویل می‌گیرید</p>
        <h2>یک نتیجهٔ کوچک اما قابل استفاده.</h2>
      </div>
      <p>
        هدف فقط گرفتن یک جواب زیبا نیست؛ در پایان، درخواست اصلاح‌شده، خروجی
        بررسی‌شده و فهرست کنترلی دارید که برای کار بعدی هم قابل تکرار است.
      </p>
    </div>
  </section>

  <section class="section course-lessons" aria-label="مراحل تمرین">
    <div class="shell course-lesson-list">
      {
        steps.map((step) => (
          <article id={step.id}>
            <header>
              <>
                <span>{step.label}</span>
                <time>{step.time}</time>
              </>
            </header>
            <h2>{step.label}</h2>
            <p>{step.result}</p>

            {step.id === 'choose-text' && (
              <div class="course-exercise">
                <h3>متن مناسب برای تمرین</h3>
                <p>
                  یک یادداشت جلسه، توضیح پراکندهٔ یک کار یا متن شخصی خودتان را
                  انتخاب کنید؛ به شرطی که نام، شماره تماس، اطلاعات مالی یا موضوع
                  محرمانه نداشته باشد.
                </p>
              </div>
            )}

            {step.id === 'give-instruction' && (
              <div class="course-exercise">
                <h3>قالب آماده برای کپی</h3>
                <pre>
                  <code>{instructionTemplate}</code>
                </pre>
              </div>
            )}

            {step.id === 'check-answer' && (
              <div class="course-exercise">
                <h3>سه سؤال کنترل</h3>
                <ul>
                  <li>
                    آیا چیزی به متن اصلی اضافه شده که واقعاً آنجا نبوده است؟
                  </li>
                  <li>آیا نکتهٔ مهمی حذف یا بیش از حد ساده شده است؟</li>
                  <li>
                    آیا می‌توانم بر اساس این خروجی، کار بعدی را بدون حدس‌زدن
                    انجام دهم؟
                  </li>
                </ul>
              </div>
            )}

            {step.id === 'save-method' && (
              <div class="course-exercise">
                <h3>نسخهٔ قابل تکرار</h3>
                <p>
                  درخواست نهایی، یک نمونهٔ ورودی بی‌خطر، خروجی مطلوب و سه سؤال
                  کنترل را کنار هم نگه دارید. تاریخ آخرین اصلاح را هم بنویسید تا
                  بعداً بدانید کدام نسخه بهتر کار کرده است.
                </p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="course-finish">
    <div class="shell course-finish-card">
      <p class="eyebrow">حالا نوبت اجرای واقعی است</p>
      <h2>با یک متن کم‌ریسک شروع کنید.</h2>
      <p>
        قالب را اجرا کنید، جواب را با سه سؤال کنترل بسنجید و فقط بخش‌هایی را نگه
        دارید که دقیق، روشن و قابل استفاده‌اند.
      </p>
      <div>
        <a class="button" href="/ai/persian-lab/">دیدن آزمون‌های فارسی</a>
        <a class="button button-secondary" href="/ai/learn/">راهنماهای بیشتر</a>
      </div>
    </div>
  </section>
</BaseLayout>
