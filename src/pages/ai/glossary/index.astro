---
import { aiGlossary } from '../../../data/aiGlossary';
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'واژه‌نامه هوش مصنوعی MAHSAI',
  hasDefinedTerm: aiGlossary.map((item) => ({
    '@type': 'DefinedTerm',
    name: item.term,
    description: item.definition,
  })),
};
---

<BaseLayout
  title="واژه‌نامه هوش مصنوعی به زبان ساده | MAHSAI"
  description="معنی ساده و دقیق اصطلاحات پرکاربرد هوش مصنوعی، از LLM و پرامپت تا RAG، عامل هوشمند و مدل محلی."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />
  <PageStage
    eyebrow="واژه‌نامه هوش مصنوعی"
    title="اصطلاح پیچیده،"
    highlight="تعریف روشن."
    lead="تعریف‌های کوتاه برای اینکه یک مقاله یا تنظیمات ابزار را بدون گم‌شدن در واژه‌های انگلیسی بخوانید."
    index={`${aiGlossary.length} اصطلاح پایه`}
    note="تعریف ساده جای مستندات تخصصی را نمی‌گیرد، اما نقطهٔ شروع مشترکی می‌سازد."
    signals={['معادل انگلیسی', 'تعریف کوتاه', 'بدون تبلیغ', 'قابل گسترش']}
    tone="mint"
  />
  <section class="section">
    <div class="shell ai-glossary-grid">
      {
        aiGlossary.map((item) => (
          <article id={item.english.toLowerCase().replaceAll(' ', '-')}>
            <>
              <p lang="en" dir="ltr">
                {item.english}
              </p>
              <h2>{item.term}</h2>
              <p>{item.definition}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
