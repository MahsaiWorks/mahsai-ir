---
import { getCollection } from 'astro:content';
import AIGuideCard from '../../../components/AIGuideCard.astro';
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const comparisons = (await getCollection('aiGuides')).filter(
  (guide) => !guide.data.draft && guide.data.kind === 'comparison',
);
---

<BaseLayout
  title="مقایسه ابزارهای هوش مصنوعی | MAHSAI AI"
  description="مقایسهٔ بی‌طرف ابزارهای هوش مصنوعی بر اساس سناریوی واقعی، منبع رسمی و روش آزمون تکرارپذیر."
>
  <PageStage
    eyebrow="مقایسه هوش مصنوعی"
    title="برندهٔ مطلق نداریم؛"
    highlight="انتخاب مناسب داریم."
    lead="مقایسه‌ها به‌جای امتیازهای مبهم، نوع کار، منبع، قابلیت بررسی، فارسی، حریم خصوصی و دسترسی را جداگانه می‌سنجند."
    index={`${comparisons.length + 1} مقایسهٔ منتشرشده`}
    note="هر نتیجه فقط در محدودهٔ سناریو و تاریخ همان صفحه معتبر است."
    signals={['سناریوی مشخص', 'معیار ثابت', 'منبع رسمی', 'بدون وابستگی تجاری']}
    tone="mint"
  />
  <section class="compare-starter">
    <div class="shell compare-starter-grid">
      <a href="/ai/persian-lab/results/"
        ><span>۲۴ آزمون دست‌اول</span><strong
          >بهترین هوش مصنوعی برای فارسی کدام است؟</strong
        ><p>پاسخ خام، امتیاز شفاف و برندهٔ هر کار فارسی.</p><i>←</i></a
      >
      <a href="/ai/learn/choose-ai-assistant/"
        ><span>دستیارهای ابری</span><strong>ChatGPT، Gemini یا Claude؟</strong
        ><p>انتخاب بر اساس نوع کار، منبع و حریم خصوصی.</p><i>←</i></a
      >
      <a href="/ai/learn/ollama-vs-lm-studio/"
        ><span>اجرای محلی</span><strong>Ollama یا LM Studio؟</strong><p>
          محیط گرافیکی در برابر خط فرمان و API محلی.
        </p><i>←</i></a
      >
    </div>
  </section>
  <section class="section">
    <div class="shell ai-guide-grid">
      {
        comparisons.map((guide, index) => (
          <AIGuideCard guide={guide} featured={index === 0} />
        ))
      }
    </div>
  </section>
</BaseLayout>
