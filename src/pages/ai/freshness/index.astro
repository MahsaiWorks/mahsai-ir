---
import { getCollection } from 'astro:content';
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const now = new Date('2026-08-13T12:00:00Z');
const daysOld = (date: Date) =>
  Math.max(0, Math.floor((now.valueOf() - date.valueOf()) / 86_400_000));
const guides = (await getCollection('aiGuides')).filter(
  (item) => !item.data.draft,
);
const updates = (await getCollection('aiUpdates')).filter(
  (item) => !item.data.draft,
);
const tools = await getCollection('aiTools');
const records = [
  ...guides.map((item) => ({
    type: 'راهنما',
    title: item.data.title,
    href: `/ai/learn/${item.id}/`,
    date: item.data.verifiedAt,
  })),
  ...updates.map((item) => ({
    type: 'رادار',
    title: item.data.title,
    href: `/ai/today/${item.id}/`,
    date: item.data.verifiedAt,
  })),
  ...tools.map((item) => ({
    type: 'ابزار',
    title: item.data.name,
    href: `/ai/tools/${item.id}/`,
    date: item.data.verifiedAt,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const fresh = records.filter((item) => daysOld(item.date) <= 30).length;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<BaseLayout
  title="وضعیت تازگی محتوای هوش مصنوعی | MAHSAI AI"
  description="داشبورد عمومی تاریخ آخرین بررسی راهنماها، ابزارها و گزارش‌های MAHSAI AI؛ برای اینکه بدانید کدام اطلاعات تازه‌اند."
>
  <PageStage
    eyebrow="داشبورد شفافیت"
    title="تاریخ هر ادعا باید"
    highlight="قابل دیدن باشد."
    lead="این صفحه نشان می‌دهد هر راهنما، ابزار و گزارش چه زمانی از روی منبع رسمی بازبینی شده است. تازه‌بودن به‌تنهایی نشانهٔ درست‌بودن نیست، اما اطلاعات بدون تاریخ قابل اعتماد نیستند."
    index={`${records.length} صفحهٔ زمان‌دار`}
    note="بازهٔ ۳۰ روز برای کنترل داخلی است؛ بعضی راهنماهای ماندگار فقط وقتی منبع یا محصول تغییر کند نیاز به بازبینی دارند."
    signals={['تاریخ بررسی', 'نوع محتوا', 'صفحهٔ مقصد', 'بدون عدد ساختگی']}
    tone="paper"
  />
  <section class="section freshness-summary">
    <div class="shell freshness-summary-grid">
      <div>
        <strong>{fresh}</strong><span>بررسی‌شده در ۳۰ روز اخیر</span>
      </div><div>
        <strong>{records.length - fresh}</strong><span
          >نیازمند بررسی دوره‌ای بعدی</span
        >
      </div><div>
        <strong>{tools.length}</strong><span>ابزار با منبع رسمی</span>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell freshness-table-wrap">
      <table class="freshness-table">
        <thead
          ><tr><th>نوع</th><th>صفحه</th><th>آخرین بررسی</th><th>وضعیت</th></tr
          ></thead
        ><tbody
          >{
            records.map((item) => (
              <tr>
                <>
                  <td>{item.type}</td>
                  <td>
                    <a href={item.href}>{item.title}</a>
                  </td>
                  <td>{formatDate(item.date)}</td>
                  <td>
                    <span
                      class:list={[
                        'freshness-status',
                        { 'is-current': daysOld(item.date) <= 30 },
                      ]}
                    >
                      {daysOld(item.date) <= 30 ? 'تازه' : 'بازبینی دوره‌ای'}
                    </span>
                  </td>
                </>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
  </section>
</BaseLayout>
