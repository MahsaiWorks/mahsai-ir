---
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  benchmarkCases,
  benchmarkDimensions,
  benchmarkFiles,
  benchmarkVersion,
} from '../../../data/persianBenchmark';
import {
  benchmarkRanking,
  benchmarkResultFiles,
} from '../../../data/persianBenchmarkResults';

const protocol = [
  {
    title: 'نگارش و ویرایش',
    description: 'نیم‌فاصله، نشانه‌گذاری، لحن طبیعی و پرهیز از ترجمهٔ لفظی.',
  },
  {
    title: 'درک متن',
    description: 'حفظ نام، عدد، رابطه و منظور ضمنی در متن‌های واقعی فارسی.',
  },
  {
    title: 'استخراج ساختاریافته',
    description: 'تبدیل متن فارسی به جدول یا JSON بدون ساختن دادهٔ تازه.',
  },
  {
    title: 'ابهام و صداقت',
    description: 'خودداری از حدس و اعلام صریح وقتی متن اطلاعات کافی ندارد.',
  },
];

const leader = benchmarkRanking[0] ?? {
  product: 'نتیجهٔ ثبت‌شده',
  average: 0,
};
---

<BaseLayout
  title="آزمایشگاه فارسی هوش مصنوعی | MAHSAI AI"
  description="پروتکل شفاف MAHSAI برای سنجش کیفیت فارسی ابزارهای هوش مصنوعی؛ آزمون ثابت، دادهٔ غیرمحرمانه و نتیجهٔ قابل تکرار."
>
  <PageStage
    eyebrow="آزمایشگاه فارسی MAHSAI"
    title="فارسی را با حس کلی"
    highlight="امتیاز نمی‌دهیم."
    lead="کیفیت را به معیارهای قابل مشاهده تقسیم می‌کنیم، نسخه و پرامپت را ثبت می‌کنیم و فقط نتیجه‌ای را منتشر می‌کنیم که امکان تکرار داشته باشد."
    index={`مجموعهٔ آزمون ${benchmarkVersion} · ${benchmarkCases.length} سناریو`}
    note={`۲۴ اجرای کامل منتشر شد. بالاترین میانگین این نسخه: ${leader.product} با ${leader.average} از ۱۰۰.`}
    signals={[
      'پرامپت یکسان',
      'متن واقعی غیرمحرمانه',
      'ثبت نسخه و تاریخ',
      'بازبینی انسانی',
    ]}
    tone="mint"
  />
  <section class="ai-course-banner" aria-labelledby="lab-results-title">
    <div class="shell ai-course-banner-grid">
      <div>
        <p class="eyebrow">نتیجهٔ دست‌اول منتشر شد</p>
        <h2 id="lab-results-title">
          ChatGPT، دو حالت Gemini و Qwen در ۲۴ اجرای واقعی.
        </h2>
        <p>
          پاسخ خام، برندهٔ هر کار، روش امتیازدهی و حتی اجراهای حذف‌شده را یکجا
          ببینید.
        </p>
      </div>
      <a class="button" href="/ai/persian-lab/results/">دیدن نتیجهٔ کامل</a>
    </div>
  </section>
  <section class="section lab-download-section">
    <div class="shell lab-download-card">
      <div>
        <p class="eyebrow">دادهٔ باز و قابل تکرار</p>
        <h2>خودتان همان آزمون را اجرا کنید.</h2>
        <p>
          ورودی، دستور و معیار قبولی هر سناریو منتشر شده است. JSON برای
          برنامه‌نویسی و CSV برای بررسی جدولی آماده است.
        </p>
      </div>
      <div class="lab-download-actions">
        <a class="button" href={benchmarkFiles.json} download>دانلود JSON</a>
        <a class="button button-secondary" href={benchmarkFiles.csv} download
          >دانلود CSV</a
        >
        <a class="story-link" href={benchmarkResultFiles.json} download
          >دانلود نتایج</a
        >
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell ai-lab-grid">
      <div>
        <p class="eyebrow">چهار دستهٔ آزمون</p><h2>
          هر امتیاز باید توضیح‌پذیر باشد.
        </h2><p>
          برای جلوگیری از رتبه‌بندی نمایشی، هر دسته نمونه، پاسخ مرجع و قواعد
          خطای جدا دارد.
        </p>
      </div><ol>
        {
          protocol.map((item, index) => (
            <li>
              <>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section class="ai-lab-status">
    <div class="shell ai-lab-status-grid">
      <div>
        <p class="eyebrow">وضعیت انتشار</p><h2>
          حالا روش و نتیجه هر دو قابل بررسی‌اند.
        </h2>
      </div><dl>
        <div><dt>تعریف معیارها</dt><dd>انجام شده</dd></div><div>
          <dt>ساخت مجموعهٔ آزمون</dt><dd>نسخهٔ ۰٫۱ منتشر شد</dd>
        </div><div><dt>اجرای چندمدلی</dt><dd>۲۴ پاسخ کامل</dd></div><div>
          <dt>انتشار داده</dt><dd>پرامپت، پاسخ و امتیاز</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section">
    <div class="shell benchmark-cases">
      <div class="ai-section-head">
        <div>
          <p class="eyebrow">سناریوهای نسخهٔ ۰٫۱</p><h2>
            کوچک، واقعی و قابل بررسی.
          </h2>
        </div>
        <p>
          این نسخه کوچک است و نتیجه فقط در محدودهٔ همین سناریوها معتبر می‌ماند.
          دادهٔ حساس یا محرمانه داخل مجموعه وجود ندارد.
        </p>
      </div>
      <div class="benchmark-case-grid">
        {
          benchmarkCases.map((item) => (
            <article>
              <span>
                {item.id} · {item.category}
              </span>
              <h3>{item.title}</h3>
              <p>{item.goal}</p>
              <details>
                <summary>دیدن ورودی و معیارها</summary>
                <>
                  <h4>ورودی</h4>
                  <p>{item.input}</p>
                </>
                <>
                  <h4>دستور</h4>
                  <p>{item.prompt}</p>
                </>
                <>
                  <h4>معیار قبولی</h4>
                  <ul>
                    {item.checks.map((check) => (
                      <li>{check}</li>
                    ))}
                  </ul>
                </>
              </details>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section benchmark-score-section">
    <div class="shell benchmark-score-card">
      <div>
        <p class="eyebrow">وزن امتیازها</p><h2>امتیاز از کجا می‌آید؟</h2>
      </div>
      <dl>
        {
          benchmarkDimensions.map((item) => (
            <div>
              <>
                <dt>{item.label}</dt>
                <dd>{item.weight}٪</dd>
              </>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
  <section class="section">
    <div class="shell ai-lab-rules">
      <h2>قواعد انتشار نتیجه</h2><ul>
        <li>نام دقیق ابزار یا مدل و تاریخ اجرا ثبت می‌شود.</li><li>
          پرامپت و ورودی آزمون برای همه یکسان می‌ماند.
        </li><li>خطاهای واقعیت، زبان و قالب جداگانه گزارش می‌شوند.</li><li>
          امتیاز نهایی همراه پاسخ خام و توضیح داور منتشر می‌شود.
        </li><li>تغییر نسخه به‌معنای لزوم آزمون دوباره است.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
