---
import { getCollection } from 'astro:content';
import AIGuideCard from '../../../components/AIGuideCard.astro';
import AIToolCard from '../../../components/AIToolCard.astro';
import PageStage from '../../../components/PageStage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const guides = (await getCollection('aiGuides')).filter(
  (guide) => !guide.data.draft && guide.data.topic === 'offline',
);
const tools = (await getCollection('aiTools'))
  .filter((tool) => tool.data.category === 'local')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="هوش مصنوعی آفلاین و مدل‌های محلی | MAHSAI"
  description="راهنمای امن اجرای مدل‌های هوش مصنوعی روی ویندوز و کامپیوتر شخصی؛ مشخصات سخت‌افزار، لینک رسمی و روش آزمون آفلاین."
>
  <PageStage
    eyebrow="هوش مصنوعی آفلاین"
    title="مدل روی دستگاه شما؛"
    highlight="با انتظار واقعی."
    lead="لینک دانلود فقط به سایت رسمی می‌رود. قبل از نصب، سخت‌افزار، فضای دیسک، مجوز مدل و مرز واقعی آفلاین‌بودن را بررسی می‌کنیم."
    index={`${tools.length} ابزار محلی`}
    note="MAHSAI فایل نصبی دیگران را میزبانی نمی‌کند و نسخهٔ کرک‌شده یا لینک ناشناس معرفی نخواهد کرد."
    signals={[
      'لینک رسمی',
      'نیازمندی سخت‌افزار',
      'هشدار امنیتی',
      'آزمون آفلاین',
    ]}
    tone="apricot"
  />
  <section class="section">
    <div class="shell">
      <div class="ai-section-head">
        <div>
          <p class="eyebrow">راهنمای شروع</p><h2>قبل از دانلود بخوانید.</h2>
        </div>
      </div><div class="ai-guide-grid">
        {guides.map((guide) => <AIGuideCard guide={guide} featured />)}
      </div>
    </div>
  </section>
  <section class="section section-alt">
    <div class="shell">
      <div class="ai-section-head">
        <div>
          <p class="eyebrow">ابزارهای محلی</p><h2>
            از مسیر سازنده دریافت کنید.
          </h2>
        </div>
      </div><div class="ai-tool-grid">
        {tools.map((tool) => <AIToolCard tool={tool} />)}
      </div>
    </div>
  </section>
</BaseLayout>
