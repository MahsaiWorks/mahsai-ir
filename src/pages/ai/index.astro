---
import { getCollection } from 'astro:content';
import AIGuideCard from '../../components/AIGuideCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = (await getCollection('aiGuides'))
  .filter((guide) => !guide.data.draft)
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );
const updates = (await getCollection('aiUpdates'))
  .filter((update) => !update.data.draft)
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      b.data.priority - a.data.priority,
  );
const latestUpdate = updates[0];
const paths = [
  {
    label: 'می‌خواهم از صفر شروع کنم',
    description:
      'یک راهنمای کوتاه انتخاب کنید و با یک خروجی واقعی از صفحه بیرون بروید.',
    href: '/ai/learn/',
    action: 'دیدن راهنماهای ساده',
    tone: 'mint',
  },
  {
    label: 'می‌خواهم ابزار درست را انتخاب کنم',
    description:
      'کاربرد، محدودیت و شرایط دسترسی هر ابزار را قبل از صرف وقت ببینید.',
    href: '/ai/tools/',
    action: 'مقایسهٔ انتخاب‌ها',
    tone: 'navy',
  },
  {
    label: 'می‌خواهم بدانم چه چیزی تازه است',
    description:
      'فقط تغییرهایی را بخوانید که روی کار، هزینه یا تصمیم شما اثر می‌گذارند.',
    href: '/ai/today/',
    action: 'خواندن تازه‌های مهم',
    tone: 'coral',
  },
  {
    label: 'می‌خواهم روی رایانهٔ خودم اجرا کنم',
    description:
      'ببینید اجرای بدون اینترنت برای دستگاه و نیاز شما منطقی هست یا نه.',
    href: '/ai/offline/',
    action: 'راهنمای استفاده بدون اینترنت',
    tone: 'sand',
  },
] as const;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const itemListStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'راهنماهای فارسی هوش مصنوعی در MAHSAI',
  itemListElement: guides.slice(0, 6).map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: guide.data.title,
    url: new URL(`/ai/learn/${guide.id}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title="راهنمای ساده و کاربردی هوش مصنوعی برای فارسی‌زبانان | MAHSAI"
  description="راهنماهای فارسی و تصویری هوش مصنوعی، انتخاب ابزار، تازه‌های مهم و روش استفاده بدون اینترنت؛ ساده، منبع‌دار و مناسب نیاز کاربر ایرانی."
  keywords={[
    'هوش مصنوعی به زبان ساده',
    'آموزش هوش مصنوعی فارسی',
    'راهنمای ابزارهای هوش مصنوعی',
    'هوش مصنوعی برای کاربران ایرانی',
  ]}
  imageAlt="راهنمای فارسی و کاربردی هوش مصنوعی در MAHSAI"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(itemListStructuredData)}
  />

  <section class="mahsa-ai-hero" aria-labelledby="ai-title">
    <div class="shell mahsa-ai-hero-grid">
      <div class="mahsa-ai-hero-copy">
        <p class="mahsa-home-kicker">هوش مصنوعی برای زندگی و کار واقعی</p>
        <h1 id="ai-title">
          از سؤال شما شروع می‌کنیم؛ <span>نه از نام ابزارها.</span>
        </h1>
        <p>
          اینجا قرار نیست میان اصطلاحات پیچیده و فهرست‌های بلند گم شوید.
          مسئله‌تان را انتخاب کنید، توضیح ساده بخوانید و قدم بعدی را همان روز
          امتحان کنید.
        </p>
        <div class="mahsa-home-actions">
          <a class="button" href="/ai/learn/">یک راهنمای مناسب پیدا کنید</a>
          <a class="mahsa-text-link" href="/ai/tools/"
            >برای کارم چه ابزاری بهتر است؟</a
          >
        </div>
        <ul class="mahsa-home-promises" aria-label="تعهدهای محتوایی MAHSAI">
          <li>توضیح روان</li>
          <li>منبع قابل بررسی</li>
          <li>محدودیت‌های روشن</li>
        </ul>
      </div>

      <figure class="mahsa-ai-hero-visual">
        <img
          src="/ai/gemini-notebook-editorial-cover-v1.png"
          alt="برگه‌ها و منابعی که به یک پاسخ مرتب و قابل استفاده تبدیل شده‌اند"
          width="1664"
          height="945"
        />
        <figcaption>
          <strong>فرمول هر مطلب</strong>
          <span>یک مسئلهٔ روشن</span>
          <span>یک توضیح قابل فهم</span>
          <span>یک کار قابل انجام</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {
    latestUpdate && (
      <section class="mahsa-latest" aria-labelledby="ai-latest-title">
        <div class="shell mahsa-latest-card">
          <div class="mahsa-latest-copy">
            <p class="eyebrow">تغییری که ارزش دانستن دارد</p>
            <h2 id="ai-latest-title">{latestUpdate.data.title}</h2>
            <p>{latestUpdate.data.description}</p>
            <div class="mahsa-latest-action">
              <span>پیشنهاد عملی</span>
              <p>{latestUpdate.data.action}</p>
            </div>
            <a class="button" href={`/ai/today/${latestUpdate.id}/`}>
              توضیح کامل و منبع
            </a>
          </div>
          <aside class="mahsa-latest-note">
            <span>آخرین بررسی منبع</span>
            <strong>{formatDate(latestUpdate.data.verifiedAt)}</strong>
            <p>
              تفاوت میان گفتهٔ سازنده، بررسی منبع و آزمون عملی در خود مطلب مشخص
              شده است.
            </p>
          </aside>
        </div>
      </section>
    )
  }

  <section class="mahsa-entry section" aria-labelledby="ai-paths-title">
    <div class="shell">
      <div class="mahsa-section-heading">
        <div>
          <p class="eyebrow">مسیر کوتاه‌تر</p>
          <h2 id="ai-paths-title">امروز چه کاری می‌خواهید انجام دهید؟</h2>
        </div>
        <p>
          نزدیک‌ترین جمله به نیازتان را انتخاب کنید؛ بقیهٔ مسیر را برایتان مرتب
          کرده‌ایم.
        </p>
      </div>
      <div class="mahsa-entry-grid">
        {
          paths.map((item) => (
            <a href={item.href} data-tone={item.tone}>
              <span aria-hidden="true">
                <>
                  <i />
                  <b />
                </>
              </span>
              <strong>{item.label}</strong>
              <p>{item.description}</p>
              <em>{item.action} ←</em>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mahsa-learning section" aria-labelledby="ai-guides-title">
    <div class="shell">
      <div class="mahsa-section-heading">
        <div>
          <p class="eyebrow">برای شروع</p>
          <h2 id="ai-guides-title">سه راهنمایی که فقط خواندنی نیستند.</h2>
        </div>
        <a class="story-link" href="/ai/learn/">همهٔ راهنماهای رایگان</a>
      </div>
      <div class="ai-guide-grid">
        {
          guides
            .slice(0, 3)
            .map((guide, index) => (
              <AIGuideCard guide={guide} featured={index === 0} />
            ))
        }
      </div>
    </div>
  </section>

  <section class="mahsa-editorial-method" aria-labelledby="ai-method-title">
    <div class="shell mahsa-editorial-method-grid">
      <div>
        <p class="eyebrow">چرا می‌شود به یک مطلب اعتماد کرد؟</p>
        <h2 id="ai-method-title">اطمینان را داخل همان صفحه نشان می‌دهیم.</h2>
        <p>
          هر ادعا باید به منبع اصلی برسد. تاریخ بررسی پنهان نمی‌شود و اگر چیزی
          را خودمان امتحان نکرده باشیم، آن را نتیجهٔ آزمون معرفی نمی‌کنیم.
        </p>
        <a class="button button-secondary" href="/ai/sources/"
          >روش انتخاب و اصلاح منابع</a
        >
      </div>
      <ul>
        <li>
          <strong>منبع اصلی</strong><span
            >لینک مستقیم به سازنده، پژوهش یا مرجع رسمی</span
          >
        </li>
        <li>
          <strong>زبان انسانی</strong><span
            >توضیح مفهوم بدون تکرار واژه‌های پیچیده</span
          >
        </li>
        <li>
          <strong>شرایط کاربر ایرانی</strong><span
            >توجه به دسترسی، هزینه، حریم خصوصی و زبان فارسی</span
          >
        </li>
        <li>
          <strong>اصلاح روشن</strong><span
            >به‌روزرسانی مطلب وقتی اطلاعات مهم تغییر می‌کند</span
          >
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
