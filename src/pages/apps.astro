---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../config/site';
import { getCafeBazaarLink } from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const publishedApps = (await getCollection('apps'))
  .filter(
    (entry) =>
      entry.data.status === 'available' && entry.data.storeLinks.length > 0,
  )
  .sort((a, b) => a.data.order - b.data.order);

const app = publishedApps.find((entry) => entry.id === 'metrazh');
if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const related = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder)
  .slice(0, 3);
---

<BaseLayout
  title={`اپلیکیشن‌های منتشرشده | ${siteConfig.brandName}`}
  description="اپلیکیشن‌های رسمی و منتشرشده MAHSAI؛ در حال حاضر متراژ، دستیار فارسی مدیریت فایل و مشتری برای مشاوران املاک ایران."
>
  <header class="catalog-hero">
    <div class="shell catalog-hero-grid">
      <div>
        <p class="kicker">اپلیکیشن‌های رسمی MAHSAI</p>
        <h1>محصولی را معرفی می‌کنیم که <span>قابل استفاده باشد.</span></h1>
        <p class="lead">
          اینجا فقط محصولات منتشرشده قرار می‌گیرند؛ همراه تصویر واقعی،
          قابلیت‌های فعلی، مسیر نصب و پشتیبانی مشخص.
        </p>
      </div>
      <aside class="catalog-rule">
        <strong>قاعدهٔ سادهٔ انتشار</strong>
        <p>
          محصول درحال‌ساخت، نام و وعدهٔ زودهنگام ندارد. هر محصول هم‌زمان با
          انتشار رسمی یا بعد از آن وارد این فهرست می‌شود.
        </p>
      </aside>
    </div>
  </header>

  <section class="published-product" aria-labelledby="published-product-title">
    <div class="shell published-product-grid">
      <div class="published-product-media">
        <ResponsiveImage
          class="published-product-character"
          src="/images/home/metrazh-hero-character.webp"
          alt="مشاور املاک در کنار ماکت ساختمان و تلفن همراه"
          width="1717"
          height="916"
        />
        <figure>
          <ResponsiveImage
            src="/images/apps/metrazh/bazaar/customer-follow-up.webp"
            alt="تصویر رسمی پیگیری مشتری در متراژ"
            width="1080"
            height="1920"
          />
        </figure>
      </div>

      <div class="published-product-copy">
        <span class="status-pill">منتشرشده در کافه‌بازار</span>
        <ResponsiveImage
          class="metrazh-wordmark metrazh-wordmark-dark"
          src={app.data.wordmark}
          alt="متراژ"
          width="702"
          height="425"
        />
        <h2 id="published-product-title">
          برای مشاوری که می‌خواهد اطلاعات کارش دست خودش بماند.
        </h2>
        <p>{app.data.shortDescription}</p>
        <ul class="feature-checks feature-checks-dark">
          {app.data.features.slice(0, 4).map((feature) => <li>{feature}</li>)}
        </ul>
        <div class="hero-actions">
          <a class="button" href="/apps/metrazh/">معرفی کامل و تصاویر</a>
          {
            bazaarLink && (
              <a
                class="text-link"
                href={bazaarLink.url}
                target="_blank"
                rel="noopener"
              >
                نصب از کافه‌بازار ↗
              </a>
            )
          }
        </div>
        <dl class="product-mini-facts">
          <div><dt>نسخه</dt><dd>{app.data.version}</dd></div>
          <div><dt>سیستم‌عامل</dt><dd>اندروید</dd></div>
          <div><dt>پشتیبانی</dt><dd>فارسی</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section product-ecosystem" aria-labelledby="ecosystem-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">فراتر از نصب برنامه</p>
          <h2 id="ecosystem-title">ابزار، آموزش و پشتیبانی کنار هم.</h2>
        </div>
        <p>
          صفحهٔ هر محصول فقط ویترین نیست؛ راه یادگیری، پاسخ پرسش‌های مهم و مسیر
          ارتباط رسمی همان‌جا کامل می‌شود.
        </p>
      </header>

      <div class="ecosystem-grid">
        <a href="/apps/metrazh/">
          <ResponsiveImage
            src="/images/editorial/property-workflow-light.webp"
            alt="جریان منظم فایل‌ها و کارهای روزانهٔ املاک"
            width="1693"
            height="929"
            loading="lazy"
            decoding="async"
          />
          <div>
            <strong>معرفی محصول</strong><span>قابلیت و تصویر واقعی ←</span>
          </div>
        </a>
        <a href="/academy/">
          <ResponsiveImage
            src="/images/editorial/female-consultant-matching.webp"
            alt="مشاور املاک در حال بررسی نیاز مشتری"
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
          />
          <div>
            <strong>آموزش رایگان</strong><span>مسیرهای مرحله‌به‌مرحله ←</span>
          </div>
        </a>
        <a href="/support/">
          <ResponsiveImage
            src="/images/editorial/secure-real-estate-data.webp"
            alt="محافظت از اطلاعات کاری و فایل‌های املاک"
            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
          />
          <div>
            <strong>پشتیبانی رسمی</strong><span>راه ارتباط روشن ←</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section
        class="section latest-reading"
        aria-labelledby="apps-reading-title"
      >
        <div class="shell">
          <header class="section-head">
            <div>
              <p class="kicker">محتوای مرتبط با متراژ</p>
              <h2 id="apps-reading-title">قبل از نصب هم به کارتان می‌آید.</h2>
            </div>
            <a class="text-link" href="/articles/">
              همهٔ مقاله‌ها ←
            </a>
          </header>
          <div class="editorial-grid">
            {related.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
