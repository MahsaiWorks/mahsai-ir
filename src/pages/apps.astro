---
import { getCollection } from 'astro:content';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const publishedApps = (await getCollection('apps'))
  .filter(
    (entry) =>
      entry.data.status === 'available' && entry.data.storeLinks.length > 0,
  )
  .sort((a, b) => a.data.order - b.data.order);

const app = publishedApps.find((entry) => entry.id === 'metrazh');
if (!app) throw new Error('Published Metrazh content entry is missing.');

const bazaarLink = getCafeBazaarLink(app.data.storeLinks);
const related = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder)
  .slice(0, 3);

const productLinks = [
  {
    title: 'یادگیری متراژ',
    description: 'شروع سریع و روش‌های اجرایی برای کار روزانهٔ املاک',
    href: '/academy/',
  },
  {
    title: 'وضعیت نسخه',
    description: 'نسخهٔ منتشرشده، زمان بررسی و تاریخچهٔ تغییرات',
    href: '/apps/metrazh/status/',
  },
  {
    title: 'پشتیبانی رسمی',
    description: 'پاسخ پرسش‌ها، گزارش مشکل و مسیرهای ارتباط مستقیم',
    href: '/support/',
  },
] as const;
---

<BaseLayout
  title={`اپلیکیشن‌های منتشرشده | ${siteConfig.brandName}`}
  description="فهرست رسمی اپلیکیشن‌های منتشرشدهٔ MAHSAI؛ معرفی متراژ با تصویر واقعی، قابلیت‌های فعلی، راه نصب و پشتیبانی فارسی."
  preloadImage="/images/apps/metrazh/ui/properties.webp"
  preloadImageWidth={720}
  preloadImageSizes="(max-width: 56.25rem) 46vw, 17rem"
>
  <header class="product-index-hero">
    <div class="shell product-index-hero-grid">
      <div>
        <p class="brand-intro">محصولی که می‌توانید همین امروز امتحانش کنید</p>
        <h1>
          اینجا خبری از وعدهٔ محصول آینده نیست؛ <span
            >متراژ آمادهٔ نصب است.</span
          >
        </h1>
      </div>
      <div class="product-index-intro">
        <p>
          محیط واقعی برنامه، کارهایی که همین نسخه انجام می‌دهد و مسیر پشتیبانی
          را ببینید؛ بعد با خیال روشن‌تری تصمیم بگیرید.
        </p>
        <span>اکنون: متراژ برای اندروید</span>
      </div>
    </div>
  </header>

  <div class="product-index-main">
    <section class="product-dossier" aria-labelledby="product-dossier-title">
      <div class="shell product-dossier-layout">
        <div class="dossier-screens" aria-label="تصاویر واقعی اپلیکیشن متراژ">
          <figure class="dossier-screen dossier-screen-primary">
            <ResponsiveImage
              src="/images/apps/metrazh/ui/properties.webp"
              alt="فهرست فایل‌های ملکی در اپلیکیشن متراژ"
              width="720"
              height="1600"
              sizes="(max-width: 56.25rem) 48vw, 18rem"
              fetchpriority="high"
            />
          </figure>
          <figure class="dossier-screen dossier-screen-secondary">
            <ResponsiveImage
              src="/images/apps/metrazh/ui/customers.webp"
              alt="فهرست مشتری‌ها در اپلیکیشن متراژ"
              width="720"
              height="1600"
              sizes="(max-width: 56.25rem) 38vw, 13rem"
            />
          </figure>
        </div>

        <div class="dossier-copy">
          <p class="product-status-line">
            <span aria-hidden="true"></span> منتشرشده در کافه‌بازار
          </p>
          <div class="dossier-brand-row">
            <ResponsiveImage
              class="dossier-icon"
              src={app.data.icon}
              alt="نشان اپلیکیشن متراژ"
              width="512"
              height="512"
              sizes="5rem"
            />
            <ResponsiveImage
              class="metrazh-wordmark metrazh-wordmark-dark"
              src={app.data.wordmark}
              alt="متراژ"
              width="702"
              height="425"
              sizes="9rem"
            />
          </div>
          <h2 id="product-dossier-title">
            وقتی مشتری تماس می‌گیرد، فایل و یادداشت آخر جلوی شماست.
          </h2>
          <p>
            متراژ برای مشاوری ساخته شده که نمی‌خواهد جزئیات ملک و خواستهٔ مشتری
            میان دفترچه، پیام‌ها و گالری گم شود.
          </p>
          <ul class="dossier-feature-list">
            <li>فایل‌های ملکی با جست‌وجو و فیلتر</li>
            <li>نیاز مشتری و پیگیری بعدی</li>
            <li>پیشنهاد فایل متناسب با معیارهای ثبت‌شده</li>
            <li>بازدید، یادآوری و خروجی‌های کاری</li>
          </ul>
          <div class="hero-actions">
            <a class="button" href="/apps/metrazh/">متراژ را کامل ببینید</a>
            {
              bazaarLink && (
                <a
                  class="arrow-link"
                  href={getTrackedCafeBazaarUrl(bazaarLink.url, 'apps_dossier')}
                  target="_blank"
                  rel="noopener"
                  data-event="metrazh_bazaar_click"
                  data-event-location="apps_dossier"
                >
                  دریافت از کافه‌بازار <span aria-hidden="true">↗</span>
                </a>
              )
            }
          </div>
          <dl class="dossier-facts">
            <div><dt>نسخهٔ منتشرشده</dt><dd>{app.data.version}</dd></div>
            <div><dt>سیستم‌عامل</dt><dd>اندروید</dd></div>
            <div><dt>زبان و پشتیبانی</dt><dd>فارسی</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="product-compass" aria-labelledby="product-compass-title">
      <div class="shell product-compass-layout">
        <header>
          <p class="section-sign">آموزش و پشتیبانی کنار محصول</p>
          <h2 id="product-compass-title">بعد از نصب هم تنها نمی‌مانید.</h2>
        </header>
        <div class="product-link-list">
          {
            productLinks.map((item) => (
              <a href={item.href}>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <span aria-hidden="true">←</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      related.length > 0 && (
        <section
          class="product-reading"
          aria-labelledby="product-reading-title"
        >
          <div class="shell product-reading-layout">
            <header>
              <p class="section-sign">برای شروع مرتب‌تر</p>
              <h2 id="product-reading-title">
                برای اولین روز، از این سه راهنمای ساده شروع کنید.
              </h2>
              <a class="arrow-link" href="/articles/">
                همهٔ مقاله‌ها <span aria-hidden="true">←</span>
              </a>
            </header>
            <div class="reading-row-list">
              {related.map((article) => (
                <article>
                  <p>
                    {article.data.category} · {article.data.readingTime}
                  </p>
                  <h3>
                    <a href={`/articles/${article.id}/`}>
                      {article.data.title}
                    </a>
                  </h3>
                  <span>{article.data.description}</span>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
