---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { getAppStatusLabel, getCafeBazaarLink } from '../data/appPresentation';
import BaseLayout from '../layouts/BaseLayout.astro';

const app = (await getCollection('apps')).sort(
  (a, b) => a.data.order - b.data.order,
)[0];

if (!app) {
  throw new Error('No application content is available.');
}

const downloadLink = getCafeBazaarLink(app.data.storeLinks);
const productGuides = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.featured)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder)
  .slice(0, 3);
---

<BaseLayout
  title={`اپلیکیشن متراژ؛ محصول کاربردی ${siteConfig.brandName}`}
  description="آشنایی با متراژ؛ اپلیکیشن فارسی مدیریت فایل، مشتری، بازدید و پیگیری برای مشاوران املاک، همراه با تصاویر واقعی و لینک رسمی نصب."
>
  <section class="mahsa-apps-hero" aria-labelledby="apps-title">
    <div class="shell mahsa-apps-hero-grid">
      <div class="mahsa-apps-copy">
        <p class="mahsa-home-kicker">محصولی برای یک مسئلهٔ واقعی در ایران</p>
        <img
          class="mahsa-apps-wordmark"
          src={app.data.logo.dark}
          alt="متراژ"
          width="190"
          height="115"
        />
        <h1 id="apps-title">
          کار املاک شلوغ است؛ <span>اطلاعاتتان نباید باشد.</span>
        </h1>
        <p>
          متراژ فایل ملک، نیاز مشتری، بازدید و پیگیری بعدی را در یک برنامهٔ
          فارسی کنار هم نگه می‌دارد؛ برای مشاوری که می‌خواهد کمتر میان دفتر،
          گالری و یادداشت‌ها جابه‌جا شود.
        </p>
        <div class="mahsa-home-actions">
          <a class="button" href={`/apps/${app.id}/`}>متراژ را کامل ببینید</a>
          {
            downloadLink && (
              <a
                class="mahsa-text-link"
                href={downloadLink.url}
                target="_blank"
                rel="noopener"
              >
                نصب از صفحهٔ رسمی کافه‌بازار ↗
              </a>
            )
          }
        </div>
        <p class="mahsa-app-status">
          <span>{getAppStatusLabel(app.data.status, app.data.storeLinks)}</span>
          <span>پشتیبانی فارسی</span>
          <span>طراحی راست‌به‌چپ</span>
        </p>
      </div>

      <div class="mahsa-apps-visual" aria-label="نمای اپلیکیشن متراژ">
        <img
          class="mahsa-apps-character"
          src="/images/home/metrazh-hero-character.webp"
          alt="مشاور املاک ایرانی در حال استفاده از اپلیکیشن متراژ"
          width="996"
          height="1096"
        />
        <figure>
          <img
            src={app.data.screenshots[0]?.src}
            alt={app.data.screenshots[0]?.alt}
            loading="eager"
          />
          <figcaption>نمای واقعی میز کار متراژ</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section mahsa-app-fit" aria-labelledby="app-fit-title">
    <div class="shell mahsa-app-fit-grid">
      <div>
        <p class="eyebrow">آیا متراژ برای شماست؟</p>
        <h2 id="app-fit-title">
          اگر این مسئله‌ها آشناست، از معرفی کامل شروع کنید.
        </h2>
      </div>
      <ul>
        {app.data.features.slice(0, 4).map((feature) => <li>{feature}</li>)}
      </ul>
      <aside>
        <strong>شفاف پیش از نصب</strong>
        <p>
          تصاویر واقعی، قابلیت‌های فعلی، روش نگهداری داده و وضعیت انتشار را در
          صفحهٔ اختصاصی متراژ یک‌جا می‌بینید.
        </p>
        <a class="button" href={`/apps/${app.id}/`}>معرفی کامل و تصاویر متراژ</a
        >
      </aside>
    </div>
  </section>

  {
    productGuides.length > 0 && (
      <section
        class="section mahsa-property-reads"
        aria-labelledby="apps-guides-title"
      >
        <div class="shell">
          <header class="mahsa-section-heading">
            <div>
              <p class="eyebrow">قبل و بعد از نصب</p>
              <h2 id="apps-guides-title">
                راهنماهایی برای کار منظم‌تر در املاک.
              </h2>
            </div>
            <a class="story-link" href="/articles/">
              همهٔ مقاله‌های املاک
            </a>
          </header>
          <div class="mahsa-property-grid">
            {productGuides.map((guide) => (
              <article>
                <a href={`/articles/${guide.id}/`}>
                  <img
                    src={guide.data.cover}
                    alt={guide.data.coverAlt}
                    loading="lazy"
                  />
                </a>
                <p>{guide.data.category}</p>
                <h3>
                  <a href={`/articles/${guide.id}/`}>{guide.data.title}</a>
                </h3>
                <a class="story-link" href={`/articles/${guide.id}/`}>
                  مطالعهٔ راهنما
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
