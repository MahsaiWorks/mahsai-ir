---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandPageIntro from '../components/BrandPageIntro.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { metrazhDirectRelease as direct } from '../data/metrazhDirectRelease';
const apps = (await getCollection('apps'))
  .filter((app) => app.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="اپلیکیشن‌های مهسای | ابزارهای فارسی برای کار روزانه"
  description="اپلیکیشن‌های مهسای را با تصاویر واقعی و راهنمای استفاده بشناسید؛ دریافت رسمی متراژ برای اندروید و دسترسی به آموزش و پشتیبانی فارسی."
>
  <BrandPageIntro
    eyebrow="اپلیکیشن‌های مهسای"
    title="برنامه‌های فارسی برای کار روزانه"
    description="محیط برنامه، امکانات و روش استفاده را ببینید و ابزار متناسب با نیازتان را انتخاب کنید."
  >
    <a class="button" href="/apps/metrazh/download/">دانلود متراژ</a><a
      class="text-link"
      href="/support/">راهنمای نصب ←</a
    >
  </BrandPageIntro>
  <section class="section" aria-label="اپلیکیشن‌های قابل دریافت">
    <div class="shell brand-app-list">
      {
        apps.map((app) => (
          <article class="brand-app-card">
            <div class="brand-app-copy">
              <div class="brand-app-identity">
                <>
                  <ResponsiveImage
                    src={app.data.icon}
                    width="512"
                    height="512"
                    sizes="72px"
                    alt=""
                    aria-hidden="true"
                  />
                  <div>
                    <>
                      <p class="kicker">دستیار فارسی مشاور املاک</p>
                      <h2>{app.data.name}</h2>
                    </>
                  </div>
                </>
              </div>
              <h3>فایل، مشتری و پیگیری در یک برنامه</h3>
              <p>{app.data.shortDescription}</p>
              <ul class="brand-app-features">
                <>
                  <li>مدیریت پرونده‌های ملکی</li>
                  <li>پیشنهاد فایل و مشتری</li>
                  <li>بازدید و پیگیری روزانه</li>
                </>
              </ul>
              <div class="brand-page-actions">
                <>
                  <a class="button" href={`/apps/${app.id}/download/`}>
                    دریافت {app.data.name}
                  </a>
                  <a class="text-link" href={`/apps/${app.id}/`}>
                    مشاهدهٔ امکانات ←
                  </a>
                </>
              </div>
              <p class="brand-app-meta">
                اندروید ۷ و بالاتر <span>نسخهٔ مستقیم {direct.versionFa}</span>
              </p>
              <p class="brand-app-access">
                نصب رایگان؛ امکانات حرفه‌ای با اشتراک
              </p>
            </div>
            <div class="brand-app-picture">
              <ResponsiveImage
                src="/images/apps/metrazh/current/property-details.webp"
                width="1080"
                height="2460"
                sizes="(max-width:760px) 60vw, 260px"
                alt="پروندهٔ یک ملک نمونه در متراژ"
                fetchpriority="high"
              />
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section
    class="section brand-next-steps"
    aria-labelledby="after-install-title"
  >
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="kicker">همراه برنامه</p><h2 id="after-install-title">
            از نصب تا استفادهٔ روزانه
          </h2>
        </div>
      </header>
      <div class="brand-link-grid">
        <a href="/academy/"
          ><span>۰۱</span><h3>یادگیری</h3><p>
            با آموزش‌های کوتاه و تمرین شروع کنید
          </p><b aria-hidden="true">←</b></a
        >
        <a href="/support/"
          ><span>۰۲</span><h3>پشتیبانی</h3><p>
            پاسخ پرسش‌ها و راه ارتباط مستقیم را پیدا کنید
          </p><b aria-hidden="true">←</b></a
        >
        <a href="/apps/metrazh/changelog/"
          ><span>۰۳</span><h3>به‌روزرسانی</h3><p>
            تغییرات و نسخهٔ تازهٔ متراژ را ببینید
          </p><b aria-hidden="true">←</b></a
        >
      </div>
    </div>
  </section>
</BaseLayout>
