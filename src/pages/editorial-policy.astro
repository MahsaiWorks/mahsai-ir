---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const updatedAt = new Date('2026-08-19');
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<BaseLayout
  title={`سیاست تحریریه و اصلاح محتوا | ${siteConfig.brandName}`}
  description="شیوهٔ انتخاب، نگارش، منبع‌دهی، به‌روزرسانی و اصلاح مقاله‌های MAHSAI و مرز روشن میان آموزش عمومی، معرفی محصول و نظر تخصصی."
>
  <header class="inner-hero editorial-policy-hero">
    <div class="shell inner-hero-grid">
      <div>
        <p class="kicker">پاسخ‌گویی و اعتماد</p>
        <h1>
          هر مطلب باید معلوم کند چه کسی، چگونه و چه زمانی آن را نوشته است.
        </h1>
        <p class="lead">
          این صفحه تعهد تحریریهٔ MAHSAI برای تولید محتوای روشن، قابل بررسی و
          قابل اصلاح است. آخرین بازبینی: {formatDate(updatedAt)}.
        </p>
      </div>
      <figure>
        <ResponsiveImage
          src="/images/editorial/secure-real-estate-data.webp"
          alt="پرونده‌های کاری مرتب و محافظت‌شده در کنار ابزارهای دیجیتال"
          width="1536"
          height="1024"
        />
      </figure>
    </div>
  </header>

  <section class="section">
    <div class="shell legal-layout">
      <aside class="legal-aside">
        <strong>خلاصهٔ تعهد</strong>
        <p>
          مطلب بی‌منبع، نظر ساختگی، تجربهٔ کاربر بدون اجازه و ادعای محصول
          منتشرنشده در سایت جایی ندارد.
        </p>
        <a
          class="button"
          href={`mailto:${siteConfig.supportEmail}?subject=${encodeURIComponent('گزارش اصلاح محتوای سایت MAHSAI')}`}
          data-event="editorial_correction_email"
          data-event-location="editorial_policy">گزارش خطا یا اصلاح</a
        >
      </aside>

      <article class="prose legal-prose">
        <h2>چه محتوایی منتشر می‌کنیم؟</h2>
        <p>
          محتوای هر حوزه فقط کنار محصول منتشرشدهٔ همان حوزه ساخته می‌شود. اکنون
          تمرکز عمومی سایت بر کار روزانهٔ مشاوران املاک و کاربردهای نسخهٔ عمومی
          متراژ است. محصول درحال‌ساخت تا زمان انتشار رسمی معرفی نمی‌شود.
        </p>

        <h2>نویسنده و مسئول محتوا</h2>
        <p>
          مسئول هر مقاله «تحریریهٔ MAHSAI» است و نام آن در صفحه دیده می‌شود.
          مسئولیت انتخاب موضوع، کنترل ادعاها، نگارش فارسی روان و اصلاح خطا با
          همین تحریریه است؛ استفاده از ابزار کمکی این مسئولیت را جابه‌جا
          نمی‌کند.
        </p>

        <h2>روش تهیه و منبع‌دهی</h2>
        <ul>
          <li>
            ادعای مربوط به متراژ با نسخه و مدارک انتشار عمومی تطبیق داده می‌شود.
          </li>
          <li>
            برای مقررات، سامانه‌ها و موضوع‌های حساس به منبع رسمی روز پیوند
            می‌دهیم.
          </li>
          <li>
            هرجا تجربه یا نظر بیرونی لازم باشد، هویت و اجازهٔ انتشار جداگانه
            بررسی می‌شود.
          </li>
          <li>
            تصویر استوک، تصویر محصول و تصویر تولیدشده در فهرست منابع از هم جدا
            می‌مانند.
          </li>
        </ul>

        <h2>تاریخ انتشار و به‌روزرسانی</h2>
        <p>
          تاریخ انتشار همیشه نمایش داده می‌شود. اگر متن، منبع یا نتیجهٔ عملی
          مطلب تغییر معنادار کند، تاریخ به‌روزرسانی هم ثبت می‌شود. اصلاح نگارشی
          کوچک الزاماً تاریخ مقاله را تغییر نمی‌دهد.
        </p>

        <h2>هر مطلب پیش از انتشار چه کنترل‌هایی می‌شود؟</h2>
        <ul>
          <li>سؤال اصلی و پاسخ کوتاه صفحه باید روشن و با عنوان هماهنگ باشد.</li>
          <li>
            متن باید یک اقدام قابل اجرا، خطای رایج و ادامهٔ مسیر داشته باشد.
          </li>
          <li>
            ادعای محصول با نسخهٔ عمومی و ادعای بیرونی با منبع معتبر سنجیده شود.
          </li>
          <li>تصویر، متن جایگزین، پیوندهای داخلی و نمایش موبایل بررسی شوند.</li>
          <li>نویسنده، روش تهیه، تاریخ بررسی و مسیر گزارش اصلاح دیده شوند.</li>
          <li>هیچ آمار، رضایت کاربر یا تأیید تخصصی بدون مدرک منتشر نشود.</li>
        </ul>
        <p>
          این کنترل‌ها برای ساختن صفحهٔ بیشتر نیست؛ برای این است که کاربر بعد از
          خواندن، جواب کامل‌تری بگیرد و مجبور نباشد همان سؤال را دوباره جست‌وجو
          کند.
        </p>

        <h2>موضوع‌های حقوقی و حساس</h2>
        <p>
          راهنمای حقوقی سایت آموزش عمومی است و جای نظر وکیل، دفتر اسناد رسمی یا
          مرجع دارای صلاحیت را نمی‌گیرد. اگر بازبینی بیرونی انجام نشده باشد، این
          موضوع صریحاً روی همان مقاله نوشته می‌شود. نام متخصص فقط پس از بررسی
          هویت، حوزهٔ صلاحیت و تأیید متن منتشر خواهد شد.
        </p>

        <h2>نظر کاربران و ادعاهای نتیجه</h2>
        <p>
          نقل‌قول، امتیاز، تعداد نصب یا نتیجهٔ کسب‌وکار ساخته نمی‌شود. تجربهٔ
          کاربر فقط با متن قابل‌ردیابی، اجازهٔ روشن برای انتشار و امکان حذف بعدی
          درج می‌شود. آمار رشد نیز فقط از ابزار سنجش واقعی و همراه بازهٔ زمانی
          گزارش خواهد شد.
        </p>

        <h2>اصلاح خطا چگونه انجام می‌شود؟</h2>
        <p>
          گزارش را به ایمیل پشتیبانی بفرستید و نشانی صفحه، عبارت مسئله‌دار، دلیل
          و در صورت امکان منبع معتبر را بنویسید. گزارش بررسی می‌شود؛ اگر درست
          باشد متن اصلاح و در تغییرهای مهم تاریخ به‌روزرسانی ثبت می‌شود. ارسال
          گزارش به معنی پذیرش خودکار ادعا نیست، اما همهٔ گزارش‌های روشن قابل
          بررسی‌اند.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
