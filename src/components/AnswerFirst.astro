---
interface Props {
  answer: string;
  actions?: string[];
  impact?: string;
  action?: string;
}

const { answer, actions = [], impact, action } = Astro.props;
---

<aside class="answer-first" aria-labelledby="answer-first-title">
  <span>اگر عجله دارید</span>
  <h2 id="answer-first-title">جواب کوتاه</h2>
  <p>{answer}</p>
  {
    actions.length > 0 && (
      <ol class="answer-first-actions">
        {actions.slice(0, 3).map((item) => (
          <li>{item}</li>
        ))}
      </ol>
    )
  }
  {
    impact && (
      <p class="answer-first-impact">
        <strong>چرا مهمه؟</strong> {impact}
      </p>
    )
  }
  {
    action && (
      <p class="answer-first-action">
        <strong>الان چه کار کنی؟</strong> {action}
      </p>
    )
  }
</aside>
