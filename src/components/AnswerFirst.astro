---
interface Props {
  answer: string;
  impact?: string;
}

const { answer, impact } = Astro.props;
---

<aside class="answer-first" aria-labelledby="answer-first-title">
  <span>اگر فقط ۳۰ ثانیه وقت دارید</span>
  <h2 id="answer-first-title">جواب کوتاه</h2>
  <p>{answer}</p>
  {
    impact && (
      <p class="answer-first-impact">
        <strong>چرا مهم است؟</strong> {impact}
      </p>
    )
  }
</aside>
