---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import { getCafeBazaarLink } from '../data/appPresentation';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'خانه' },
  { href: '/ai/today/', label: 'تازه‌های مهم' },
  { href: '/ai/learn/', label: 'یادگیری' },
  { href: '/ai/tools/', label: 'انتخاب ابزار' },
  { href: '/apps/metrazh/', label: 'متراژ' },
  { href: '/articles/', label: 'مجلهٔ املاک' },
  { href: '/support/', label: 'پشتیبانی' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const featuredApp = (await getCollection('apps'))
  .filter((app) => app.data.featured)
  .sort((a, b) => a.data.order - b.data.order)[0];
const downloadLink = featuredApp
  ? getCafeBazaarLink(featuredApp.data.storeLinks)
  : undefined;
---

<header class="site-header spatial-header">
  <div class="shell header-inner">
    <a
      class="brand"
      href="/"
      aria-label={`${siteConfig.brandName} — صفحه اصلی`}
    >
      <span class="brand-mark" aria-hidden="true">
        <img
          src="/brand/mahsai-symbol-reversed.svg"
          alt=""
          width="28"
          height="28"
        />
      </span>
      <span>{siteConfig.brandName}</span>
    </a>

    <nav class="desktop-nav" aria-label="پیمایش اصلی">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      (
        <a class="header-cta" href="/ai/today/">
          امروز چه چیزی مهم است؟
          <span aria-hidden="true">←</span>
        </a>
      )
    }

    <details class="mobile-nav">
      <summary aria-label="باز کردن فهرست پیمایش">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <nav aria-label="پیمایش موبایل">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            downloadLink && featuredApp && (
              <li>
                <a
                  class="mobile-download-link"
                  href={downloadLink.url}
                  target="_blank"
                  rel="noopener"
                >
                  دانلود {featuredApp.data.name} از کافه‌بازار
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
