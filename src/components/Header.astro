---
import { siteConfig } from '../config/site';
import MetrazhInstallDock from './MetrazhInstallDock.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/apps/', label: 'اپلیکیشن‌ها' },
  { href: '/academy/', label: 'آموزش' },
  { href: '/articles/', label: 'مجلهٔ مهسای' },
  { href: '/tools/', label: 'ابزارها' },
  { href: '/about/', label: 'دربارهٔ مهسای' },
];
const active = (href: string) => path.startsWith(href);
---

<header class="mahsai-header">
  <div class="shell mahsai-header-inner">
    <a class="mahsai-brand" href="/" aria-label="مهسای؛ صفحهٔ نخست">
      <img
        src="/brand/mahsai-symbol-navy-on-white.svg"
        width="43"
        height="43"
        alt=""
        aria-hidden="true"
      />
      <span dir="ltr">{siteConfig.brandName}</span>
    </a>
    <nav class="mahsai-nav" aria-label="فهرست اصلی">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="mahsai-support-link" href="/support/"
      >پشتیبانی <span aria-hidden="true">↖</span></a
    >
    <details class="mahsai-mobile-menu">
      <summary>فهرست</summary>
      <nav aria-label="فهرست موبایل">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={active(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <a href="/support/">پشتیبانی</a>
      </nav>
    </details>
  </div>
</header>

{path.replace(/\/$/, '') === '/apps/metrazh' && <MetrazhInstallDock />}

<script is:inline>
  (() => {
    const menu = document.querySelector('.mahsai-mobile-menu');
    if (!(menu instanceof HTMLDetailsElement)) return;
    const summary = menu.querySelector('summary');
    const closeMenu = () => {
      menu.open = false;
    };
    menu.addEventListener('toggle', () => {
      summary?.setAttribute(
        'aria-label',
        menu.open ? 'بستن فهرست' : 'باز کردن فهرست',
      );
    });
    menu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      closeMenu();
      summary?.focus();
    });
    document.addEventListener('pointerdown', (event) => {
      if (
        event.target instanceof Node &&
        menu.open &&
        !menu.contains(event.target)
      )
        closeMenu();
    });
  })();
</script>
