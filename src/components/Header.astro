---
import ResponsiveImage from './ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';

const path = Astro.url.pathname;
const links = [
  { href: '/apps/', label: 'محصولات' },
  { href: '/apps/metrazh/', label: 'متراژ' },
  { href: '/guides/', label: 'راهنماها' },
  { href: '/academy/', label: 'آموزش' },
  { href: '/articles/', label: 'مجله' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const featuredApp = (await getCollection('apps'))
  .filter((app) => app.data.featured && app.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order)[0];
const downloadLink = featuredApp
  ? getCafeBazaarLink(featuredApp.data.storeLinks)
  : undefined;
const downloadUrl = downloadLink
  ? getTrackedCafeBazaarUrl(downloadLink.url, 'header')
  : undefined;
---

<header class="site-header">
  <div class="shell header-inner">
    <a
      class="brand"
      href="/"
      aria-label={`${siteConfig.brandName} — صفحه اصلی`}
    >
      <span class="brand-mark" aria-hidden="true">
        <ResponsiveImage
          src="/brand/mahsai-symbol-reversed.svg"
          alt=""
          width="28"
          height="28"
          aria-hidden="true"
        />
      </span>
      <span class="brand-word">{siteConfig.brandName}</span>
    </a>

    <nav class="desktop-nav" aria-label="پیمایش اصلی">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="header-cta"
      href={downloadUrl ?? '/apps/metrazh/'}
      target={downloadLink ? '_blank' : undefined}
      rel={downloadLink ? 'noopener' : undefined}
    >
      دریافت متراژ
      <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-nav">
      <summary aria-label="باز کردن فهرست پیمایش">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <nav aria-label="پیمایش موبایل">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            downloadLink && featuredApp && (
              <li>
                <a
                  class="mobile-download-link"
                  href={getTrackedCafeBazaarUrl(downloadLink.url, 'mobile_nav')}
                  target="_blank"
                  rel="noopener"
                >
                  دانلود {featuredApp.data.name} از کافه‌بازار
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const menu = document.querySelector('.mobile-nav');
    if (!(menu instanceof HTMLDetailsElement)) return;

    const summary = menu.querySelector('summary');
    const closeMenu = () => {
      if (menu.open) menu.open = false;
    };

    const updateLabel = () => {
      summary?.setAttribute(
        'aria-label',
        menu.open ? 'بستن فهرست پیمایش' : 'باز کردن فهرست پیمایش',
      );
    };

    menu.addEventListener('toggle', updateLabel);
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      closeMenu();
      summary?.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (!(event.target instanceof Node)) return;
      if (menu.open && !menu.contains(event.target)) closeMenu();
    });

    updateLabel();
  })();
</script>
