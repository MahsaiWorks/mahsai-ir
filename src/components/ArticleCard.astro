---
import ResponsiveImage from './ResponsiveImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<article
  class:list={['editorial-card', { 'editorial-card-featured': featured }]}
>
  <a
    class="editorial-card-media"
    href={`/articles/${article.id}/`}
    aria-label={`مطالعه ${article.data.title}`}
    data-event="article_open"
    data-event-location="article_card_image"
  >
    <ResponsiveImage
      src={article.data.cover}
      alt={article.data.coverAlt}
      width={article.data.coverWidth}
      height={article.data.coverHeight}
      loading="lazy"
      decoding="async"
    />
    <span>{article.data.category}</span>
  </a>
  <div class="editorial-card-copy">
    <div class="article-meta">
      <time datetime={article.data.publishedAt.toISOString()}>
        {formatDate(article.data.publishedAt)}
      </time>
      {
        article.data.updatedAt && (
          <span>به‌روزرسانی {formatDate(article.data.updatedAt)}</span>
        )
      }
      <span>{article.data.readingTime}</span>
    </div>
    <h3>
      <a
        href={`/articles/${article.id}/`}
        data-event="article_open"
        data-event-location="article_card_title"
      >
        {article.data.title}
      </a>
    </h3>
    <p>{article.data.description}</p>
    <a
      class="story-link"
      href={`/articles/${article.id}/`}
      data-event="article_open"
      data-event-location="article_card_text"
    >
      خواندن مقاله <span aria-hidden="true">←</span>
    </a>
  </div>
</article>
