---
interface Item {
  href: string;
  label: string;
  title: string;
  description: string;
}

interface Props {
  items: Item[];
  title?: string;
}

const { items, title = 'بعد از این، چه بخوانم؟' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="related-reads" aria-labelledby="related-reads-title">
      <div class="related-reads-head">
        <p class="eyebrow">مسیر پیشنهادی</p>
        <h2 id="related-reads-title">{title}</h2>
      </div>
      <div class="related-reads-grid">
        {items.map((item, index) => (
          <a href={item.href}>
            <span>
              {String(index + 1).padStart(2, '0')} · {item.label}
            </span>
            <strong>{item.title}</strong>
            <p>{item.description}</p>
            <i aria-hidden="true">←</i>
          </a>
        ))}
      </div>
    </section>
  )
}
