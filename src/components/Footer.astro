---
import ResponsiveImage from './ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import {
  getCafeBazaarLink,
  getTrackedCafeBazaarUrl,
} from '../data/appPresentation';

const year = new Intl.DateTimeFormat('fa-IR', { year: 'numeric' }).format(
  new Date(),
);
const featuredApp = (await getCollection('apps'))
  .filter((app) => app.data.featured && app.data.status === 'available')
  .sort((a, b) => a.data.order - b.data.order)[0];
const downloadLink = featuredApp
  ? getCafeBazaarLink(featuredApp.data.storeLinks)
  : undefined;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <ResponsiveImage
            src="/brand/mahsai-symbol-reversed.svg"
            alt=""
            width="28"
            height="28"
            aria-hidden="true"
          />
        </span>
        <span>{siteConfig.brandName}</span>
      </a>
      <p>
        MAHSAI ابزارهای فارسی می‌سازد که اطلاعات پراکنده را جمع می‌کنند و کار
        بعدی را جلوی چشم می‌گذارند. متراژ، اولین محصول ما برای کار روزانهٔ املاک
        است.
      </p>
    </div>

    <nav aria-label="پیوندهای اصلی سایت">
      <h2>دسترسی سریع</h2>
      <ul>
        <li><a href="/apps/">اپلیکیشن‌های MAHSAI</a></li>
        <li><a href="/apps/metrazh/">معرفی کامل متراژ</a></li>
        <li><a href="/apps/metrazh/download/">نصب متراژ از کافه‌بازار</a></li>
        <li><a href="/apps/metrazh/changelog/">نسخه‌های متراژ</a></li>
        <li><a href="/guides/">راهنمای جامع املاک</a></li>
        <li><a href="/academy/">آموزش‌های رایگان املاک</a></li>
        <li><a href="/articles/">مقاله‌های کاربردی املاک</a></li>
        <li>
          <a href="/real-estate-software/">راهنمای نرم‌افزار مشاور املاک</a>
        </li>
        <li>
          <a href="/resources/real-estate-checklists/">چک‌لیست‌های رایگان</a>
        </li>
      </ul>
    </nav>

    <div>
      <h2>ارتباط</h2>
      <ul class="footer-site-links">
        <li><a href="/about/">درباره MAHSAI</a></li>
        <li><a href="/support/">پشتیبانی</a></li>
        <li><a href="/editorial-policy/">سیاست تحریریه و اصلاحات</a></li>
        <li><a href="/privacy/">حریم خصوصی</a></li>
        <li><a href="/terms/">شرایط استفاده</a></li>
        {
          downloadLink && featuredApp && (
            <li>
              <a
                href={getTrackedCafeBazaarUrl(downloadLink.url, 'footer')}
                target="_blank"
                rel="noopener"
                data-event="metrazh_bazaar_click"
                data-event-location="footer"
              >
                دانلود {featuredApp.data.name} از کافه‌بازار
              </a>
            </li>
          )
        }
      </ul>
      <a
        class="footer-email"
        href={`mailto:${siteConfig.supportEmail}`}
        dir="ltr"
      >
        {siteConfig.supportEmail}
      </a>
      {
        siteConfig.socialLinks.length > 0 && (
          <ul class="social-list">
            {siteConfig.socialLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="me noopener"
                  target="_blank"
                  data-event="official_instagram_open"
                  data-event-location="footer"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {year} {siteConfig.brandName}</span>
    <span>نسخه‌های رسمی فقط از مسیرهای اعلام‌شده در همین سایت.</span>
    <span lang="en" dir="ltr">mahsai.ir</span>
  </div>
</footer>
