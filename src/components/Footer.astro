---
import { siteConfig } from '../config/site';
const year = new Intl.DateTimeFormat('fa-IR', { year: 'numeric' }).format(
  new Date(),
);
const enamadBadgeHtml = `<a referrerpolicy='origin' target='_blank' aria-label='مشاهده شناسنامه رسمی اینماد متراژ' href='https://trustseal.enamad.ir/?id=7506195&Code=OHQG1aXCXFqM3gYapj2Mb7b109YIqMOn'><img referrerpolicy='origin' src='https://trustseal.enamad.ir/logo.aspx?id=7506195&Code=OHQG1aXCXFqM3gYapj2Mb7b109YIqMOn' alt='' style='cursor:pointer' code='OHQG1aXCXFqM3gYapj2Mb7b109YIqMOn'></a>`;
---

<footer class="mahsai-footer">
  <div class="shell mahsai-footer-grid">
    <div class="mahsai-footer-intro">
      <a class="mahsai-brand" href="/" aria-label="مهسای؛ صفحهٔ نخست">
        <img
          src="/brand/mahsai-symbol-navy-on-white.svg"
          width="43"
          height="43"
          alt=""
          aria-hidden="true"
        />
        <span dir="ltr">{siteConfig.brandName}</span>
      </a>
      <p>اپلیکیشن‌ها، ابزارها و آموزش‌های فارسی برای کار روزانه</p>
      <a href="/about/">با مهسای آشنا شوید ←</a>
    </div>
    <nav aria-label="کشف مهسای">
      <h2>کشف مهسای</h2>
      <ul>
        <li><a href="/apps/">اپلیکیشن‌ها</a></li>
        <li><a href="/apps/metrazh/">متراژ</a></li>
        <li><a href="/apps/metrazh/download/">دریافت متراژ</a></li>
        <li><a href="/tools/">ابزارهای آنلاین</a></li>
        <li><a href="/academy/">آموزش‌های رایگان</a></li>
        <li><a href="/articles/">مجلهٔ مهسای</a></li>
        <li><a href="/guides/">راهنماهای موضوعی</a></li>
      </ul>
    </nav>
    <nav aria-label="پشتیبانی و اطلاعات رسمی">
      <h2>کنار شما</h2>
      <ul>
        <li><a href="/support/">راهنما و پشتیبانی</a></li>
        <li><a href="/apps/metrazh/status/">وضعیت نسخهٔ متراژ</a></li>
        <li><a href="/apps/metrazh/changelog/">تاریخچهٔ تغییرات</a></li>
        <li>
          <a href="/resources/real-estate-checklists/">چک‌لیست‌های آماده</a>
        </li>
        <li><a href="/editorial-policy/">سیاست تحریریه</a></li>
        <li><a href="/privacy/">حریم خصوصی</a></li>
        <li><a href="/terms/">شرایط استفاده و خرید</a></li>
      </ul>
    </nav>
    <div class="mahsai-footer-contact">
      <h2>در ارتباط باشیم</h2>
      <a href={`mailto:${siteConfig.supportEmail}`} dir="ltr"
        >{siteConfig.supportEmail}</a
      >
      {
        siteConfig.socialLinks.map((link) => (
          <a href={link.url} rel="me noopener noreferrer" target="_blank">
            {link.label} ↖
          </a>
        ))
      }
      <div class="mahsai-trust">
        <div set:html={enamadBadgeHtml} /><p>
          شناسنامهٔ رسمی کسب‌وکار متراژ در سامانهٔ اینماد
        </p>
      </div>
    </div>
  </div>
  <div class="shell mahsai-footer-bottom">
    <span>© {year} MAHSAI · مهسای</span><span>وب‌سایت رسمی مهسای</span><span
      dir="ltr">mahsai.ir</span
    >
  </div>
</footer>
