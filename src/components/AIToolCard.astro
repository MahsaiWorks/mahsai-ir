---
import type { CollectionEntry } from 'astro:content';
import { toolAccessLabels, toolVerificationLabels } from '../data/aiNavigation';

interface Props {
  tool: CollectionEntry<'aiTools'>;
}

const { tool } = Astro.props;
const toolCategoryLabels = {
  assistant: 'دستیار عمومی',
  research: 'جست‌وجو و تحقیق',
  local: 'اجرا روی رایانه',
} as const;
const toolNameLabels: Record<string, string> = {
  chatgpt: 'چت‌جی‌پی‌تی',
  gemini: 'جمینای گوگل',
  claude: 'کلود',
  'gemini-notebook': 'دفتر پژوهش جمینای',
  perplexity: 'پرپلکسیتی',
  'microsoft-copilot': 'کوپایلت مایکروسافت',
  ollama: 'اولاما',
  'lm-studio': 'ال‌ام استودیو',
  'open-webui': 'اوپن وب‌یوآی',
  anythingllm: 'انی‌تینگ‌ال‌ال‌ام',
};
const displayName = toolNameLabels[tool.id] ?? tool.data.name;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<article class="ai-tool-card spatial-card">
  <div class="ai-tool-card-head">
    <span class="ai-tool-monogram" aria-hidden="true">
      {toolCategoryLabels[tool.data.category]}
    </span>
    <div>
      <p>{toolAccessLabels[tool.data.access]}</p>
      <h2>{displayName}</h2>
    </div>
  </div>
  <p>{tool.data.description}</p>
  <p class="ai-tool-plain">
    <strong>به زبان ساده:</strong>
    {tool.data.plainSummary}
  </p>
  <div class="ai-tool-detail">
    <h3>مناسب برای</h3>
    <ul>{tool.data.bestFor.map((item) => <li>{item}</li>)}</ul>
  </div>
  <div class="ai-tool-detail ai-tool-warning">
    <h3>قبل از استفاده</h3>
    <ul>{tool.data.limitations.map((item) => <li>{item}</li>)}</ul>
  </div>
  <footer>
    <span
      >{toolVerificationLabels[tool.data.verification]} · {
        formatDate(tool.data.verifiedAt)
      }</span
    >
    <a href={`/ai/tools/${tool.id}/`}>
      جزئیات و منابع <span aria-hidden="true">←</span>
    </a>
  </footer>
</article>
