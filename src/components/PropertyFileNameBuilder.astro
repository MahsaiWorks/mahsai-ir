<section
  class="file-name-builder"
  data-file-name-builder
  aria-labelledby="file-name-builder-title"
>
  <div class="builder-heading">
    <div>
      <p>ابزار کاربردی همین راهنما</p>
      <h2 id="file-name-builder-title">عنوان فایل را همین‌جا بسازید.</h2>
    </div>
    <span>اطلاعات فقط در مرورگر شما می‌ماند</span>
  </div>

  <p class="builder-intro" id="file-name-builder-help">
    چهار بخش را کامل کنید. خروجی کوتاه و یکدست است و می‌توانید آن را در یادداشت،
    پوشه یا سامانهٔ فعلی دفترتان استفاده کنید.
  </p>

  <form autocomplete="off" data-file-name-form>
    <fieldset aria-describedby="file-name-builder-help">
      <legend>چهار جزء عنوان</legend>
      <div class="builder-grid">
        <label>
          <span>نوع معامله</span>
          <select name="transaction" data-file-part required>
            <option value="">انتخاب کنید</option>
            <option value="فروش">فروش</option>
            <option value="رهن و اجاره">رهن و اجاره</option>
            <option value="پیش‌فروش">پیش‌فروش</option>
          </select>
        </label>

        <label>
          <span>محله</span>
          <input
            name="neighborhood"
            data-file-part
            type="text"
            maxlength="40"
            placeholder="مثلاً جنت‌آباد جنوبی"
            required
          />
        </label>

        <label>
          <span>نوع ملک</span>
          <select name="propertyType" data-file-part required>
            <option value="">انتخاب کنید</option>
            <option value="آپارتمان">آپارتمان</option>
            <option value="خانهٔ ویلایی">خانهٔ ویلایی</option>
            <option value="زمین">زمین</option>
            <option value="مغازه">مغازه</option>
            <option value="دفتر کار">دفتر کار</option>
          </select>
        </label>

        <label>
          <span>نشانهٔ تشخیصی</span>
          <input
            name="clue"
            data-file-part
            type="text"
            maxlength="60"
            placeholder="مثلاً ۲خواب، طبقهٔ ۳"
            required
          />
        </label>
      </div>
    </fieldset>

    <div class="builder-result">
      <span>عنوان پیشنهادی</span>
      <output data-file-name-output aria-live="polite" tabindex="0">
        بعد از تکمیل چهار بخش، عنوان اینجا ساخته می‌شود.
      </output>
    </div>

    <div class="builder-actions">
      <button
        class="builder-copy"
        type="submit"
        data-file-name-copy
        data-event="property_file_name_copied"
        disabled
      >
        کپی عنوان
      </button>
      <button class="builder-reset" type="reset">پاک‌کردن فرم</button>
      <p data-file-name-status role="status" aria-live="polite"></p>
    </div>
  </form>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-file-name-builder]');
    if (!root) return;

    const form = root.querySelector('[data-file-name-form]');
    const output = root.querySelector('[data-file-name-output]');
    const copyButton = root.querySelector('[data-file-name-copy]');
    const status = root.querySelector('[data-file-name-status]');
    const parts = [...root.querySelectorAll('[data-file-part]')];

    if (!form || !output || !copyButton || !status || parts.length === 0) {
      return;
    }

    const emptyOutput = output.textContent.trim();

    const clean = (value) =>
      value.replaceAll('|', ' ').replace(/\s+/g, ' ').trim();

    const update = () => {
      const values = parts.map((part) => clean(part.value));
      const complete = values.every(Boolean);
      output.textContent = complete ? values.join(' | ') : emptyOutput;
      copyButton.disabled = !complete;
      status.textContent = '';
    };

    form.addEventListener('input', update);
    form.addEventListener('reset', () => {
      copyButton.disabled = true;
      output.textContent = emptyOutput;
      status.textContent = '';
      window.setTimeout(update, 0);
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (copyButton.disabled) return;

      try {
        if (!navigator.clipboard?.writeText) throw new Error('clipboard');
        await navigator.clipboard.writeText(output.textContent.trim());
        status.textContent = 'عنوان کپی شد.';
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(output);
        selection?.removeAllRanges();
        selection?.addRange(range);
        output.focus();
        status.textContent =
          'عنوان انتخاب شد؛ برای کپی از کلیدهای کنترل و C استفاده کنید.';
      }
    });
  })();
</script>

