---
interface CourseOffer {
  slug: 'ai-content-real-estate';
  title: string;
  description: string;
  label: string;
}

interface Download {
  title: string;
  description: string;
  href: string;
  label: string;
}

interface Props {
  course: CourseOffer;
  download?: Download;
}

const { course, download } = Astro.props;
---

{
  download && (
    <aside
      class="article-free-download"
      id="article-download"
      aria-labelledby="article-download-title"
    >
      <p class="kicker">رایگان، بدون ثبت‌نام</p>
      <h2 id="article-download-title">{download.title}</h2>
      <p>{download.description}</p>
      <a class="text-link" href={download.href} download>
        {download.label} <span aria-hidden="true">↓</span>
      </a>
    </aside>
  )
}

<aside
  class="article-course-cta"
  id="course-for-this-article"
  aria-labelledby="article-course-title"
>
  <p class="kicker">اگر دوست داری ادامه بدی</p>
  <h2 id="article-course-title">{course.title}</h2>
  <p>{course.description}</p>
  <a class="button" href={`/academy/courses/${course.slug}/`}>
    {course.label}
    <span aria-hidden="true">←</span>
  </a>
</aside>

<style>
  .article-free-download,
  .article-course-cta {
    min-width: 0;
    padding: clamp(1.2rem, 4vw, 2rem);
    margin-top: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    scroll-margin-top: 6.5rem;
  }

  .article-free-download {
    background: var(--paper);
  }

  .article-course-cta {
    background: #f2f5ff;
    border-color: #d9e2ff;
  }

  .article-free-download h2,
  .article-course-cta h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  .article-free-download p,
  .article-course-cta p {
    color: var(--muted);
  }

  aside.article-course-cta .button {
    background: #064dff;
    color: #fff;
  }

  aside.article-course-cta .button:hover {
    background: #0039c7;
  }

  .article-course-cta .button,
  .article-free-download .text-link {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>
