---
import type { CollectionEntry } from 'astro:content';
import { guideKindLabels, guideLevelLabels } from '../data/aiNavigation';

interface Props {
  guide: CollectionEntry<'aiGuides'>;
  featured?: boolean;
}

const { guide, featured = false } = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('fa-IR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
---

<article
  class:list={[
    'ai-guide-card',
    'spatial-card',
    { 'ai-guide-card-featured': featured },
  ]}
>
  <div class="ai-guide-card-top">
    <span>{guideKindLabels[guide.data.kind]}</span>
    <span>{guideLevelLabels[guide.data.level]}</span>
  </div>
  <h3><a href={`/ai/learn/${guide.id}/`}>{guide.data.title}</a></h3>
  <p>{guide.data.description}</p>
  <div class="ai-card-meta">
    <time datetime={guide.data.verifiedAt.toISOString()}>
      بررسی {formatDate(guide.data.verifiedAt)}
    </time>
    <span>{guide.data.readingTime}</span>
  </div>
  <a class="story-link" href={`/ai/learn/${guide.id}/`}>
    مطالعه راهنما <span aria-hidden="true">←</span>
  </a>
</article>
