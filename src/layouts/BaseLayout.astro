---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';
import { getResponsiveImageSrcSet } from '../utils/responsiveImages';
import estedadArabicFont from '@fontsource-variable/estedad/files/estedad-arabic-wght-normal.woff2?url';
import '../styles/estedad-arabic.css';
import '../styles/site.css';
import '../styles/mahsai-original.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  preloadImage?: string;
  preloadImageWidth?: number;
  preloadImageSizes?: string;
}

const {
  title,
  description,
  noindex = false,
  image = siteConfig.seoDefaults.image,
  type = 'website',
  keywords = [],
  imageAlt = `معرفی اپلیکیشن‌های فارسی ${siteConfig.brandName}`,
  imageWidth = 1600,
  imageHeight = 900,
  preloadImage,
  preloadImageWidth = 1600,
  preloadImageSizes = '(max-width: 56.25rem) 100vw, 50vw',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const cloudflareAnalyticsToken = import.meta.env
  .PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const socialImage = new URL(image, Astro.site);
const socialImagePath = socialImage.pathname.toLowerCase();
const socialImageType = socialImagePath.endsWith('.webp')
  ? 'image/webp'
  : socialImagePath.endsWith('.jpg') || socialImagePath.endsWith('.jpeg')
    ? 'image/jpeg'
    : 'image/png';
const preloadImageSrcSet = preloadImage
  ? getResponsiveImageSrcSet(preloadImage, preloadImageWidth)
  : undefined;
const organizationId = new URL('/#organization', Astro.site).toString();
const websiteId = new URL('/#website', Astro.site).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: siteConfig.brandName,
      alternateName: siteConfig.brandNameFa,
      url: Astro.site?.toString(),
      logo: {
        '@type': 'ImageObject',
        url: new URL('/brand/mahsai-symbol.png', Astro.site).toString(),
      },
      sameAs: siteConfig.socialLinks.map((link) => link.url),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: siteConfig.brandName,
      alternateName: siteConfig.brandNameFa,
      url: Astro.site?.toString(),
      inLanguage: 'fa-IR',
      description: siteConfig.seoDefaults.description,
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang="fa-IR" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="enamad" content="4941961" />
    <link rel="icon" type="image/svg+xml" href="/favicon-mahsai-navy.svg" />
    <link
      rel="preload"
      href="/fonts/vazirmatn-arabic-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={estedadArabicFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          imagesrcset={preloadImageSrcSet}
          imagesizes={preloadImageSrcSet ? preloadImageSizes : undefined}
          fetchpriority="high"
        />
      )
    }
    <meta name="theme-color" content="#fffaf2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      keywords.length > 0 && (
        <meta name="keywords" content={keywords.join('، ')} />
      )
    }
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large'}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="مجلهٔ املاک MAHSAI"
      href="/articles/rss.xml"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={socialImageType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {
      cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: cloudflareAnalyticsToken,
          })}
        />
      )
    }
    <script is:inline>
      (() => {
        const emit = (name, properties = {}) => {
          document.dispatchEvent(
            new CustomEvent('mahsai:measure', {
              detail: {
                name,
                properties: { path: location.pathname, ...properties },
              },
            }),
          );
        };

        window.mahsaiMeasure = emit;

        const allowedMeasurementEvents = new Set([
          'guide_open',
          'guide_reading_started',
          'guide_to_metrazh',
          'article_open',
          'article_reading_started',
          'article_to_guide',
          'scroll_depth',
          'article_to_metrazh',
          'article_metrazh_anchor_click',
          'article_metrazh_offer_viewed',
          'article_resource_copied',
          'metrazh_page_view',
          'metrazh_screenshots_open',
          'metrazh_quick_start_view',
          'metrazh_scenarios_view',
          'metrazh_site_story_seen',
          'metrazh_interface_seen',
          'download_guide_viewed',
          'metrazh_bazaar_click',
          'metrazh_bazaar_review_open',
          'official_instagram_open',
          'print_checklists',
          'property_file_name_copied',
          'free_tool_completed',
          'free_tool_copied',
          'free_tool_printed',
          'support_contact_click',
          'support_email_prepared',
          'metrazh_feedback_email',
          'content_share',
          'newsletter_interest_email',
          'campaign_redirect',
          'content_vote_email',
          'free_course_print',
          'paid_course_interest_email',
          'editorial_correction_email',
          'workday_route_selected',
          'client_error',
        ]);

        const fixedLabel = (value) => {
          if (typeof value !== 'string') return undefined;
          const label = value
            .normalize('NFKC')
            .trim()
            .toLowerCase()
            .replace(/[^a-z0-9_:-]+/g, '_')
            .replace(/_+/g, '_')
            .replace(/^_+|_+$/g, '')
            .slice(0, 80);
          return /^[a-z0-9]/.test(label) ? label : undefined;
        };

        const measurementLocation = (name, properties) => {
          const direct = fixedLabel(properties.location);
          if (direct) return direct;

          if (name === 'scroll_depth') {
            return properties.depth === 90 ? 'depth_90' : 'depth_50';
          }
          if (name === 'client_error') {
            return properties.kind === 'unhandled_rejection'
              ? 'unhandled_rejection'
              : 'error';
          }

          const fixedProperty =
            name === 'workday_route_selected'
              ? fixedLabel(properties.route)
              : name === 'campaign_redirect'
                ? fixedLabel(properties.campaign)
                : name === 'free_course_print'
                  ? fixedLabel(properties.course)
                  : name === 'support_email_prepared'
                    ? fixedLabel(properties.category)
                    : undefined;
          return fixedProperty
            ? `${name}:${fixedProperty}`.slice(0, 80)
            : 'page';
        };

        document.addEventListener('mahsai:measure', (event) => {
          if (!(event instanceof CustomEvent)) return;
          const detail = event.detail;
          if (!detail || typeof detail !== 'object') return;

          const name = detail.name;
          const properties =
            detail.properties && typeof detail.properties === 'object'
              ? detail.properties
              : {};
          if (typeof name !== 'string' || !allowedMeasurementEvents.has(name)) {
            return;
          }

          const payload = JSON.stringify({
            schema: 'mahsai_site_event_v1',
            name,
            path: location.pathname,
            location: measurementLocation(name, properties),
          });
          const endpoint = '/api/events';
          const queued =
            typeof navigator.sendBeacon === 'function' &&
            navigator.sendBeacon(
              endpoint,
              new Blob([payload], { type: 'application/json' }),
            );

          if (!queued) {
            fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true,
              credentials: 'omit',
            }).catch(() => {});
          }
        });

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const target = event.target.closest('a, button, [data-event]');
          if (!target) return;

          const destination = target.getAttribute('href') || undefined;
          const name =
            target.dataset.event ||
            (destination?.includes('cafebazaar.ir')
              ? 'metrazh_bazaar_click'
              : destination?.startsWith('mailto:') ||
                  (location.pathname === '/support/' &&
                    destination?.includes('t.me/'))
                ? 'support_contact_click'
                : undefined);
          if (!name) return;

          const fallbackLocation = target.closest('.site-header')
            ? 'header'
            : target.closest('.site-footer')
              ? 'footer'
              : 'page';

          emit(name, {
            location: target.dataset.eventLocation || fallbackLocation,
            destination,
          });
        });

        const reached = new Set();
        addEventListener(
          'scroll',
          () => {
            const available =
              document.documentElement.scrollHeight - innerHeight;
            if (available <= 0) return;
            const depth = Math.round((scrollY / available) * 100);

            for (const threshold of [50, 90]) {
              if (depth >= threshold && !reached.has(threshold)) {
                reached.add(threshold);
                emit('scroll_depth', { depth: threshold });
              }
            }
          },
          { passive: true },
        );

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const name = entry.target.dataset.viewEvent;
              if (name) emit(name, { location: entry.target.id || undefined });
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.45 },
        );

        document
          .querySelectorAll('[data-view-event]')
          .forEach((element) => observer.observe(element));

        addEventListener('error', () =>
          emit('client_error', { kind: 'error' }),
        );
        addEventListener('unhandledrejection', () =>
          emit('client_error', { kind: 'unhandled_rejection' }),
        );
      })();
    </script>
  </body>
</html>
